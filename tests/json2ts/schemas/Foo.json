{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foo",
  "type": "object",
  "required": ["bar", "count"],
  "properties": {
    "bar": { "$ref": "#/$defs/Bar" },
    "count": { "type": "integer" }
  },
  "$defs": {
    "Bar": { "type": "string", "enum": ["x", "y"] }
  }
}
