{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cddl_lib",
  "$defs": {
    "Bar": { "type": "string", "enum": ["x", "y"] },
    "Blake2b256": {
      "description": "Blake2b256JSON is named verbatim here, and so is Blake2b256.",
      "type": "object",
      "required": ["hash"],
      "properties": { "hash": { "type": "string" } }
    },
    "Blake2B256": {
      "type": "object",
      "required": ["hex"],
      "properties": { "hex": { "type": "string" } }
    },
    "Spelling": { "type": "string", "enum": ["Blake2b256JSON", "Blake2b256"] },
    "OrderedHashMap<K, V>": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "Odd<K>/~1name": {
      "type": "object",
      "required": ["v"],
      "properties": { "v": { "type": "integer" } }
    },
    "OddHolder": {
      "type": "object",
      "required": ["odd"],
      "properties": { "odd": { "$ref": "#/$defs/Odd%3CK%3E~1~01name" } }
    },
    "Deep": {
      "type": "object",
      "required": ["inner"],
      "properties": {
        "inner": {
          "type": "object",
          "required": ["titled"],
          "properties": {
            "titled": { "$ref": "#/$defs/Titled" },
            "extra": { "type": "integer" }
          },
          "patternProperties": { "^\\d+$": { "$ref": "#/$defs/Bar" } }
        }
      }
    },
    "Foo": {
      "type": "object",
      "required": ["bar", "count", "nested", "titled"],
      "properties": {
        "bar": { "$ref": "#/$defs/Bar" },
        "count": { "type": "integer" },
        "nested": { "$ref": "#/$defs/Nested", "description": "a documented field" },
        "titled": { "$ref": "#/$defs/Titled" }
      }
    },
    "Nested": {
      "type": "object",
      "required": ["n"],
      "properties": { "n": { "type": "integer", "format": "uint64", "minimum": 0 } }
    },
    "Open": {
      "type": "object",
      "required": ["nested"],
      "properties": {
        "nested": { "$ref": "#/$defs/Nested" },
        "label": { "type": "string" }
      },
      "patternProperties": { "^\\d+$": { "$ref": "#/$defs/Bar" } }
    },
    "Rest": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "type": "string" },
        "count": { "type": "integer" }
      },
      "additionalProperties": { "$ref": "#/$defs/Bar" }
    },
    "RestDeep": {
      "type": "object",
      "required": ["inner"],
      "properties": {
        "inner": {
          "type": "object",
          "required": ["titled"],
          "properties": {
            "titled": { "$ref": "#/$defs/Titled" },
            "spare": { "type": "string" }
          },
          "additionalProperties": { "$ref": "#/$defs/Bar" }
        }
      }
    },
    "RestSame": {
      "type": "object",
      "required": ["n"],
      "properties": { "n": { "type": "integer" } },
      "additionalProperties": { "type": "integer" }
    },
    "RestAny": {
      "type": "object",
      "required": ["n"],
      "properties": { "n": { "type": "integer" } },
      "additionalProperties": {}
    },
    "Table": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "Titled": {
      "title": "RenamedByDocComment",
      "type": "object",
      "required": ["t"],
      "properties": { "t": { "type": "string" } }
    }
  }
}
