; Preserve-encodings golden known-answer vectors. The byte strings in tests.rs are hand-derived
; from RFC 8949 §3 (integer/length/tag argument forms, indefinite-length items), independent of
; the generator AND of the tests/deser_test cbor_event helpers: the preserve/canonical suites
; build their expected bytes with the same cbor_event write_*_sz primitives the generated code
; encodes with, so a symmetric bug in that shared layer corrupts expected and actual identically
; and still round-trips green. Raw spec-anchored hex breaks that circularity for the preserve path.
;
; Coverage: non-minimal integer/length/tag header arguments (the 1/2/4/8-byte forms of values that
; fit smaller), indefinite-length strings/arrays/maps (incl. chunked strings), and map key order.

; non-minimal uint arguments + array framing
pair = [a: uint, b: uint]

; indefinite / non-minimal-length text and byte strings
strs = [s: tstr, v: bstr]

; struct map: indefinite framing, non-minimal count, key order, key/value header arguments
kv = { a: uint, b: uint }

; homogeneous array (the `*` occurrence): bare [* uint] generates a plain Vec alias with no
; serialization methods, so wrap it in a record to get a testable struct
uint_seq   = [* uint]
seq_holder = [xs: uint_seq]

; tag header argument forms (tag 11: minimal head 0xcb, wider heads 0xd8/0xd9 + argument)
tagged_one = #6.11([x: uint])

; negative integers (major type 1): the argument-form family mirrored from `pair`.
; The generated struct STORES the CBOR argument (-1 - value) as u64 — see the emitted
; write_negative_integer_sz(-(n+1)) — so the tests.rs value anchors assert that argument.
npair = [n: nint, m: nint]

; table (`{ * uint => text }`): key ORDER and per-key/value header arguments are data under
; preserve. Wrapped in a record (transparent aliases have no standalone Serialize).
uint_table   = { * uint => text }
table_holder = [t: uint_table]

; variable-length container of CBOR major-type-7 (bool) elements: an indefinite `[* bool]` re-frame
; feeds the deserialize-loop break-check a bool (0xf4/0xf5), which shares major type 7 with the 0xff
; break — it must NOT be mistaken for the break. Bare `[* bool]` is a transparent Vec alias, wrap it.
bool_seq        = [* bool]
bool_seq_holder = [bs: bool_seq]

; table with major-type-7 (bool) KEYS: the map break-check peeks the KEY type, so a bool key
; (0xf4/0xf5) must flow to the key deserializer rather than be read as the 0xff break.
bool_table        = { * bool => text }
bool_table_holder = [bt: bool_table]

; tag-258 set idiom (`#6.258([* a]) / [* a]`): the tag PRESENCE is an encoding variable, so BOTH
; wire arms — tagged (at any header size) and untagged — must re-serialize byte-identically under
; --preserve-encodings, and a non-minimal tag header is preserved verbatim. These rules carry the
; EXPLICIT `; @duplicates preserve` opt-out: tag 258 now DEFAULTS to `@duplicates reject`, so the
; opt-out is what pins the transparent alias (Vec<String>) here — the multi-era byte-exact reader
; for historical duplicate-bearing data (see the duplicate KATs in tests.rs). Wrap in a record.
opt_set        = #6.258([* tstr]) / [* tstr] ; @duplicates preserve
opt_set_holder = [s: opt_set]

; DUPLICATE-carrying set instances are spec-VALID (cddl `[* a]` / `[+ a]` are plain arrays; tag 258's
; "mathematical set" semantics is not a cddl uniqueness constraint) and, under the EXPLICIT
; `@duplicates preserve` opt-out, must round-trip BYTE-EXACT with the duplicates and their order
; intact — the multi-era byte-exact-reader contract that lives on the `preserve` spelling now that the
; 258 default is `reject`. This is the regression floor for that contract: the `[+]` twin (collapses
; to NonEmptyVec) alongside the `[*]` twin above, so both occurrence flavors are pinned. Vectors live
; in tests.rs.
opt_neset        = #6.258([+ tstr]) / [+ tstr] ; @duplicates preserve
opt_neset_holder = [s: opt_neset]

; `@duplicates reject` set idiom under preserve: `reject` narrows WHICH inputs are accepted (a
; duplicate is refused) but must not touch the bytes of what IS accepted — a duplicate-free instance
; re-emits byte-exact in wire order, exactly like the preserve default (the twin is order-preserving,
; never sorted). This pins that accept-path byte identity for both wire arms; the reject path (a
; duplicate on the wire → DuplicateKey) is spec-VALID CBOR the oracle can't model, so it lives in an
; in-process integration test rather than here or the decode catalog.
reject_set        = #6.258([* tstr]) / [* tstr] ; @duplicates reject
reject_set_holder = [s: reject_set]

; `@duplicates preserve` table (the PairMap twin): DUPLICATE keys are spec-VALID CBOR (a cddl
; `{* k => v}` is a map, and cddl imposes no key-uniqueness constraint) and, under
; --preserve-encodings, MUST round-trip BYTE-EXACT with the duplicates and their entry order intact.
; This is the consensus-critical property for Cardano `transaction_metadata`: its auxiliary-data hash
; is computed over the ORIGINAL bytes, so a reader that collapses or reorders duplicate keys fails
; hash verification. The pair-map's positional encoding sidecar preserves per-entry header arguments
; (a non-minimal key head re-emits verbatim) independently for each entry — a keyed encoding map
; could not, since two same-key entries would collide. Vectors live in tests.rs.
pmap        = { * uint => tstr } ; @duplicates preserve
pmap_holder = [m: pmap]

; The Cardano `transaction_metadata` headline: a RECURSIVE metadatum union whose map arm is the
; preserve-mode pair-map, so a duplicate-keyed metadata map must decode AND re-emit byte-exact through
; the recursive-descent (de)serializer (the recursion lives in the map VALUE here; a union used as the
; map KEY trips a pre-existing generation limitation orthogonal to this policy — see the
; TESTING_ROADMAP phase-2 entry). `md_holder` wraps the union so it has a standalone (de)serializer.
md         = mdmap / [* md] / int / bytes / tstr
mdmap      = { * tstr => md } ; @duplicates preserve
md_holder  = [meta: md]

; open struct-map under --preserve-encodings: a captured rest entry's key/value HEADER ARGUMENTS
; are data. A non-minimal rest KEY head (7 written 0x18 0x07) re-emits verbatim through the loose
; container's per-key encoding sidecar. Vectors in tests.rs.
open_map = { 1: uint, * uint => uint }

; open array under --preserve-encodings: a captured TAIL element's HEADER ARGUMENT is data. A
; non-minimal tail element head (7 written 0x18 0x07) re-emits verbatim through the positional
; per-element encoding sidecar (`rest_elem_encodings`); the declared members stay minimal. Vectors in
; tests.rs.
open_list = [uint, tstr, * uint]
