// json flavor of `external_rust_raw_bytes_def` — keep the two in sync. Under
// `--json-serde-derives`/`--json-schema-export` the generated code delegates its JSON
// representation to the user-supplied type, so this flavor adds the serde/schemars derives that
// contract imposes (see docs/docs/comment_dsl.mdx, _CDDL_CODEGEN_RAW_BYTES_TYPE_). Derives, not
// hand impls, so they stay compatible with whatever serde/schemars API the generated crate uses.
use crate::error::{DeserializeError, DeserializeFailure};
use crate::serialization::RawBytesEncoding;

#[derive(Clone, Debug, serde::Serialize, serde::Deserialize, schemars::JsonSchema)]
pub struct PubKey([u8; 32]);

impl RawBytesEncoding for PubKey {
    fn to_raw_bytes(&self) -> &[u8] {
        &self.0
    }

    fn from_raw_bytes(bytes: &[u8]) -> Result<Self, DeserializeError> {
        use std::convert::TryInto;
        bytes
            .try_into()
            .map(PubKey)
            .map_err(|e| DeserializeFailure::InvalidStructure(Box::new(e)).into())
    }
}
