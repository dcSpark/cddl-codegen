// User-supplied definition for the `json-ref-dangling` fixture's extern.
//
// `StubRef`'s hand-written `JsonSchema` impl returns a REFERENCE where a schema body belongs — the
// shape a consumer writes when a type's real schema lives somewhere the impl has not been wired up
// to yet. Do NOT give it a body: the bare `Schema::new_ref` with a name no registration row
// publishes IS the assertion.

#[derive(Clone, Debug, serde::Serialize, serde::Deserialize)]
pub struct StubRef {
    pub value: u64,
}

impl StubRef {
    pub fn new(value: u64) -> Self {
        Self { value }
    }
}

impl schemars::JsonSchema for StubRef {
    fn schema_name() -> std::borrow::Cow<'static, str> {
        std::borrow::Cow::Borrowed("StubRef")
    }

    fn json_schema(_generator: &mut schemars::SchemaGenerator) -> schemars::Schema {
        schemars::Schema::new_ref("PlutusData".to_owned())
    }
}

impl cbor_event::se::Serialize for StubRef {
    fn serialize<'se>(
        &self,
        serializer: &'se mut cbor_event::se::Serializer,
    ) -> cbor_event::Result<&'se mut cbor_event::se::Serializer> {
        serializer.write_unsigned_integer(self.value)
    }
}

impl serialization::Deserialize for StubRef {
    fn deserialize(
        raw: &mut cbor_event::de::Deserializer,
    ) -> Result<Self, error::DeserializeError> {
        Ok(Self {
            value: raw.unsigned_integer()?,
        })
    }
}

