// writes bytes using indefinite encoding chunked into 1-byte parts
pub fn custom_serialize_bytes<'se>(
    serializer: &'se mut cbor_event::se::Serializer,
    bytes: &[u8],
    enc: &StringEncoding,
) -> cbor_event::Result<&'se mut cbor_event::se::Serializer> {
    let szs = match enc {
        StringEncoding::Indefinite(encs) => {
            encs.iter().map(|(_l, e)| *e).chain(std::iter::repeat(cbor_event::Sz::Inline)).take(bytes.len()).collect::<Vec<_>>()
        }
        _ => std::iter::repeat(cbor_event::Sz::Inline).take(bytes.len()).collect::<Vec<_>>()
    };
    serializer.write_raw_bytes(&[0x5f])?;
    for (sz, byte) in szs.iter().zip(bytes.iter()) {
        serializer.write_bytes_sz(&[*byte], cbor_event::StringLenSz::Len(*sz))?;
    }
    serializer.write_special(cbor_event::Special::Break)
}

// read bytes and verify the 1-byte chunking of custom_serialize_bytes()
pub fn custom_deserialize_bytes(
    raw: &mut cbor_event::de::Deserializer,
) -> Result<(Vec<u8>, StringEncoding), DeserializeError> {
    let (bytes, bytes_enc) = raw.bytes_sz()?;
    match &bytes_enc {
        cbor_event::StringLenSz::Len(_sz) => Err(DeserializeFailure::CBOR(cbor_event::Error::CustomError("custom_deserialize_bytes(): needs indefinite chunking".to_owned())).into()),
        cbor_event::StringLenSz::Indefinite(chunks) => {
            for (chunk_len, _chunk_sz) in chunks.iter() {
                if *chunk_len != 1 {
                    return Err(DeserializeFailure::CBOR(cbor_event::Error::CustomError(format!("custom_deserialize_bytes(): chunks need to be 1-len, found: {:?}", chunks))).into());
                }
            }
            Ok((bytes, bytes_enc.into()))
        }
    }
}

// A whole-record codec deliberately uses a text item rather than the record's declared array.
// Record encoding sidecars are self-carrying, so this complete-item pair takes no external tuple.
pub fn write_custom_record<'se>(
    serializer: &'se mut cbor_event::se::Serializer,
    value: &CustomRecord,
) -> cbor_event::Result<&'se mut cbor_event::se::Serializer> {
    serializer.write_text(value.value.to_string())
}

pub fn read_custom_record(
    raw: &mut cbor_event::de::Deserializer,
) -> Result<CustomRecord, DeserializeError> {
    let text = raw.text()?;
    let value = text
        .parse()
        .map_err(|e| DeserializeFailure::InvalidStructure(Box::new(e)))?;
    Ok(CustomRecord::new(value))
}

// writes as hex text
pub fn write_hex_string<'se>(
    serializer: &'se mut cbor_event::se::Serializer,
    bytes: &[u8],
    enc: &StringEncoding,
) -> cbor_event::Result<&'se mut cbor_event::se::Serializer> {
    // the encoding length is the HEX TEXT's (2n), not the raw bytes' (n): a fresh value
    // (StringEncoding::Canonical) picks the width from the passed length, and canonical(n)
    // cannot hold 2n whenever they straddle a width boundary (n = 12..=23, 128..=255, ...) —
    // write_text_sz then fails InvalidLenPassed and to_cbor_bytes unwraps it. A DECODED value's
    // stored encoding was recorded for the 2n text, so passing 2n is also the fidelity-correct
    // length there.
    let hex_text = hex::encode(bytes);
    let str_len_sz = enc.to_str_len_sz(hex_text.len() as u64);
    serializer.write_text_sz(hex_text, str_len_sz)
}

// The preserve-flavored twin of the newtype in `tests/custom_serialization`, carrying the same
// consumer migration: hand code that BOXES an alloc-mode dependency's error type needs a local
// newtype whenever that dependency's `Error` impl is gated on its own `std` feature. The `hex` key's
// package (`const-hex`, with `core-error`) impls `core::error::Error` unconditionally, so this is
// the shape rather than a requirement here — see the twin for the full note. `Debug`/`Display`
// delegate VERBATIM rather than being derived, so the wrapper never shows up in a rendered
// `DeserializeFailure`.
struct HexDecodeError(hex::FromHexError);

impl core::fmt::Debug for HexDecodeError {
    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
        core::fmt::Debug::fmt(&self.0, f)
    }
}

impl core::fmt::Display for HexDecodeError {
    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
        core::fmt::Display::fmt(&self.0, f)
    }
}

impl core::error::Error for HexDecodeError {}

// reads hex text to bytes
pub fn read_hex_string(
    raw: &mut cbor_event::de::Deserializer,
) -> Result<(Vec<u8>, StringEncoding), DeserializeError> {
    let (text, text_enc) = raw.text_sz()?;
    // Fidelity: accept only wire the paired writer re-emits. `hex::decode` tolerates uppercase
    // digits, but the writer is `hex::encode` (lowercase) and `StringEncoding` carries width, not
    // case — an uppercase digit is wire information this codec cannot reproduce, so under
    // --preserve-encodings (whose fuzz oracle asserts accepted input re-encodes byte-identically)
    // it must be a rejection, not a normalization. Same posture as `custom_deserialize_bytes`
    // above, which already rejects the chunkings its writer never emits.
    reject_non_lowercase_hex(&text)?;
    hex::decode(text)
        .map(|bytes| (bytes, text_enc.into()))
        .map_err(|e| DeserializeFailure::InvalidStructure(Box::new(HexDecodeError(e))).into())
}

// the fidelity precheck shared by both hex readers (see read_hex_string for why it exists —
// found by the byte fuzzer: `"ffffCf"` was accepted and re-encoded as `"ffffcf"`)
fn reject_non_lowercase_hex(text: &str) -> Result<(), DeserializeError> {
    if text.bytes().all(|b| matches!(b, b'0'..=b'9' | b'a'..=b'f')) {
        Ok(())
    } else {
        Err(DeserializeFailure::CBOR(cbor_event::Error::CustomError(
            "hex codec: non-lowercase hex text cannot re-encode to itself".to_owned(),
        ))
        .into())
    }
}

// The TABLE-position twin of write_hex_string/read_hex_string (same hex-TEXT-over-bytes wire), split
// off because the encoding sidecar arrives differently there: a record field hands its stored
// encoding to the custom writer BY REFERENCE, while a table's key/value loop looks the entry's
// encoding out of the `BTreeMap` sidecar and hands it over BY VALUE. Only the argument mode differs
// — the body is the same codec — so this pair is what pins that a table key domain and a table value
// range both route through the alias's custom pair at all.
pub fn write_hex_table_string<'se>(
    serializer: &'se mut cbor_event::se::Serializer,
    bytes: &[u8],
    enc: StringEncoding,
) -> cbor_event::Result<&'se mut cbor_event::se::Serializer> {
    // the length passed is the HEX TEXT's (2n), never the raw bytes' (n) — see write_hex_string
    let hex_text = hex::encode(bytes);
    let str_len_sz = enc.to_str_len_sz(hex_text.len() as u64);
    serializer.write_text_sz(hex_text, str_len_sz)
}

pub fn read_hex_table_string(
    raw: &mut cbor_event::de::Deserializer,
) -> Result<(Vec<u8>, StringEncoding), DeserializeError> {
    let (text, text_enc) = raw.text_sz()?;
    // same fidelity precheck as read_hex_string — this twin is where the fuzzer's artifact hit
    // (a table VALUE `"ffffCf"`)
    reject_non_lowercase_hex(&text)?;
    hex::decode(text)
        .map(|bytes| (bytes, text_enc.into()))
        .map_err(|e| DeserializeFailure::InvalidStructure(Box::new(HexDecodeError(e))).into())
}

// must include the tag since @custom_serialize at field-level overrides everything
pub fn write_tagged_uint_str<'se>(
    serializer: &'se mut cbor_event::se::Serializer,
    uint: &u64,
    tag_encoding: Option<cbor_event::Sz>,
    text_encoding: Option<cbor_event::Sz>,
) -> cbor_event::Result<&'se mut cbor_event::se::Serializer> {
    let uint_string = uint.to_string();
    let text_encoding = text_encoding
        .map(|enc| crate::serialization::StringEncoding::Definite(enc))
        .unwrap_or(crate::serialization::StringEncoding::Canonical);
    let uint_string_encoding = text_encoding.to_str_len_sz(uint_string.len() as u64);
    serializer
        .write_tag_sz(9, fit_sz(9, tag_encoding))?
        .write_text_sz(uint_string, uint_string_encoding)
}

pub fn read_tagged_uint_str(
    raw: &mut cbor_event::de::Deserializer,
) -> Result<(u64, Option<cbor_event::Sz>, Option<cbor_event::Sz>), DeserializeError> {
    use std::str::FromStr;
    let (tag, tag_encoding) = raw.tag_sz()?;
    // the write half hard-codes tag 9, so accepting any tag here breaks the preserve-fidelity
    // invariant the fuzz harness asserts over this type (accepted input must re-encode
    // byte-identically): a tag-10 document would be accepted and re-encode as tag 9
    if tag != 9 {
        return Err(DeserializeFailure::TagMismatch {
            found: tag,
            expected: 9,
        }
        .into());
    }
    let (text, text_encoding) = raw.text_sz()?;
    match text_encoding {
        cbor_event::StringLenSz::Indefinite(_) => Err(DeserializeFailure::CBOR(cbor_event::Error::CustomError(format!("We only support definite encodings in order to use the uint one"))).into()),
        cbor_event::StringLenSz::Len(text_encoding_sz) => {
            let uint = u64::from_str(&text)
                .map_err(|e| DeserializeError::from(DeserializeFailure::InvalidStructure(Box::new(e))))?;
            // Fidelity, same reasoning as the tag check above: `u64::from_str` tolerates a leading
            // `+` and leading zeros, but the write half emits `uint.to_string()` — canonical
            // decimal — and no encoding variable carries the spelling, so text that is not its own
            // re-emission must be rejected rather than normalized (comparing against the
            // re-emission is the exact contract, whatever from_str tolerates).
            if uint.to_string() != text {
                return Err(DeserializeFailure::CBOR(cbor_event::Error::CustomError(
                    "uint-as-text codec: non-canonical decimal text cannot re-encode to itself"
                        .to_owned(),
                ))
                .into());
            }
            Ok((uint, Some(tag_encoding), Some(text_encoding_sz)))
        }
    }
}
