; Fixture for the dep-side extern-interface export emitter (commit 4). Exercises every projection
; row plus the exclude-with-record / reference-closure / prelude paths. Snapshot-compared by
; src/tests/snapshot_tests.rs::extern_interface_emit. Descriptive prose stays on its own comment
; lines: a `;` DSL annotation must be the LAST thing on its rule line (trailing prose would be
; swallowed into the annotation, e.g. as a @newtype getter name).

; opaque (class-backed) rows: Record / Wrapper / TypeChoice / GroupChoice -> _CDDL_CODEGEN_EXTERN_TYPE_
rec = [a: uint, b: text]
wrap = uint ; @newtype
tc = uint / text
gc = [0, uint // 1, text]
; RawBytesType -> the raw-bytes marker
hash = _CDDL_CODEGEN_RAW_BYTES_TYPE_

; transparent rows
; named collections (Array + Table) via the transparent alias spelling; foo_list refs rec
foo_list = [* rec]
tbl = { * uint => text }
; c-style enum -> value choices verbatim
ce = 0 / 1 / 2
; @no_alias carried verbatim
na = uint ; @no_alias
; transparent alias + alias chain (big_coin refs coin)
coin = uint
big_coin = coin
; prelude reference (bignint) renders by prelude name from a TRANSPARENT row; NOT an exclusion.
; The carrier is a named table because a `bytes .cbor` rule body is no longer transparent — it
; force-wraps (see `bn` below), which projects as an opaque marker and so cannot exercise the
; prelude-rendering path.
bn_tbl = { * bignint => uint }
; a `bytes .cbor` rule body force-wraps into a real wrapper struct, so it projects OPAQUE like
; `wrap` above rather than rendering its transparent body
bn = bytes .cbor { * bignint => uint }

; generics: the DEFINITION never crosses the boundary (no record); the named instance is opaque
pair<t0, t1> = [t0, t1]
inst = pair<uint, text>

; exclude-with-record + reference-closure
; a custom-serialize transparent alias cannot be exported (would diverge from the dep wire format)
cs = bytes ; @custom_serialize my_ser @custom_deserialize my_deser
; dep_cs references excluded cs -> transitively excluded, chain root named
dep_cs = cs
; anon_arr references an anonymous generic instance (no CDDL ident) -> excluded
anon_arr = [* pair<uint, text>]
; holder embeds cs but its opaque marker is self-contained -> NOT excluded
holder = [f: cs]

; a never-referenced plain group materializes no shape -> excluded-with-record (Ask 0)
helper = (h: uint)

; a REFERENCED plain group materializes as a Record -> a transparent group-body row (post-DSL body,
; @rust_name-pinned); the self-check asserts its four bounds (whole-value + embedded-group). A fixed
; tag renders its literal, `coin` renders the referenced rule's source ident (reference-closure keeps
; it alive), and opt_field takes a `?` prefix.
pg = (tag: 0, amount: coin, ? opt_field: text)
uses_pg = [outer: uint, pg]
