#[derive(Clone, Debug)]
pub struct Address {
    pub address: Vec<u8>,
    pub checksum: u64,
    pub encodings: Option<AddressEncoding>,
}

impl Address {
    pub fn new(address: Vec<u8>, checksum: u64) -> Self {
        Self {
            address,
            checksum,
            encodings: None,
        }
    }
}

#[derive(Clone, Debug)]
pub enum Block {
    EbbBlockWrapper {
        ebb_block_cbor: Vec<u8>,
        len_encoding: LenEncoding,
        index_0_encoding: Option<cbor_event::Sz>,
        ebb_block_cbor_encoding: StringEncoding,
    },
    MainBlockWrapper {
        main_block_cbor: Vec<u8>,
        len_encoding: LenEncoding,
        index_0_encoding: Option<cbor_event::Sz>,
        main_block_cbor_encoding: StringEncoding,
    },
}

impl Block {
    pub fn new_ebb_block_wrapper(ebb_block_cbor: Vec<u8>) -> Self {
        Self::EbbBlockWrapper {
            ebb_block_cbor,
            len_encoding: LenEncoding::default(),
            index_0_encoding: None,
            ebb_block_cbor_encoding: StringEncoding::default(),
        }
    }

    pub fn new_main_block_wrapper(main_block_cbor: Vec<u8>) -> Self {
        Self::MainBlockWrapper {
            main_block_cbor,
            len_encoding: LenEncoding::default(),
            index_0_encoding: None,
            main_block_cbor_encoding: StringEncoding::default(),
        }
    }
}

