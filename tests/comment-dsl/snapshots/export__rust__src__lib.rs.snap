#[derive(Clone, Debug)]
pub enum Typechoice {
    Case1(Case1),
    Case2(Case2),
}

impl Typechoice {
    pub fn new_case1(case1: Case1) -> Self {
        Self::Case1(case1)
    }

    pub fn new_case2(case2: Case2) -> Self {
        Self::Case2(case2)
    }
}

#[derive(Clone, Debug)]
pub enum TypechoiceVariants {
    Case1 {
        case1: String,
        case1_encoding: StringEncoding,
    },
    Case2 {
        case2: Vec<String>,
        case2_encoding: LenEncoding,
        case2_elem_encodings: Vec<StringEncoding>,
    },
}

impl TypechoiceVariants {
    pub fn new_case1(case1: String) -> Self {
        Self::Case1 {
            case1,
            case1_encoding: StringEncoding::default(),
        }
    }

    pub fn new_case2(case2: Vec<String>) -> Self {
        Self::Case2 {
            case2,
            case2_encoding: LenEncoding::default(),
            case2_elem_encodings: Vec::new(),
        }
    }
}

impl From<ProtocolMagic> for u64 {
    fn from(wrapper: ProtocolMagic) -> Self {
        wrapper.inner
    }
