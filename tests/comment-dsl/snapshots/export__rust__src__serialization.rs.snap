            } {
                match raw.cbor_type()? {
                    cbor_event::Type::UnsignedInteger => match raw.unsigned_integer_sz()? {
                        (0, key_enc) => {
                            if minfee_a.is_some() {
                                return Err(DeserializeFailure::DuplicateKey(Key::Uint(0)).into());
                            }
                            let (tmp_minfee_a, tmp_minfee_a_encoding) = raw
                                .unsigned_integer_sz()
                                .map_err(Into::<DeserializeError>::into)
                                .map(|(x, enc)| (x, Some(enc)))
                                .map_err(|e: DeserializeError| e.annotate("minfee_a"))?;
                            minfee_a = Some(tmp_minfee_a);
                            minfee_a_encoding = tmp_minfee_a_encoding;
                            minfee_a_key_encoding = Some(key_enc);
                            orig_deser_order.push(0);
                        }
                        (1, key_enc) => {
                            if minfee_b.is_some() {
                                return Err(DeserializeFailure::DuplicateKey(Key::Uint(1)).into());
                            }
                            let (tmp_minfee_b, tmp_minfee_b_encoding) = raw
                                .unsigned_integer_sz()
                                .map_err(Into::<DeserializeError>::into)
                                .map(|(x, enc)| (x, Some(enc)))
                                .map_err(|e: DeserializeError| e.annotate("minfee_b"))?;
                            minfee_b = Some(tmp_minfee_b);
                            minfee_b_encoding = tmp_minfee_b_encoding;
                            minfee_b_key_encoding = Some(key_enc);
                            orig_deser_order.push(1);
                        }
                        (unknown_key, _enc) => {
                            return Err(
                                DeserializeFailure::UnknownKey(Key::Uint(unknown_key)).into()
                            )
                        }
                    },
                    cbor_event::Type::Text => {
                        return Err(DeserializeFailure::UnknownKey(Key::Str(raw.text()?)).into())
                    }
                    cbor_event::Type::Special => match len {
                        cbor_event::LenSz::Len(_, _) => {
                            return Err(DeserializeFailure::BreakInDefiniteLen.into())
                        }
                        cbor_event::LenSz::Indefinite => match raw.special()? {
                            cbor_event::Special::Break => break,
                            _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                        },
                    },
                    other_type => {
                        return Err(DeserializeFailure::UnexpectedKeyType(other_type).into())
                    }
                }
                read += 1;
            }
            let minfee_a = match minfee_a {
                Some(x) => x,
                None => return Err(DeserializeFailure::MandatoryFieldMissing(Key::Uint(0)).into()),
            };
            let minfee_b = match minfee_b {
                Some(x) => x,
                None => return Err(DeserializeFailure::MandatoryFieldMissing(Key::Uint(1)).into()),
            };
            ();
            Ok(Self {
                minfee_a,
                minfee_b,
                encodings: Some(ProtocolParamUpdateEncoding {
                    len_encoding,
                    orig_deser_order,
                    minfee_a_key_encoding,
                    minfee_a_encoding,
                    minfee_b_key_encoding,
                    minfee_b_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("ProtocolParamUpdate"))
    }
}

impl cbor_event::se::Serialize for Typechoice {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        match self {
            Typechoice::Case1(case1) => case1.serialize(serializer),
            Typechoice::Case2(case2) => case2.serialize(serializer),
        }
    }
}

impl Deserialize for Typechoice {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let initial_position = raw.as_mut_ref().stream_position().unwrap();
            let mut errs = Vec::new();
            let deser_variant: Result<_, DeserializeError> = Case1::deserialize(raw);
            match deser_variant {
                Ok(case1) => return Ok(Self::Case1(case1)),
                Err(e) => {
                    errs.push(e.annotate("Case1"));
                    raw.as_mut_ref()
                        .seek(SeekFrom::Start(initial_position))
                        .unwrap();
                }
            };
            let deser_variant: Result<_, DeserializeError> = Case2::deserialize(raw);
            match deser_variant {
                Ok(case2) => return Ok(Self::Case2(case2)),
                Err(e) => {
                    errs.push(e.annotate("Case2"));
                    raw.as_mut_ref()
                        .seek(SeekFrom::Start(initial_position))
                        .unwrap();
                }
            };
            Err(DeserializeError::new(
                "Typechoice",
                DeserializeFailure::NoVariantMatchedWithCauses(errs),
            ))
        })()
        .map_err(|e| e.annotate("Typechoice"))
    }
}

impl cbor_event::se::Serialize for TypechoiceVariants {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        match self {
            TypechoiceVariants::Case1 {
                case1,
                case1_encoding,
            } => serializer.write_text_sz(&case1, case1_encoding.to_str_len_sz(case1.len() as u64)),
            TypechoiceVariants::Case2 {
                case2,
                case2_encoding,
                case2_elem_encodings,
            } => {
                serializer.write_array_sz(case2_encoding.to_len_sz(case2.len() as u64))?;
                for (i, element) in case2.iter().enumerate() {
                    let case2_elem_encoding =
                        case2_elem_encodings.get(i).cloned().unwrap_or_default();
                    serializer.write_text_sz(
                        &element,
                        case2_elem_encoding.to_str_len_sz(element.len() as u64),
                    )?;
                }
                case2_encoding.end(serializer)
            }
        }
    }
}

impl Deserialize for TypechoiceVariants {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            match raw.cbor_type()? {
                cbor_event::Type::Text => {
                    let (case1, case1_encoding) = raw
                        .text_sz()
                        .map(|(s, enc)| (s, StringEncoding::from(enc)))?;
                    Ok(Self::Case1 {
                        case1,
                        case1_encoding,
                    })
                }
                cbor_event::Type::Array => {
                    let mut case2_arr = Vec::new();
                    let len = raw.array_sz()?;
                    let case2_encoding = len.into();
                    let mut case2_elem_encodings = Vec::new();
                    while match len {
                        cbor_event::LenSz::Len(n, _) => (case2_arr.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if raw.cbor_type()? == cbor_event::Type::Special {
                            assert_eq!(raw.special()?, cbor_event::Special::Break);
                            break;
                        }
                        let (case2_elem, case2_elem_encoding) = raw
                            .text_sz()
                            .map(|(s, enc)| (s, StringEncoding::from(enc)))?;
                        case2_arr.push(case2_elem);
                        case2_elem_encodings.push(case2_elem_encoding);
                    }
                    let (case2, case2_encoding, case2_elem_encodings) =
                        (case2_arr, case2_encoding, case2_elem_encodings);
                    Ok(Self::Case2 {
                        case2,
                        case2_encoding,
                        case2_elem_encodings,
                    })
                }
                _ => Err(DeserializeError::new(
                    "TypechoiceVariants",
                    DeserializeFailure::NoVariantMatched,
                )),
            }
        })()
        .map_err(|e| e.annotate("TypechoiceVariants"))
    }
}
