// Hand-written `_CDDL_CODEGEN_RAW_BYTES_TYPE_` definition for `tests/alias-of-marker-e2e`: the
// 28-byte CIP-25 policy id whose alias carries the custom hex-text pair. Kept beside the base flavor
// (`external_rust_raw_bytes_def`'s `PubKey`) rather than folded into it because this one is used as a
// MAP KEY and as a sidecar key, so it must supply `Ord`/`Eq`/`Hash` — a supply the record-field-only
// base flavor deliberately does not carry (see docs/docs/comment_dsl.mdx,
// _CDDL_CODEGEN_RAW_BYTES_TYPE_).
use crate::error::{DeserializeError, DeserializeFailure};
use crate::serialization::RawBytesEncoding;

#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd, Hash)]
pub struct PolicyId([u8; 28]);

impl RawBytesEncoding for PolicyId {
    fn to_raw_bytes(&self) -> &[u8] {
        &self.0
    }

    fn from_raw_bytes(bytes: &[u8]) -> Result<Self, DeserializeError> {
        use std::convert::TryInto;
        bytes
            .try_into()
            .map(PolicyId)
            .map_err(|e| DeserializeFailure::InvalidStructure(Box::new(e)).into())
    }
}
