; Open struct-maps (loose CBOR "rest row"): a trailing `* k => v` after fixed keys captures unknown
; map entries into a `pub rest` map field instead of erroring. Snapshotted only in the plain
; (non-preserve, non-JSON, --wasm=false) flavor: the preserve fidelity core, the flattened-JSON
; surface, and the wasm accessors for open structs are later work packages, so generation is
; gracefully rejected under --preserve-encodings / --json-* / --wasm (temporary front doors those
; WPs lift). This mirrors the any-positions whole_program input's profile-limited posture.
uint_rest = { 1: uint, 2: text, * uint => any }   ; uint key domain, any value
opt_rest = { ? 3: text, * uint => any }           ; only an optional fixed key before the rest row
any_rest = { 1: uint, * any => any }              ; any key domain (captures every wire key type)
typed_rest = { 1: uint, * uint => uint }          ; concrete key AND value types
renamed_rest = {
  1: uint,
  * uint => any ; @name extra
}
