; Fixture for the dep-side compiled self-check (commit 5). Every rule here projects to a
; tool-GENERATED rust surface (no hand-written externs / raw-bytes / custom-serialize), so the
; generated crate — including `generated/extern_interface_check.rs` — must `cargo check` cleanly.
; Exercised by src/tests/integration_tests.rs::extern_interface_check_compiles (nested-cargo) and
; the weakened-bound / mutation vectors beside it.

; opaque class-backed rows -> _assert_serialize (+ _assert_deserialize)
rec = [a: uint, b: text]
wrap = uint ; @newtype
tc = uint / text

; An optional member immediately before an open rest tail has NO generated deserialize: a count
; cannot distinguish the optional uint from the first tail uint. The self-check therefore weakens
; its bound to Serialize only (asserting Deserialize would fail the dep's own build).
ambig = [? uint, * uint]

; A finite final open-array tail is also a class-backed record, so its export/import boundary is
; opaque while this dep-side self-check proves the BoundedVec runtime + Serialize/Deserialize bounds.
bounded_tail = [prefix: uint, 2*3 bytes]

; A major-disjoint middle occurrence is still an opaque record export: the position fact is wire
; internal, while this self-check proves the projected class remains Serialize + Deserialize.
middle_segment = [prefix: uint, * bytes, suffix: text]

; Exact count, rather than a major discriminator, owns this same-major middle boundary. The exported
; record still needs only its normal Serialize + Deserialize projection.
exact_middle_segment = [prefix: uint, 2*2 uint, suffix: uint]

; transparent rows -> a `use crate::generated::<Name> as _;` existence check
ce = 0 / 1 / 2
coin = uint
big_coin = coin
some_list = [* rec]
lookup = { * uint => text }

; a @no_alias rule emits NO rust type -> the self-check asserts nothing for it (must not `use` it)
raw_index = uint ; @no_alias

; a materialized (referenced) plain group -> a transparent group-body row whose self-check asserts
; ALL FOUR bounds the consumer's generated code uses: whole-value Serialize/Deserialize (a
; group-choice arm calls `.serialize()`) AND embedded SerializeEmbeddedGroup/DeserializeEmbeddedGroup
; (a spliced record member delegates inline). Proves the new embedded-group carriers compile.
pg = (tag: 0, x: uint)
uses_pg = [outer: uint, pg]
