use super::*;
use crate::error::*;
use cbor_event::de::Deserializer;
use cbor_event::se::{Serialize, Serializer};
use std::io::{BufRead, Seek, SeekFrom, Write};

impl cbor_event::se::Serialize for Everything {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array(cbor_event::Len::Len(6))?;
        self.foo.serialize(serializer)?;
        self.external_foo.serialize(serializer)?;
        serializer.write_array(cbor_event::Len::Len(self.bars.len() as u64))?;
        for element in self.bars.iter() {
            element.serialize(serializer)?;
        }
        serializer.write_map(cbor_event::Len::Len(self.table.len() as u64))?;
        for (key, value) in self.table.iter() {
            serializer.write_unsigned_integer(*key)?;
            value.serialize(serializer)?;
        }
        self.baz.serialize(serializer)?;
        self.qux.serialize(serializer)?;
        Ok(serializer)
    }
}

impl Deserialize for Everything {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let len = raw.array()?;
        let mut read_len = CBORReadLen::new(len);
        read_len.read_elems(6)?;
        read_len.finish()?;
        (|| -> Result<_, DeserializeError> {
            let foo = Foo::deserialize(raw).map_err(|e: DeserializeError| e.annotate("foo"))?;
            let external_foo = ExternalFoo::deserialize(raw)
                .map_err(|e: DeserializeError| e.annotate("external_foo"))?;
            let bars = (|| -> Result<_, DeserializeError> {
                let mut bars_arr = Vec::new();
                let len = raw.array()?;
                while match len {
                    cbor_event::Len::Len(n) => (bars_arr.len() as u64) < n,
                    cbor_event::Len::Indefinite => true,
                } {
                    if raw.cbor_type()? == cbor_event::Type::Special {
                        assert_eq!(raw.special()?, cbor_event::Special::Break);
                        break;
                    }
                    bars_arr.push(Bar::deserialize(raw)?);
                }
                Ok(bars_arr)
            })()
            .map_err(|e| e.annotate("bars"))?;
            let table = (|| -> Result<_, DeserializeError> {
                let mut table_table = BTreeMap::new();
                let table_len = raw.map()?;
                while match table_len {
                    cbor_event::Len::Len(n) => (table_table.len() as u64) < n,
                    cbor_event::Len::Indefinite => true,
                } {
                    if raw.cbor_type()? == cbor_event::Type::Special {
                        assert_eq!(raw.special()?, cbor_event::Special::Break);
                        break;
                    }
                    let table_key = raw.unsigned_integer()? as u64;
                    let table_value = Bar::deserialize(raw)?;
                    if table_table.insert(table_key, table_value).is_some() {
                        return Err(
                            DeserializeFailure::DuplicateKey(Key::Uint(table_key.into())).into(),
                        );
                    }
                }
                Ok(table_table)
            })()
            .map_err(|e| e.annotate("table"))?;
            let baz = Baz::deserialize(raw).map_err(|e: DeserializeError| e.annotate("baz"))?;
            let qux = Qux::deserialize(raw).map_err(|e: DeserializeError| e.annotate("qux"))?;
            match len {
                cbor_event::Len::Len(_) => (),
                cbor_event::Len::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(Everything {
                foo,
                external_foo,
                bars,
                table,
                baz,
                qux,
            })
        })()
        .map_err(|e| e.annotate("Everything"))
    }
}
