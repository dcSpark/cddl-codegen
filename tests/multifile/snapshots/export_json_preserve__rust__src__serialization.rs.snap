        self.external_foo.serialize(serializer)?;
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.bars_encoding)
                .unwrap_or_default()
                .to_len_sz(self.bars.len() as u64),
        )?;
        for element in self.bars.iter() {
            element.serialize(serializer)?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.bars_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        serializer.write_map_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.table_encoding)
                .unwrap_or_default()
                .to_len_sz(self.table.len() as u64),
        )?;
        for (key, value) in self.table.iter() {
            let table_key_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.table_key_encodings.get(key))
                .cloned()
                .unwrap_or_default();
