bar = {
    foo: #6.1337([* foo]),
    ? derp: uint,
    1 : uint / null,
    ? 5: text,
    five: 5,
    foo_map: { * foo => foo },
    ? baz: baz,
}

; test refs too
bar_typedef = bar

; consumed as a group-choice variant by `relay` (qux.cddl): the choice's expanded
; `new_relay_host(port, dns_name)` ctor names THIS record's field types in qux's scope, so
; `relay_port` must be imported there even though nothing else in qux references it
; (scope_references' group-ctor field marking)
relay_port = uint ; @newtype
relay_host = (0, port: relay_port, dns_name: text)

; consumed ONLY as the VALUE of an open struct-map rest row in qux.cddl. The row's wrapper class is
; minted at ROOT and names this type bare there, so root must import it even though no root-scope
; rule mentions it — the second of the rest position's two import sides (the first being the wrapper
; itself, imported into qux)
rest_value = [z: uint]