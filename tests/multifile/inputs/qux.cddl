qux = [2, text]

; group choice over a record living in ANOTHER module (relay_host, b/bar.cddl) — pins the
; ctor-expansion import class: `Relay::new_relay_host(..)` takes relay_host's fields directly
; (rust and wasm passes), so RelayPort must be imported here despite no other reference
relay = [relay_host // 1, uint]

; --- open rest rows/tails whose inner types live in OTHER modules ---------------------------
; The rest position is a CONTAINER position: the wasm accessor returns the `MapKToV` / `<T>List`
; wrapper class minted at the container's emission scope (root here), and that wrapper's own
; `insert`/`get`/`keys` signatures name K/V/T bare THERE. So each of these rules needs an import
; on BOTH sides — the wrapper into `qux`, its inner types into the wrapper's scope — which is what
; marking the rest CONTAINER (`RestRow::container_type`) in `scope_references` supplies. Marking
; the inner types flat at the using scope instead left both sides dangling (E0425 on the wrapper
; here and on its key/value/element at root). Three shapes, all with a cross-module ident:

; flat `* K => V` row: key from `a`, value from `b/bar`
open_flat = {1: uint, * epoch => rest_value}

; nested `* K => {* K => V}` row: the OUTER wrapper's value is itself a wrapper class, and both
; levels name a cross-module key/value
open_nested = {1: uint, * epoch => {* epoch => foo}}

; array `* T` rest tail: the tail accessor returns the root-minted `TailElemList` over `a/c/foo`
open_tail = [x: uint, * tail_elem]