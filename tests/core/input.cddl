; --- A NAMED ALIAS reached through a wrapping context, in both wrapping spellings ---
; The two positions that WRAP a rule rather than referencing it plainly: a tag head, and a `.cbor`
; payload. Both spell the wrapped type as declared — `TaggedScalarAlias(ScalarAlias)`, and
; `pub payload: ScalarAlias` — which `docs/docs/output_format.mdx` § "Type spelling at member
; positions" states as the rule for every member position. The alias here is deliberately PAIRLESS
; (no `@custom_serialize`/`@custom_deserialize`), because that is the half the corpus can carry: an
; annotated alias needs hand-written codec fns the emitted crate has no home for, so its two-paths
; agreement is pinned in-process by `dsl_position_tests`. What this fixture adds is the SPELLING and
; the round trip through both wrappings — the blessed bytes are what make a re-resolution at either
; wrapping seam a visible diff rather than an invisible one.
scalar_alias = uint
tagged_scalar_alias = #6.7(scalar_alias)
scalar_alias_holder = [payload: bytes .cbor scalar_alias]

; --- Every leaf under a `bytes .cbor <X>` overload reads the PAYLOAD's cursor ---
; The payload's decode runs against an `inner_de` built over the byte string's contents, so a leaf
; that names the outer reader instead consumes the next OUTER item and mis-frames everything after
; it. Three leaf kinds did exactly that (`float64`/`float32`/`bool`, emitted then as
; `<T>::deserialize`; the two float leaves now read through `read_float_width`, whose reader
; argument is the same mis-nameable slot),
; as did the indefinite-length break probe and the INLINED c-style-enum variant sweep — a c-style
; enum has no `Deserialize` impl of its own, so its try-each-variant sequence is emitted at the use
; site and its position save/restore plus each variant closure's argument must name the payload
; reader too.
;
; Every payload member is followed by another member, and the record ends in `tail: text`: the
; assertion that proves framing is the FOLLOWING field's value, not merely that decode succeeded.
; Both bounded and unbounded float spellings appear because they are separate emission sites.
cbor_payload_leaves = [
	f64_payload: bytes .cbor float64,
	f32_payload: bytes .cbor float32,
	bounded64_payload: bytes .cbor (float64 .le 10.5),
	bounded32_payload: bytes .cbor (float32 .le 10.5),
	bool_payload: bytes .cbor bool,
	enum_payload: bytes .cbor c_enum,
	tail: text,
]

; Collections reached through `.cbor`: the loop reads elements/keys from the payload, so the break
; probe must read it too. Only an INDEFINITE-length inner encoding reaches that probe, and the
; emitted serializer only ever writes definite lengths — `cbor_payload_indefinite_inner` in
; tests/core/tests.rs decodes a hand-built payload to reach it.
cbor_payload_collections = [
	arr_payload: bytes .cbor [* uint],
	map_payload: bytes .cbor {* uint => text},
	tail: text,
]

; A `.cbor` payload whose ELEMENTS/VALUES are themselves `.cbor` payloads. The inner byte-string
; read is emitted inside the outer collection's loop body, where the enclosing payload's reader is
; an `inner_de` overload — naming the OUTER reader there consumes the next outer item as the
; element's payload, so the member decodes plausible values and every member after it mis-frames.
; Only the decode side was ever wrong (the serializer writes the nested payload correctly), which
; makes this round-trip-visible rather than silent, and makes the encode-vs-oracle assertion in
; `cbor_payload_nested_payloads` (tests/core/tests.rs) a real control rather than a formality.
;
; `*` is load-bearing on both containers: a fixed `[X]` mints a record struct whose
; `fn deserialize(raw..)` boundary resets the buffer name and masks the defect entirely. Both the
; array-element and the map-VALUE position are spelled because they are separate emission sites in
; the loop body (the map's key is read before the value, so only the value can mis-frame).
cbor_payload_nested_payloads = [
	elem_payloads: bytes .cbor [* bytes .cbor uint],
	value_payloads: bytes .cbor {* uint => bytes .cbor uint},
	after_payload: bytes .cbor uint,
	tail: text,
]

u8 = uint .size 1
u16 = uint .le 65535
u32 = 0..4294967295
u64 = uint .size 8 ; 8 bytes
i8 = -128 .. 127
i64 = -9223372036854775808 .. 9223372036854775807 ; 8-byte signed window (was `int .size 8` — rejected since cbor-wg/cddl#32 clarified it as the uint window)

signed_ints = [
	u_8: 0 .. 255,
	u_16: uint .size 2,
	u_32: uint .size 4,
	u_64: uint .le 18446744073709551615,
	i_8: -128 .. 127,
	i_16: -32768 .. 32767,
	i_32: -2147483648 .. 2147483647,
	i_64: -9223372036854775808 .. 9223372036854775807,
	n_64: nint,
	u64_max: 18446744073709551615,
	; this test assumes i64::BITS == isize::BITS (i.e. 64-bit programs) or else the cddl parsing lib would mess up
	; if this test fails on your platform we might need to either remove this part
	; or make a fix for the cddl library.
	; The fix would be ideal as even though the true min in CBOR would be -u64::MAX
	; we can't test that since isize::BITS is never > 64 in any normal system and likely never will be
	i64_min: -9223372036854775808,
]

