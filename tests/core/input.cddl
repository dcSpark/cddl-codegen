; Signed-int fields whose value window must be partitioned across the two CBOR sign arms
; (uint major type / nint major type). Each field pins a distinct region of the position × sign
; grid so a naive per-arm bound filter (which conflated "vacuous in this arm" with "arm entirely
; excluded") can't regress. All map to i64.
sign_bounds = [
    all_neg: -10 .. -3,     ; all-negative two-sided window
    upto_zero: -10 .. 0,    ; upper endpoint exactly 0
    le_neg: int .le -3,     ; one-sided negative upper
    le_pos: int .le 10,     ; one-sided positive upper (nint arm vacuous)
    ge_pos: int .ge 3,      ; one-sided positive lower (nint arm empty)
    ne_pos: int .ne 5,      ; exclusion of a non-negative value
    ne_neg: int .ne -5,     ; exclusion of a negative value
    straddle: -10 .. 3,     ; window spanning both signs
    ne_one: int .ne 1,      ; exclusion at the boundary where the (N+1, N-1) encoding's max hits 0
    ne_zero: int .ne 0      ; exclusion of 0 itself (encoding (1, -1) spans the sign split)
]

; Literal-headed top-level range rules must WRAP (not emit a bare `pub type` alias) so their
; standalone to/from_cbor_bytes enforces the window — and, when tagged, writes the tag. Mirrors the
; `int .op`-headed top-level wrappers; the exact-collapse canaries (u32, i8 above) stay bare aliases.
top_level_neg_range = -10 .. -3          ; all-negative window (i64 wrapper; also a WP1 full-window regression)
top_level_pos_range = 3 .. 10            ; positive window (u64 wrapper)
top_level_tagged_range = #6.5(3 .. 10)   ; tagged positive window: the wrapper must write tag 5

nint_ge_newtype = nint .ge -5 ; @newtype
nint_le_newtype = nint .le -5 ; @newtype

; Float value windows: enforced at deserialize AND constructor with a NaN-safe accept-form check.
; Each field pins a distinct window shape (inclusive/exclusive rangeop, one-sided control ops, .eq,
; and an f32 whose value is compared as f64 so the authored decimal is exact).
float_bounds = [
    incl: 0.5 .. 10.5,        ; inclusive both endpoints
    excl: 0.5 ... 10.5,       ; exclusive upper endpoint (10.5 rejected)
    lt: float64 .lt 10.5,     ; one-sided exclusive max
    ge: float64 .ge 0.5,      ; one-sided inclusive min
    eq: float64 .eq 3.3,      ; single accepted value (a float64 one: 3.5's shortest form is f9)
    f32le: float32 .le 10.5   ; f32 variant, compared as f64
]

; Top-level literal float ranges WRAP into a bounds-enforcing newtype (a bare `pub type = f64` alias
; would silently drop the window). Inclusive vs exclusive upper endpoint, plus a tagged variant whose
; wrapper must write/require tag 5.
float_range = 0.5 .. 10.5
float_range_excl = 0.5 ... 10.5
tagged_float_range = #6.5(0.5 .. 10.5)

; WHOLE-valued float fixed members must emit valid f64 literals (`3.0`, not `3`): f64 Display
; drops the decimal point on whole values, which once emitted three E0308s per member
; (Special::Float(3) / v_value != 3 / Key::Float(3)) — the crate didn't compile. The hexfloat
; spelling (0x1.8p+1 = 3.0) rides the same emission; the non-whole control field (3.5) pins the
; already-correct formatting byte-identical.
float_fixed_whole = [
    w: 3.0,
    hx: 0x1.8p+1,
    frac: 3.5
]

bounds_type_choice = bytes .size (0..64)
                   / text .size (0..64)

