custom_bytes = bytes ; @custom_serialize custom_serialize_bytes @custom_deserialize custom_deserialize_bytes

; A named record's pair owns the whole item, not just a member: this deliberately writes TEXT
; instead of the structurally ambiguous optional-array record, and the holder reaches the identical
; custom wire. The generated field decoder cannot decide whether `ignored` is present; the custom
; reader supersedes that refusal and constructs only the mandatory `value`.
custom_record = [? ignored: uint, value: uint] ; @custom_serialize write_custom_record @custom_deserialize read_custom_record
custom_record_holder = [ nested: custom_record ]

struct_with_custom_serialization = [
  custom_bytes,
  field: bytes, ; @custom_serialize custom_serialize_bytes @custom_deserialize custom_deserialize_bytes
  overridden: custom_bytes, ; @custom_serialize write_hex_string @custom_deserialize read_hex_string
  tagged1: #6.9(custom_bytes),
  tagged2: #6.9(uint), ; @custom_serialize write_tagged_uint_str @custom_deserialize read_tagged_uint_str 
]

; The MAP-rep twin of struct_with_custom_serialization. A map-rep field's serialize builds ONE
; config that serves both the member-key write and the VALUE write, so that config must carry the
; field's @custom_serialize: built without it the custom WRITER was silently dropped while the read
; side kept honoring @custom_deserialize — a round-trip-breaking asymmetry the array-rep rule above
; cannot see, since array fields take a different construction path. Each custom field here writes
; bytes the DEFAULT writer would not (indefinite 1-byte-chunked bytes, hex TEXT over a `bytes`
; field, a hook-written tag), so a dropped writer fails the byte-exact vector rather than merely
; the round-trip. `aliased` is the type-level control (honored through the alias, not the field)
; and `plain` the no-directive control — neither may move.
map_struct_with_custom_serialization = {
  chunked: bytes, ; @custom_serialize custom_serialize_bytes @custom_deserialize custom_deserialize_bytes
  hexed: bytes, ; @custom_serialize write_hex_string @custom_deserialize read_hex_string
  aliased: custom_bytes,
  tagged: #6.9(uint), ; @custom_serialize write_tagged_uint_str @custom_deserialize read_tagged_uint_str
  plain: uint,
}

docs = [
  foo: text, ; @doc this is a field-level comment
  bar: uint, ; @doc bar is a u64
] ; @doc struct documentation here

docs_groupchoice = [
  ; @name first @doc comment-about-first
  0, uint //
  ; @doc comments about second @name second
  text
] ; @doc type-level comment
; --- WI-1: NonEmptyVec two-type enforcement for the `+`/`1*` occurrence on arrays ---
; `[+ T]` becomes NonEmptyVec<T> (invalid empty state unrepresentable, one TryFrom door). Every
; other array bound keeps the runtime-check path; `[* T]` stays a bare Vec.
nev_bar = { a: uint }
; a NAMED `[+ T]` rule gains a real enforcement surface: `pub type NevInts = NonEmptyVec<u64>`
nev_ints = [+ uint]
nev_holder = {
  tags: [+ nev_bar],        ; inline [+ bar]   -> NonEmptyVec<NevBar>
  ? maybe: [+ nev_bar],     ; optional [+ bar] -> Option<NonEmptyVec<NevBar>>
  nested: [+ [+ uint]],     ; nested           -> NonEmptyVec<NonEmptyVec<u64>>
  plain: [* text],          ; control (stays a bare Vec<String>)
  ints: nev_ints,           ; reference to the named `[+ uint]` rule
}
; single-field array-record whose standalone deserialize routes an empty wire array through the same
; TryFrom door as the API (identical RangeCheck error at both doors)
nev_wire = [items: [+ uint]]

; Named `[+ elem]` over a NON-exposable element (free name): the wasm class gets a
; `try_from(&NevPtList)` borrowing the loose builder (minted for it). An inline `[+ nev_pt]` in the
; same spec DEDUPS to this named rule's class (the spec author's name wins over a synthesized
; NonEmptyNevPtList — lexicographically-first same-shape rule if several exist). NB: the same dedup
; makes nev_holder's inner `[+ uint]` (in `nested` above) resolve to NevInts.
nev_pt = { p: uint }
nev_pts = [+ nev_pt]
; SELF-NAMED rule: the rule ident IS the element's loose-builder name (`nev_q_list` -> NevQList =
; the loose list wrapper name for element NevQ), so the restricted class legitimately owns the
; ident and emits WITHOUT `try_from` — construction is `new(first)` + `add`.
nev_q = [a: uint]
nev_q_list = [+ nev_q]
nev_holder2 = {
  pts: nev_pts,
  pts_inline: [+ nev_pt],
  qs: nev_q_list,
}

; --- WI-2: NonEmptyMap two-type enforcement for the `+`/`1*` occurrence on tables ---
; `{+ k => v}` becomes NonEmptyMap<K, V> (invalid empty state unrepresentable, one TryFrom door).
; `{* k => v}` stays a bare table map; every other count-permitting marker is rejected at parse time.
nem_val = { v: uint }
; a NAMED `{+ k => v}` rule with struct values gains `pub type NemNamed = NonEmptyMap<String, NemVal>`
nem_named = {+ tstr => nem_val}
nem_holder = {
  inline: {+ tstr => uint},        ; inline {+ k => v}  -> NonEmptyMap<String, u64>
  ? maybe: {+ uint => tstr},       ; optional           -> Option<NonEmptyMap<u64, String>>
  plain: {* tstr => uint},         ; control (stays a bare BTreeMap<String, u64>)
  named: nem_named,                ; reference to the named `{+ ...}` rule (dedups its wasm class)
}
; single-field map-record whose deserialize routes an empty wire map through the same TryFrom door as
; the API (identical RangeCheck error at both doors)
nem_wire = { m: {+ uint => uint} }

; --- cbor_event 3.2.0 upgrade vectors: nullable fields whose INNER type also lives in CBOR major 7 ---
; The `T / null` null-peek must not assume a 1-byte Special: bool/null are 1 byte but two-byte simples
; (f8 xx) are 2 and f16/f32/f64 are 3/5/9, so the emitted peek saves/restores the reader position
; around `special()` instead of rewinding a fixed width.
nullable_bool = bool / null
; --- the six float prelude names are six VALUE classes (RFC 8610 §2.2.3: the `#7.x` notation is
; about a set of values, not a serialization variant) ---
; The names partition the float values by shortest lossless form, so a read accepts any head and
; refuses a VALUE the class excludes, and a write emits the value's shortest form — which for a
; member IS the declared width. Carriers: `f32` where every value in the class fits it, `f64`
; otherwise.
float_heads = [h: float16, u: float16-32, w: float32-64, s: float32, d: float64, f: float]

nullable_float = float / null
nullable_specials = [b: nullable_bool, f: nullable_float]

; --- OPTIONAL fixed-value members: a `bool` presence field (false=absent, true=present) ---
; An optional fixed value carries exactly one bit (present/absent), so it gets a `pub <name>: bool`
; struct field — unlike a MANDATORY fixed value, which carries zero information and gets no field.
; Array rep: the presence peek + verify honors the ambiguity guard (each optional fixed value's cbor
; type must not overlap the following field) and the possibly-last Special-peek path (`? nfix: null`
; in final position). Map rep spans all in-scope kinds (uint/text/nint/bool/null) as keyed entries.
opt_fixed_arr = [a: uint, ? bfix: true, b: text]
opt_fixed_arr_last = [a: text, ? ufix: 5]
opt_fixed_arr_null = [a: uint, ? nfix: null]
opt_fixed_map = {a: uint, ? m_uint: 5, ? m_text: "tag", ? m_nint: -7, ? m_bool: true, ? m_null: null}

; --- OPTIONAL fixed FLOAT member: the `bool` presence field again, constant is a Special float ---
; Same one-bit presence model as the kinds above; the constant is written with
; `write_special(Special::Float(<lit>))` (canonical `fb` + 8 bytes) and verified with `raw.float()?`
; + an exact `!= <lit>` compare -> FixedValueMismatch, the SAME spellings the mandatory fixed-float
; path emits. Under --preserve-encodings the constant additionally carries its head-width encoding
; var (see the preserve suite's `opt_fixed_arr_float`). The float peeks as CBOR Special like
; bool/null, so in the array form it must not
; be followed by another Special-classed field: `? ffix: 2.5` (Special) precedes `b: text`. 2.5 is
; exactly representable so the verify's exact compare is well-defined. Corpus sibling:
; tests/corpus/optional_fixed_float.cddl.
opt_fixed_arr_float = [a: uint, ? ffix: 2.5, b: text]
opt_fixed_map_float = {a: uint, ? m_float: 2.5}

; `@duplicates reject` set idiom: the wasm wrapper wraps the OrderedSet uniqueness twin and exposes a
; CHECKED `add` (Result-returning; refuses an already-present element). Exercised at the wasm boundary
; by tests_wasm.rs (checked-add refusal + try_from door + embedded round-trip through reject_set_holder).
reject_uint_set    = #6.258([* uint]) / [* uint] ; @duplicates reject
reject_set_holder  = [s: reject_uint_set]

; `@duplicates preserve` table (PairMap): the wasm wrapper wraps the vec-of-pairs twin and exposes an
; APPENDING `insert` (never replaces a key — a repeated key grows `len`), `get` returns the first
; match. A `uint => bytes` shape (no other `uint => bytes` map here) so no structural-name collision.
; Exercised at the wasm boundary by tests_wasm.rs (insert-appends + get-first-match + embedded
; round-trip through preserve_pmap_holder), and by --emit-tests (the default profile builds a
; distinct-key PairMap through `.collect()` and round-trips it).
preserve_uint_map    = { * uint => bytes } ; @duplicates preserve
preserve_pmap_holder = [m: preserve_uint_map]
