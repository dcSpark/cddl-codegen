; Open arrays (CBOR "rest tail"): a final-position occurrence after ≥1 fixed member captures the
; trailing elements into a loose `Vec<T>`, a min-one `NonEmptyVec<T>`, or a checked `BoundedVec<T, MIN, MAX>`
; (default), or drops loose data with `@ignore`. Snapshotted under
; the plain (`default`) and json flavors (--wasm=false to isolate the rust/json surfaces). Byte-exact
; per-element tail encodings under --preserve-encodings are covered by the capture-only
; `open-array-preserve-e2e` fixture, so this mixed capture/ignore input has no preserve profile.
typed = [uint, tstr, * uint]        ; typed tail
anytail = [uint, * any]             ; any tail (nested-container elements)
required = [uint, + bytes]          ; restricted one-or-more tail; wasm getter uses NonEmptyBytesList
bounded = [uint, 2*3 bytes]         ; checked finite carrier; wasm getter uses BytesListMin2Max3
named = [
  uint,
  tstr,
  * bytes ; @name extras            ; @name renames the captured Vec field
]
ignored = [
  uint,
  * any ; @ignore                   ; tolerate-and-drop tail
]
; Degenerate shape combos (each exercises a distinct length/optional path):
;  - all-mandatory prefix + @ignore tail (the empty-conditional definite_info path);
;  - single fixed member + tail;
;  - optional fixed-value member + type-distinct tail (the bool-presence + rest-fold path).
all_mandatory_ignore = [
  uint,
  tstr,
  * any ; @ignore
]
single_fixed = [uint, * uint]
opt_fixed_member = [uint, ? 5, * tstr]
