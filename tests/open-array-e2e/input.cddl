; Open-array rest-tail end-to-end round-trip vectors. Plain flavor only (--wasm=false,
; non-preserve); the sibling preserve fixture owns byte-exact per-element encoding coverage. See
; tests/open-array-e2e/tests.rs for the loose, min-one, and bounded value-level vectors.
cap = [uint, tstr, * uint]          ; typed tail (each trailing element is a uint)
cap_any = [uint, * any]             ; any tail (captures nested-container elements)
byte_alias = bytes
required = [uint, + byte_alias]     ; one-or-more tail, with alias element
named_required = [
  uint,
  + byte_alias ; @name extras
]
bounded_required = [uint, + uint .le 5]
bounded = [uint, 2*3 byte_alias]   ; complete BoundedVec constructor carrier
bounded_min = [uint, 2* uint]      ; min-only BoundedVec
bounded_zero = [uint, *0 uint]     ; exact-zero BoundedVec
opt = [uint, ? tstr, * uint]        ; optional member + type-distinct tail (uint vs tstr)
; Major-disjoint middle segments greedily stop before the mandatory text suffix.  Every occurrence
; window reuses the tail carriers; `middle_max` pins leaving the suffix after the maximum.
lead = [* bytes, tstr]
middle = [uint, * bytes, tstr]
middle_required = [uint, + bytes, tstr]
middle_bounded = [uint, 2*3 bytes, tstr]
middle_max = [uint, *2 bytes, tstr]
middle_zero = [uint, *0 bytes, tstr]
exact_middle = [uint, 2*2 uint, uint] ; count-delimited same-major exact segment
exact_zero_middle = [uint, 0*0 uint, uint] ; exact-zero leaves same-major suffix in place
; Every occurrence member is an exact named boundary.  Adjacent `absent`/`values` uses the same
; uint major to prove decoding follows counts, never a major peek or suffix speculation.
exact_segments = [
  prefix: uint
  , 2*2 bytes ; @name chunks
  , separator: tstr
  , 0*0 uint ; @name absent
  , 3*3 uint ; @name values
  , suffix: uint
]
; With no fixed suffix, only the final exact segment may use the owner boundary. The first must
; still stop at its own count, even though both segments share the uint major.
trailing_exact_segments = [
  2*2 uint ; @name first
  , 3*3 uint ; @name second
]
; The emitted-test minter must keep ExactSegments' source-ordered constructor slots when this
; record is itself an ordinary member of another minted record.
nested_exact_segments = [exact_segments]
; Same-major fixed-domain middle segments retry only the repeated decoder.  Their generator-owned
; finite literal domains are disjoint, including through transparent aliases, so a suffix cannot
; successfully decode as another repetition.
repeat = 0 / 1
repeat_alias = repeat
suffix = 2 / 3
suffix_alias = suffix
fixed_middle = [prefix: tstr, * repeat_alias, suffix_alias]
fixed_middle_required = [prefix: tstr, + repeat_alias, suffix_alias]
fixed_middle_bounded = [prefix: tstr, 1*2 repeat_alias, suffix_alias]
fixed_middle_named_position = [
  prefix: tstr,
  * repeat_alias, ; @name initial_position
  suffix_alias
]
; The cursor helper must also avoid a fixed member named after its preferred spelling.
fixed_middle_cursor_name_collision = [
  initial_position_retry_position: tstr,
  * repeat_alias, ; @name initial_position
  suffix_alias
]
fixed_literal_suffix = [* repeat_alias, 2]
bool_repeat = false / true
null_suffix = null
fixed_simple_middle = [* bool_repeat, null_suffix]
outer_fixed_middle = [fixed_middle, uint]
; A transparent custom codec owns the bytes it writes. Its declared `bytes` head, inherited through
; `middle_elem_alias`, is the variable middle loop's discriminator rather than the replaced uint.
middle_elem = uint ; @custom_serialize write_middle_elem @custom_deserialize read_middle_elem @custom_wire_major bytes
middle_elem_alias = middle_elem
middle_declared = [uint, * middle_elem_alias, tstr]
; The suffix twin's declared `text` head proves disjointness but remains the ordinary suffix reader.
middle_suffix = uint ; @custom_serialize write_middle_suffix @custom_deserialize read_middle_suffix @custom_wire_major text
middle_declared_suffix = [uint, * bytes, middle_suffix]
outer_declared_middle = [middle_declared, uint]
ign = [
  uint,
  * any ; @ignore                   ; tolerate-and-drop tail (drops trailing elements)
]
; Stream position (the cip36 skip-arm bug class): an open array is a member of an outer array; the
; tail loop must stop at the open array's end and leave the sibling for the outer decoder.
outer = [inner, uint]
inner = [uint, * uint]
outer_required = [inner_required, uint]
inner_required = [uint, + uint]
outer_bounded = [inner_bounded, uint]
inner_bounded = [uint, 2*3 uint]
outer_ign = [inner_ign, uint]
inner_ign = [
  uint,
  * any ; @ignore
]
outer_middle = [inner_middle, uint]
inner_middle = [uint, * bytes, tstr]
outer_exact_middle = [inner_exact_middle, uint]
inner_exact_middle = [uint, 2*2 uint, uint]
