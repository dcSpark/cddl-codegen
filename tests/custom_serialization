// writes bytes using indefinite encoding chunked into 1-byte parts
pub fn custom_serialize_bytes<'se>(
    serializer: &'se mut cbor_event::se::Serializer,
    bytes: &[u8],
) -> cbor_event::Result<&'se mut cbor_event::se::Serializer> {
    serializer.write_raw_bytes(&[0x5f])?;
    for byte in bytes {
        serializer.write_bytes(&[*byte])?;
    }
    serializer.write_special(cbor_event::Special::Break)
}

// read bytes and verify the 1-byte chunking of custom_serialize_bytes()
pub fn custom_deserialize_bytes(
    raw: &mut cbor_event::de::Deserializer,
) -> Result<Vec<u8>, DeserializeError> {
    let (bytes, bytes_enc) = raw.bytes_sz()?;
    match bytes_enc {
        cbor_event::StringLenSz::Len(_sz) => Err(DeserializeFailure::CBOR(cbor_event::Error::CustomError("custom_deserialize_bytes(): needs indefinite chunking".to_owned())).into()),
        cbor_event::StringLenSz::Indefinite(chunks) => {
            for (chunk_len, _chunk_sz) in chunks.iter() {
                if *chunk_len != 1 {
                    return Err(DeserializeFailure::CBOR(cbor_event::Error::CustomError(format!("custom_deserialize_bytes(): chunks need to be 1-len, found: {:?}", chunks))).into());
                }
            }
            Ok(bytes)
        }
    }
}

// A whole-record codec deliberately uses a text item rather than the record's declared array.
// The record's thin generated impls and a holder's named-reference dispatch must both land here.
pub fn write_custom_record<'se>(
    serializer: &'se mut cbor_event::se::Serializer,
    value: &CustomRecord,
) -> cbor_event::Result<&'se mut cbor_event::se::Serializer> {
    serializer.write_text(value.value.to_string())
}

pub fn read_custom_record(
    raw: &mut cbor_event::de::Deserializer,
) -> Result<CustomRecord, DeserializeError> {
    let text = raw.text()?;
    let value = text
        .parse()
        .map_err(|e| DeserializeFailure::InvalidStructure(Box::new(e)))?;
    Ok(CustomRecord::new(value))
}

// A whole-table pair deliberately writes a flat ARRAY rather than the declared map. The nominal
// wrapper's `new`/`From` surface remains usable for constructing the in-memory map; direct and
// embedded serialization both delegate to this one owner. The alternating text-key/uint-value
// spelling is visibly non-map while retaining every map entry, in BTreeMap order.
pub fn write_custom_table<'se>(
    serializer: &'se mut cbor_event::se::Serializer,
    value: &CustomTable,
) -> cbor_event::Result<&'se mut cbor_event::se::Serializer> {
    serializer.write_array(cbor_event::Len::Len((value.get().len() * 2) as u64))?;
    for (key, item) in value.get() {
        serializer.write_text(key)?;
        serializer.write_unsigned_integer(*item)?;
    }
    Ok(serializer)
}

pub fn read_custom_table(
    raw: &mut cbor_event::de::Deserializer,
) -> Result<CustomTable, DeserializeError> {
    let len = match raw.array_sz()? {
        cbor_event::LenSz::Len(len, _) if len % 2 == 0 => len,
        cbor_event::LenSz::Len(_, _) => {
            return Err(DeserializeFailure::CBOR(cbor_event::Error::CustomError(
                "table-as-array codec: odd item count".to_owned(),
            ))
            .into());
        }
        cbor_event::LenSz::Indefinite => {
            return Err(DeserializeFailure::CBOR(cbor_event::Error::CustomError(
                "table-as-array codec: indefinite arrays are not emitted".to_owned(),
            ))
            .into());
        }
    };
    let mut map = std::collections::BTreeMap::new();
    for _ in 0..len / 2 {
        let key = raw.text()?;
        let value = raw.unsigned_integer()?;
        if map.insert(key, value).is_some() {
            return Err(DeserializeFailure::CBOR(cbor_event::Error::CustomError(
                "table-as-array codec: duplicate key".to_owned(),
            ))
            .into());
        }
    }
    Ok(CustomTable::from(map))
}

// writes as hex text
pub fn write_hex_string<'se>(
    serializer: &'se mut cbor_event::se::Serializer,
    bytes: &[u8],
) -> cbor_event::Result<&'se mut cbor_event::se::Serializer> {
    serializer.write_text(hex::encode(bytes))
}

// The in-repo exemplar of the consumer migration an ALLOC-MODE dependency forces on hand code that
// BOXES that dependency's error type: a dependency whose `Error` impl is gated on its own `std`
// feature stops satisfying `Box<dyn Error>` the moment the generated crate takes it with
// `default-features = false`, and a local newtype supplying the impl is the fix — not re-enabling
// the dependency's default features.
//
// The `hex` KEY is no longer such a dependency: it takes the `const-hex` package with `core-error`,
// which impls `core::error::Error` unconditionally, so `Box::new(e)` compiles here without the
// newtype. It is kept because the shape is what a dependency lacking that impl still requires, and
// this file is where the shape is written down and compiled.
//
// `Debug` and `Display` are hand-written and delegate VERBATIM rather than derived:
// `DeserializeFailure` renders a boxed error inline, so a derived `Debug` would insert a
// `HexDecodeError(..)` layer into every rendered message. The wrapper is deliberately invisible in
// output.
struct HexDecodeError(hex::FromHexError);

impl core::fmt::Debug for HexDecodeError {
    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
        core::fmt::Debug::fmt(&self.0, f)
    }
}

impl core::fmt::Display for HexDecodeError {
    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
        core::fmt::Display::fmt(&self.0, f)
    }
}

impl core::error::Error for HexDecodeError {}

// reads hex text to bytes
pub fn read_hex_string(
    raw: &mut cbor_event::de::Deserializer,
) -> Result<Vec<u8>, DeserializeError> {
    let text = raw.text()?;
    hex::decode(text)
        .map_err(|e| DeserializeFailure::InvalidStructure(Box::new(HexDecodeError(e))).into())
}

// must include the tag since @custom_serialize at field-level overrides everything
pub fn write_tagged_uint_str<'se>(
    serializer: &'se mut cbor_event::se::Serializer,
    uint: &u64,
) -> cbor_event::Result<&'se mut cbor_event::se::Serializer> {
    serializer
        .write_tag(9)?
        .write_text(uint.to_string())
}

pub fn read_tagged_uint_str(
    raw: &mut cbor_event::de::Deserializer,
) -> Result<u64, DeserializeError> {
    use std::str::FromStr;
    // the write half hard-codes tag 9 ("must include the tag" above) — reject anything else,
    // otherwise a wrong-tag document is silently accepted (generated code delegates the WHOLE
    // tagged field to this hook, so nothing upstream checks it)
    let tag = raw.tag()?;
    if tag != 9 {
        return Err(DeserializeFailure::TagMismatch {
            found: tag,
            expected: 9,
        }
        .into());
    }
    let text = raw.text()?;
    u64::from_str(&text).map_err(|e| DeserializeFailure::InvalidStructure(Box::new(e)).into())
}
