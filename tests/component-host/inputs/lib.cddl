; The BEHAVIORAL fixture: one shape per assertion class the wasmtime host harness drives, and
; nothing else. Every other component fixture is judged by reading emitted bytes; this one is judged
; by RUNNING the component, so each rule below exists to make one runtime claim checkable.
;
; A DIRECTORY input on purpose — `tests/<dir>/input.cddl` carries a corpus-parity registration
; obligation (`wasm_api_parity_axes_and_pins_are_live` reconciles every such dir against
; `CORPUS_PARITY_INPUTS`/`CORPUS_PARITY_EXCLUDED`) and a directory does not, and this fixture has no
; wasm-parity question to answer: its subject is what the COMPONENT boundary does at runtime.
;
; Which assertion class each shape serves (the classes are the `#[test]`s in
; `tests/component-host/host/tests/behavior.rs`):
;
;   hash      — the fallible door. A `result<hash, string>` constructor that must return `Err` and
;               NEVER trap, leaving the instance usable afterwards (a trap poisons it).
;   color     — a c-style enum crossing the boundary in both directions.
;   value     — a type choice: `new-<variant>` statics, the `<name>-kind` discriminant, `as-<variant>`.
;   thing     — an inlined group-choice arm with two optional fixed presence bits and a text value:
;               component field-qualified reads preserve all constructor values and wrong-arm None.
;   solo      — the tuple-form compatibility control: one optional fixed bit retains `as-solo0`.
;   node      — the RE-ENTRANCY case, and the only one with no wasm-face precedent. `children` is
;               OPTIONAL, which is what mints a `set-children` taking `list<borrow<node>>` — so
;               `x.set-children([x])` is expressible, must return normally, and must store a
;               SNAPSHOT rather than an aliased cycle. It is also the returned-collection snapshot
;               subject in both directions.
;   names     — a NonEmpty list. Despecialized to a plain `list<string>` in WIT, so its invariant is
;               re-imposed at the CONSUMING constructor and setter: `record`'s fallible ctor and the
;               fallible `set-aliases`.
;   attrs     — a table: `list<tuple<string, u64>>`, never a `map<K, V>`.
;   interleaved_segments — compatible-type constructor slots interleaved with two dynamic array
;               segments, whose distinct values must retain identity and order at every getter.
;   record    — mandatory + optional fields (construction / accessor read-back / byte round-trip),
;               `delta: int` for the `variant int` bridge and its -(n+1) bias, `meta: any` for the
;               any-cbor edges, `? extra: any` for the same edges through a SETTER, and
;               `? nested: text / null` for the three distinct states of `option<option<string>>`.

; a bounded newtype wrapper -> `resource hash` with a FALLIBLE constructor
hash = bytes .size 32

; a c-style enum -> a WIT `enum` VALUE type
color = 0 / 1 / 2

; a type choice -> a resource with NO constructor: `new-<variant>` statics, a `kind` discriminant
; and `as-<variant>` getters
value = uint / text / bytes

; An inlined group-choice arm has three materialized native values. The component face keeps every
; one in `new-thing0(a, x, b)` and gives each its own `as-thing0-<field>` read door.
thing = [ ? a: 0, x: tstr, ? b: 1 // y: bytes ]

; A sole materialized inlined arm stays a tuple variant natively; its component API retains the
; established unqualified `as-solo0()` compatibility read instead of inventing `as-solo0-a()`.
solo = [ ? a: 2, fixed: 3 // y: bytes ]

; collection-mediated recursion with the collection field OPTIONAL, which is what gives the resource
; a `set-children: func(children: list<borrow<node>>)` — the same-handle re-entrancy shape
node = {
  label: text,
  ? children: [* node],
}

; a NonEmpty list: type-enforced in rust, despecialized to a plain `list<string>` in WIT
names = [+ text]

; A bounded reject set: both cardinality and uniqueness are type-enforced in rust by one
; BoundedOrderedSet door, while WIT deliberately carries only `list<u64>`. `record.unique` is
; optional so its setter exercises a post-construction component input boundary.
unique = [2*3 uint] ; @duplicates reject

; a table -> `list<tuple<string, u64>>`
attrs = { * text => uint }

record = {
  id: uint,
  name: text,
  digest: hash,
  delta: int,
  tags: names,
  props: attrs,
  kind: color,
  choice: value,
  root: node,
  meta: any,
  ? aliases: names,
  ? unique: unique,
  ? extra: any,
  ? note: text,
  ? nested: text / null,
}

; All five constructor arguments are list<string> on the component face and Vec<String> natively.
; Required nested arrays separate two flat text segments on the wire, so decoding has major-disjoint
; boundaries while a constructor slot swap still compiles.
; The host test uses distinct sentinels for every slot and reads both segment getters independently.
interleaved_segments = [
  head: [* tstr]
  , * tstr ; @name left
  , middle: [* tstr]
  , * tstr ; @name right
  , tail: [* tstr]
]

; Optional fixed presence carries bool state, while a defaulted optional uint is stored plain.
; These two doors are distinct WitMemberOp cases, not the inlined choice's AsVariant bool payload.
presence = { ? flag: 0 }
defaults = { ? count: uint .default 7 }


; Protected map storage: the fixed and forbidden text keys overlap the bare-text rest domain.
; Complete-row construction validates keys; the component rest getter must use the native accessor.
protected_rest = { required: uint, 0*0 forbidden: uint, * tstr => uint }

; WrapperGet uses the authored getter name rather than assuming get.
renamed_bytes = bytes ; @newtype read_payload

; The first new-checked delegates a loose byte Vec to its fallible native constructor.
native_choice =
  bytes .size 4 ; @name checked
  / tstr ; @name fallback

; The second new-checked revalidates a NonEmptyVec at the boundary before an infallible native ctor.
boundary_choice =
  names ; @name checked
  / bytes ; @name fallback

; AsVariant crosses a resource payload as an owned snapshot, not the primitive-payload path.
resource_choice =
  node ; @name held
  / bytes ; @name fallback
