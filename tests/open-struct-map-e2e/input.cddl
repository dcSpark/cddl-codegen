; Open struct-map (loose CBOR "rest row") end-to-end round-trip vectors, plain flavor
; (--wasm=false, non-preserve). See tests/open-struct-map-e2e/tests.rs for the value-level vectors;
; the PRESERVE fidelity twin lives in tests/open-struct-map-preserve-e2e.
foo = { 1: uint, 2: text, * uint => any }   ; uint key domain, any value
bar = { ? 3: text, * uint => any }          ; optional fixed key, then rest
baz = { 1: uint, * any => any }             ; any key domain, captures every wire key type

; --- TYPED key domains (the seek path: nothing is reconstructed from the loop's peek) ---
md = int / bstr / text
; A local union K crossed with BOTH declared key kinds. Declared keys peel first (a second
; occurrence is a DuplicateKey, never a capture); every other wire key is refined by `Md`.
qux = { 1: uint, "nm": text, * md => uint }
; A `bytes` K: the `_` dispatch arm (major type 2 is neither uint, text, nor special).
quux = { 1: uint, * bstr => uint }
; A bounds-refined text K: `.size 5` lowers to a newtype whose deserialize enforces the length, so a
; short key is a parse ERROR rather than a capture.
five = tstr .size 5
grault = { 1: uint, * five => uint }
; The typed union under `@duplicates preserve` (the PairMap twin): duplicates are kept, in wire order.
garply = {
  1: uint,
  * md => uint ; @duplicates preserve
}
