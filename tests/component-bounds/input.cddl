; The VALUE-WINDOW fixture for the component face: one shape per way a CDDL bound reaches a
; boundary parameter, plus the two controls that say where a bound must NOT produce an inline check.
;
; Every row here is a fact about the generated RUST crate that no WIT gate can see — the WIT
; signature of a bounded setter (`result<_, string>`) is identical whether the glue checks the window
; or ignores it — which is why this fixture is in the wasip2 build smoke as well as the WIT sweep.

; a bounded ARRAY: its rust type is `BoundedVec<T, MIN, MAX>` while WIT carries a plain list, so
; the boundary must re-enter BoundedVec's `TryFrom` door. No inline check is needed because the
; invalid state is unrepresentable after conversion.
sized_list = [2*5 uint]

; a `[+ T]`: the CONTROL for the opposite verdict. Its `>= 1` bound is enforced by the type system
; (`NonEmptyVec`'s single `TryFrom` door), so the boundary re-enters that door and emits NO inline
; check — the invalid state is unrepresentable rather than rejected.
non_empty = [+ uint]

; an `@duplicates reject` set: the OTHER despecialized shape, for the same reason. It crosses as a
; plain `list<u64>` and its uniqueness is re-imposed by `OrderedSet`'s `TryFrom`.
unique = [* uint] ; @duplicates reject

bounded = {
  ; mandatory and bounded: the rust `new` takes an already-checked BoundedVec and is infallible, so
  ; the guest re-enters `TryFrom` before calling it. A second inline check would duplicate the door.
  fixed_size: sized_list,

  ; the optional bounded rows — one per bounds-check expression the shared owner renders: a bare
  ; integer, a float window, and `.len()` over bytes, text, and a map. Each reaches a SETTER, which
  ; is the only door that has to enforce the window itself; the bounded-array field above is typed.
  ? lim: uint .le 5,
  ? window: 0.5 .. 10.5,
  ? digest: bytes .size 4,
  ? label: text .size (3..14),
  ? span: sized_list,
  ; a bounded MAP, spelled INLINE because that is where the window reaches the field's own rust
  ; type. It matters twice over: `BTreeMap<K, V>` has NO `TryFrom<Vec<(K, V)>>` at all, so a
  ; boundary that mistook a bounded map for a despecialized collection emitted glue that did not
  ; compile — and the check itself has to be a `.len()` over the map.
  ? counts: { * uint => text } .le 3,
  ; Unlike the value-bound control above, this occurrence window is represented by BoundedMap and
  ; must re-enter its TryFrom door after WIT's list-of-pairs crossing.
  ? exact_counts: { 2*3 uint => text },

  ; the two controls, as optional fields so they reach a SETTER — the one door with no rust
  ; constructor between the caller and the field.
  ? ids: non_empty,
  ? tags: unique,
}

; A direct table's WIT spelling is `list<tuple<K, V>>`; its bounded VALUE must still re-enter
; BoundedVec's TryFrom door while the outer collect selects the target BTreeMap.
mapped = {
  entries: { * uint => sized_list },
}
