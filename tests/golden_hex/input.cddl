; Golden known-answer vectors. The expected CBOR bytes in tests.rs are hand-derived from
; RFC 8949 (Appendix A: the canonical CBOR encoding examples), independent of the generator.
; Round-trip tests cannot catch a *symmetric* encode+decode bug (both sides wrong in a
; compensating way); exact-byte assertions can, because the bytes are anchored to the spec.
;
; Coverage spans every CBOR major type the generator emits under default flags:
;   0 uint, 1 nint, 2 bstr, 3 tstr, 4 array, 5 map, 6 tag, 7 simple (bool/null/undefined) + float.

; major type 0 (unsigned) + 4 (array) + nesting
triple    = [a: uint, b: uint, c: uint]
point     = [x: uint, y: uint]
nested    = [tag: uint, inner: point]

; major type 3 (text) and 2 (bytes)
one_text  = [s: tstr]
one_bytes = [v: bstr]
fixed_bytes = h'CAFE'

; major type 1 (negative integer)
one_nint  = [n: nint]

; major type 7 (simple: bool, null, undefined) and float
one_bool  = [v: bool]
one_undefined = [v: undefined]
one_float = [v: float]
nullable  = [v: uint / null]

; major type 5 (map) — text keys and integer keys
text_map  = { a: uint, b: uint }
int_map   = { 1 => uint, 2 => uint }

; major type 6 (tag) — a tag wrapping an array record
tagged_pair = #6.42([x: uint, y: uint])

; variable-length array and map (the `*` occurrence). Bare `[* uint]` / `{ * uint => uint }`
; generate as plain Vec/BTreeMap aliases with no serialization methods, so wrap each in a record
; to get a testable struct; the inner bytes are the variable-length encoding under test.
uint_array = [* uint]
uint_map   = { * uint => uint }
arr_holder = [a: uint_array]
map_holder = [m: uint_map]

; bignum — RFC 8949 tags 2 (unsigned) and 3 (negative), via the biguint/bignint prelude types
big_uint = [b: biguint]
big_nint = [b: bignint]

; open struct-map (loose CBOR "rest row"): a fixed key `1: uint` followed by a trailing
; `* uint => uint` captures unknown map entries into `.rest`. The wire is the declared field
; followed by the captured entries in key order; empty rest ≡ the closed one-entry map.
open_map = { 1: uint, * uint => uint }

; the `@ignore` (tolerate-and-drop) flavor of the same shape: unknown map entries are typed-
; deserialized and DROPPED, so re-serialize emits ONLY the declared field. Decoding wire that
; carries unknown entries therefore does NOT round-trip to itself — it round-trips to the
; declared-only bytes (the KATs assert exactly that lossy contract). Non-preserve only. The
; `; @ignore` sits on its own line before `}` so the comment does not swallow the brace.
ignore_map = {
  1: uint,
  * uint => uint ; @ignore
}

; open array (loose CBOR "rest tail"): fixed members `uint, tstr` followed by a trailing `* uint`
; captures the trailing elements into `.rest`. The array header COUNTS the declared members plus every
; tail element (2 + rest.len()); the wire is the declared members first, then the tail elements in
; order. Empty tail ≡ the closed two-element array.
open_list = [uint, tstr, * uint]

; the `@ignore` (tolerate-and-drop) flavor: trailing elements are typed-deserialized and DROPPED, so
; re-serialize emits ONLY the declared prefix. Decoding wire that carries trailing elements therefore
; does NOT round-trip to itself — it round-trips to the declared-prefix bytes (the KATs assert exactly
; that lossy contract). Non-preserve only. The `; @ignore` sits on its own line before `]` so the
; comment does not swallow the closing bracket.
ignore_list = [
  uint,
  * uint ; @ignore
]
