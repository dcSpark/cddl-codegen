; Open table (`t = { * K_t => V_t, * K_r => V_r }`) CBOR fidelity end-to-end vectors: one typed
; table row plus one trailing typed catch-all rest row, dispatched by WIRE MAJOR TYPE peeked before
; any deserializer runs. Generated under --preserve-encodings --canonical-form (canonical implies
; preserve), so the one crate exercises byte-exact round-trip (the TAGGED `orig_deser_order` slot
; encoding over two dynamic sequences) AND the runtime canonical key merge across both regions.
; Every `wire` byte string in tests.rs is hand-written from the CBOR grammar.
pid = bytes .size 4
details = { name: text }
md = uint / text

; The base shape: a bytes-keyed typed row (major 2) beside a uint/text catch-all (majors 0 and 3).
; The typed row claims major 2 and nothing else; the catch-all sees the complement.
labels = { * pid => details, * md => md }

; The typed row keyed on a TEXT primitive (major 3): the catch-all's `md` still admits major 0, so
; the complement is non-empty and the two partition majors 0/3 between them.
text_keyed = { * text => uint, * md => md }

; `@duplicates preserve` on BOTH rows: each becomes its own `PairMap` (duplicate keys kept, in wire
; order) with POSITIONAL encoding sidecars, and the canonical merge still sorts both regions into
; one order by encoded key bytes.
dup_both = {
  * pid => uint ; @duplicates preserve
  ,
  * md => md ; @duplicates preserve
}

; `@name` on both rows: the two containers are two `pub` fields on one struct, so each row names its
; own field (the defaults are `entries` / `rest`).
named = {
  * pid => uint ; @name typed
  ,
  * md => md ; @name captured
}

; The NonEmpty twin (`{+ …}`): the min-1 counts TYPED entries only, so a map of purely CAPTURED
; entries is not a non-empty table. The typed field is a restricted carrier: `new` takes the first
; entry directly and CBOR stages into the loose map before its checked conversion.
non_empty = { + pid => uint, * md => md }

; The duplicate-preserving NonEmpty twin: the typed row retains its entry order and duplicates
; while the public carrier still prevents dropping its final entry.
non_empty_preserve = {
  + pid => uint ; @duplicates preserve
  ,
  * md => md ; @duplicates preserve
}

; Every dynamic-map-row window is now a checked carrier. These four rules give the e2e vectors an
; open struct rest, the two open-table positions, and the duplicate-preserving counting twin.
bounded_rest = { 1: uint, 2*3 uint => text }
bounded_typed = { 2*3 pid => uint, * md => md }
; A zero-minimum typed window crosses wasm `new()` through its loose builder, then re-enters the
; native checked carrier. `pid` is deliberately a generated record rather than a primitive, so the
; compile floor catches a wasm/native type spelling mix-up at that boundary.
optional_bounded_typed = { 0*3 pid => uint, * md => md }
bounded_catch_all = { * pid => uint, 2*3 md => md }
bounded_preserve = {
  2*3 pid => uint ; @duplicates preserve
  ,
  * md => md
}

; Primitive-key companions for the generated `--emit-tests` module. The general-purpose minter
; deliberately does not manufacture multiple distinct `pid`/`md` keys, while these rules exercise
; the same bounded native-carrier and wasm staging-builder constructors end-to-end.
emitted_bounded_typed = { 2*3 uint => uint, * text => text }
emitted_optional_bounded_typed = { 0*3 uint => uint, * text => text }
emitted_bounded_catch_all = { * bytes => uint, 2*3 text => text }
emitted_bounded_preserve = {
  2*3 uint => uint ; @duplicates preserve
  ,
  * text => text
}
