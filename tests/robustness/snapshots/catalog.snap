# generator outcome per malformed/edge input
# PANIC = regression: malformed input must error gracefully, never panic

duplicate_rule             error (graceful)
empty                      ok
empty_array                ok
empty_group                ok
garbage                    error (graceful)
generic_arity_mismatch     error (graceful)
prelude_biguint            ok
self_recursive             ok
undefined_generic          error (graceful)
undefined_reference        error (graceful)
unknown_control            error (graceful)
whitespace_only            ok
