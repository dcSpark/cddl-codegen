; Fixed FLOAT choice arms now use the fixed-value minter's canonical fallback only when the old
; derived spelling cannot be a Rust identifier: `1.5` -> `Float3FF8000000000000` and
; `2.5` -> `Float4004000000000000`, exact IEEE-754 identities. The supported paths here are:
;   - `a` bare rule-level type choice,
;   - `b` all-fixed c-style enum,
;   - `c` nested anonymous choice, and
;   - `d` bare-member group choice, the separate consumer that has no member key to use.
; `e` confirms explicit @name remains a public reservation and wins over a derived sibling; `f`
; confirms a named group member still gets its name from its member key. The kind's spellable
; legacy names are deliberately unchanged; this is a fallback, never a global rename.
a = 1.5 / tstr
b = 1.5 / 2.5
c = [1.5 / tstr]
d = [ true // 1.5 ]
e = 1.5 ; @name half
  / tstr
f = [ true // v: 1.5 ]
