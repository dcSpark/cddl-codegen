; A fixed NINT arm's old display-derived spelling (`-1` -> `U-1`) is not an identifier, so it
; takes the fixed-value minter's canonical magnitude identity `Nint1`. Both the rule-level and
; bare-member group-choice consumers share that minter. `c` retains the explicit @name route as a
; public reservation, while `d` is the spellable UINT legacy-name control (`I1`).
a = -1 / null / tstr
b = [ true // -1 ]
c = -1 ; @name neg_one
  / null / tstr
d = 1 / null / tstr
