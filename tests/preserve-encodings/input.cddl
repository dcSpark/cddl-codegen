foo = #6.11([uint, text, bytes]) ; @used_as_key

bar = {
	foo: #6.13(foo),
	? derp: uint,
	1 : uint / null,
	? 5: text,
	five: 5,
}

table = { * uint => text }

u32 = uint .size 4 ; 4 bytes

table_arr_members = {
	arr: [*u32],
	arr2: [*foo],
	table: table,
}

data = { * #6.14(bytes) => { * uint => { * #6.9(uint) => [* #6.18([* text]) ] } } }

deeply_nested = [ data: data ]

string64 = text .size (0..64)

tagged_text = #6.9(text)

string_16_32 = #6.7(text .size (16..32))

type_choice = 0 / "hello world" / uint / text / #6.16([*uint])

non_overlapping_type_choice_all = uint / nint / text / bytes / #6.13("hello world") / [* uint] / { *text => uint }

non_overlapping_type_choice_some = uint / nint / text ; @used_as_key

overlap_basic_embed =  [
  ; @name identity
  tag: 0 //
  ; @name x
  tag: 1, hash: bytes .size 32
]

non_overlap_basic_embed = [
  ; @name first
  x: uint, tag: 0 //
  ; @name second
  y: text, tag: 1
]

non_overlap_basic_embed_multi_fields = [
  ; @name first
  x: uint, z: uint //
  ; @name second
  y: text, z: uint
]

non_overlap_basic_embed_mixed = [
  ; @name first
  x: uint, tag: 0 //
  ; @name second
  y: text, z: uint
]

bytes_uint = (bytes, uint)

non_overlap_basic_embed_mixed_explicit = [
  ; @name first
  x: uint, tag: 0 //
  ; @name second
  y: text, z: uint //
  ; @name third
  bytes_uint
]

basic = (uint, text)

basic_arr = [basic]

; not overlap since double array for second
non_overlap_basic_not_basic = [
  ; @name group
  basic //
  ; @name group_arr
  basic_arr //
  ; @name group_tagged
  #6.11(basic_arr) //
  ; @name group_bytes
  bytes .cbor basic_arr
]

c_enum = 3 / 1 / 4

enums = [
	c_enum,
	type_choice,
]

plain = (d: #6.13(uint), e: tagged_text)

plain_arrays = [
    embedded: plain,
    single: [plain],
    multi: [* [plain]],
]

group_choice = [ 3 // #6.10(2) // foo // 0, x: uint // plain ]

foo_bytes = bytes .cbor foo

; since we don't generate code for definitions like the above (should we if no one refers to it?)
cbor_in_cbor = [foo_bytes, uint_bytes: bytes .cbor uint, tagged_foo_bytes]

tagged_foo_bytes = #6.20(bytes .cbor foo)

signed_ints = [
	u_8: uint .size 1,
	u_16: uint .size 2,
	u_32: uint .size 4,
	u_64: uint .size 8,
	i_8: -128 .. 127,
	i_16: -32768 .. 32767,
	i_32: -2147483648 .. 2147483647,
	i_64: -9223372036854775808 .. 9223372036854775807,
	n_64: nint
	u64_max: 18446744073709551615,
	; this test assumes i64::BITS == isize::BITS (i.e. 64-bit programs) or else the cddl parsing lib would mess up
	; if this test fails on your platform we might need to either remove this part
	; or make a fix for the cddl library.
	; The fix would be ideal as even though the true min in CBOR would be -u64::MAX
	; we can't test that since isize::BITS is never > 64 in any normal system and likely never will be
	i64_min: -9223372036854775808
]

default_uint = uint .default 1337

map_with_defaults = {
	? 1 : default_uint
	? 2 : text .default "two"
}

; TODO: preserve-encodings remembering optional fixed values. Issue: https://github.com/dcSpark/cddl-codegen/issues/205
array_opt_fields = [
;  ? x: null,
  ? a: uint,
  ? b: text,
	c: nint,
  ? d: text,
    y: #6.10(1),
  ? e: non_overlapping_type_choice_some
;  ? z: null,
]

hash = bytes .size (0..8)

bounds = [
    w: -1000 .. 1000
    x: uint .le 7,
    y: nint .ge -5,
    z: text .size (3..14),
    a: [* uint] .size (1..3),
    b: { * uint => uint } .le 3
]

; Signed-int fields whose value window must be partitioned across the two CBOR sign arms. Under
; --preserve-encodings BOTH arms go through the classification (the nint arm isn't the i64-special
; case), so `.le 10` / `.ge 3` / `.ne 5` — which panicked generation before — are pinned here.
sign_bounds = [
    all_neg: -10 .. -3,
    upto_zero: -10 .. 0,
    le_neg: int .le -3,
    le_pos: int .le 10,
    ge_pos: int .ge 3,
    ne_pos: int .ne 5,
    ne_neg: int .ne -5,
    straddle: -10 .. 3,
    ne_one: int .ne 1,
    ne_zero: int .ne 0
]

; Literal-headed top-level range rules wrap into a bounds-enforcing struct (mirroring the
; `int .op`-headed wrappers). The bounds/tag logic is mode-independent; pinned here too so the
; preserve-encodings wrapper machinery (encoding capture beside the window check / the tag write)
; is exercised on a literal-headed range, and a tagged rule keeps writing its tag under preserve.
top_level_neg_range = -10 .. -3
top_level_pos_range = 3 .. 10
top_level_tagged_range = #6.5(3 .. 10)

bounds_type_choice = bytes .size (0..64)
                   / text .size (0..64)

bounds_group_choice = [
    ; @name a
    a: uint, b: text .le 4 //
    ; @name b
    hash //
    ; @name c
    1, x: hash, y: hash
]

overlapping_inlined = [
    ; @name one
    0 //
    ; @name two
    0, uint //
    ; @name three
    0, uint, text
]

enum_opt_embed_fields = [
    ; @name ea
    1 //
    ; @name eb
    1, ?text, 5 //
    ; @name ec
    1, uint, 7 //
; doesn't parse but would result in triple nesting so worth testing if we can ever parse it
;  1, ? (text / null), #6.9(9)
    ; @name ed
    1, uint, ?text //
    ; @name ee
    1, uint, ?bytes, uint //
    ;  @name ef
    1, ? non_overlapping_type_choice_some, #6.11(11) //
    ; @name eg
    1, ? overlapping_inlined, #6.13(13)
]

custom_bytes = bytes ; @custom_serialize custom_serialize_bytes @custom_deserialize custom_deserialize_bytes

; A named record's pair owns the whole item, not just a member: this deliberately writes TEXT
; instead of the structural array wire, and the holder reaches the identical custom wire. The
; complete custom reader owns the item and constructs only the mandatory `value`.
custom_record = [? ignored: uint, value: uint] ; @custom_serialize write_custom_record @custom_deserialize read_custom_record
custom_record_holder = [ nested: custom_record ]

; A complete table pair owns the whole item and is self-carrying under preserve encodings: its
; reader returns the nominal map wrapper and its writer receives that wrapper, not entry sidecars.
custom_table = { * text => uint } ; @custom_serialize write_custom_table @custom_deserialize read_custom_table
custom_table_holder = [ nested: custom_table ]

struct_with_custom_serialization = [
  custom_bytes,
  field: bytes, ; @custom_serialize custom_serialize_bytes @custom_deserialize custom_deserialize_bytes
  overridden: custom_bytes, ; @custom_serialize write_hex_string @custom_deserialize read_hex_string
  tagged1: #6.9(custom_bytes),
  tagged2: #6.9(uint), ; @custom_serialize write_tagged_uint_str @custom_deserialize read_tagged_uint_str 
]

; A record that only REFERENCES a named struct whose FIELDS carry @custom_serialize (the struct
; itself has no type-level custom-ser). The encoding-fidelity oracle must exclude this holder too:
; feeding irregular re-encodings through the nested struct's custom deserializer (which rejects any
; non-indefinite-chunked bytes) would panic. Guards emit_tests's reachable-custom-ser walk against
; regressing to a type-level-only check.
custom_field_holder = [ nested: struct_with_custom_serialization ]

; The MAP-rep twin of struct_with_custom_serialization. A map-rep field's serialize builds ONE
; config that serves both the member-key write and the VALUE write, so that config must carry the
; field's @custom_serialize: built without it the custom WRITER was silently dropped while the read
; side kept honoring @custom_deserialize — a round-trip-breaking asymmetry the array-rep rule above
; cannot see, since array fields take a different construction path. Under --preserve-encodings the
; drop is doubly visible: the value's encoding sidecar is handed to the custom writer as an
; argument, so a dropped writer also loses the recorded widths. Each custom field here writes bytes
; the DEFAULT writer would not (indefinite 1-byte-chunked bytes, hex TEXT over a `bytes` field, a
; hook-written tag). `aliased` is the type-level control (honored through the alias, not the field)
; and `plain` the no-directive control — neither may move, and both keep their own key encodings.
map_struct_with_custom_serialization = {
  chunked: bytes, ; @custom_serialize custom_serialize_bytes @custom_deserialize custom_deserialize_bytes
  hexed: bytes, ; @custom_serialize write_hex_string @custom_deserialize read_hex_string
  aliased: custom_bytes,
  tagged: #6.9(uint), ; @custom_serialize write_tagged_uint_str @custom_deserialize read_tagged_uint_str
  plain: uint,
}

; A type-level custom pair is honored wherever the alias RESOLVES, and a table's key domain and
; value range are the two such positions no struct field can reach: neither goes through a record
; field's config, both go through the table loop instead. `hex_table_str` writes bytes as hex TEXT —
; a wire shape the default `bytes` writer never produces and `read_hex_table_string` refuses — so a
; custom fn dropped in either position is a round-trip FAILURE here, not a cosmetic difference.
; Under --preserve-encodings each position also carries its own sidecar, and both are keyed by the
; DECODED KEY (`*_key_encodings` and `*_value_encodings` alike): the key sidecar is therefore filled
; from the value the custom READER handed back, not from the wire text it consumed.
hex_table_str = bytes ; @custom_serialize write_hex_table_string @custom_deserialize read_hex_table_string

custom_table_positions = [
  keyed: { * hex_table_str => uint },
  valued: { * uint => hex_table_str },
]

wrapper_table = { * uint => uint } ; @newtype
wrapper_list = [ * uint ] ; @newtype

; Exact-width collapses under --preserve-encodings: the _sz read path (u64 from
; unsigned_integer_sz, i128 from negative_integer_sz) must width-check before its narrowing
; cast exactly like the default path — a bare `x as u16`/`as i8`/`as i64` silently truncated.
width_collapse = [
    u16w: uint .size 2,
    i8w: -128 .. 127,
    i64w: -9223372036854775808 .. 9223372036854775807,
]

; WI-1: a `[+ T]` field under --preserve-encodings. The NonEmptyVec container must NOT swallow or
; duplicate the array's length-encoding metadata — the encoding vars stay keyed off the FIELD in the
; parent's encoding struct, so an indefinite-length encoding round-trips byte-identically.
nev_preserve = [ pts: [+ uint] ]

; WI-2: a `{+ k => v}` field under --preserve-encodings. The NonEmptyMap container must NOT swallow or
; duplicate the table's length/key-order encoding metadata — the encoding vars stay keyed off the
; FIELD in the parent's encoding struct, so an indefinite-length / non-canonical-order encoding
; round-trips byte-identically.
nem_preserve = [ m: {+ uint => tstr} ]

; --- cbor_event 3.2.0 upgrade vectors: the preserve flavor of the nullable-Special null-peek ---
; (see tests/core/input.cddl). BOTH major-type-7 flavors: the encoding-less `bool` and the
; width-carrying `float`, whose head width survives the null-peek and the Optional wrapper.
; Unconstrained `float` deliberately: the recorded-width fit/fallback rule these vectors pin is
; the same one every float name obeys, isolated here from any value-class question.
nullable_bool = bool / null
; --- the six float prelude names are six VALUE classes, under preserve ---
; A RECORDED head replays exactly, and is NOT confined to the class's own width: reads accept any
; head and judge the value, so an fb-headed 1.5 is a `float16` that replays as fb. A FRESH value
; writes its shortest lossless form, which for a member IS the class's declared width.
float_heads = [h: float16, u: float16-32, w: float32-64, s: float32, d: float64, f: float]

nullable_float = float / null
nullable_specials = [b: nullable_bool, f: nullable_float]

; --- OPTIONAL fixed-value members under --preserve-encodings ---
; The presence `bool` coexists with the encoding vars: an encoding-ful fixed value (uint/nint/text)
; keeps its width metadata keyed off the FIELD in the parent encoding struct, so a NON-CANONICAL
; encoding of the constant (e.g. `? ufix: 5` written 0x1805 — a 2-byte uint) round-trips
; byte-identically; the encoding-less bool/null carry only the presence bit. A fixed FLOAT is the
; third kind: encoding-ful like uint/text (its head WIDTH is the metadata), but its constant peeks as
; CBOR Special like bool/null, so in the array form it must not be followed by another
; Special-classed field.
opt_fixed_arr = [a: uint, ? ufix: 5, b: text]
opt_fixed_arr_float = [a: uint, ? ffix: 2.5, b: text]
opt_fixed_map = {a: uint, ? m_uint: 5, ? m_text: "tag", ? m_nint: -7, ? m_bool: true, ? m_null: null}

; WI-3: a `@duplicates reject` collapsed tag-set field, minted as a NAMED GENERIC instance under
; --preserve-encodings — the byte-fuzzer surface for BOTH the optionally-tagged deserialize peek path
; (peek the major type, conditionally consume + validate the tag, then the collection body — the one
; hand-rolled branch the tag-set collapse added) AND the reject uniqueness door (the collected Vec
; routed through OrderedSet::try_from, raising DuplicateKey on a duplicate). The named instance also
; exercises the generic use-site re-resolution of the reject twin (its policy survives, mirroring
; tests/corpus/tag_set_reject.cddl's `oset_u64 = oset<uint>`) while keeping a real wasm class under the
; rule name — an INLINE `oset_p<uint>` would instead synthesize a JS-invisible `pub type` alias to the
; structural wrapper, tripping the wasm-parity gate. The tag presence stays a tri-state encoding var,
; so either wire arm round-trips byte-exact; a duplicate on either arm is refused.
oset_p<a> = #6.258([* a]) / [* a] ; @duplicates reject
oset_p_u64 = oset_p<uint>
reject_set_preserve = [ s: oset_p_u64 ]

; --- fixed BOOL / NULL values in CHOICE-ARM position under --preserve-encodings ---
; bool and null are single-byte CBOR specials with no encoding variation, so a fixed one in arm
; position has NOTHING to bind under this flag: no value (it is fixed) and no encoding sidecar
; (unlike a fixed uint/nint's `Sz` or a fixed text's `StringEncoding`). The arm must VERIFY the
; constant without binding it; binding an empty list emitted `let  = ();`, which rustfmt rejects,
; so these two rules were UNGENERATABLE under the flag until the arm paths grew the same guard the
; member-position path carries. Here for the ROUND-TRIP half of that fix: the emitted tests
; construct each variant and assert the preserve contract on irregular re-encodings (the map arm's
; key `StringEncoding` and the group's `LenEncoding` are still real encoding state that must
; survive, and the fixed special beside them must not disturb it).
;   fixed_special_group_choice — collapsed map-rep arms with fixed keys (the
;                                `make_keyed_map_variant_deser_code` site), bool and null arms
;                                beside an ordinary text-valued arm.
;   fixed_special_type_choice  — a bare type choice (`rep = None`) through the generic
;                                `EnumVariantData::RustType` site, where the bool arm is genuinely
;                                field-less under every profile.
;   fixed_special_type_choice_brute — TWO fixed specials in one type choice. bool and null share
;                                CBOR major type 7, so the arms cannot be told apart by a
;                                type-match dispatch and the enum falls back to the BRUTE-FORCE
;                                try-each-arm emission (a per-arm probe closure whose `Ok` value is
;                                matched to pick the variant) — a third emission site the two-arm
;                                spellings above never reach, and the one that emitted an
;                                unterminated `()` ahead of the appended `Ok(())` until `7d66993a`.
; The array-rep arm flavor and the default/json profiles of all of these live in
; tests/corpus/group_choice_fixed_special.cddl; this fixture is the preserve-only execution half.
fixed_special_group_choice = { flag: true // absent: null // label: tstr }
fixed_special_type_choice = true / tstr
fixed_special_type_choice_brute = true / null / tstr

; --- mandatory RULE tags over anonymous choices under --preserve-encodings ---
; A tag wrapping the whole choice belongs to the ENUM RULE rather than to any arm. Rust enums have
; no enum-level instance storage, so every physical variant carries the same rule-owned tag-width
; field. The tag is read and checked ONCE before type dispatch/backtracking, then every successful
; arm construction receives it. `tagged_choice` carries an arm-specific StringEncoding beside that
; shared field; `tagged_all_fixed` proves the preserve-only data-carrying lowering of an otherwise
; C-style all-fixed choice.
tagged_choice = #6.10(int / tstr)
tagged_group_array = #6.11([ n: uint // text: tstr ])
tagged_group_map = #6.12({ n: uint // text: tstr })
tagged_all_fixed = #6.13(1 / 2 / 3)
; The `tag` arm already owns `tag_encoding` for its uint width. The enum-rule tag width must choose
; one collision-free name across every variant rather than colliding or choosing arm-by-arm.
tagged_tag_field_collision = #6.14([ tag: uint // text: tstr ])

; --- a c-style enum under an encoding-carrying wrapper, under --preserve-encodings ---
; A c-style enum is inlined at every use site (no `Deserialize` impl of its own — a fieldless Copy
; enum has nowhere to store an encoding, so the sidecar lives in the OWNER's encoding struct). That
; inline dispatch destructures the per-variant probe closure's `Ok` value, which carries only the
; enum's OWN encoding field; the wrapper's exprs (`StringEncoding::from(..)` from `.cbor`,
; `Some(tag_enc)` from the tag) belong to the RETURNED value, not the pattern. Mixing them made both
; rules below ungeneratable-as-compilable Rust under this flag (E0164 + E0308 for the `.cbor` arm,
; E0308 for the tagged arm). Here for the ROUND-TRIP half: the emitted tests must carry the enum's
; own `Sz` AND the wrapper's encoding (the payload's byte-string `StringEncoding`, the tag's `Sz`)
; through an irregular re-encoding byte-identically — a pattern that merely COMPILED could still
; bind the wrong slot, and only an executed round-trip rules that out.
; The default/json profiles of the same two spellings live in tests/corpus/cbor_enum_payload.cddl.
cbor_payload_enum = 0 / 1 / 2
cbor_enum_wrappers = [
  bytes_arm: bytes .cbor cbor_payload_enum,
  tagged_arm: #6.42(cbor_payload_enum),
]

; --- a `.cbor` payload nested inside another `.cbor` payload's collection, under --preserve-encodings ---
; The inner byte-string read is emitted inside the OUTER payload's loop body, where the enclosing
; reader is an `inner_de` overload; naming the outer reader there consumes the next outer item as
; the element's payload. Only the decode side was wrong, so the shape COMPILES and encodes
; spec-correctly under every profile — an executed round trip is the only thing that sees it, and
; under this flag the round trip must additionally carry each nested payload's own byte-string
; `StringEncoding` (the outer container's `LenEncoding` plus one `StringEncoding` per element/value)
; through an irregular re-encoding byte-identically.
; `*` is load-bearing: a fixed `[X]` would mint a record struct whose `fn deserialize(raw..)`
; boundary resets the buffer name and masks the defect. The default/json profiles of this shape
; live in tests/corpus/cbor_payload_nested.cddl, and tests/core carries the hand-vector decode leg.
cbor_nested_payloads = [
  elem_payloads: bytes .cbor [* bytes .cbor uint],
  value_payloads: bytes .cbor {* uint => bytes .cbor uint},
  after_payload: bytes .cbor uint,
]

; --- the INLINE nested `.cbor` spelling under --preserve-encodings ---
; `bytes .cbor (bytes .cbor T)` puts both depths in ONE encoding chain, so both byte strings are
; framed by the SAME owning member and their sidecar members are told apart only by the depth suffix
; (`pair_bytes_encoding` / `pair_bytes2_encoding`). Undepthed, the struct declared one field twice
; (E0124) and the outer level's final expr read the inner level's `StringEncoding`. This flag is
; where that second half is observable: an irregular encoding on the OUTER byte string only survives
; a round trip if the outer level reads its own encoding var, so the test drives both levels
; independently (each byte-string head sized separately, including indefinite chunking).
; `triple` carries the level-3 case, which is what pins the counter rather than a two-name scheme.
cbor_inline_nested_payloads = [
  pair: bytes .cbor (bytes .cbor uint),
  triple: bytes .cbor (bytes .cbor (bytes .cbor uint)),
  tail: text,
]
