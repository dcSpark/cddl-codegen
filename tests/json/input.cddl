bytes_wrapper = bytes ; @newtype
exact_bytes_wrapper = bytes .size 4 ; @newtype
str_wrapper = text ; @newtype
u8_wrapper = uint .lt 256 ; @newtype
u64_wrapper = uint ; @newtype
i16_wrapper = -32768 .. 32767 ; @newtype
i64_wrapper = -9223372036854775808 .. 9223372036854775807 ; @newtype
int_wrapper = int ; @newtype
nint_wrapper = nint ; @newtype

; TODO: issue: https://github.com/dcSpark/cddl-codegen/issues/223
; bool_wrapper = bool ; @newtype

struct_wrapper = u64_wrapper ; @newtype
custom_wrapper = uint ; @newtype @custom_json
; `@custom_json` in CONTAINED position: a serde/schemars-DERIVED holder whose member is the type
; whose json impls the user owns. The derived holder's `Serialize`/`Deserialize`/`JsonSchema` each
; demand the same trait on `custom_wrapper`, so this member is the compile proof that the hand impls
; the directive promises satisfy the contained flavor too — not just the type's own standalone
; surface. It is the flavor a real consumer always hits (a hand-owned JSON type is written to be
; held), and it holds on all three surfaces this fixture builds: the rust crate, the wasm wrapper's
; to_json/from_json door, and json-gen's schema row.
custom_holder = [c: custom_wrapper]

; NB: float JSON lives in tests/json-float/, whose fixture carries the schema-validation and
; bit-exact-f64 round-trip tests this one has no home for. The split dates from preserve-encodings
; being unable to emit floats at all; it emits them now, so holding a float here is no longer ruled
; out by the json_preserve leg this fixture also runs under
; map-bearing type: BTreeMap (json) / OrderedHashMap (json_preserve) JSON serde/schema emission
table = { * text => uint }
; array-struct holder: a single-field bareword-keyed MAP holder panics generation
; (tests/robustness/single_bareword_map_field.cddl pins that)
table_holder = [t: table]
; WI-1: a `[+ uint]` field exercises the serde/schemars leg — NonEmptyVec serializes as a plain JSON
; array, and JSON deserialize routes through the same TryFrom door (empty array rejected).
nev_json = { xs: [+ uint] }

; WI-2: a `{+ tstr => uint}` field exercises the serde/schemars leg — NonEmptyMap serializes as a
; plain JSON object, and JSON deserialize routes through the same TryFrom door (empty object rejected).
nem_json = { xs: {+ tstr => uint} }

; WI-3: an `@duplicates reject` set field exercises the serde/schemars leg — OrderedSet serializes
; as a plain JSON array, and JSON deserialize routes through the same TryFrom uniqueness door, so a
; duplicate-carrying array is rejected there (never silently deduped). Accept round-trips byte-exactly.
reject_uints    = [* uint] ; @duplicates reject
reject_set_json = { xs: reject_uints }

; WI-4: an `@duplicates preserve` table field exercises the serde/schemars leg — a PairMap serializes
; as a JSON ARRAY of `[k, v]` pairs (NOT an object, which would collapse duplicate keys), preserving
; both order AND duplicates; JSON deserialize reads that array-of-pairs. Both flavors are the same K/V
; shape (both preserve, so no structural-name collision). The `{+ …}` NonEmptyPairMap door refuses an
; empty array on the JSON path (the same min-1 error the CBOR decoder raises for `{+ …}`).
preserve_pmap         = { * uint => tstr } ; @duplicates preserve
preserve_pmap_json    = { xs: preserve_pmap }
ne_preserve_pmap      = { + uint => tstr } ; @duplicates preserve
ne_preserve_pmap_json = { ys: ne_preserve_pmap }

; A bounded preserve table takes the same honest array-of-pairs JSON shape, but its inclusive
; cardinality is enforced by BoundedPairMap at deserialize and published as array minItems/maxItems.
bounded_preserve_pmap      = { 2*3 uint => tstr } ; @duplicates preserve
bounded_preserve_pmap_json = { zs: bounded_preserve_pmap }
