foo = #6.11([uint, text, bytes])

bar = {
	foo: #6.13(foo),
	? derp: uint,
	1 : uint / null,
	? 5: text,
	five: 5,
}

u32 = uint .size 4 ; 4 bytes

table_arr_members = {
	arr: [*u32],
	arr2: [*foo],
	table: { * uint => text },
}

data = { * #6.14(bytes) => { * uint => { * #6.9(uint) => [* #6.18([* text]) ] } } }

deeply_nested = [ data: data ]

string64 = text .size (0..64)

tagged_text = #6.9(text)

string32 = #6.7(text .size (16..32))

type_choice = 0 / "hello world" / uint / text / #6.16([*uint])

plain = (d: #6.13(uint), e: tagged_text)

group_choice = [ 3 // #6.10(2) // foo // 0, x: uint // plain ]

foo_bytes = bytes .cbor foo

; since we don't generate code for definitions like the above (should we if no one refers to it?)
cbor_in_cbor = [foo_bytes, uint_bytes: bytes .cbor uint]

; keys chosen so length-first (RFC 7049 canonical) and bytewise-lexicographic (RFC 8949
; deterministic) ordering DISAGREE: text key "a" encodes to 2 bytes, uint key 256 to 3 bytes, so
; length-first puts "a" first while bytewise would put 256 first (0x19 < 0x61). Every other
; fixture's keys order identically under both rules, so only this type pins WHICH rule
; --canonical-form implements.
mixed_len_keys = {
	256: uint,
	a: uint,
}

; --- lint-provocation shapes for generated_code_clippy_clean ---
; (a) a bounded negative int at a record-FIELD site: its deserialize emits a nint RangeCheck whose
; `found` value comes from `negative_integer_sz()` (already i128, so no widening cast). A regression
; re-adding the no-op `as i128` is clippy::unnecessary_cast — hard-red here. (A wrapper site would
; instead check the stored u64 magnitude with a REAL `as i128`, so it must be a member.)
clippy_neg_bounded = [ neg: nint .ge -100 ]

; (b) a @newtype over a map: the rust `From<map>` impl must construct via `new(inner)` directly,
; with no identity `.clone().into()` (clippy::useless_conversion + a redundant clone of the owned
; last-use param).
clippy_wrapped_map = { * uint => text } ; @newtype

; (c) a c-style enum as a record field: the wasm ctor/getter cross the enum BY VALUE (it is
; `pub use`-re-exported into the wasm crate, so the wasm face IS the rust type), so no identity
; `.into()` may be emitted at the boundary (clippy::useless_conversion).
clippy_enum = 0 / 1 / 2
clippy_enum_record = [ tag: clippy_enum, rest: uint ]

; (d) an intentionally asymmetric choice: this ~30-uint-field record versus a scalar arm crosses
; clippy::large_enum_variant's default threshold.  Generated roots permanently allow that lint
; because boxing either public type would distort the emitted API; the clippy gate asserts this pair
; mints, so that allowance cannot become unexercised policy.  `result_large_err` remains an adjacent
; static-error allowance but this fixture does not claim to cross its input-independent threshold.
clippy_large_record = [
	f00: uint, f01: uint, f02: uint, f03: uint, f04: uint,
	f05: uint, f06: uint, f07: uint, f08: uint, f09: uint,
	f10: uint, f11: uint, f12: uint, f13: uint, f14: uint,
	f15: uint, f16: uint, f17: uint, f18: uint, f19: uint,
	f20: uint, f21: uint, f22: uint, f23: uint, f24: uint,
	f25: uint, f26: uint, f27: uint, f28: uint, f29: uint,
]
clippy_large_choice = clippy_large_record / uint

; A mandatory tag owned by an anonymous enum rule. The canonical test proves the decoded non-minimal
; tag head is retained for ordinary replay but minimized by the canonical serializer.
tagged_anonymous_choice = #6.10(int / tstr)
