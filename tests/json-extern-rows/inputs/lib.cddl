; Content-pin fixture for the json-gen extern schema-row fix (feature request 05). Read in-process
; by `snapshot_tests::json_gen_extern_schema_rows` (no compile) to pin exactly which
; `gen_json_schema!` rows the json-gen crate emits. It combines every class the fix distinguishes:
;   - `ext_set<T>` : generic-extern BASE  -> row SKIPPED (bare `ExtSet` names no concrete type)
;   - `ext_unused<T>`: generic-extern BASE with ZERO instances -> row SKIPPED (the skip must key on
;                      the parse-time generic-extern record, not on instance-derived bases, or a
;                      never-instantiated base leaks an E0107 row)
;   - `my_set`     : concrete instance    -> row KEPT (`cddl_lib::MySet`)
;   - `my_extern`  : plain extern         -> row KEPT (`cddl_lib::MyExtern`)
;   - `dep_thing`/`dep_alias`: dep-owned extern/alias -> rows and transitive claims SKIPPED
;                                            (non-export scope; the dep's own json-gen owns it,
;                                            and this crate's json-gen manifest never depends on
;                                            the dep). `own_table` puts the alias at a generated
;                                            map-key schema-BODY boundary as well as BigThing's
;                                            ordinary subschema field boundary.
;   - `scoped_thing`: in-crate scoped type -> row KEPT with its real module path
;                                            (`cddl_lib::sub::module::ScopedThing`)
; It also pins the `@no_json_schema_export` suppression (the spec author's "this type is not part of
; the published JSON surface" declaration), on BOTH rule kinds the directive must reach:
;   - `quiet_extern` : annotated EXTERN   -> row SKIPPED (its unannotated twin `my_extern` is kept)
;   - `quiet_thing`  : annotated ORDINARY -> row SKIPPED (its unannotated twin `big_thing` is kept)
;   - `quiet_group`  : annotated PLAIN GROUP -> row SKIPPED (its unannotated twin `loud_group` is kept)
; Each annotated rule is paired with an unannotated twin of the SAME shape, so the pin cannot pass by
; suppressing everything. The three shapes are here because they reach the flag by three DIFFERENT
; routes through `parsing.rs`, and a route that is missed is a SILENT drop (the exact failure class
; this directive exists to prevent):
;   - an extern rule's metadata never reaches `RustStructConfig` (`RustStruct::new_extern` builds with
;     `RustStructConfig::default()`), so only the `IntermediateTypes` marker set can carry it;
;   - an ordinary type rule flows through `parse_type` / `parse_type_choices`;
;   - a PLAIN GROUP rule is handled by `parse_rule`'s own `Rule::Group` arm, which never reaches
;     either of those — it needs its own marking site.
my_extern = _CDDL_CODEGEN_EXTERN_TYPE_
quiet_extern = _CDDL_CODEGEN_EXTERN_TYPE_ ; @no_json_schema_export
ext_set<T> = _CDDL_CODEGEN_EXTERN_TYPE_
ext_unused<T> = _CDDL_CODEGEN_EXTERN_TYPE_
my_set = ext_set<uint>
quiet_thing = [q: uint] ; @no_json_schema_export
loud_group = (lg: uint)
quiet_group = (qg: uint) ; @no_json_schema_export
big_thing = [e: my_extern, s: my_set, d: dep_thing, da: dep_alias, sc: scoped_thing, loud_group, quiet_group]
own_table = { * dep_alias => uint }
table_holder = [entries: own_table]
