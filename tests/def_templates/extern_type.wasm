// The wasm face of a `_CDDL_CODEGEN_EXTERN_TYPE_`: a hand-written `#[wasm_bindgen]` wrapper over the
// rust crate's type, re-exported at the wasm crate root the same way the rust definition is.
#[derive(Clone, Debug)]
#[wasm_bindgen]
pub struct __NAME__(cddl_lib::__NAME__);

#[wasm_bindgen]
impl __NAME__ {
    pub fn new(inner: u64) -> Self {
        Self(cddl_lib::__NAME__::new(inner))
    }
}

impl From<cddl_lib::__NAME__> for __NAME__ {
    fn from(native: cddl_lib::__NAME__) -> Self {
        Self(native)
    }
}

impl From<__NAME__> for cddl_lib::__NAME__ {
    fn from(wasm: __NAME__) -> Self {
        wasm.0
    }
}

impl AsRef<cddl_lib::__NAME__> for __NAME__ {
    fn as_ref(&self) -> &cddl_lib::__NAME__ {
        &self.0
    }
}
