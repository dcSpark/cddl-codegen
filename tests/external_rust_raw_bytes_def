// Base flavor — keep in sync with `external_rust_raw_bytes_def_json`, which is identical except
// for the serde/schemars derives the json flags impose on user-supplied types (see
// docs/docs/comment_dsl.mdx, _CDDL_CODEGEN_RAW_BYTES_TYPE_). The wasm def has no flavor: the
// generated wasm json fns delegate through the rust type's serde.
use crate::serialization::RawBytesEncoding;

#[derive(Clone, Debug)]
pub struct PubKey([u8; 32]);

impl RawBytesEncoding for PubKey {
    fn to_raw_bytes(&self) -> &[u8] {
        &self.0
    }

    fn from_raw_bytes(bytes: &[u8]) -> Result<Self, DeserializeError> {
        use std::convert::TryInto;
        bytes
            .try_into()
            .map(PubKey)
            .map_err(|e| DeserializeFailure::InvalidStructure(Box::new(e)).into())
    }
}
