; Custom-serialize CANONICAL end-to-end vectors. Generated under --preserve-encodings
; --canonical-form (canonical implies preserve), which is what puts both key positions below through
; a LOCAL scratch `Serializer`: the canonical passes serialize each key into a `buf` to sort by
; encoded bytes before the real write. A `@custom_serialize` target is a FREE function taking the
; serializer as an ARGUMENT, so those sites must pass `&mut buf` — a method receiver auto-refs, a
; function argument does not. Emitting the bare name there made the crate fail to compile (E0308),
; so this fixture COMPILING is itself the regression pin; the vectors in tests.rs then pin that the
; sort key equals the bytes the write arm actually emits. Every `wire` byte string is hand-written
; from the CBOR grammar.

; --- table position: the canonical key-sort scratch pass ---
; In-memory the key is decoded bytes, on the wire it is lowercase hex TEXT, so both legs of the
; custom pair do real work. Used as a map key inside a struct field.
hexid = bytes ; @custom_serialize write_hex_key @custom_deserialize read_hex_key

table_holder = [
  table: { * hexid => uint },
]

; --- table VALUE position: the same alias in a table's range ---
; A canonical map sorts by its KEYS, so a custom VALUE writer never reaches the scratch-buffer sort
; pass — but it is on the write path, it receives `force_canonical` all the same, and its sidecar is
; keyed by the DECODED KEY rather than by the value it encodes. Pinning the value leg beside the key
; leg keeps one position from regressing while the other stays green.
value_table_holder = [
  table: { * uint => hexid },
]

; --- open struct-map rest row whose key domain alias carries the custom pair ---
; This is the SHIPPED open-struct-map feature's exposure to the same call site: the canonical merge
; that orders rest keys against the declared ones. The declared `"zzz"` key is sized (4 wire bytes)
; so the vectors can place a rest key on each side of it, pinning that the merge interleaves by the
; custom-written bytes under the length-first comparator.
extkey = text ; @custom_serialize write_ext_key @custom_deserialize read_ext_key

open_ext = {
  "zzz": uint,
  * extkey => uint
}

; --- whole-table rule: the nominal wrapper owns a complete non-map codec ---
; This one deliberately replaces the table's map wire with an alternating array. It is the table
; RULE counterpart to the key/value aliases above: the custom pair takes the wrapper itself and,
; under canonical mode, must receive force_canonical from both direct and embedded trait paths.
custom_table = { * text => uint } ; @custom_serialize write_custom_table @custom_deserialize read_custom_table
custom_table_holder = [ table: custom_table ]
