; The phase-1 component fixture: one shape per WIT type-mapping row the projection supports, and
; nothing else. Type and group choices are deliberately ABSENT — they are excluded-and-recorded
; until phase 2, and a fixture carrying them would test the exclusion path rather than the mapping.

; a bounded newtype wrapper -> `resource hash` with a FALLIBLE constructor
hash = bytes .size 32

; a c-style enum -> a WIT `enum` VALUE type
color = 0 / 1 / 2

; a collection-mediated recursive type: the only recursion spelling the generator produces working
; rust for, and the shape WIT's resource handles exist to carry
node = [
  label: text,
  children: [* node],
]

; a NonEmpty list: type-enforced in rust, despecialized to a plain `list<string>` in WIT, so the
; constraint moves to the consuming constructor/setter
names = [+ text]

; a table -> `list<tuple<string, u64>>`, never `map<K, V>`
attrs = { * text => uint }

; a NonEmpty TABLE: the map twin of `names`. It despecializes to the SAME `list<tuple<…>>` a plain
; table becomes, so its non-emptiness is re-checked at the consuming constructor — which reaches the
; invariant through the runtime's vec-of-pairs door rather than by staging a map first
counts = {+ text => uint}

; a record: mandatory + optional fields, every primitive row, and one field per container row.
; `limit` is a VALUE-bounded mandatory field, which is what makes the rust `Record::new` itself
; fallible — a second, independent reason from the despecialized collections above, and the one the
; guest constructor has to unwrap rather than wrap
record = {
  id: uint,
  name: text,
  digest: hash,
  delta: int,
  limit: uint .le 5,
  tags: names,
  props: attrs,
  totals: counts,
  kind: color,
  root: node,
  meta: any,
  ? note: text,
}
