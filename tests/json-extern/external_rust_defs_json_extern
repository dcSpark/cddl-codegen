// User-supplied definitions for the `json-extern` fixture's extern types, exercising the
// `--json-schema-export` extern contract: whenever the json flags are on, a hand-written extern must
// additionally implement `serde::Serialize`/`serde::Deserialize` (under `--json-serde-derives`) and
// `schemars::JsonSchema`. `MyExtern` is a plain extern; `ExtSet<T>` a generic extern instantiated as
// `MySet = ExtSet<u64>`. The generic BASE gets no schema row (uncompilable bare name); the concrete
// instance and the plain extern do, and they compile because of the JsonSchema impls below.

#[derive(Clone, Debug, serde::Serialize, serde::Deserialize, schemars::JsonSchema)]
pub struct MyExtern {
    pub value: u64,
}

impl MyExtern {
    pub fn new(value: u64) -> Self {
        Self { value }
    }
}

impl cbor_event::se::Serialize for MyExtern {
    fn serialize<'se>(
        &self,
        serializer: &'se mut cbor_event::se::Serializer,
    ) -> cbor_event::Result<&'se mut cbor_event::se::Serializer> {
        serializer.write_unsigned_integer(self.value)
    }
}

impl serialization::Deserialize for MyExtern {
    fn deserialize(
        raw: &mut cbor_event::de::Deserializer,
    ) -> Result<Self, error::DeserializeError> {
        Ok(Self {
            value: raw.unsigned_integer()?,
        })
    }
}

// `no_schema_extern` (`@no_json_schema_export`): serialization impls and serde derives, but
// deliberately NO `schemars::JsonSchema` impl — its published JSON encoding is produced by
// `HandJsonParent`'s hand-written impl, so a derived schema for it would be a contradictory
// artifact. The directive is what keeps the json-gen crate free of a `gen_json_schema!` row that
// would be an `E0277` here. Do not add a `JsonSchema` impl: its absence IS the assertion.
// The ordering/hashing derives are the extern side of the rest-row KEY demand (`no_schema_key_rest`
// keys a `BTreeMap` with this type) — the same contract `extern_interface_check.rs` states.
#[derive(
    Clone, Debug, serde::Serialize, serde::Deserialize, PartialEq, Eq, PartialOrd, Ord, Hash,
)]
pub struct NoSchemaExtern {
    pub value: u64,
}

impl NoSchemaExtern {
    pub fn new(value: u64) -> Self {
        Self { value }
    }
}

impl cbor_event::se::Serialize for NoSchemaExtern {
    fn serialize<'se>(
        &self,
        serializer: &'se mut cbor_event::se::Serializer,
    ) -> cbor_event::Result<&'se mut cbor_event::se::Serializer> {
        serializer.write_unsigned_integer(self.value)
    }
}

impl serialization::Deserialize for NoSchemaExtern {
    fn deserialize(
        raw: &mut cbor_event::de::Deserializer,
    ) -> Result<Self, error::DeserializeError> {
        Ok(Self {
            value: raw.unsigned_integer()?,
        })
    }
}

#[derive(Clone, Debug, serde::Serialize, serde::Deserialize, schemars::JsonSchema)]
pub struct ExtSet<T>(pub Vec<T>);

impl<T> ExtSet<T> {
    pub fn new(elems: Vec<T>) -> Self {
        Self(elems)
    }
}

impl<T: cbor_event::se::Serialize> cbor_event::se::Serialize for ExtSet<T> {
    fn serialize<'se>(
        &self,
        serializer: &'se mut cbor_event::se::Serializer,
    ) -> cbor_event::Result<&'se mut cbor_event::se::Serializer> {
        serializer.write_array(cbor_event::Len::Len(self.0.len() as u64))?;
        for elem in &self.0 {
            elem.serialize(serializer)?;
        }
        Ok(serializer)
    }
}

impl<T: serialization::Deserialize> serialization::Deserialize for ExtSet<T> {
    fn deserialize(
        raw: &mut cbor_event::de::Deserializer,
    ) -> Result<Self, error::DeserializeError> {
        let mut elems = Vec::new();
        let len = raw.array()?;
        while match len {
            cbor_event::Len::Len(n) => (elems.len() as u64) < n,
            cbor_event::Len::Indefinite => true,
        } {
            if let cbor_event::Len::Indefinite = len {
                if raw.cbor_type()? == cbor_event::Type::Special {
                    assert_eq!(raw.special()?, cbor_event::Special::Break);
                    break;
                }
            }
            elems.push(T::deserialize(raw)?);
        }
        Ok(Self(elems))
    }
}

// `--json-schema-root` (extra JSON-schema root): a published type described by NO CDDL rule at all.
// This is the real shape of the ask — hand-written machinery whose JSON form is API while its bytes
// are not a CDDL rule — so it deliberately has NO cbor_event/Deserialize impls and is reachable from
// the generated code by nothing. Its only route into the schema document is the flag's registration
// row, which `run_test` asserts landed in `$defs`. Do not add a CDDL rule for it: its absence from
// the spec IS the assertion.
#[derive(Clone, Debug, serde::Serialize, serde::Deserialize, schemars::JsonSchema)]
pub struct HandWrittenJsonRoot {
    pub label: String,
}

// The encoded-`$ref` vector (see `encoded_name` in input.cddl). Do NOT simplify this name. It covers
// the three escape classes the emitted closure check's decode must handle — `<`/`>` (percent), `/`
// (`~1`), `~` (`~0`) — and, through the LITERAL `~1` in `~1name`, the decode's ORDER. A decode that
// gets any class wrong, or that unescapes `~0` before `~1`, reports this document's own reference as
// dangling and fails the json-gen run.
#[derive(Clone, Debug, serde::Serialize, serde::Deserialize)]
pub struct EncodedName {
    pub value: u64,
}

impl EncodedName {
    pub fn new(value: u64) -> Self {
        Self { value }
    }
}

impl schemars::JsonSchema for EncodedName {
    fn schema_name() -> std::borrow::Cow<'static, str> {
        std::borrow::Cow::Borrowed("Odd<K>/~1name")
    }

    fn json_schema(generator: &mut schemars::SchemaGenerator) -> schemars::Schema {
        <u64 as schemars::JsonSchema>::json_schema(generator)
    }
}

impl cbor_event::se::Serialize for EncodedName {
    fn serialize<'se>(
        &self,
        serializer: &'se mut cbor_event::se::Serializer,
