; Each zero-permitting marker on a unique fixed map key has the same meaningful
; cardinality as `?`: absent or one. The distinct spellings keep that normalization
; from becoming an accidental parser-only rule; `fixed` also reaches the fixed-value
; presence-bool path.
zero_permitting_map = {
  required: uint,
  * zero_star: uint,
  0*1 zero_bounded: tstr,
  *2 max_only: bool,
  * fixed: 5
}

; Exact zero is a key constraint, never an optional value field.
zero_exact_closed = { required: uint, 0*0 forbidden: uint }
zero_exact_open = { required: uint, 0*0 forbidden: uint, * tstr => uint }
zero_exact_non_empty_open = { required: uint, 0*0 forbidden: uint, + tstr => uint }
zero_exact_loose_pair_open = {
  required: uint,
  0*0 forbidden: uint,
  * tstr => uint ; @duplicates preserve
}
rest_key = uint / tstr
zero_exact_typed_open = { required: uint, 0*0 forbidden: uint, * rest_key => uint }
zero_exact_any_open = { required: uint, 0*0 forbidden: uint, * any => uint }
zero_exact_ignore = {
  required: uint,
  0*0 forbidden: uint,
  * tstr => uint ; @ignore
}
zero_exact_bounded_open = { required: uint, 0*0 forbidden: uint, 1*2 tstr => uint }
zero_exact_pair_open = {
  required: uint,
  0*0 forbidden: uint,
  1*2 tstr => uint ; @duplicates preserve
}

; The wasm fixture executes parent-owned insertion for both loose carrier policies. `rest()` stays
; a detached snapshot; `insert_rest` is the record mutation door.
wasm_mutation_open = { required: uint, * tstr => uint }
wasm_mutation_pair_open = {
  required: uint,
  * tstr => uint ; @duplicates preserve
}
wasm_protected_any = { 1: uint, * any => uint }
wasm_protected_pair = {
  1: uint,
  * uint => uint ; @duplicates preserve
}
declared_bounded = { 1: uint, 1*2 uint => uint }
zero_exact_named_multi = {
  required: uint,
  0*0 41: uint, ; @name no_uint
  0*0 original_text: uint ; @name no_text
}
