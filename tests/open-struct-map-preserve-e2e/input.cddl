; Open struct-map (loose CBOR "rest row") PRESERVE fidelity end-to-end vectors.
; Generated under --preserve-encodings --canonical-form (canonical implies preserve): the same crate
; exercises byte-exact round-trip (to_cbor_bytes, force_canonical=false) AND the runtime canonical
; key merge (to_canonical_cbor_bytes). See tests.rs. Every `wire` byte string is hand-written from
; the CBOR grammar.
open_any = { 1: uint, ? 2: text, * any => any }   ; self-carried any key + value
uint_any = { 3: uint, * uint => any }             ; concrete uint key (sidecar) + self-carried value
concrete = { 4: uint, * uint => text }            ; concrete key AND value (both sidecars)
div_open = { 24: uint, * uint => any }            ; codegen<->runtime canonical merge (24 vs rest 10)
div_closed = { 10: uint, 24: uint }               ; closed twin: baked canonical order 10-before-24
dup_pair = {
  9: uint,
  * uint => any ; @duplicates preserve
}
dup_pair_concrete = {
  5: uint,
  * uint => text ; @duplicates preserve
}
; The composition the rules above each cover only half of: the `any` KEY domain crossed with
; `@duplicates preserve` on the rest row. `dup_pair`/`dup_pair_concrete` pair `preserve` with a
; CONCRETE uint key domain (whose container Eq is value equality); `open_any` pairs the `any` key
; domain with the default REJECT. Only here does an entry key of arbitrary CBOR type — a float, a
; composite — land in a PairMap<AnyCbor, AnyCbor> that must keep duplicates and their wire order.
; The declared key is text rather than uint so the canonical merge must also order a text key
; against arbitrary rest keys. Vectors in tests.rs.
dup_any_rest = {
  name : text,
  * any => any ; @duplicates preserve
}
