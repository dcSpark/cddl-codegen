use super::cbor_encodings::*;
use super::*;
use crate::generated::error::*;
use cbor_event::de::Deserializer;
use cbor_event::se::{Serialize, Serializer};
use std::io::{BufRead, Seek, SeekFrom, Write};

impl cbor_event::se::Serialize for SizedText {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_text_sz(
            &self.inner,
            self.encodings
                .as_ref()
                .map(|encs| encs.inner_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(self.inner.len() as u64),
        )
    }
}

impl Deserialize for SizedText {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let (inner, inner_encoding) = raw
                .text_sz()
                .map(|(s, enc)| (s, StringEncoding::from(enc)))?;
            if inner.len() < 1 || inner.len() > 16 {
                return Err(DeserializeFailure::RangeCheck {
                    found: inner.len() as isize,
                    min: Some(1),
                    max: Some(16),
                }
                .into());
            }
            Ok(Self {
                inner,
                encodings: Some(SizedTextEncoding { inner_encoding }),
            })
        })()
        .map_err(|e| e.annotate("SizedText"))
    }
}
