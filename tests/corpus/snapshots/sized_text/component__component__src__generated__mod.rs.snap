// This file was code-generated using an experimental CDDL to rust tool:
// https://github.com/dcSpark/cddl-codegen

use core::cell::RefCell;

wit_bindgen::generate!({
    path: "wit",
    world: "cddl-lib-world",
});

use exports::cddl::cddl_lib::types as wit_types;

struct Component;

impl wit_types::Guest for Component {
    type SizedText = WitSizedText;
}

export!(Component);

/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitSizedText(pub RefCell<cddl_lib::SizedText>);

impl wit_types::GuestSizedText for WitSizedText {
    fn new(inner: String) -> Result<Self, String> {
        let inner = cddl_lib::SizedText::new(inner).map_err(err)?;
        Ok(WitSizedText(RefCell::new(inner)))
    }

    fn get(&self) -> String {
        let me = self.0.borrow();
        let inner = me.get().clone();
        inner.clone()
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::SizedText as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::SizedText, String> {
        <cddl_lib::SizedText as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::SizedText::new(WitSizedText(RefCell::new(v))))
            .map_err(err)
    }
}
