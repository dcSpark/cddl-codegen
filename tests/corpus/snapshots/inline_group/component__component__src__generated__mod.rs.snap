// This file was code-generated using an experimental CDDL to rust tool:
// https://github.com/dcSpark/cddl-codegen

use core::cell::RefCell;

wit_bindgen::generate!({
    path: "wit",
    world: "cddl-lib-world",
});

use exports::cddl::cddl_lib::types as wit_types;

struct Component;

impl wit_types::Guest for Component {
    type InlineGroup = WitInlineGroup;
}

export!(Component);

/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitInlineGroup(pub RefCell<cddl_lib::InlineGroup>);

impl wit_types::GuestInlineGroup for WitInlineGroup {
    fn new(index0: u64, index1: String) -> Self {
        let inner = cddl_lib::InlineGroup::new(index0, index1);
        WitInlineGroup(RefCell::new(inner))
    }

    fn index0(&self) -> u64 {
        let me = self.0.borrow();
        me.index_0
    }

    fn index1(&self) -> String {
        let me = self.0.borrow();
        me.index_1.clone()
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::InlineGroup as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::InlineGroup, String> {
        <cddl_lib::InlineGroup as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::InlineGroup::new(WitInlineGroup(RefCell::new(v))))
            .map_err(err)
    }
}
