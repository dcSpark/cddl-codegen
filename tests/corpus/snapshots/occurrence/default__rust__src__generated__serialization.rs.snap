                        cbor_event::Len::Len(n) => (nested_bounded_elem_arr.len() as u64) < n,
                        cbor_event::Len::Indefinite => true,
                    } {
                        if matches!(len, cbor_event::Len::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        nested_bounded_elem_arr.push(raw.unsigned_integer()?);
                    }
                    let nested_bounded_elem_arr =
                        BoundedVec::<_, 0, 2>::try_from(nested_bounded_elem_arr)?;
                    nested_bounded_arr.push(nested_bounded_elem_arr);
                }
                let nested_bounded_arr = BoundedVec::<_, 2, 3>::try_from(nested_bounded_arr)?;
                Ok(nested_bounded_arr)
            })()
            .map_err(|e| e.annotate("nested_bounded"))?;
            let inline_bounded = (|| -> Result<_, DeserializeError> {
                let mut inline_bounded_arr = Vec::new();
                let len = raw.array()?;
                while match len {
                    cbor_event::Len::Len(n) => (inline_bounded_arr.len() as u64) < n,
                    cbor_event::Len::Indefinite => true,
                } {
                    if matches!(len, cbor_event::Len::Indefinite)
                        && raw.cbor_type()? == cbor_event::Type::Special
                        && raw.special_break()?
                    {
                        break;
                    }
                    inline_bounded_arr.push(raw.text()?);
                }
                let inline_bounded_arr = BoundedVec::<_, 1, 3>::try_from(inline_bounded_arr)?;
                Ok(inline_bounded_arr)
            })()
            .map_err(|e| e.annotate("inline_bounded"))?;
            let inline_upper = (|| -> Result<_, DeserializeError> {
                let mut inline_upper_arr = Vec::new();
                let len = raw.array()?;
                while match len {
                    cbor_event::Len::Len(n) => (inline_upper_arr.len() as u64) < n,
                    cbor_event::Len::Indefinite => true,
                } {
                    if matches!(len, cbor_event::Len::Indefinite)
                        && raw.cbor_type()? == cbor_event::Type::Special
                        && raw.special_break()?
                    {
                        break;
                    }
                    inline_upper_arr.push(raw.unsigned_integer()?);
                }
                let inline_upper_arr = BoundedVec::<_, 0, 5>::try_from(inline_upper_arr)?;
                Ok(inline_upper_arr)
            })()
            .map_err(|e| e.annotate("inline_upper"))?;
            let inline_lower = (|| -> Result<_, DeserializeError> {
                let mut inline_lower_arr = Vec::new();
                let len = raw.array()?;
                while match len {
                    cbor_event::Len::Len(n) => (inline_lower_arr.len() as u64) < n,
                    cbor_event::Len::Indefinite => true,
                } {
                    if matches!(len, cbor_event::Len::Indefinite)
                        && raw.cbor_type()? == cbor_event::Type::Special
                        && raw.special_break()?
                    {
                        break;
                    }
                    inline_lower_arr.push(raw.unsigned_integer()?);
                }
                let inline_lower_arr =
                    BoundedVec::<_, 2, { u64::MAX }>::try_from(inline_lower_arr)?;
                Ok(inline_lower_arr)
            })()
            .map_err(|e| e.annotate("inline_lower"))?;
            let inline_maybe = (|| -> Result<_, DeserializeError> {
                let mut inline_maybe_arr = Vec::new();
                let len = raw.array()?;
                while match len {
                    cbor_event::Len::Len(n) => (inline_maybe_arr.len() as u64) < n,
                    cbor_event::Len::Indefinite => true,
                } {
                    if matches!(len, cbor_event::Len::Indefinite)
                        && raw.cbor_type()? == cbor_event::Type::Special
                        && raw.special_break()?
                    {
                        break;
                    }
                    inline_maybe_arr.push(raw.unsigned_integer()?);
                }
                let inline_maybe_arr = BoundedVec::<_, 0, 1>::try_from(inline_maybe_arr)?;
                Ok(inline_maybe_arr)
            })()
            .map_err(|e| e.annotate("inline_maybe"))?;
            let inline_exact = (|| -> Result<_, DeserializeError> {
                let mut inline_exact_arr = Vec::new();
                let len = raw.array()?;
                while match len {
                    cbor_event::Len::Len(n) => (inline_exact_arr.len() as u64) < n,
                    cbor_event::Len::Indefinite => true,
                } {
                    if matches!(len, cbor_event::Len::Indefinite)
                        && raw.cbor_type()? == cbor_event::Type::Special
                        && raw.special_break()?
                    {
                        break;
                    }
                    inline_exact_arr.push(raw.unsigned_integer()?);
                }
                let inline_exact_arr: [_; 2] =
                    inline_exact_arr.try_into().map_err(|elements: Vec<_>| {
                        DeserializeFailure::RangeCheck {
                            found: elements.len() as i128,
                            min: Some(2),
                            max: Some(2),
                        }
                    })?;
                Ok(inline_exact_arr)
            })()
            .map_err(|e| e.annotate("inline_exact"))?;
            match len {
                cbor_event::Len::Len(_) => (),
                cbor_event::Len::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(OccurrenceHolder {
                o,
                b,
                upper,
                lower,
                maybe,
                exact,
                nested,
                nested_bounded,
                inline_bounded,
                inline_upper,
                inline_lower,
                inline_maybe,
                inline_exact,
            })
        })()
        .map_err(|e| e.annotate("OccurrenceHolder"))
    }
}

impl cbor_event::se::Serialize for OptionalSegmentOccurrence {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array(cbor_event::Len::Len(
            1 + match &self.label {
                Some(_) => 1,
                None => 0,
            } + self.numbers.len() as u64,
        ))?;
        for element in self.numbers.iter() {
            serializer.write_unsigned_integer(*element)?;
        }
        if let Some(field) = &self.label {
            serializer.write_text(field)?;
        }
        serializer.write_tag(10u64)?;
        serializer.write_unsigned_integer(self.suffix)?;
        Ok(serializer)
    }
}

impl Deserialize for OptionalSegmentOccurrence {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.array()?;
            let mut read_len = CBORReadLen::from(len);
            read_len.read_elems(1)?;
            let mut numbers = Vec::new();
            while (match len {
                cbor_event::Len::Len(n) => read_len.read() < n,
                cbor_event::Len::Indefinite => raw.as_slice().first() != Some(&0xff),
            }) && raw.cbor_type()? == cbor_event::Type::UnsignedInteger
            {
                read_len.read_elems(1)?;
                let numbers_elem = raw.unsigned_integer()?;
                numbers.push(numbers_elem);
            }
            let label = if raw
                .cbor_type()
                .map(|ty| ty == cbor_event::Type::Text)
                .unwrap_or(false)
            {
                (|| -> Result<_, DeserializeError> {
                    read_len.read_elems(1)?;
                    Ok(raw.text()?)
                })()
                .map_err(|e| e.annotate("label"))
                .map(Some)
            } else {
                Ok(None)
            }?;
            let suffix = (|| -> Result<_, DeserializeError> {
                match raw.tag()? {
                    10 => Ok(raw.unsigned_integer()?),
                    tag => Err(DeserializeFailure::TagMismatch {
                        found: tag,
                        expected: 10,
                    }
                    .into()),
                }
            })()
            .map_err(|e| e.annotate("suffix"))?;
            match len {
                cbor_event::Len::Len(_) => read_len.finish()?,
                cbor_event::Len::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => read_len.finish()?,
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(OptionalSegmentOccurrence {
                numbers,
                label,
                suffix,
            })
        })()
        .map_err(|e| e.annotate("OptionalSegmentOccurrence"))
    }
}
