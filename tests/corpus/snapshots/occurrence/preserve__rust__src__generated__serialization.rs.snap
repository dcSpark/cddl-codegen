                        exact_elem_encodings.push(exact_elem_encoding);
                    }
                    let exact_arr: [_; 2] = exact_arr.try_into().map_err(|elements: Vec<_>| {
                        DeserializeFailure::RangeCheck {
                            found: elements.len() as i128,
                            min: Some(2),
                            max: Some(2),
                        }
