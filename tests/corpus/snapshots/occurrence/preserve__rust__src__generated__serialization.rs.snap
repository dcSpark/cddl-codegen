                    let mut maybe_arr = Vec::new();
                    let len = raw.array_sz()?;
                    let maybe_encoding = len.into();
                    let mut maybe_elem_encodings = Vec::new();
                    while match len {
                        cbor_event::LenSz::Len(n, _) => (maybe_arr.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(len, cbor_event::LenSz::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        let (maybe_elem, maybe_elem_encoding) =
                            raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                        maybe_arr.push(maybe_elem);
                        maybe_elem_encodings.push(maybe_elem_encoding);
                    }
                    let maybe_arr = BoundedVec::<_, 0, 1>::try_from(maybe_arr)?;
                    Ok((maybe_arr, maybe_encoding, maybe_elem_encodings))
                })()
                .map_err(|e| e.annotate("maybe"))?;
            let (exact, exact_encoding, exact_elem_encodings) =
                (|| -> Result<_, DeserializeError> {
                    let mut exact_arr = Vec::new();
                    let len = raw.array_sz()?;
                    let exact_encoding = len.into();
                    let mut exact_elem_encodings = Vec::new();
