                        && raw.special_break()?
                    {
                        break;
                    }
                    let (b_elem, b_elem_encoding) =
                        raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                    b_arr.push(b_elem);
                    b_elem_encodings.push(b_elem_encoding);
                }
                let b_arr = BoundedVec::<_, 2, 5>::try_from(b_arr)?;
                Ok((b_arr, b_encoding, b_elem_encodings))
            })()
            .map_err(|e| e.annotate("b"))?;
            let (upper, upper_encoding, upper_elem_encodings) =
                (|| -> Result<_, DeserializeError> {
                    let mut upper_arr = Vec::new();
                    let len = raw.array_sz()?;
                    let upper_encoding = len.into();
                    let mut upper_elem_encodings = Vec::new();
                    while match len {
                        cbor_event::LenSz::Len(n, _) => (upper_arr.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(len, cbor_event::LenSz::Indefinite)
