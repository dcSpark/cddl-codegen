                                raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                            nested_elem_arr.push(nested_elem_elem);
                            nested_elem_elem_encodings.push(nested_elem_elem_encoding);
                        }
                        let nested_elem_arr = BoundedVec::<_, 0, 2>::try_from(nested_elem_arr)?;
                        let (nested_elem, nested_elem_encoding, nested_elem_elem_encodings) = (
                            nested_elem_arr,
                            nested_elem_encoding,
                            nested_elem_elem_encodings,
                        );
                        nested_arr.push(nested_elem);
                        nested_elem_encodings
                            .push((nested_elem_encoding, nested_elem_elem_encodings));
                    }
                    Ok((nested_arr, nested_encoding, nested_elem_encodings))
                })()
                .map_err(|e| e.annotate("nested"))?;
            let (nested_bounded, nested_bounded_encoding, nested_bounded_elem_encodings) =
                (|| -> Result<_, DeserializeError> {
                    let mut nested_bounded_arr = Vec::new();
                    let len = raw.array_sz()?;
                    let nested_bounded_encoding = len.into();
                    let mut nested_bounded_elem_encodings = Vec::new();
                    while match len {
                        cbor_event::LenSz::Len(n, _) => (nested_bounded_arr.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(len, cbor_event::LenSz::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        let mut nested_bounded_elem_arr = Vec::new();
                        let len = raw.array_sz()?;
                        let nested_bounded_elem_encoding = len.into();
                        let mut nested_bounded_elem_elem_encodings = Vec::new();
                        while match len {
                            cbor_event::LenSz::Len(n, _) => {
                                (nested_bounded_elem_arr.len() as u64) < n
                            }
                            cbor_event::LenSz::Indefinite => true,
                        } {
                            if matches!(len, cbor_event::LenSz::Indefinite)
                                && raw.cbor_type()? == cbor_event::Type::Special
                                && raw.special_break()?
                            {
                                break;
                            }
                            let (nested_bounded_elem_elem, nested_bounded_elem_elem_encoding) =
                                raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                            nested_bounded_elem_arr.push(nested_bounded_elem_elem);
                            nested_bounded_elem_elem_encodings
                                .push(nested_bounded_elem_elem_encoding);
                        }
                        let nested_bounded_elem_arr =
                            BoundedVec::<_, 0, 2>::try_from(nested_bounded_elem_arr)?;
                        let (
                            nested_bounded_elem,
                            nested_bounded_elem_encoding,
                            nested_bounded_elem_elem_encodings,
                        ) = (
                            nested_bounded_elem_arr,
                            nested_bounded_elem_encoding,
                            nested_bounded_elem_elem_encodings,
                        );
                        nested_bounded_arr.push(nested_bounded_elem);
                        nested_bounded_elem_encodings.push((
                            nested_bounded_elem_encoding,
                            nested_bounded_elem_elem_encodings,
                        ));
                    }
                    let nested_bounded_arr = BoundedVec::<_, 2, 3>::try_from(nested_bounded_arr)?;
                    Ok((
                        nested_bounded_arr,
                        nested_bounded_encoding,
                        nested_bounded_elem_encodings,
                    ))
                })()
                .map_err(|e| e.annotate("nested_bounded"))?;
            let (inline_bounded, inline_bounded_encoding, inline_bounded_elem_encodings) =
                (|| -> Result<_, DeserializeError> {
                    let mut inline_bounded_arr = Vec::new();
                    let len = raw.array_sz()?;
                    let inline_bounded_encoding = len.into();
                    let mut inline_bounded_elem_encodings = Vec::new();
                    while match len {
                        cbor_event::LenSz::Len(n, _) => (inline_bounded_arr.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(len, cbor_event::LenSz::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        let (inline_bounded_elem, inline_bounded_elem_encoding) = raw
                            .text_sz()
                            .map(|(s, enc)| (s, StringEncoding::from(enc)))?;
                        inline_bounded_arr.push(inline_bounded_elem);
                        inline_bounded_elem_encodings.push(inline_bounded_elem_encoding);
                    }
                    let inline_bounded_arr = BoundedVec::<_, 1, 3>::try_from(inline_bounded_arr)?;
                    Ok((
                        inline_bounded_arr,
                        inline_bounded_encoding,
                        inline_bounded_elem_encodings,
                    ))
                })()
                .map_err(|e| e.annotate("inline_bounded"))?;
            let (inline_upper, inline_upper_encoding, inline_upper_elem_encodings) =
                (|| -> Result<_, DeserializeError> {
                    let mut inline_upper_arr = Vec::new();
                    let len = raw.array_sz()?;
                    let inline_upper_encoding = len.into();
                    let mut inline_upper_elem_encodings = Vec::new();
                    while match len {
                        cbor_event::LenSz::Len(n, _) => (inline_upper_arr.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(len, cbor_event::LenSz::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        let (inline_upper_elem, inline_upper_elem_encoding) =
                            raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                        inline_upper_arr.push(inline_upper_elem);
                        inline_upper_elem_encodings.push(inline_upper_elem_encoding);
                    }
                    let inline_upper_arr = BoundedVec::<_, 0, 5>::try_from(inline_upper_arr)?;
                    Ok((
                        inline_upper_arr,
                        inline_upper_encoding,
                        inline_upper_elem_encodings,
                    ))
                })()
                .map_err(|e| e.annotate("inline_upper"))?;
            let (inline_lower, inline_lower_encoding, inline_lower_elem_encodings) =
                (|| -> Result<_, DeserializeError> {
                    let mut inline_lower_arr = Vec::new();
                    let len = raw.array_sz()?;
                    let inline_lower_encoding = len.into();
                    let mut inline_lower_elem_encodings = Vec::new();
                    while match len {
                        cbor_event::LenSz::Len(n, _) => (inline_lower_arr.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(len, cbor_event::LenSz::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        let (inline_lower_elem, inline_lower_elem_encoding) =
                            raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                        inline_lower_arr.push(inline_lower_elem);
                        inline_lower_elem_encodings.push(inline_lower_elem_encoding);
                    }
                    let inline_lower_arr =
                        BoundedVec::<_, 2, { u64::MAX }>::try_from(inline_lower_arr)?;
                    Ok((
                        inline_lower_arr,
                        inline_lower_encoding,
                        inline_lower_elem_encodings,
                    ))
                })()
                .map_err(|e| e.annotate("inline_lower"))?;
            let (inline_maybe, inline_maybe_encoding, inline_maybe_elem_encodings) =
                (|| -> Result<_, DeserializeError> {
                    let mut inline_maybe_arr = Vec::new();
                    let len = raw.array_sz()?;
                    let inline_maybe_encoding = len.into();
                    let mut inline_maybe_elem_encodings = Vec::new();
                    while match len {
                        cbor_event::LenSz::Len(n, _) => (inline_maybe_arr.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(len, cbor_event::LenSz::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        let (inline_maybe_elem, inline_maybe_elem_encoding) =
                            raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                        inline_maybe_arr.push(inline_maybe_elem);
                        inline_maybe_elem_encodings.push(inline_maybe_elem_encoding);
                    }
                    let inline_maybe_arr = BoundedVec::<_, 0, 1>::try_from(inline_maybe_arr)?;
                    Ok((
                        inline_maybe_arr,
                        inline_maybe_encoding,
                        inline_maybe_elem_encodings,
                    ))
                })()
                .map_err(|e| e.annotate("inline_maybe"))?;
            let (inline_exact, inline_exact_encoding, inline_exact_elem_encodings) =
                (|| -> Result<_, DeserializeError> {
                    let mut inline_exact_arr = Vec::new();
                    let len = raw.array_sz()?;
                    let inline_exact_encoding = len.into();
                    let mut inline_exact_elem_encodings = Vec::new();
                    while match len {
                        cbor_event::LenSz::Len(n, _) => (inline_exact_arr.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(len, cbor_event::LenSz::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        let (inline_exact_elem, inline_exact_elem_encoding) =
                            raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                        inline_exact_arr.push(inline_exact_elem);
                        inline_exact_elem_encodings.push(inline_exact_elem_encoding);
                    }
                    let inline_exact_arr = BoundedVec::<_, 2, 2>::try_from(inline_exact_arr)?;
                    Ok((
                        inline_exact_arr,
                        inline_exact_encoding,
                        inline_exact_elem_encodings,
                    ))
                })()
                .map_err(|e| e.annotate("inline_exact"))?;
            match len {
                cbor_event::LenSz::Len(_, _) => (),
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(OccurrenceHolder {
                o,
                b,
                upper,
                lower,
                maybe,
                exact,
                nested,
                nested_bounded,
                inline_bounded,
                inline_upper,
                inline_lower,
                inline_maybe,
                inline_exact,
                encodings: Some(OccurrenceHolderEncoding {
                    len_encoding,
                    o_encoding,
                    o_elem_encodings,
                    b_encoding,
                    b_elem_encodings,
                    upper_encoding,
                    upper_elem_encodings,
                    lower_encoding,
                    lower_elem_encodings,
                    maybe_encoding,
                    maybe_elem_encodings,
                    exact_encoding,
                    exact_elem_encodings,
                    nested_encoding,
                    nested_elem_encodings,
                    nested_bounded_encoding,
                    nested_bounded_elem_encodings,
                    inline_bounded_encoding,
                    inline_bounded_elem_encodings,
                    inline_upper_encoding,
                    inline_upper_elem_encodings,
                    inline_lower_encoding,
                    inline_lower_elem_encodings,
                    inline_maybe_encoding,
                    inline_maybe_elem_encodings,
                    inline_exact_encoding,
                    inline_exact_elem_encodings,
                }),
            })
        })()
        .map_err(|e| e.annotate("OccurrenceHolder"))
    }
}
