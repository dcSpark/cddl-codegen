impl cbor_event::se::Serialize for MiddleOccurrence {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(2 + self.rest.len() as u64),
        )?;
        serializer.write_unsigned_integer_sz(
            self.prefix,
            fit_sz(
                self.prefix,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.prefix_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        for (i, element) in self.rest.iter().enumerate() {
            let rest_elem_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.rest_elem_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer.write_bytes_sz(
                element,
                rest_elem_encoding.to_str_len_sz(element.len() as u64),
            )?;
        }
        serializer.write_text_sz(
            &self.suffix,
            self.encodings
                .as_ref()
                .map(|encs| encs.suffix_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(self.suffix.len() as u64),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

