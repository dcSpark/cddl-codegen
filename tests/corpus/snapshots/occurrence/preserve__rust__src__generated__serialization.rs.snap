                .map_err(|e| e.annotate("upper"))?;
            let (lower, lower_encoding, lower_elem_encodings) =
                (|| -> Result<_, DeserializeError> {
                    let mut lower_arr = Vec::new();
                    let len = raw.array_sz()?;
                    let lower_encoding = len.into();
                    let mut lower_elem_encodings = Vec::new();
                    while match len {
                        cbor_event::LenSz::Len(n, _) => (lower_arr.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(len, cbor_event::LenSz::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        let (lower_elem, lower_elem_encoding) =
                            raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                        lower_arr.push(lower_elem);
                        lower_elem_encodings.push(lower_elem_encoding);
                    }
                    let lower_arr = BoundedVec::<_, 2, { u64::MAX }>::try_from(lower_arr)?;
                    Ok((lower_arr, lower_encoding, lower_elem_encodings))
                })()
                .map_err(|e| e.annotate("lower"))?;
            let (maybe, maybe_encoding, maybe_elem_encodings) =
