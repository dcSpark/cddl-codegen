            .as_ref()
            .map(|encs| encs.o_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.b_encoding)
                .unwrap_or_default()
                .to_len_sz(self.b.len() as u64),
        )?;
        for (i, element) in self.b.iter().enumerate() {
            let b_elem_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.b_elem_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*element, fit_sz(*element, b_elem_encoding))?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.b_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.upper_encoding)
                .unwrap_or_default()
                .to_len_sz(self.upper.len() as u64),
        )?;
        for (i, element) in self.upper.iter().enumerate() {
            let upper_elem_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.upper_elem_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer
                .write_unsigned_integer_sz(*element, fit_sz(*element, upper_elem_encoding))?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.upper_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.lower_encoding)
                .unwrap_or_default()
                .to_len_sz(self.lower.len() as u64),
        )?;
        for (i, element) in self.lower.iter().enumerate() {
            let lower_elem_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.lower_elem_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer
                .write_unsigned_integer_sz(*element, fit_sz(*element, lower_elem_encoding))?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.lower_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.maybe_encoding)
                .unwrap_or_default()
                .to_len_sz(self.maybe.len() as u64),
        )?;
        for (i, element) in self.maybe.iter().enumerate() {
            let maybe_elem_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.maybe_elem_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer
                .write_unsigned_integer_sz(*element, fit_sz(*element, maybe_elem_encoding))?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.maybe_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.exact_encoding)
                .unwrap_or_default()
                .to_len_sz(self.exact.len() as u64),
        )?;
        for (i, element) in self.exact.iter().enumerate() {
            let exact_elem_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.exact_elem_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer
                .write_unsigned_integer_sz(*element, fit_sz(*element, exact_elem_encoding))?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.exact_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.nested_encoding)
                .unwrap_or_default()
                .to_len_sz(self.nested.len() as u64),
        )?;
        for (i, element) in self.nested.iter().enumerate() {
            let (nested_elem_encoding, nested_elem_elem_encodings) = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.nested_elem_encodings.get(i))
                .cloned()
                .unwrap_or_else(|| (LenEncoding::default(), Vec::new()));
            serializer.write_array_sz(nested_elem_encoding.to_len_sz(element.len() as u64))?;
            for (i, element) in element.iter().enumerate() {
                let nested_elem_elem_encoding = nested_elem_elem_encodings
                    .get(i)
                    .cloned()
                    .unwrap_or_default();
                serializer.write_unsigned_integer_sz(
                    *element,
                    fit_sz(*element, nested_elem_elem_encoding),
                )?;
            }
            nested_elem_encoding.end(serializer)?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.nested_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.nested_bounded_encoding)
                .unwrap_or_default()
                .to_len_sz(self.nested_bounded.len() as u64),
        )?;
        for (i, element) in self.nested_bounded.iter().enumerate() {
            let (nested_bounded_elem_encoding, nested_bounded_elem_elem_encodings) = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.nested_bounded_elem_encodings.get(i))
                .cloned()
                .unwrap_or_else(|| (LenEncoding::default(), Vec::new()));
            serializer
                .write_array_sz(nested_bounded_elem_encoding.to_len_sz(element.len() as u64))?;
            for (i, element) in element.iter().enumerate() {
                let nested_bounded_elem_elem_encoding = nested_bounded_elem_elem_encodings
                    .get(i)
                    .cloned()
                    .unwrap_or_default();
                serializer.write_unsigned_integer_sz(
                    *element,
                    fit_sz(*element, nested_bounded_elem_elem_encoding),
                )?;
            }
            nested_bounded_elem_encoding.end(serializer)?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.nested_bounded_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.inline_bounded_encoding)
                .unwrap_or_default()
                .to_len_sz(self.inline_bounded.len() as u64),
        )?;
        for (i, element) in self.inline_bounded.iter().enumerate() {
            let inline_bounded_elem_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.inline_bounded_elem_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer.write_text_sz(
                element,
                inline_bounded_elem_encoding.to_str_len_sz(element.len() as u64),
            )?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.inline_bounded_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.inline_upper_encoding)
                .unwrap_or_default()
                .to_len_sz(self.inline_upper.len() as u64),
        )?;
        for (i, element) in self.inline_upper.iter().enumerate() {
            let inline_upper_elem_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.inline_upper_elem_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(
                *element,
                fit_sz(*element, inline_upper_elem_encoding),
            )?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.inline_upper_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.inline_lower_encoding)
                .unwrap_or_default()
                .to_len_sz(self.inline_lower.len() as u64),
        )?;
        for (i, element) in self.inline_lower.iter().enumerate() {
            let inline_lower_elem_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.inline_lower_elem_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(
                *element,
                fit_sz(*element, inline_lower_elem_encoding),
            )?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.inline_lower_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.inline_maybe_encoding)
                .unwrap_or_default()
                .to_len_sz(self.inline_maybe.len() as u64),
        )?;
        for (i, element) in self.inline_maybe.iter().enumerate() {
            let inline_maybe_elem_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.inline_maybe_elem_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(
                *element,
                fit_sz(*element, inline_maybe_elem_encoding),
            )?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.inline_maybe_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.inline_exact_encoding)
                .unwrap_or_default()
                .to_len_sz(self.inline_exact.len() as u64),
        )?;
        for (i, element) in self.inline_exact.iter().enumerate() {
            let inline_exact_elem_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.inline_exact_elem_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(
                *element,
                fit_sz(*element, inline_exact_elem_encoding),
            )?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.inline_exact_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for OccurrenceHolder {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.array_sz()?;
            let len_encoding: LenEncoding = len.into();
            let mut read_len = CBORReadLen::new(len);
            read_len.read_elems(13)?;
            read_len.finish()?;
            let (o, o_encoding, o_elem_encodings) = (|| -> Result<_, DeserializeError> {
                let mut o_arr = Vec::new();
                let len = raw.array_sz()?;
                let o_encoding = len.into();
                let mut o_elem_encodings = Vec::new();
                while match len {
                    cbor_event::LenSz::Len(n, _) => (o_arr.len() as u64) < n,
                    cbor_event::LenSz::Indefinite => true,
                } {
                    if matches!(len, cbor_event::LenSz::Indefinite)
                        && raw.cbor_type()? == cbor_event::Type::Special
                        && raw.special_break()?
                    {
                        break;
                    }
                    let (o_elem, o_elem_encoding) =
                        raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                    o_arr.push(o_elem);
                    o_elem_encodings.push(o_elem_encoding);
                }
                let o_arr = NonEmptyVec::try_from(o_arr)?;
                Ok((o_arr, o_encoding, o_elem_encodings))
            })()
            .map_err(|e| e.annotate("o"))?;
            let (b, b_encoding, b_elem_encodings) = (|| -> Result<_, DeserializeError> {
                let mut b_arr = Vec::new();
                let len = raw.array_sz()?;
                let b_encoding = len.into();
                let mut b_elem_encodings = Vec::new();
