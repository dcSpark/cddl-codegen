                        upper_arr.push(upper_elem);
                        upper_elem_encodings.push(upper_elem_encoding);
                    }
                    let upper_arr = BoundedVec::<_, 0, 5>::try_from(upper_arr)?;
                    Ok((upper_arr, upper_encoding, upper_elem_encodings))
