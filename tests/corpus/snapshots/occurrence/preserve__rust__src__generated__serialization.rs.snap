                    while match len {
                        cbor_event::LenSz::Len(n, _) => (inline_upper_arr.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(len, cbor_event::LenSz::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        let (inline_upper_elem, inline_upper_elem_encoding) =
                            raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                        inline_upper_arr.push(inline_upper_elem);
                        inline_upper_elem_encodings.push(inline_upper_elem_encoding);
                    }
                    let inline_upper_arr = BoundedVec::<_, 0, 5>::try_from(inline_upper_arr)?;
                    Ok((
                        inline_upper_arr,
                        inline_upper_encoding,
                        inline_upper_elem_encodings,
                    ))
                })()
                .map_err(|e| e.annotate("inline_upper"))?;
            let (inline_lower, inline_lower_encoding, inline_lower_elem_encodings) =
                (|| -> Result<_, DeserializeError> {
                    let mut inline_lower_arr = Vec::new();
                    let len = raw.array_sz()?;
                    let inline_lower_encoding = len.into();
                    let mut inline_lower_elem_encodings = Vec::new();
                    while match len {
                        cbor_event::LenSz::Len(n, _) => (inline_lower_arr.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(len, cbor_event::LenSz::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        let (inline_lower_elem, inline_lower_elem_encoding) =
                            raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                        inline_lower_arr.push(inline_lower_elem);
                        inline_lower_elem_encodings.push(inline_lower_elem_encoding);
                    }
                    let inline_lower_arr =
                        BoundedVec::<_, 2, { u64::MAX }>::try_from(inline_lower_arr)?;
                    Ok((
                        inline_lower_arr,
                        inline_lower_encoding,
                        inline_lower_elem_encodings,
                    ))
                })()
                .map_err(|e| e.annotate("inline_lower"))?;
            let (inline_maybe, inline_maybe_encoding, inline_maybe_elem_encodings) =
                (|| -> Result<_, DeserializeError> {
                    let mut inline_maybe_arr = Vec::new();
                    let len = raw.array_sz()?;
                    let inline_maybe_encoding = len.into();
                    let mut inline_maybe_elem_encodings = Vec::new();
                    while match len {
                        cbor_event::LenSz::Len(n, _) => (inline_maybe_arr.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(len, cbor_event::LenSz::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        let (inline_maybe_elem, inline_maybe_elem_encoding) =
                            raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                        inline_maybe_arr.push(inline_maybe_elem);
                        inline_maybe_elem_encodings.push(inline_maybe_elem_encoding);
                    }
                    let inline_maybe_arr = BoundedVec::<_, 0, 1>::try_from(inline_maybe_arr)?;
                    Ok((
                        inline_maybe_arr,
                        inline_maybe_encoding,
                        inline_maybe_elem_encodings,
                    ))
                })()
                .map_err(|e| e.annotate("inline_maybe"))?;
            let (inline_exact, inline_exact_encoding, inline_exact_elem_encodings) =
                (|| -> Result<_, DeserializeError> {
                    let mut inline_exact_arr = Vec::new();
                    let len = raw.array_sz()?;
                    let inline_exact_encoding = len.into();
                    let mut inline_exact_elem_encodings = Vec::new();
                    while match len {
                        cbor_event::LenSz::Len(n, _) => (inline_exact_arr.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(len, cbor_event::LenSz::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        let (inline_exact_elem, inline_exact_elem_encoding) =
                            raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                        inline_exact_arr.push(inline_exact_elem);
                        inline_exact_elem_encodings.push(inline_exact_elem_encoding);
                    }
                    let inline_exact_arr: [_; 2] =
                        inline_exact_arr.try_into().map_err(|elements: Vec<_>| {
                            DeserializeFailure::RangeCheck {
                                found: elements.len() as i128,
                                min: Some(2),
                                max: Some(2),
                            }
                        })?;
                    Ok((
                        inline_exact_arr,
                        inline_exact_encoding,
                        inline_exact_elem_encodings,
                    ))
                })()
                .map_err(|e| e.annotate("inline_exact"))?;
            match len {
                cbor_event::LenSz::Len(_, _) => (),
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(OccurrenceHolder {
                o,
                b,
                upper,
                lower,
                maybe,
                exact,
                nested,
                nested_bounded,
                inline_bounded,
                inline_upper,
                inline_lower,
                inline_maybe,
                inline_exact,
                encodings: Some(OccurrenceHolderEncoding {
                    len_encoding,
                    o_encoding,
                    o_elem_encodings,
                    b_encoding,
                    b_elem_encodings,
                    upper_encoding,
                    upper_elem_encodings,
                    lower_encoding,
                    lower_elem_encodings,
                    maybe_encoding,
                    maybe_elem_encodings,
                    exact_encoding,
                    exact_elem_encodings,
                    nested_encoding,
                    nested_elem_encodings,
                    nested_bounded_encoding,
                    nested_bounded_elem_encodings,
                    inline_bounded_encoding,
                    inline_bounded_elem_encodings,
                    inline_upper_encoding,
                    inline_upper_elem_encodings,
                    inline_lower_encoding,
                    inline_lower_elem_encodings,
                    inline_maybe_encoding,
                    inline_maybe_elem_encodings,
                    inline_exact_encoding,
                    inline_exact_elem_encodings,
                }),
            })
        })()
        .map_err(|e| e.annotate("OccurrenceHolder"))
    }
}

impl cbor_event::se::Serialize for OptionalSegmentOccurrence {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(
                    1 + match &self.label {
                        Some(_) => 1,
                        None => 0,
                    } + self.numbers.len() as u64,
                ),
        )?;
        for (i, element) in self.numbers.iter().enumerate() {
            let numbers_elem_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.numbers_elem_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer
                .write_unsigned_integer_sz(*element, fit_sz(*element, numbers_elem_encoding))?;
        }
        if let Some(field) = &self.label {
            serializer.write_text_sz(
                field,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.label_encoding.clone())
                    .unwrap_or_default()
                    .to_str_len_sz(field.len() as u64),
            )?;
        }
        serializer.write_tag_sz(
            10u64,
            fit_sz(
                10u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.suffix_tag_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_unsigned_integer_sz(
            self.suffix,
            fit_sz(
                self.suffix,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.suffix_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for OptionalSegmentOccurrence {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.array_sz()?;
            let len_encoding: LenEncoding = len.into();
            let mut read_len = CBORReadLen::new(len);
            read_len.read_elems(1)?;
            let mut numbers = Vec::new();
            let mut numbers_elem_encodings = Vec::new();
            while (match len {
                cbor_event::LenSz::Len(n, _) => read_len.read() < n,
                cbor_event::LenSz::Indefinite => raw.as_slice().first() != Some(&0xff),
            }) && raw.cbor_type()? == cbor_event::Type::UnsignedInteger
            {
                read_len.read_elems(1)?;
                let (numbers_elem, numbers_elem_encoding) =
                    raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                numbers.push(numbers_elem);
                numbers_elem_encodings.push(numbers_elem_encoding);
            }
            let (label, label_encoding) = if raw
                .cbor_type()
                .map(|ty| ty == cbor_event::Type::Text)
                .unwrap_or(false)
            {
                (|| -> Result<_, DeserializeError> {
                    read_len.read_elems(1)?;
                    raw.text_sz()
                        .map_err(Into::<DeserializeError>::into)
                        .map(|(s, enc)| (s, StringEncoding::from(enc)))
                })()
                .map_err(|e| e.annotate("label"))
                .map(|(label, label_encoding)| (Some(label), label_encoding))
            } else {
                Ok((None, StringEncoding::default()))
            }?;
            let (suffix, suffix_tag_encoding, suffix_encoding) =
                (|| -> Result<_, DeserializeError> {
                    match raw.tag_sz()? {
                        (10, tag_enc) => raw
                            .unsigned_integer_sz()
                            .map_err(Into::<DeserializeError>::into)
                            .map(|(x, enc)| (x, Some(tag_enc), Some(enc))),
                        (tag, _enc) => Err(DeserializeFailure::TagMismatch {
                            found: tag,
                            expected: 10,
                        }
                        .into()),
                    }
                })()
                .map_err(|e| e.annotate("suffix"))?;
            match len {
                cbor_event::LenSz::Len(_, _) => read_len.finish()?,
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => read_len.finish()?,
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(OptionalSegmentOccurrence {
                numbers,
                label,
                suffix,
                encodings: Some(OptionalSegmentOccurrenceEncoding {
                    numbers_elem_encodings,
                    len_encoding,
                    label_encoding,
                    suffix_tag_encoding,
                    suffix_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("OptionalSegmentOccurrence"))
    }
}
