                        let mut nested_elem_arr = Vec::new();
                        let len = raw.array_sz()?;
                        let nested_elem_encoding = len.into();
                        let mut nested_elem_elem_encodings = Vec::new();
                        while match len {
                            cbor_event::LenSz::Len(n, _) => (nested_elem_arr.len() as u64) < n,
                            cbor_event::LenSz::Indefinite => true,
                        } {
                            if matches!(len, cbor_event::LenSz::Indefinite)
                                && raw.cbor_type()? == cbor_event::Type::Special
                                && raw.special_break()?
                            {
                                break;
                            }
                            let (nested_elem_elem, nested_elem_elem_encoding) =
                                raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                            nested_elem_arr.push(nested_elem_elem);
                            nested_elem_elem_encodings.push(nested_elem_elem_encoding);
                        }
                        let nested_elem_arr = BoundedVec::<_, 0, 2>::try_from(nested_elem_arr)?;
                        let (nested_elem, nested_elem_encoding, nested_elem_elem_encodings) = (
                            nested_elem_arr,
                            nested_elem_encoding,
                            nested_elem_elem_encodings,
                        );
                        nested_arr.push(nested_elem);
                        nested_elem_encodings
                            .push((nested_elem_encoding, nested_elem_elem_encodings));
                    }
                    Ok((nested_arr, nested_encoding, nested_elem_encodings))
                })()
                .map_err(|e| e.annotate("nested"))?;
            let (nested_bounded, nested_bounded_encoding, nested_bounded_elem_encodings) =
                (|| -> Result<_, DeserializeError> {
                    let mut nested_bounded_arr = Vec::new();
                    let len = raw.array_sz()?;
                    let nested_bounded_encoding = len.into();
                    let mut nested_bounded_elem_encodings = Vec::new();
                    while match len {
                        cbor_event::LenSz::Len(n, _) => (nested_bounded_arr.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(len, cbor_event::LenSz::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        let mut nested_bounded_elem_arr = Vec::new();
                        let len = raw.array_sz()?;
                        let nested_bounded_elem_encoding = len.into();
                        let mut nested_bounded_elem_elem_encodings = Vec::new();
                        while match len {
                            cbor_event::LenSz::Len(n, _) => {
                                (nested_bounded_elem_arr.len() as u64) < n
                            }
                            cbor_event::LenSz::Indefinite => true,
                        } {
                            if matches!(len, cbor_event::LenSz::Indefinite)
                                && raw.cbor_type()? == cbor_event::Type::Special
                                && raw.special_break()?
                            {
