use crate::generated::error::*;
use crate::generated::non_empty::NonEmptyVec;

pub type Bounded = Vec<u64>;

#[derive(Clone, Debug)]
pub struct OccurrenceHolder {
    pub o: OneOrMore,
    pub b: Bounded,
    pub inline_bounded: Vec<String>,
}

impl OccurrenceHolder {
    pub fn new(
        o: OneOrMore,
        b: Bounded,
        inline_bounded: Vec<String>,
    ) -> Result<Self, DeserializeError> {
        if b.len() < 2 || b.len() > 5 {
            return Err(DeserializeFailure::RangeCheck {
                found: b.len() as i128,
                min: Some(2),
                max: Some(5),
            }
            .into());
        }
        if inline_bounded.len() < 1 || inline_bounded.len() > 3 {
            return Err(DeserializeFailure::RangeCheck {
                found: inline_bounded.len() as i128,
                min: Some(1),
                max: Some(3),
            }
            .into());
        }
        Ok(Self {
            o,
            b,
            inline_bounded,
        })
    }
}

/// `[+ u64]`: at least one element, enforced at the `NonEmptyVec` `TryFrom<Vec<_>>` door (the CBOR decoder routes through the same door, so wire-side and API-side rejection are identical).
pub type OneOrMore = NonEmptyVec<u64>;
