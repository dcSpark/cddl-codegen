}

impl From<Bounded> for Vec<u64> {
    fn from(wasm: Bounded) -> Self {
        wasm.0
    }
}

impl AsRef<Vec<u64>> for Bounded {
    fn as_ref(&self) -> &Vec<u64> {
        &self.0
    }
}

