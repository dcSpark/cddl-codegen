// This file was code-generated using an experimental CDDL to rust tool:
// https://github.com/dcSpark/cddl-codegen

use core::cell::RefCell;

wit_bindgen::generate!({
    path: "wit",
    world: "cddl-lib-world",
});

use exports::cddl::cddl_lib::types as wit_types;

struct Component;

impl wit_types::Guest for Component {
    type WrappedArr = WitWrappedArr;
    type WrappedMap = WitWrappedMap;
}

export!(Component);

/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitWrappedArr(pub RefCell<cddl_lib::WrappedArr>);

impl wit_types::GuestWrappedArr for WitWrappedArr {
    fn new(inner: Vec<u64>) -> Self {
        let inner = inner.into_iter().collect();
        let inner = cddl_lib::WrappedArr::new(inner);
        WitWrappedArr(RefCell::new(inner))
    }

    fn get(&self) -> Vec<u64> {
        let me = self.0.borrow();
        let inner = me.get().clone();
        inner.iter().map(|x| *x).collect()
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::WrappedArr as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::WrappedArr, String> {
        <cddl_lib::WrappedArr as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::WrappedArr::new(WitWrappedArr(RefCell::new(v))))
            .map_err(err)
    }
}

pub struct WitWrappedMap(pub RefCell<cddl_lib::WrappedMap>);

impl wit_types::GuestWrappedMap for WitWrappedMap {
    fn new(inner: Vec<(u64, String)>) -> Self {
        let inner = inner.into_iter().collect();
        let inner = cddl_lib::WrappedMap::new(inner);
        WitWrappedMap(RefCell::new(inner))
    }

    fn get(&self) -> Vec<(u64, String)> {
        let me = self.0.borrow();
