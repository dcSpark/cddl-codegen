        inner.iter().map(|(x0, x1)| (*x0, x1.clone())).collect()
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::WrappedMap as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::WrappedMap, String> {
        <cddl_lib::WrappedMap as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::WrappedMap::new(WitWrappedMap(RefCell::new(v))))
            .map_err(err)
