                    4 + match &self.t {
                        Some(_) => 1,
                        None => 0,
                    },
                ),
        )?;
        self.s.serialize(serializer)?;
        self.ns.serialize(serializer)?;
        self.g.serialize(serializer)?;
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.p_encoding)
                .unwrap_or_default()
                .to_len_sz(self.p.len() as u64),
        )?;
        for (i, element) in self.p.iter().enumerate() {
            let p_elem_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.p_elem_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*element, fit_sz(*element, p_elem_encoding))?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.p_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        if let Some(field) = &self.t {
            field.serialize(serializer)?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
