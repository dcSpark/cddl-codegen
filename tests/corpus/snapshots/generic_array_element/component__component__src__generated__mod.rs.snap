    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::OnePair, String> {
        <cddl_lib::OnePair as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::OnePair::new(WitOnePair(RefCell::new(v))))
            .map_err(err)
