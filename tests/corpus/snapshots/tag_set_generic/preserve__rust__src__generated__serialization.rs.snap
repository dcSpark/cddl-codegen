impl cbor_event::se::Serialize for Point {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(2),
        )?;
        serializer.write_unsigned_integer_sz(
            self.x,
            fit_sz(
                self.x,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.x_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_unsigned_integer_sz(
            self.y,
            fit_sz(
                self.y,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.y_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

