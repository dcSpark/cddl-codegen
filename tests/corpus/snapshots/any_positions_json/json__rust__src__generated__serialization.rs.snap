                11 => crate::generated::any_cbor::AnyCbor::deserialize(raw)?,
                tag => {
                    return Err(DeserializeFailure::TagMismatch {
                        found: tag,
                        expected: 11,
                    }
                    .into());
                }
            }))
        })()
        .map_err(|e| e.annotate("Tagged"))
    }
}
