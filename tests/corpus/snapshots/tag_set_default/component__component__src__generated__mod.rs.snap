/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitDefaultNeset(pub RefCell<cddl_lib::DefaultNeset>);

impl wit_types::GuestDefaultNeset for WitDefaultNeset {
    fn new(inner: Vec<u64>) -> Result<Self, String> {
        let inner: Vec<_> = inner.into_iter().collect();
        let inner = cddl_lib::DefaultNeset::new(inner.try_into().map_err(err)?);
        Ok(WitDefaultNeset(RefCell::new(inner)))
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::DefaultNeset as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::DefaultNeset, String> {
        <cddl_lib::DefaultNeset as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::DefaultNeset::new(WitDefaultNeset(RefCell::new(v))))
            .map_err(err)
    }
}

