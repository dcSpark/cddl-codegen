        ns: wit_types::DefaultNesetBorrow<'_>,
        sa: wit_types::SingleArmBorrow<'_>,
        o: wit_types::OptOutBorrow<'_>,
    ) -> Self {
        let s = s.get::<WitDefaultSet>().0.borrow().clone();
        let ns = ns.get::<WitDefaultNeset>().0.borrow().clone();
        let sa = sa.get::<WitSingleArm>().0.borrow().clone();
        let o = o.get::<WitOptOut>().0.borrow().clone();
        let inner = cddl_lib::Holder::new(s, ns, sa, o);
        WitHolder(RefCell::new(inner))
