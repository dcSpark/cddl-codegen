    fn s(&self) -> wit_types::DefaultSet {
        let me = self.0.borrow();
        wit_types::DefaultSet::new(WitDefaultSet(RefCell::new(me.s.clone())))
    }

    fn ns(&self) -> wit_types::DefaultNeset {
        let me = self.0.borrow();
        wit_types::DefaultNeset::new(WitDefaultNeset(RefCell::new(me.ns.clone())))
    }

    fn sa(&self) -> wit_types::SingleArm {
        let me = self.0.borrow();
        wit_types::SingleArm::new(WitSingleArm(RefCell::new(me.sa.clone())))
    }

    fn o(&self) -> wit_types::OptOut {
        let me = self.0.borrow();
        wit_types::OptOut::new(WitOptOut(RefCell::new(me.o.clone())))
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::Holder as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(&self.0.borrow())
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::Holder, String> {
        <cddl_lib::Holder as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::Holder::new(WitHolder(RefCell::new(v))))
            .map_err(err)
    }
}

