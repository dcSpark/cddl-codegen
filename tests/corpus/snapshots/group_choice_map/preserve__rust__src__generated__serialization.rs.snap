impl cbor_event::se::Serialize for NonemptyArm0 {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_map_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(2),
        )?;
        self.serialize_as_embedded_group(serializer)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl SerializeEmbeddedGroup for NonemptyArm0 {
    fn serialize_as_embedded_group<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        let deser_order = self
            .encodings
            .as_ref()
            .filter(|encs| encs.orig_deser_order.len() == 2)
            .map(|encs| encs.orig_deser_order.clone())
            .unwrap_or_else(|| (0..2).collect());
        for field_index in deser_order {
            match field_index {
                0 => {
                    serializer.write_text_sz(
                        "f0",
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.f0_key_encoding.clone())
                            .unwrap_or_default()
                            .to_str_len_sz("f0".len() as u64),
                    )?;
                    serializer.write_array_sz(
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.f0_encoding)
                            .unwrap_or_default()
                            .to_len_sz(self.f0.len() as u64),
                    )?;
                    for (i, element) in self.f0.iter().enumerate() {
                        let f0_elem_encoding = self
                            .encodings
                            .as_ref()
                            .and_then(|encs| encs.f0_elem_encodings.get(i))
                            .cloned()
                            .unwrap_or_default();
                        serializer.write_unsigned_integer_sz(
                            *element,
                            fit_sz(*element, f0_elem_encoding),
                        )?;
                    }
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.f0_encoding)
                        .unwrap_or_default()
                        .end(serializer)?;
                }
                1 => {
                    serializer.write_text_sz(
                        "f1",
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.f1_key_encoding.clone())
                            .unwrap_or_default()
                            .to_str_len_sz("f1".len() as u64),
                    )?;
                    serializer.write_unsigned_integer_sz(
                        self.f1,
                        fit_sz(
                            self.f1,
                            self.encodings
                                .as_ref()
                                .map(|encs| encs.f1_encoding)
                                .unwrap_or_default(),
                        ),
                    )?;
                }
                _ => unreachable!(),
            };
        }
        Ok(serializer)
    }
}

impl Deserialize for NonemptyArm0 {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        let (len, mut read_len) = (|| -> Result<_, DeserializeError> {
            let len = raw.map_sz()?;
            let mut read_len = CBORReadLen::new(len);
            read_len.read_elems(2)?;
            read_len.finish()?;
            Ok((len, read_len))
        })()
        .map_err(|e| e.annotate("NonemptyArm0"))?;
        let ret = Self::deserialize_as_embedded_group(raw, &mut read_len, len);
        ret
    }
}

impl DeserializeEmbeddedGroup for NonemptyArm0 {
    fn deserialize_as_embedded_group(
        raw: &mut Deserializer,
        _read_len: &mut CBORReadLen,
        len: cbor_event::LenSz,
    ) -> Result<Self, DeserializeError> {
        let len_encoding = len.into();
        (|| -> Result<_, DeserializeError> {
            let mut orig_deser_order = Vec::new();
            let mut f0_encoding = LenEncoding::default();
            let mut f0_elem_encodings = Vec::new();
            let mut f0_key_encoding = StringEncoding::default();
            let mut f0 = None;
            let mut f1_encoding = None;
            let mut f1_key_encoding = StringEncoding::default();
            let mut f1 = None;
            let mut read = 0;
            while match len {
                cbor_event::LenSz::Len(n, _) => read < n,
                cbor_event::LenSz::Indefinite => true,
            } {
                match raw.cbor_type()? {
                    cbor_event::Type::UnsignedInteger => {
                        return Err(DeserializeFailure::UnknownKey(Key::Uint(
                            raw.unsigned_integer()?,
                        ))
                        .into());
                    }
                    cbor_event::Type::Text => {
                        let (text_key, key_enc) = raw.text_sz()?;
                        match text_key.as_str() {
                            "f0" => {
                                if f0.is_some() {
                                    return Err(DeserializeFailure::DuplicateKey(Key::Str(
                                        "f0".into(),
                                    ))
                                    .into());
                                }
                                let (tmp_f0, tmp_f0_encoding, tmp_f0_elem_encodings) =
                                    (|| -> Result<_, DeserializeError> {
                                        let mut f0_arr = Vec::new();
                                        let len = raw.array_sz()?;
                                        let f0_encoding = len.into();
                                        let mut f0_elem_encodings = Vec::new();
                                        while match len {
                                            cbor_event::LenSz::Len(n, _) => {
                                                (f0_arr.len() as u64) < n
                                            }
                                            cbor_event::LenSz::Indefinite => true,
                                        } {
                                            if matches!(len, cbor_event::LenSz::Indefinite)
                                                && raw.cbor_type()? == cbor_event::Type::Special
                                                && raw.special_break()?
                                            {
                                                break;
                                            }
                                            let (f0_elem, f0_elem_encoding) = raw
                                                .unsigned_integer_sz()
                                                .map(|(x, enc)| (x, Some(enc)))?;
                                            f0_arr.push(f0_elem);
                                            f0_elem_encodings.push(f0_elem_encoding);
                                        }
                                        let f0_arr = NonEmptyVec::try_from(f0_arr)?;
                                        Ok((f0_arr, f0_encoding, f0_elem_encodings))
                                    })()
                                    .map_err(|e| e.annotate("f0"))?;
                                f0 = Some(tmp_f0);
                                f0_encoding = tmp_f0_encoding;
                                f0_elem_encodings = tmp_f0_elem_encodings;
                                f0_key_encoding = StringEncoding::from(key_enc);
                                orig_deser_order.push(0);
                            }
                            "f1" => {
                                if f1.is_some() {
                                    return Err(DeserializeFailure::DuplicateKey(Key::Str(
                                        "f1".into(),
                                    ))
                                    .into());
                                }
                                let (tmp_f1, tmp_f1_encoding) = raw
                                    .unsigned_integer_sz()
                                    .map_err(Into::<DeserializeError>::into)
                                    .and_then(|(x, enc)| {
                                        if x > 10 {
                                            Err(DeserializeFailure::RangeCheck {
                                                found: x as i128,
                                                min: None,
                                                max: Some(10),
                                            }
                                            .into())
                                        } else {
                                            Ok((x, Some(enc)))
                                        }
                                    })
                                    .map_err(|e: DeserializeError| e.annotate("f1"))?;
                                f1 = Some(tmp_f1);
                                f1_encoding = tmp_f1_encoding;
                                f1_key_encoding = StringEncoding::from(key_enc);
                                orig_deser_order.push(1);
                            }
                            unknown_key => {
                                return Err(DeserializeFailure::UnknownKey(Key::Str(
                                    unknown_key.to_owned(),
                                ))
                                .into());
                            }
                        }
                    }
                    cbor_event::Type::Special => match len {
                        cbor_event::LenSz::Len(_, _) => {
                            return Err(DeserializeFailure::BreakInDefiniteLen.into());
                        }
                        cbor_event::LenSz::Indefinite => match raw.special()? {
                            cbor_event::Special::Break => break,
                            _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                        },
                    },
                    other_type => {
                        return Err(DeserializeFailure::UnexpectedKeyType(other_type).into());
                    }
                }
                read += 1;
            }
            let f0 = match f0 {
                Some(x) => x,
                None => {
                    return Err(
                        DeserializeFailure::MandatoryFieldMissing(Key::Str(String::from("f0")))
                            .into(),
                    );
                }
            };
            let f1 = match f1 {
                Some(x) => x,
                None => {
                    return Err(
                        DeserializeFailure::MandatoryFieldMissing(Key::Str(String::from("f1")))
                            .into(),
                    );
                }
            };
            Ok(Self {
                f0,
                f1,
                encodings: Some(NonemptyArm0Encoding {
                    len_encoding,
                    orig_deser_order,
                    f0_key_encoding,
                    f0_encoding,
                    f0_elem_encodings,
                    f1_key_encoding,
                    f1_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("NonemptyArm0"))
    }
}

