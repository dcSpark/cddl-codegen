impl cbor_event::se::Serialize for UintKeyed {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        match self {
            UintKeyed::U64 {
                uint,
                uint_encoding,
                uint_key_encoding,
                len_encoding,
            } => {
                serializer.write_map_sz(len_encoding.to_len_sz(1))?;
                serializer.write_unsigned_integer_sz(1u64, fit_sz(1u64, *uint_key_encoding))?;
                serializer.write_unsigned_integer_sz(*uint, fit_sz(*uint, *uint_encoding))?;
                len_encoding.end(serializer)?;
                Ok(serializer)
            }
            UintKeyed::Text {
                text,
                text_encoding,
                text_key_encoding,
                len_encoding,
            } => {
                serializer.write_map_sz(len_encoding.to_len_sz(1))?;
                serializer.write_unsigned_integer_sz(2u64, fit_sz(2u64, *text_key_encoding))?;
                serializer.write_text_sz(text, text_encoding.to_str_len_sz(text.len() as u64))?;
                len_encoding.end(serializer)?;
                Ok(serializer)
            }
        }
    }
}

