        Self(cddl_lib::UintKeyed::new_uint(u64))
    }

    pub fn new_text(text: String) -> Self {
        Self(cddl_lib::UintKeyed::new_text(text))
    }

    pub fn kind(&self) -> UintKeyedKind {
        match &self.0 {
            cddl_lib::UintKeyed::U64(_) => UintKeyedKind::U64,
            cddl_lib::UintKeyed::Text(_) => UintKeyedKind::Text,
        }
    }

    pub fn as_uint(&self) -> Option<u64> {
        match &self.0 {
            cddl_lib::UintKeyed::U64(uint) => Some(*uint),
            _ => None,
        }
    }

    pub fn as_text(&self) -> Option<String> {
        match &self.0 {
            cddl_lib::UintKeyed::Text(text) => Some(text.clone()),
            _ => None,
        }
    }
}

impl From<cddl_lib::UintKeyed> for UintKeyed {
    fn from(native: cddl_lib::UintKeyed) -> Self {
        Self(native)
    }
}

impl From<UintKeyed> for cddl_lib::UintKeyed {
    fn from(wasm: UintKeyed) -> Self {
        wasm.0
    }
}

impl AsRef<cddl_lib::UintKeyed> for UintKeyed {
    fn as_ref(&self) -> &cddl_lib::UintKeyed {
        &self.0
    }
}

#[wasm_bindgen]
pub enum UintKeyedKind {
    U64,
    Text,
}
