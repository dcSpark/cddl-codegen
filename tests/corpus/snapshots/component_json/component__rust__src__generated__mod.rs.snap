pub type Attrs = OrderedHashMap<String, u64>;

#[derive(
    Copy, Eq, PartialEq, Ord, PartialOrd, Clone, Debug, serde::Deserialize, serde::Serialize,
)]
#[cfg_attr(feature = "wasm", wasm_bindgen::prelude::wasm_bindgen)]
pub enum Color {
    I0,
    I1,
    I2,
}

/// `{+ String => u64}`: at least one entry, enforced at the `NonEmptyMap` `TryFrom` door (the CBOR decoder routes through the same door, so wire-side and API-side rejection are identical).
pub type Counts = NonEmptyMap<String, u64>;

#[derive(Clone, Debug)]
pub struct Hash {
    pub(crate) inner: [u8; 32],
    pub encodings: Option<HashEncoding>,
}

impl Hash {
    pub fn get(&self) -> &[u8; 32] {
        &self.inner
    }

    pub fn new(inner: Vec<u8>) -> Result<Self, DeserializeError> {
        let inner: [u8; 32] = inner.try_into().map_err(|bytes: Vec<u8>| {
            DeserializeError::new(
                "Hash",
                DeserializeFailure::RangeCheck {
                    found: bytes.len() as i128,
                    min: Some(32),
                    max: Some(32),
                },
            )
        })?;
        Ok(Self {
            inner,
            encodings: None,
        })
    }
}

impl TryFrom<Vec<u8>> for Hash {
    type Error = DeserializeError;

    fn try_from(inner: Vec<u8>) -> Result<Self, Self::Error> {
        Hash::new(inner)
    }
}

impl serde::Serialize for Hash {
    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>
    where
        S: serde::Serializer,
    {
        serializer.serialize_str(&hex::encode(self.inner.clone()))
    }
}

impl<'de> serde::de::Deserialize<'de> for Hash {
    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
    where
        D: serde::de::Deserializer<'de>,
    {
        let s = <String as serde::de::Deserialize>::deserialize(deserializer)?;
        decode_canonical_hex(&s)
            .ok()
            .and_then(|bytes| Hash::new(bytes).ok())
            .ok_or_else(|| {
                serde::de::Error::invalid_value(
                    serde::de::Unexpected::Str(&s),
                    &"invalid hex bytes",
                )
            })
    }
}

#[derive(Clone, Debug)]
pub enum Int {
    Uint {
        value: u64,
        encoding: Option<cbor_event::Sz>,
    },
    Nint {
        value: u64,
        encoding: Option<cbor_event::Sz>,
    },
}

impl serde::Serialize for Int {
    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>
    where
        S: serde::Serializer,
    {
        serializer.serialize_str(&self.to_string())
    }
}

impl<'de> serde::de::Deserialize<'de> for Int {
    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
    where
        D: serde::de::Deserializer<'de>,
    {
        let s = <String as serde::de::Deserialize>::deserialize(deserializer)?;
        core::str::FromStr::from_str(&s).map_err(|_e| {
            serde::de::Error::invalid_value(serde::de::Unexpected::Str(&s), &"invalid Int")
        })
    }
}

impl Int {
    pub fn new_uint(value: u64) -> Self {
        Self::Uint {
            value,
            encoding: None,
        }
    }

    /// * `value` - Value as encoded in CBOR - note: a negative `x` here would be `|x + 1|` due to CBOR's `nint` encoding e.g. to represent -5, pass in 4.
    pub fn new_nint(value: u64) -> Self {
        Self::Nint {
            value,
            encoding: None,
        }
    }
}

impl core::fmt::Display for Int {
    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
        match self {
            Self::Uint { value, .. } => write!(f, "{}", value),
            Self::Nint { value, .. } => write!(f, "{}", -((*value as i128) + 1)),
        }
    }
}

impl core::str::FromStr for Int {
    type Err = IntError;

    fn from_str(s: &str) -> Result<Self, Self::Err> {
        let x = i128::from_str(s).map_err(IntError::Parsing)?;
        Self::try_from(x).map_err(IntError::Bounds)
    }
}

impl TryFrom<i128> for Int {
    type Error = core::num::TryFromIntError;

    fn try_from(x: i128) -> Result<Self, Self::Error> {
        if x >= 0 {
            u64::try_from(x).map(|x| Self::Uint {
                value: x,
                encoding: None,
            })
        } else {
            u64::try_from((x + 1).unsigned_abs()).map(|x| Self::Nint {
                value: x,
                encoding: None,
            })
        }
    }
}

#[derive(Clone, Debug)]
pub enum IntError {
    Bounds(core::num::TryFromIntError),
    Parsing(core::num::ParseIntError),
}

/// `[+ String]`: at least one element, enforced at the `NonEmptyVec` `TryFrom<Vec<_>>` door (the CBOR decoder routes through the same door, so wire-side and API-side rejection are identical).
pub type Names = NonEmptyVec<String>;

#[derive(Clone, Debug, serde::Deserialize, serde::Serialize)]
pub struct Node {
    pub label: String,
    pub children: Vec<Node>,
    #[serde(skip)]
    pub encodings: Option<NodeEncoding>,
}

impl Node {
    pub fn new(label: String, children: Vec<Node>) -> Self {
        Self {
            label,
            children,
            encodings: None,
        }
    }
}

#[derive(Clone, Debug, serde::Deserialize, serde::Serialize)]
pub struct Record {
    pub id: u64,
    pub name: String,
    pub digest: Hash,
    pub delta: Int,
    pub limit: u64,
    pub tags: Names,
    pub props: Attrs,
    pub totals: Counts,
    pub kind: Color,
    pub root: Node,
    #[serde(with = "crate::generated::any_cbor::natural_any_cbor")]
    pub meta: crate::generated::any_cbor::AnyCbor,
    #[serde(with = "crate::generated::any_cbor::natural_any_cbor_seq")]
    pub metas: Vec<crate::generated::any_cbor::AnyCbor>,
    pub note: Option<String>,
    #[serde(skip)]
    pub encodings: Option<RecordEncoding>,
}

impl Record {
    pub fn new(
        id: u64,
        name: String,
        digest: Hash,
        delta: Int,
        limit: u64,
        tags: Names,
        props: Attrs,
        totals: Counts,
        kind: Color,
        root: Node,
        meta: crate::generated::any_cbor::AnyCbor,
        metas: Vec<crate::generated::any_cbor::AnyCbor>,
    ) -> Result<Self, DeserializeError> {
        if limit > 5 {
            return Err(DeserializeFailure::RangeCheck {
                found: limit as i128,
                min: None,
                max: Some(5),
            }
            .into());
        }
        Ok(Self {
            id,
            name,
            digest,
            delta,
            limit,
            tags,
            props,
            totals,
            kind,
            root,
            meta,
            metas,
            note: None,
            encodings: None,
        })
    }
}

impl From<Hash> for [u8; 32] {
    fn from(wrapper: Hash) -> Self {
        wrapper.inner
    }
}
