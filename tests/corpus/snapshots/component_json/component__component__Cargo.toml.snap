[package]
name = "cddl-lib-component"
version = "0.1.0"
edition = "2024"

[package.metadata.cddl-codegen]
generated-with = "0.1.0"

[lib]
crate-type = ["cdylib"]

[dependencies]
cddl-lib = { path = "../rust" }
wit-bindgen = "0.57"
serde_json = { version = "1.0.57", features = ["float_roundtrip"] }
