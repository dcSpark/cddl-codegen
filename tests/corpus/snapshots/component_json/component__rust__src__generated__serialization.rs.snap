impl Deserialize for Record {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.map_sz()?;
            let len_encoding: LenEncoding = len.into();
            let mut read_len = CBORReadLen::new(len);
            read_len.read_elems(12)?;
            let mut orig_deser_order = Vec::new();
            let mut id_encoding = None;
            let mut id_key_encoding = StringEncoding::default();
            let mut id = None;
            let mut kind_encoding = None;
            let mut kind_key_encoding = StringEncoding::default();
            let mut kind = None;
            let mut meta_key_encoding = StringEncoding::default();
            let mut meta = None;
            let mut name_encoding = StringEncoding::default();
            let mut name_key_encoding = StringEncoding::default();
            let mut name = None;
            let mut note_encoding = StringEncoding::default();
            let mut note_key_encoding = StringEncoding::default();
            let mut note = None;
            let mut root_key_encoding = StringEncoding::default();
            let mut root = None;
            let mut tags_encoding = LenEncoding::default();
            let mut tags_elem_encodings = Vec::new();
            let mut tags_key_encoding = StringEncoding::default();
            let mut tags = None;
            let mut delta_key_encoding = StringEncoding::default();
            let mut delta = None;
            let mut limit_encoding = None;
            let mut limit_key_encoding = StringEncoding::default();
            let mut limit = None;
            let mut metas_encoding = LenEncoding::default();
            let mut metas_key_encoding = StringEncoding::default();
            let mut metas = None;
            let mut props_encoding = LenEncoding::default();
            let mut props_key_encodings = BTreeMap::new();
            let mut props_value_encodings = BTreeMap::new();
            let mut props_key_encoding = StringEncoding::default();
            let mut props = None;
            let mut digest_key_encoding = StringEncoding::default();
            let mut digest = None;
            let mut totals_encoding = LenEncoding::default();
            let mut totals_key_encodings = BTreeMap::new();
            let mut totals_value_encodings = BTreeMap::new();
            let mut totals_key_encoding = StringEncoding::default();
            let mut totals = None;
            let mut read = 0;
            while match len { cbor_event::LenSz::Len(n, _) => read < n, cbor_event::LenSz::Indefinite => true, } {
                match raw.cbor_type()? {
                    cbor_event::Type::UnsignedInteger => return Err(DeserializeFailure::UnknownKey(Key::Uint(raw.unsigned_integer()?)).into()),
                    cbor_event::Type::Text => {
                        let (text_key, key_enc) = raw.text_sz()?;
                        match text_key.as_str() {
                            "id" =>  {
                                if id.is_some() {
                                    return Err(DeserializeFailure::DuplicateKey(Key::Str("id".into())).into());
                                }
                                let (tmp_id, tmp_id_encoding) = raw.unsigned_integer_sz().map_err(Into::<DeserializeError>::into).map(|(x, enc)| (x, Some(enc))).map_err(|e: DeserializeError| e.annotate("id"))?;
                                id = Some(tmp_id);
                                id_encoding = tmp_id_encoding;
                                id_key_encoding = StringEncoding::from(key_enc);
                                orig_deser_order.push(0);
                            },
                            "kind" =>  {
                                if kind.is_some() {
                                    return Err(DeserializeFailure::DuplicateKey(Key::Str("kind".into())).into());
                                }
                                let (tmp_kind, tmp_kind_encoding) = (|| -> Result<_, DeserializeError> {
                                    let initial_position = raw.position();
                                    let deser_variant = (|raw: &mut Deserializer| -> Result<_, DeserializeError> {
                                        let (i0_value, i0_encoding) = raw.unsigned_integer_sz()?;
                                        if i0_value != 0 {
                                            return Err(DeserializeFailure::FixedValueMismatch{ found: Key::Uint(i0_value), expected: Key::Uint(0) }.into());
                                        }
                                        Ok(Some(i0_encoding))
                                    })(raw);
                                    match deser_variant {
                                        Ok(kind_encoding) => return Ok((Color::I0, kind_encoding)),
                                        Err(_) => raw.set_position(initial_position).unwrap(),
                                    };
                                    let deser_variant = (|raw: &mut Deserializer| -> Result<_, DeserializeError> {
                                        let (i1_value, i1_encoding) = raw.unsigned_integer_sz()?;
                                        if i1_value != 1 {
                                            return Err(DeserializeFailure::FixedValueMismatch{ found: Key::Uint(i1_value), expected: Key::Uint(1) }.into());
                                        }
                                        Ok(Some(i1_encoding))
                                    })(raw);
                                    match deser_variant {
                                        Ok(kind_encoding) => return Ok((Color::I1, kind_encoding)),
                                        Err(_) => raw.set_position(initial_position).unwrap(),
                                    };
                                    let deser_variant = (|raw: &mut Deserializer| -> Result<_, DeserializeError> {
                                        let (i2_value, i2_encoding) = raw.unsigned_integer_sz()?;
                                        if i2_value != 2 {
                                            return Err(DeserializeFailure::FixedValueMismatch{ found: Key::Uint(i2_value), expected: Key::Uint(2) }.into());
                                        }
                                        Ok(Some(i2_encoding))
                                    })(raw);
                                    match deser_variant {
                                        Ok(kind_encoding) => return Ok((Color::I2, kind_encoding)),
                                        Err(_) => raw.set_position(initial_position).unwrap(),
