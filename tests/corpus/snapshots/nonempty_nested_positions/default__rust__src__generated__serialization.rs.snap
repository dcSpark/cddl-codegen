extern crate alloc;
use alloc::collections::BTreeMap;
use alloc::string::String;
use alloc::vec::Vec;
use super::*;
use crate::generated::error::*;
use cbor_event::de::Deserializer;
use cbor_event::se::{Serialize, Serializer};

impl cbor_event::se::Serialize for Holder {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array(cbor_event::Len::Len(2))?;
        serializer.write_array(cbor_event::Len::Len(self.np.len() as u64))?;
        for element in self.np.iter() {
            serializer.write_array(cbor_event::Len::Len(element.len() as u64))?;
            for element in element.iter() {
                serializer.write_unsigned_integer(*element)?;
            }
        }
        serializer.write_map(cbor_event::Len::Len(self.dm.len() as u64))?;
        for (key, value) in self.dm.iter() {
            serializer.write_map(cbor_event::Len::Len(key.len() as u64))?;
            for (key, value) in key.iter() {
                serializer.write_unsigned_integer(*key)?;
                serializer.write_unsigned_integer(*value)?;
            }
            serializer.write_text(value)?;
        }
        Ok(serializer)
    }
}

impl Deserialize for Holder {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.array()?;
            let mut read_len = CBORReadLen::from(len);
            read_len.read_elems(2)?;
            read_len.finish()?;
            let np = (|| -> Result<_, DeserializeError> {
                let mut np_arr = Vec::new();
                let len = raw.array()?;
                while match len {
                    cbor_event::Len::Len(n) => (np_arr.len() as u64) < n,
                    cbor_event::Len::Indefinite => true,
                } {
                    if matches!(len, cbor_event::Len::Indefinite)
                        && raw.cbor_type()? == cbor_event::Type::Special
                        && raw.special_break()?
                    {
                        break;
                    }
                    let mut np_elem_arr = Vec::new();
                    let len = raw.array()?;
                    while match len {
                        cbor_event::Len::Len(n) => (np_elem_arr.len() as u64) < n,
                        cbor_event::Len::Indefinite => true,
                    } {
                        if matches!(len, cbor_event::Len::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        np_elem_arr.push(raw.unsigned_integer()?);
                    }
                    let np_elem_arr = NonEmptyVec::try_from(np_elem_arr)?;
                    np_arr.push(np_elem_arr);
                }
                Ok(np_arr)
            })()
            .map_err(|e| e.annotate("np"))?;
            let dm = (|| -> Result<_, DeserializeError> {
                let mut dm_table = BTreeMap::new();
                let dm_len = raw.map()?;
                while match dm_len {
                    cbor_event::Len::Len(n) => (dm_table.len() as u64) < n,
                    cbor_event::Len::Indefinite => true,
                } {
                    if matches!(dm_len, cbor_event::Len::Indefinite)
                        && raw.cbor_type()? == cbor_event::Type::Special
                        && raw.special_break()?
                    {
                        break;
                    }
                    let mut dm_key_table = BTreeMap::new();
                    let dm_key_len = raw.map()?;
                    while match dm_key_len {
                        cbor_event::Len::Len(n) => (dm_key_table.len() as u64) < n,
                        cbor_event::Len::Indefinite => true,
                    } {
                        if matches!(dm_key_len, cbor_event::Len::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        let dm_key_key = raw.unsigned_integer()?;
                        let dm_key_value = raw.unsigned_integer()?;
                        if dm_key_table.insert(dm_key_key, dm_key_value).is_some() {
                            return Err(
                                DeserializeFailure::DuplicateKey(Key::Uint(dm_key_key)).into()
                            );
                        }
                    }
                    let dm_key_table = NonEmptyMap::try_from(dm_key_table)?;
                    let dm_key = dm_key_table;
                    let dm_value = raw.text()?;
                    if dm_table.insert(dm_key.clone(), dm_value).is_some() {
                        return Err(DeserializeFailure::DuplicateKey(Key::Str(String::from(
                            "some complicated/unsupported type",
                        )))
                        .into());
                    }
                }
                Ok(dm_table)
            })()
            .map_err(|e| e.annotate("dm"))?;
            match len {
                cbor_event::Len::Len(_) => (),
                cbor_event::Len::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(Holder { np, dm })
        })()
        .map_err(|e| e.annotate("Holder"))
