                    .write_unsigned_integer_sz(*element, fit_sz(*element, np_elem_elem_encoding))?;
            }
            np_elem_encoding.end(serializer)?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.np_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        serializer.write_map_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.dm_encoding)
                .unwrap_or_default()
                .to_len_sz(self.dm.len() as u64),
        )?;
        for (key, value) in self.dm.iter() {
            let (dm_key_encoding, dm_key_key_encodings, dm_key_value_encodings) = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.dm_key_encodings.get(key))
                .cloned()
                .unwrap_or_else(|| (LenEncoding::default(), BTreeMap::new(), BTreeMap::new()));
            serializer.write_map_sz(dm_key_encoding.to_len_sz(key.len() as u64))?;
            for (key, value) in key.iter() {
                let dm_key_key_encoding =
                    dm_key_key_encodings.get(key).cloned().unwrap_or_default();
                serializer.write_unsigned_integer_sz(*key, fit_sz(*key, dm_key_key_encoding))?;
                let dm_key_value_encoding =
                    dm_key_value_encodings.get(key).cloned().unwrap_or_default();
                serializer
                    .write_unsigned_integer_sz(*value, fit_sz(*value, dm_key_value_encoding))?;
            }
            dm_key_encoding.end(serializer)?;
            let dm_value_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.dm_value_encodings.get(key))
                .cloned()
                .unwrap_or_default();
            serializer.write_text_sz(value, dm_value_encoding.to_str_len_sz(value.len() as u64))?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.dm_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        self.encodings
