impl cbor_event::se::Serialize for Record {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_map(cbor_event::Len::Len(2))?;
        serializer.write_text("a")?;
        serializer.write_unsigned_integer(self.a)?;
        serializer.write_text("b")?;
        serializer.write_text(&self.b)?;
        Ok(serializer)
