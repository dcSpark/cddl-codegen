// This file was code-generated using an experimental CDDL to rust tool:
// https://github.com/dcSpark/cddl-codegen

use core::cell::RefCell;

wit_bindgen::generate!({
    path: "wit",
    world: "cddl-lib-world",
});

use exports::cddl::cddl_lib::types as wit_types;

struct Component;

impl wit_types::Guest for Component {
    type Record = WitRecord;
}

export!(Component);

/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitRecord(pub RefCell<cddl_lib::Record>);

impl wit_types::GuestRecord for WitRecord {
    fn new(a: u64, b: String) -> Self {
        let inner = cddl_lib::Record::new(a, b);
        WitRecord(RefCell::new(inner))
    }

    fn a(&self) -> u64 {
        let me = self.0.borrow();
        me.a
    }

    fn b(&self) -> String {
        let me = self.0.borrow();
        me.b.clone()
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::Record as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(&self.0.borrow())
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::Record, String> {
        <cddl_lib::Record as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::Record::new(WitRecord(RefCell::new(v))))
            .map_err(err)
    }
}
