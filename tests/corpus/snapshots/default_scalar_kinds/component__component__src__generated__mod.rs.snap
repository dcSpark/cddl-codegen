    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::BoolDefault, String> {
        <cddl_lib::BoolDefault as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::BoolDefault::new(WitBoolDefault(RefCell::new(v))))
            .map_err(err)
