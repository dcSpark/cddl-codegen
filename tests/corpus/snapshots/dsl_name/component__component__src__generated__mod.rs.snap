// This file was code-generated using an experimental CDDL to rust tool:
// https://github.com/dcSpark/cddl-codegen

use core::cell::RefCell;

wit_bindgen::generate!({
    path: "wit",
    world: "cddl-lib-world",
});

use exports::cddl::cddl_lib::types as wit_types;

struct Component;

impl wit_types::Guest for Component {
    type Named = WitNamed;
}

export!(Component);

/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitNamed(pub RefCell<cddl_lib::Named>);

impl wit_types::GuestNamed for WitNamed {
    fn new(address: Vec<u8>, checksum: u64) -> Self {
        let address = address.into_iter().collect();
        let inner = cddl_lib::Named::new(address, checksum);
        WitNamed(RefCell::new(inner))
    }

    fn address(&self) -> Vec<u8> {
        let me = self.0.borrow();
        me.address.iter().map(|x| *x).collect()
    }

    fn checksum(&self) -> u64 {
        let me = self.0.borrow();
        me.checksum
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::Named as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(&self.0.borrow())
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::Named, String> {
        <cddl_lib::Named as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::Named::new(WitNamed(RefCell::new(v))))
            .map_err(err)
    }
}
