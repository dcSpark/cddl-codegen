                        .into())
                    } else {
                        Ok(x)
                    }
                })? as u16)
            .map_err(|e: DeserializeError| e.annotate("u_16"))?;
            let u_32 = Ok(raw
                .unsigned_integer()
                .map_err(Into::<DeserializeError>::into)
                .and_then(|x| {
