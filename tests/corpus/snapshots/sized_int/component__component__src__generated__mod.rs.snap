// This file was code-generated using an experimental CDDL to rust tool:
// https://github.com/dcSpark/cddl-codegen

use core::cell::RefCell;

wit_bindgen::generate!({
    path: "wit",
    world: "cddl-lib-world",
});

use exports::cddl::cddl_lib::types as wit_types;

struct Component;

impl wit_types::Guest for Component {
    type BoundedInts = WitBoundedInts;
}

export!(Component);

/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitBoundedInts(pub RefCell<cddl_lib::BoundedInts>);

impl wit_types::GuestBoundedInts for WitBoundedInts {
    fn new(u8: u8, u16: u16, u32: u32, i8: i8) -> Self {
        let inner = cddl_lib::BoundedInts::new(u8, u16, u32, i8);
        WitBoundedInts(RefCell::new(inner))
    }

    fn u8(&self) -> u8 {
        let me = self.0.borrow();
        me.u_8
    }

    fn u16(&self) -> u16 {
        let me = self.0.borrow();
        me.u_16
    }

    fn u32(&self) -> u32 {
        let me = self.0.borrow();
        me.u_32
    }

    fn i8(&self) -> i8 {
        let me = self.0.borrow();
        me.i_8
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::BoundedInts as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::BoundedInts, String> {
        <cddl_lib::BoundedInts as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::BoundedInts::new(WitBoundedInts(RefCell::new(v))))
            .map_err(err)
    }
}
