        } else {
            serializer.write_negative_integer_sz(
                self.i_8 as i128,
                fit_sz(
                    (self.i_8 + 1).abs() as u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.i_8_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        }
        if self.i_64 >= 0 {
            serializer.write_unsigned_integer_sz(
                self.i_64 as u64,
                fit_sz(
                    self.i_64 as u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.i_64_encoding)
                        .unwrap_or_default(),
                ),
            )?;
