            ),
        )?;
        serializer.write_unsigned_integer_sz(
            self.u_32 as u64,
            fit_sz(
                self.u_32 as u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.u_32_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        if self.i_8 >= 0 {
            serializer.write_unsigned_integer_sz(
                self.i_8 as u64,
                fit_sz(
                    self.i_8 as u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.i_8_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        } else {
            serializer.write_negative_integer_sz(
                self.i_8 as i128,
                fit_sz(
                    (self.i_8 + 1).unsigned_abs() as u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.i_8_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
