                self.u_32 as u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.u_32_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        if self.i_8 >= 0 {
            serializer.write_unsigned_integer_sz(
                self.i_8 as u64,
                fit_sz(
                    self.i_8 as u64,
                    self.encodings
