// This file was code-generated using an experimental CDDL to rust tool:
// https://github.com/dcSpark/cddl-codegen

use core::cell::RefCell;

wit_bindgen::generate!({
    path: "wit",
    world: "cddl-lib-world",
});

use exports::cddl::cddl_lib::types as wit_types;

struct Component;

impl wit_types::Guest for Component {
    type HasBool = WitHasBool;
}

export!(Component);

/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitHasBool(pub RefCell<cddl_lib::HasBool>);

impl wit_types::GuestHasBool for WitHasBool {
    fn new(flag: bool) -> Self {
        let inner = cddl_lib::HasBool::new(flag);
        WitHasBool(RefCell::new(inner))
    }

    fn flag(&self) -> bool {
        let me = self.0.borrow();
        me.flag
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::HasBool as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(&self.0.borrow())
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::HasBool, String> {
        <cddl_lib::HasBool as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::HasBool::new(WitHasBool(RefCell::new(v))))
            .map_err(err)
    }
}
