        serializer.write_bytes(&self.m_zero_len)?;
        serializer.write_unsigned_integer(self.m_int_range)?;
        serializer.write_unsigned_integer(self.m_zero_exact)?;
        serializer.write_negative_integer_sz(
            -(self.m_nint_range as i128 + 1),
            cbor_event::Sz::canonical(self.m_nint_range),
        )?;
        if let Some(field) = &self.m_optional_size {
            serializer.write_bytes(field)?;
        }
        Ok(serializer)
    }
}

