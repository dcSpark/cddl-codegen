                .to_str_len_sz(self.m_zero_len.len() as u64),
        )?;
        serializer.write_unsigned_integer_sz(
            self.m_int_range,
            fit_sz(
                self.m_int_range,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.m_int_range_encoding)
