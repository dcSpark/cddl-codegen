pub struct BoundsMembers {
    pub m_exact_size: [u8; 3],
    pub m_zero_len: Vec<u8>,
    pub m_int_range: u64,
    pub m_zero_exact: u64,
    pub m_nint_range: u64,
    pub m_optional_size: Option<[u8; 3]>,
    pub encodings: Option<BoundsMembersEncoding>,
