                    found: bytes.len() as i128,
                    min: Some(3),
                    max: Some(3),
                })?;
        if m_zero_len.len() > 32 {
            return Err(DeserializeFailure::RangeCheck {
                found: m_zero_len.len() as i128,
                min: None,
                max: Some(32),
            }
            .into());
        }
        if m_int_range > 100 {
            return Err(DeserializeFailure::RangeCheck {
                found: m_int_range as i128,
                min: None,
                max: Some(100),
            }
            .into());
        }
        if m_zero_exact > 0 {
            return Err(DeserializeFailure::RangeCheck {
                found: m_zero_exact as i128,
                min: None,
                max: Some(0),
            }
            .into());
        }
        if m_nint_range > 99 {
            return Err(DeserializeFailure::RangeCheck {
                found: m_nint_range as i128,
                min: None,
                max: Some(99),
            }
            .into());
        }
        Ok(Self {
            m_exact_size,
            m_zero_len,
            m_int_range,
            m_zero_exact,
            m_nint_range,
            m_optional_size: None,
            encodings: None,
        })
    }
