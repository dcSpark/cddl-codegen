use std::collections::BTreeMap;
use wasm_bindgen::prelude::{wasm_bindgen, JsError, JsValue};

pub type MapU64ToText = Table;

#[derive(Clone, Debug)]
#[wasm_bindgen]
pub struct Table(cddl_lib::Table);

#[wasm_bindgen]
impl Table {
    pub fn new() -> Self {
        Self(BTreeMap::new())
    }

    pub fn len(&self) -> usize {
        self.0.len()
    }

    pub fn insert(&mut self, key: u64, value: String) -> Option<String> {
        self.0.insert(key, value)
    }

    pub fn get(&self, key: u64) -> Option<String> {
        self.0.get(&key).map(|v| v.clone())
    }

    pub fn keys(&self) -> Vec<u64> {
        self.0.keys().copied().collect::<Vec<_>>()
    }
}

impl From<cddl_lib::Table> for Table {
    fn from(native: cddl_lib::Table) -> Self {
        Self(native)
    }
}

impl From<Table> for cddl_lib::Table {
