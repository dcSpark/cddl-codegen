// This file was code-generated using an experimental CDDL to rust tool:
// https://github.com/dcSpark/cddl-codegen

use core::cell::RefCell;

wit_bindgen::generate!({
    path: "wit",
    world: "cddl-lib-world",
});

use exports::cddl::cddl_lib::types as wit_types;

struct Component;

impl wit_types::Guest for Component {
    type WrappedEnum = WitWrappedEnum;
}

export!(Component);

/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

fn fixed_enum_to_wit(v: &cddl_lib::FixedEnum) -> wit_types::FixedEnum {
    match v {
        cddl_lib::FixedEnum::I0 => wit_types::FixedEnum::I0,
        cddl_lib::FixedEnum::I1 => wit_types::FixedEnum::I1,
        cddl_lib::FixedEnum::I2 => wit_types::FixedEnum::I2,
    }
}

fn fixed_enum_from_wit(v: wit_types::FixedEnum) -> cddl_lib::FixedEnum {
    match v {
        wit_types::FixedEnum::I0 => cddl_lib::FixedEnum::I0,
        wit_types::FixedEnum::I1 => cddl_lib::FixedEnum::I1,
        wit_types::FixedEnum::I2 => cddl_lib::FixedEnum::I2,
    }
}

pub struct WitWrappedEnum(pub RefCell<cddl_lib::WrappedEnum>);

impl wit_types::GuestWrappedEnum for WitWrappedEnum {
    fn new(inner: wit_types::FixedEnum) -> Self {
        let inner = fixed_enum_from_wit(inner);
        let inner = cddl_lib::WrappedEnum::new(inner);
        WitWrappedEnum(RefCell::new(inner))
    }

    fn get(&self) -> wit_types::FixedEnum {
        let me = self.0.borrow();
        let inner = me.get().clone();
        fixed_enum_to_wit(&inner)
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::WrappedEnum as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::WrappedEnum, String> {
        <cddl_lib::WrappedEnum as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::WrappedEnum::new(WitWrappedEnum(RefCell::new(v))))
            .map_err(err)
    }
}
