        <cddl_lib::RangedContainer as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::RangedContainer::new(WitRangedContainer(RefCell::new(v))))
            .map_err(err)
    }
}

