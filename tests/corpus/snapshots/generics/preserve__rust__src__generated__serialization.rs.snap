        serializer.write_text_sz(
            &self.v,
            self.encodings
                .as_ref()
                .map(|encs| encs.v_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(self.v.len() as u64),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

