#[derive(Clone, Debug)]
pub struct RangedContainer {
    pub value: u64,
    pub encodings: Option<RangedContainerEncoding>,
}

impl RangedContainer {
    pub fn new(value: u64) -> Result<Self, DeserializeError> {
        if value < 1 || value > 10 {
            return Err(DeserializeFailure::RangeCheck {
                found: value as i128,
                min: Some(1),
                max: Some(10),
            }
            .into());
        }
        Ok(Self {
            value,
            encodings: None,
        })
    }
}

