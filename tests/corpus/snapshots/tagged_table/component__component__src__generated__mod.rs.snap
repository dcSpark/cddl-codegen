// This file was code-generated using an experimental CDDL to rust tool:
// https://github.com/dcSpark/cddl-codegen

use core::cell::RefCell;

wit_bindgen::generate!({
    path: "wit",
    world: "cddl-lib-world",
});

use exports::cddl::cddl_lib::types as wit_types;

struct Component;

impl wit_types::Guest for Component {
    type Holder = WitHolder;
    type TaggedTable = WitTaggedTable;
}

export!(Component);

/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitHolder(pub RefCell<cddl_lib::Holder>);

impl wit_types::GuestHolder for WitHolder {
    fn new(payload: wit_types::TaggedTableBorrow<'_>) -> Self {
        let payload = payload.get::<WitTaggedTable>().0.borrow().clone();
        let inner = cddl_lib::Holder::new(payload);
        WitHolder(RefCell::new(inner))
    }

    fn payload(&self) -> wit_types::TaggedTable {
        let me = self.0.borrow();
        wit_types::TaggedTable::new(WitTaggedTable(RefCell::new(me.payload.clone())))
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::Holder as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(&self.0.borrow())
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::Holder, String> {
        <cddl_lib::Holder as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::Holder::new(WitHolder(RefCell::new(v))))
            .map_err(err)
    }
}

pub struct WitTaggedTable(pub RefCell<cddl_lib::TaggedTable>);

impl wit_types::GuestTaggedTable for WitTaggedTable {
    fn new(inner: Vec<(String, u64)>) -> Self {
        let inner = inner.into_iter().collect();
        let inner = cddl_lib::TaggedTable::new(inner);
        WitTaggedTable(RefCell::new(inner))
    }

    fn get(&self) -> Vec<(String, u64)> {
        let me = self.0.borrow();
        let inner = me.get().clone();
        inner.iter().map(|(x0, x1)| (x0.clone(), *x1)).collect()
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::TaggedTable as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::TaggedTable, String> {
        <cddl_lib::TaggedTable as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::TaggedTable::new(WitTaggedTable(RefCell::new(v))))
            .map_err(err)
    }
}
