extern crate alloc;
use alloc::collections::BTreeMap;
use alloc::string::String;
use alloc::vec::Vec;
use super::*;
use crate::generated::error::*;
use cbor_event::de::Deserializer;
use cbor_event::se::{Serialize, Serializer};

impl cbor_event::se::Serialize for Holder {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array(cbor_event::Len::Len(1))?;
        serializer.write_map(cbor_event::Len::Len(self.table.len() as u64))?;
        for (key, value) in self.table.iter() {
            serializer.write_array(cbor_event::Len::Len(key.len() as u64))?;
            for element in key.iter() {
                serializer.write_unsigned_integer(*element)?;
            }
            serializer.write_unsigned_integer(*value)?;
        }
        Ok(serializer)
    }
}

impl Deserialize for Holder {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.array()?;
            let mut read_len = CBORReadLen::from(len);
            read_len.read_elems(1)?;
            read_len.finish()?;
            let table = (|| -> Result<_, DeserializeError> {
                let mut table_table = BTreeMap::new();
                let table_len = raw.map()?;
                while match table_len {
                    cbor_event::Len::Len(n) => (table_table.len() as u64) < n,
                    cbor_event::Len::Indefinite => true,
                } {
                    if matches!(table_len, cbor_event::Len::Indefinite)
                        && raw.cbor_type()? == cbor_event::Type::Special
                        && raw.special_break()?
                    {
                        break;
                    }
                    let mut table_key_arr = Vec::new();
                    let len = raw.array()?;
                    while match len {
                        cbor_event::Len::Len(n) => (table_key_arr.len() as u64) < n,
                        cbor_event::Len::Indefinite => true,
                    } {
                        if matches!(len, cbor_event::Len::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        table_key_arr.push(raw.unsigned_integer()?);
                    }
                    let table_key_arr = NonEmptyVec::try_from(table_key_arr)?;
                    let table_key = table_key_arr;
                    let table_value = raw.unsigned_integer()?;
                    if table_table.insert(table_key.clone(), table_value).is_some() {
                        return Err(DeserializeFailure::DuplicateKey(Key::Str(String::from(
                            "some complicated/unsupported type",
                        )))
                        .into());
                    }
                }
                Ok(table_table)
            })()
            .map_err(|e| e.annotate("table"))?;
            match len {
                cbor_event::Len::Len(_) => (),
                cbor_event::Len::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(Holder { table })
        })()
        .map_err(|e| e.annotate("Holder"))
    }
}
