            self.encodings
                .as_ref()
                .map(|encs| encs.table_encoding)
                .unwrap_or_default()
                .to_len_sz(self.table.len() as u64),
        )?;
        for (key, value) in self.table.iter() {
            let (table_key_encoding, table_key_elem_encodings) = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.table_key_encodings.get(key))
                .cloned()
                .unwrap_or_else(|| (LenEncoding::default(), Vec::new()));
            serializer.write_array_sz(table_key_encoding.to_len_sz(key.len() as u64))?;
            for (i, element) in key.iter().enumerate() {
                let table_key_elem_encoding =
                    table_key_elem_encodings.get(i).cloned().unwrap_or_default();
                serializer.write_unsigned_integer_sz(
                    *element,
                    fit_sz(*element, table_key_elem_encoding),
                )?;
            }
            table_key_encoding.end(serializer)?;
            let table_value_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.table_value_encodings.get(key))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*value, fit_sz(*value, table_value_encoding))?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.table_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
