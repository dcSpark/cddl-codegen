impl cbor_event::se::Serialize for Choice {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        match self {
            Choice::Hash {
                hash,
                hash_encoding,
            } => serializer.write_bytes_sz(
                hash.to_raw_bytes(),
                hash_encoding.to_str_len_sz(hash.to_raw_bytes().len() as u64),
            ),
            Choice::U64 {
                uint,
                uint_encoding,
            } => serializer.write_unsigned_integer_sz(*uint, fit_sz(*uint, *uint_encoding)),
        }
    }
}

