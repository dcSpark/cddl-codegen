                                .map(|bytes| (bytes, StringEncoding::from(enc)))
                                .map_err(|e| {
                                    DeserializeFailure::InvalidStructure(Box::new(e)).into()
                                })
                        })?;
                    Ok(Self::Hash {
                        hash,
                        hash_encoding,
                    })
                }
                cbor_event::Type::UnsignedInteger => {
                    let (uint, uint_encoding) =
                        raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                    Ok(Self::U64 {
                        uint,
                        uint_encoding,
