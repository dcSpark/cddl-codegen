            match field_index {
                0 => {
                    serializer.write_unsigned_integer_sz(
                        0u64,
                        fit_sz(
                            0u64,
                            self.encodings
                                .as_ref()
                                .map(|encs| encs.key_0_key_encoding)
                                .unwrap_or_default(),
                        ),
                    )?;
                    serializer.write_bytes_sz(
                        self.key_0.to_raw_bytes(),
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.key_0_encoding.clone())
                            .unwrap_or_default()
                            .to_str_len_sz(self.key_0.to_raw_bytes().len() as u64),
                    )?;
                }
                1 => {
                    if let Some(field) = &self.key_1 {
                        serializer.write_unsigned_integer_sz(
                            1u64,
                            fit_sz(
                                1u64,
                                self.encodings
                                    .as_ref()
                                    .map(|encs| encs.key_1_key_encoding)
                                    .unwrap_or_default(),
                            ),
                        )?;
                        field.serialize(serializer)?;
                    }
                }
                2 => {
                    serializer.write_unsigned_integer_sz(
                        2u64,
                        fit_sz(
                            2u64,
                            self.encodings
                                .as_ref()
                                .map(|encs| encs.key_2_key_encoding)
                                .unwrap_or_default(),
                        ),
                    )?;
                    serializer.write_map_sz(
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.key_2_encoding)
                            .unwrap_or_default()
                            .to_len_sz(self.key_2.len() as u64),
                    )?;
                    for (key, value) in self.key_2.iter() {
                        let key_2_key_encoding = self
                            .encodings
                            .as_ref()
                            .and_then(|encs| encs.key_2_key_encodings.get(key))
                            .cloned()
                            .unwrap_or_default();
                        serializer.write_bytes_sz(
                            key.to_raw_bytes(),
                            key_2_key_encoding.to_str_len_sz(key.to_raw_bytes().len() as u64),
                        )?;
                        let key_2_value_encoding = self
                            .encodings
                            .as_ref()
                            .and_then(|encs| encs.key_2_value_encodings.get(key))
                            .cloned()
                            .unwrap_or_default();
                        serializer.write_unsigned_integer_sz(
                            *value,
                            fit_sz(*value, key_2_value_encoding),
                        )?;
                    }
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.key_2_encoding)
                        .unwrap_or_default()
                        .end(serializer)?;
                }
                _ => unreachable!(),
            };
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
