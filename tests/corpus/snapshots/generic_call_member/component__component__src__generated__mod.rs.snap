// This file was code-generated using an experimental CDDL to rust tool:
// https://github.com/dcSpark/cddl-codegen

use core::cell::RefCell;

wit_bindgen::generate!({
    path: "wit",
    world: "cddl-lib-world",
});

use exports::cddl::cddl_lib::types as wit_types;

struct Component;

impl wit_types::Guest for Component {
    type PairU64Text = WitPairU64Text;
    type X = WitX;
}

export!(Component);

/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitPairU64Text(pub RefCell<cddl_lib::PairU64Text>);

impl wit_types::GuestPairU64Text for WitPairU64Text {
    fn new(a: u64, b: String) -> Self {
        let inner = cddl_lib::PairU64Text::new(a, b);
        WitPairU64Text(RefCell::new(inner))
    }

    fn a(&self) -> u64 {
        let me = self.0.borrow();
        me.a
    }

    fn b(&self) -> String {
        let me = self.0.borrow();
        me.b.clone()
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::PairU64Text as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::PairU64Text, String> {
        <cddl_lib::PairU64Text as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::PairU64Text::new(WitPairU64Text(RefCell::new(v))))
            .map_err(err)
    }
}

pub struct WitX(pub RefCell<cddl_lib::X>);

impl wit_types::GuestX for WitX {
    fn new(pair: wit_types::PairU64TextBorrow<'_>) -> Self {
        let pair = pair.get::<WitPairU64Text>().0.borrow().clone();
        let inner = cddl_lib::X::new(pair);
        WitX(RefCell::new(inner))
    }

    fn pair(&self) -> wit_types::PairU64Text {
        let me = self.0.borrow();
        wit_types::PairU64Text::new(WitPairU64Text(RefCell::new(me.pair.clone())))
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::X as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(&self.0.borrow())
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::X, String> {
        <cddl_lib::X as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::X::new(WitX(RefCell::new(v))))
            .map_err(err)
    }
}
