        cddl_lib::any_cbor::AnyCborKind::UInt => wit_types::AnyCborKind::Uint,
        cddl_lib::any_cbor::AnyCborKind::NInt => wit_types::AnyCborKind::Nint,
        cddl_lib::any_cbor::AnyCborKind::Bytes => wit_types::AnyCborKind::Bytes,
        cddl_lib::any_cbor::AnyCborKind::Text => wit_types::AnyCborKind::Text,
        cddl_lib::any_cbor::AnyCborKind::Array => wit_types::AnyCborKind::Array,
        cddl_lib::any_cbor::AnyCborKind::Map => wit_types::AnyCborKind::Map,
        cddl_lib::any_cbor::AnyCborKind::Tag => wit_types::AnyCborKind::Tag,
        cddl_lib::any_cbor::AnyCborKind::Bool => wit_types::AnyCborKind::Bool,
        cddl_lib::any_cbor::AnyCborKind::Null => wit_types::AnyCborKind::Null,
        cddl_lib::any_cbor::AnyCborKind::Undefined => wit_types::AnyCborKind::Undefined,
        cddl_lib::any_cbor::AnyCborKind::Unassigned => wit_types::AnyCborKind::Unassigned,
        cddl_lib::any_cbor::AnyCborKind::Float => wit_types::AnyCborKind::Float,
    }
}

