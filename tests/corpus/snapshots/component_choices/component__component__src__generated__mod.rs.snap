        let l = l.get::<WitLabel>().0.borrow().clone();
        let n = n.get::<WitNode>().0.borrow().clone();
        let history = history
            .into_iter()
            .map(|x| x.get::<WitOutcome>().0.borrow().clone())
            .collect();
        let inner = cddl_lib::Holder::new(o, l, n, history);
        WitHolder(RefCell::new(inner))
    }

    fn o(&self) -> wit_types::Outcome {
        let me = self.0.borrow();
        wit_types::Outcome::new(WitOutcome(RefCell::new(me.o.clone())))
    }

    fn l(&self) -> wit_types::Label {
        let me = self.0.borrow();
        wit_types::Label::new(WitLabel(RefCell::new(me.l.clone())))
    }

    fn n(&self) -> wit_types::Node {
        let me = self.0.borrow();
        wit_types::Node::new(WitNode(RefCell::new(me.n.clone())))
    }

    fn history(&self) -> Vec<wit_types::Outcome> {
        let me = self.0.borrow();
        me.history
            .iter()
            .map(|x| wit_types::Outcome::new(WitOutcome(RefCell::new(x.clone()))))
            .collect()
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::Holder as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(&self.0.borrow())
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::Holder, String> {
        <cddl_lib::Holder as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::Holder::new(WitHolder(RefCell::new(v))))
            .map_err(err)
