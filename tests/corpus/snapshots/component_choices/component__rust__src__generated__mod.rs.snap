    }
}

#[derive(Clone, Debug)]
pub enum Outcome {
    U64(u64),
    Text(String),
    Stamp(Stamp),
    Null,
}

impl Outcome {
    pub fn new_uint(uint: u64) -> Result<Self, DeserializeError> {
        if uint > 5 {
            return Err(DeserializeFailure::RangeCheck {
                found: uint as i128,
                min: None,
                max: Some(5),
            }
            .into());
        }
        Ok(Self::U64(uint))
    }

    pub fn new_text(text: String) -> Self {
        Self::Text(text)
    }

    pub fn new_stamp(stamp: Stamp) -> Self {
        Self::Stamp(stamp)
    }

    pub fn new_null() -> Self {
        Self::Null
    }
}

#[derive(Clone, Debug)]
pub struct Stamp(pub(crate) Vec<u8>);

impl Stamp {
    pub fn get(&self) -> &Vec<u8> {
        &self.0
    }

    pub fn new(inner: Vec<u8>) -> Result<Self, DeserializeError> {
        if inner.len() != 4 {
            return Err(DeserializeError::new(
                "Stamp",
                DeserializeFailure::RangeCheck {
                    found: inner.len() as i128,
                    min: Some(4),
                    max: Some(4),
                },
            ));
        }
        Ok(Self(inner))
    }
}

impl TryFrom<Vec<u8>> for Stamp {
    type Error = DeserializeError;

    fn try_from(inner: Vec<u8>) -> Result<Self, Self::Error> {
        Stamp::new(inner)
    }
}

impl From<Stamp> for Vec<u8> {
    fn from(wrapper: Stamp) -> Self {
        wrapper.0
    }
}
