    pub l: Label,
    pub n: Node,
    pub history: Vec<Outcome>,
}

impl Holder {
    pub fn new(o: Outcome, l: Label, n: Node, history: Vec<Outcome>) -> Self {
        Self { o, l, n, history }
    }
}

#[derive(Clone, Debug)]
pub enum Label {
    Labels(Labels),
    U64(u64),
}

impl Label {
    pub fn new_labels(labels: Labels) -> Self {
        Self::Labels(labels)
    }

    pub fn new_uint(uint: u64) -> Self {
        Self::U64(uint)
    }
}

/// `[+ String]`: at least one element, enforced at the `NonEmptyVec` `TryFrom<Vec<_>>` door (the CBOR decoder routes through the same door, so wire-side and API-side rejection are identical).
pub type Labels = NonEmptyVec<String>;

#[derive(Clone, Debug)]
pub enum Node {
    Node0(Stamp),
    Node1(Node1),
    I2,
}

impl Node {
    pub fn new_node0(leaf: Stamp) -> Result<Self, DeserializeError> {
        Ok(Self::Node0(leaf))
    }

    pub fn new_node1(x: u64, y: String) -> Self {
        Self::Node1(Node1::new(x, y))
    }

    pub fn new_i2() -> Self {
        Self::I2
    }
}

#[derive(Clone, Debug)]
pub struct Node1 {
