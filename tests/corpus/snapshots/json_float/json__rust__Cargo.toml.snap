[package]
name = "cddl-lib"
version = "0.1.0"
edition = "2024"

[package.metadata.cddl-codegen]
generated-with = "0.1.0"

[lib]
crate-type = ["cdylib", "rlib"]

[dependencies]
cbor_event = { git = "https://github.com/dcSpark/cbor_event", rev = "e2bca6d257f70ab0c226c4efd0726d3f5c1b4490" }
serde = { version = "1.0", features = ["derive"] }
serde_json = { version = "1.0.57", features = ["float_roundtrip"] }
schemars = "1.2.1"

[features]
wasm = []
