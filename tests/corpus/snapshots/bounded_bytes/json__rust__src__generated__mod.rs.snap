use std::convert::TryFrom;

#[derive(Clone, Debug)]
pub struct Hash(Vec<u8>);

impl Hash {
    pub fn new(inner: Vec<u8>) -> Result<Self, DeserializeError> {
        if inner.len() > 32 {
            return Err(DeserializeError::new(
                "Hash",
                DeserializeFailure::RangeCheck {
                    found: inner.len() as isize,
                    min: Some(0),
                    max: Some(32),
                },
            ));
