}

#[derive(Clone, Debug)]
pub struct Outer {
    pub x: u64,
    pub inner: Inner,
    pub y: u64,
}

impl Outer {
    pub fn new(x: u64, inner: Inner, y: u64) -> Self {
        Self { x, inner, y }
    }
}
