                let mut named_table = BTreeMap::new();
                let named_len = raw.map()?;
                while match named_len {
                    cbor_event::Len::Len(n) => (named_table.len() as u64) < n,
                    cbor_event::Len::Indefinite => true,
                } {
                    if let cbor_event::Len::Indefinite = named_len {
                        if raw.cbor_type()? == cbor_event::Type::Special && raw.special_break()? {
                            break;
                        }
                    }
                    let named_key = bool::deserialize(raw)?;
                    let named_value = raw.unsigned_integer()? as u64;
                    if named_table.insert(named_key, named_value).is_some() {
                        return Err(DeserializeFailure::DuplicateKey(Key::Str(String::from(
                            "some complicated/unsupported type",
                        )))
                        .into());
                    }
                }
                Ok(named_table)
            })()
            .map_err(|e| e.annotate("named"))?;
            let inline = (|| -> Result<_, DeserializeError> {
                let mut inline_table = BTreeMap::new();
                let inline_len = raw.map()?;
                while match inline_len {
                    cbor_event::Len::Len(n) => (inline_table.len() as u64) < n,
                    cbor_event::Len::Indefinite => true,
                } {
                    if let cbor_event::Len::Indefinite = inline_len {
                        if raw.cbor_type()? == cbor_event::Type::Special && raw.special_break()? {
                            break;
                        }
                    }
                    let inline_key = bool::deserialize(raw)?;
                    let inline_value = raw.unsigned_integer()? as u64;
                    if inline_table.insert(inline_key, inline_value).is_some() {
                        return Err(DeserializeFailure::DuplicateKey(Key::Str(String::from(
                            "some complicated/unsupported type",
                        )))
                        .into());
                    }
                }
                Ok(inline_table)
            })()
            .map_err(|e| e.annotate("inline"))?;
            match len {
                cbor_event::Len::Len(_) => (),
                cbor_event::Len::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
