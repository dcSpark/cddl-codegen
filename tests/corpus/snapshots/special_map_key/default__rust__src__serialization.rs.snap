impl cbor_event::se::Serialize for BkeyHolder {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array(cbor_event::Len::Len(2))?;
        serializer.write_map(cbor_event::Len::Len(self.named.len() as u64))?;
        for (key, value) in self.named.iter() {
            serializer.write_special(cbor_event::Special::Bool(*key))?;
            serializer.write_unsigned_integer(*value)?;
        }
        serializer.write_map(cbor_event::Len::Len(self.inline.len() as u64))?;
        for (key, value) in self.inline.iter() {
            serializer.write_special(cbor_event::Special::Bool(*key))?;
            serializer.write_unsigned_integer(*value)?;
        }
        Ok(serializer)
    }
}

