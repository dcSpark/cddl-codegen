#[wasm_bindgen]
pub struct BkeysExact(pub(crate) BoundedMap<bool, u64, 1, 1>);

#[wasm_bindgen]
impl BkeysExact {
    pub fn len(&self) -> usize {
        self.0.len()
    }

    pub fn insert(&mut self, key: bool, value: u64) -> Result<Option<u64>, JsError> {
        self.0
            .insert(key, value)
            .map_err(|e| JsError::new(&e.to_string()))
    }

    pub fn get(&self, key: bool) -> Option<u64> {
        self.0.get(&key).copied()
    }

    pub fn keys(&self) -> BoolList {
        BoolList(self.0.keys().copied().collect::<Vec<_>>())
    }

    pub fn try_from(map: &MapBoolToU64) -> Result<BkeysExact, JsError> {
        let inner: BTreeMap<bool, u64> = map.clone().into();
        BoundedMap::try_from(inner)
            .map(Self)
            .map_err(|e| JsError::new(&e.to_string()))
    }
}

