// This file was code-generated using an experimental CDDL to rust tool:
// https://github.com/dcSpark/cddl-codegen

use core::cell::RefCell;

wit_bindgen::generate!({
    path: "wit",
    world: "cddl-lib-world",
});

use exports::cddl::cddl_lib::types as wit_types;

struct Component;

impl wit_types::Guest for Component {
    type Inner = WitInner;
    type Wrapped = WitWrapped;
}

export!(Component);

/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitInner(pub RefCell<cddl_lib::Inner>);

impl wit_types::GuestInner for WitInner {
    fn new(index0: u64, index1: String) -> Self {
        let inner = cddl_lib::Inner::new(index0, index1);
        WitInner(RefCell::new(inner))
    }

    fn index0(&self) -> u64 {
        let me = self.0.borrow();
        me.index_0
    }

    fn index1(&self) -> String {
        let me = self.0.borrow();
        me.index_1.clone()
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::Inner as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(&self.0.borrow())
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::Inner, String> {
        <cddl_lib::Inner as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::Inner::new(WitInner(RefCell::new(v))))
            .map_err(err)
    }
}

pub struct WitWrapped(pub RefCell<cddl_lib::Wrapped>);

impl wit_types::GuestWrapped for WitWrapped {
    fn new(inner: wit_types::InnerBorrow<'_>) -> Self {
        let inner = inner.get::<WitInner>().0.borrow().clone();
        let inner = cddl_lib::Wrapped::new(inner);
        WitWrapped(RefCell::new(inner))
    }

    fn get(&self) -> wit_types::Inner {
        let me = self.0.borrow();
        let inner = me.get().clone();
        wit_types::Inner::new(WitInner(RefCell::new(inner.clone())))
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::Wrapped as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(&self.0.borrow())
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::Wrapped, String> {
        <cddl_lib::Wrapped as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::Wrapped::new(WitWrapped(RefCell::new(v))))
            .map_err(err)
    }
}
