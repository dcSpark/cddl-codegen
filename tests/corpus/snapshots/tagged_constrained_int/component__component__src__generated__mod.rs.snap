/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitGarm(pub RefCell<cddl_lib::Garm>);

impl wit_types::GuestGarm for WitGarm {
    fn new_ga(ga: i64) -> Result<wit_types::Garm, String> {
        let inner = cddl_lib::Garm::new_ga(ga).map_err(err)?;
        Ok(wit_types::Garm::new(WitGarm(RefCell::new(inner))))
    }

    fn as_ga(&self) -> Option<i64> {
        let me = self.0.borrow();
        match &*me {
            cddl_lib::Garm::Ga(ga) => Some(*ga),
            _ => None,
        }
    }

    fn new_gb(gb: String) -> wit_types::Garm {
        let inner = cddl_lib::Garm::new_gb(gb);
        wit_types::Garm::new(WitGarm(RefCell::new(inner)))
    }

    fn as_gb(&self) -> Option<String> {
        let me = self.0.borrow();
        match &*me {
            cddl_lib::Garm::Gb(gb) => Some(gb.clone()),
            _ => None,
        }
    }

    fn kind(&self) -> wit_types::GarmKind {
        let me = self.0.borrow();
        match &*me {
            cddl_lib::Garm::Ga(_) => wit_types::GarmKind::Ga,
            cddl_lib::Garm::Gb(_) => wit_types::GarmKind::Gb,
        }
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::Garm as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(&self.0.borrow())
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::Garm, String> {
        <cddl_lib::Garm as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::Garm::new(WitGarm(RefCell::new(v))))
            .map_err(err)
    }
}

