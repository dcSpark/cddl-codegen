}

impl Deserialize for TaggedRangeUint {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let (inner, inner_tag_encoding, inner_encoding) = match raw.tag_sz()? {
                (11, tag_enc) => raw
                    .unsigned_integer_sz()
                    .map(|(x, enc)| (x, Some(tag_enc), Some(enc)))?,
                (tag, _enc) => {
                    return Err(DeserializeFailure::TagMismatch {
                        found: tag,
                        expected: 11,
                    }
                    .into())
                }
            };
            if inner < 3 || inner > 9 {
                return Err(DeserializeFailure::RangeCheck {
                    found: inner as isize,
                    min: Some(3),
                    max: Some(9),
                }
                .into());
            }
            Ok(Self {
                inner,
                encodings: Some(TaggedRangeUintEncoding {
                    inner_tag_encoding,
                    inner_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("TaggedRangeUint"))
    }
}
