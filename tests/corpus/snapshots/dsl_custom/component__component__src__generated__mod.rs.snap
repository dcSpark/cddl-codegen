// This file was code-generated using an experimental CDDL to rust tool:
// https://github.com/dcSpark/cddl-codegen

use core::cell::RefCell;

wit_bindgen::generate!({
    path: "wit",
    world: "cddl-lib-world",
});

use exports::cddl::cddl_lib::types as wit_types;

struct Component;

impl wit_types::Guest for Component {
    type CustomNewtype = WitCustomNewtype;
    type Customized = WitCustomized;
}

export!(Component);

/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitCustomNewtype(pub RefCell<cddl_lib::CustomNewtype>);

impl wit_types::GuestCustomNewtype for WitCustomNewtype {
    fn new(inner: u64) -> Self {
        let inner = cddl_lib::CustomNewtype::new(inner);
        WitCustomNewtype(RefCell::new(inner))
    }

    fn get(&self) -> u64 {
        let me = self.0.borrow();
        let inner = me.get().clone();
        inner
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::CustomNewtype as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::CustomNewtype, String> {
        <cddl_lib::CustomNewtype as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::CustomNewtype::new(WitCustomNewtype(RefCell::new(v))))
            .map_err(err)
    }
}

pub struct WitCustomized(pub RefCell<cddl_lib::Customized>);

impl wit_types::GuestCustomized for WitCustomized {
    fn new(field: String) -> Self {
        let inner = cddl_lib::Customized::new(field);
        WitCustomized(RefCell::new(inner))
    }

    fn field(&self) -> String {
        let me = self.0.borrow();
        me.field.clone()
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::Customized as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::Customized, String> {
        <cddl_lib::Customized as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::Customized::new(WitCustomized(RefCell::new(v))))
            .map_err(err)
    }
}
