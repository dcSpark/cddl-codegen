---
source: src/snapshot_tests.rs
expression: content
---
macro_rules! gen_json_schema {
    ($name:ty) => {
        let dest_path =
            std::path::Path::new(&"schemas").join(&format!("{}.json", stringify!($name)));
        std::fs::write(
            &dest_path,
            serde_json::to_string_pretty(&schemars::schema_for!($name)).unwrap(),
        )
        .unwrap();
    };
}

pub fn export_schemas() {
    let schema_path = std::path::Path::new(&"schemas");
    if !schema_path.exists() {
        std::fs::create_dir(schema_path).unwrap();
    }
    gen_json_schema!(cddl_lib::Int);
    gen_json_schema!(cddl_lib::Prelude);
    gen_json_schema!(cddl_lib::PreludeB64legacy);
    gen_json_schema!(cddl_lib::PreludeB64url);
    gen_json_schema!(cddl_lib::PreludeBigfloat);
    gen_json_schema!(cddl_lib::PreludeBigint);
    gen_json_schema!(cddl_lib::PreludeBignint);
    gen_json_schema!(cddl_lib::PreludeBiguint);
    gen_json_schema!(cddl_lib::PreludeDecfrac);
    gen_json_schema!(cddl_lib::PreludeEncodedCbor);
    gen_json_schema!(cddl_lib::PreludeInteger);
    gen_json_schema!(cddl_lib::PreludeMimeMessage);
    gen_json_schema!(cddl_lib::PreludeRegexp);
    gen_json_schema!(cddl_lib::PreludeTdate);
    gen_json_schema!(cddl_lib::PreludeUnsigned);
    gen_json_schema!(cddl_lib::PreludeUri);
}
