#[derive(Clone, Debug)]
pub enum PreludeBigint {
    PreludeBiguint {
        prelude_biguint: PreludeBiguint,
        prelude_biguint_tag_encoding: Option<cbor_event::Sz>,
        prelude_biguint_encoding: StringEncoding,
    },
    PreludeBignint {
        prelude_bignint: PreludeBignint,
        prelude_bignint_tag_encoding: Option<cbor_event::Sz>,
        prelude_bignint_encoding: StringEncoding,
    },
}

impl PreludeBigint {
    pub fn new_prelude_biguint(prelude_biguint: PreludeBiguint) -> Self {
        Self::PreludeBiguint {
            prelude_biguint,
            prelude_biguint_tag_encoding: None,
            prelude_biguint_encoding: StringEncoding::default(),
        }
    }

    pub fn new_prelude_bignint(prelude_bignint: PreludeBignint) -> Self {
        Self::PreludeBignint {
            prelude_bignint,
            prelude_bignint_tag_encoding: None,
            prelude_bignint_encoding: StringEncoding::default(),
        }
    }
}

