        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        match self {
            PreludeInteger::Int(int) => int.serialize(serializer),
            PreludeInteger::PreludeBigint(prelude_bigint) => prelude_bigint.serialize(serializer),
        }
    }
}

impl Deserialize for PreludeInteger {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            match raw.cbor_type()? {
                cbor_event::Type::Array | cbor_event::Type::Map => {
                    Ok(PreludeInteger::Int(Int::deserialize(raw)?))
                }
                cbor_event::Type::Tag => Ok(PreludeInteger::PreludeBigint(
                    PreludeBigint::deserialize(raw)?,
                )),
                _ => Err(DeserializeError::new(
                    "PreludeInteger",
                    DeserializeFailure::NoVariantMatched,
                )),
            }
        })()
        .map_err(|e| e.annotate("PreludeInteger"))
    }
}

impl cbor_event::se::Serialize for PreludeUnsigned {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        match self {
            PreludeUnsigned::U64 {
                uint,
                uint_encoding,
            } => serializer.write_unsigned_integer_sz(*uint, fit_sz(*uint, *uint_encoding)),
            PreludeUnsigned::PreludeBiguint {
                prelude_biguint,
                prelude_biguint_tag_encoding,
                prelude_biguint_encoding,
            } => {
                serializer.write_tag_sz(2u64, fit_sz(2u64, *prelude_biguint_tag_encoding))?;
                serializer.write_bytes_sz(
                    &prelude_biguint,
                    prelude_biguint_encoding.to_str_len_sz(prelude_biguint.len() as u64),
                )
            }
        }
    }
}

impl Deserialize for PreludeUnsigned {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            match raw.cbor_type()? {
                cbor_event::Type::UnsignedInteger => {
                    let (uint, uint_encoding) =
                        raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                    Ok(Self::U64 {
                        uint,
                        uint_encoding,
                    })
                }
                cbor_event::Type::Tag => {
                    let (prelude_biguint, prelude_biguint_tag_encoding, prelude_biguint_encoding) =
                        match raw.tag_sz()? {
                            (2, tag_enc) => raw.bytes_sz().map(|(bytes, enc)| {
                                (bytes, Some(tag_enc), StringEncoding::from(enc))
                            })?,
                            (tag, _enc) => {
                                return Err(DeserializeFailure::TagMismatch {
                                    found: tag,
                                    expected: 2,
                                }
                                .into())
                            }
                        };
                    Ok(Self::PreludeBiguint {
                        prelude_biguint,
                        prelude_biguint_tag_encoding,
                        prelude_biguint_encoding,
                    })
                }
                _ => Err(DeserializeError::new(
                    "PreludeUnsigned",
                    DeserializeFailure::NoVariantMatched,
                )),
            }
        })()
        .map_err(|e| e.annotate("PreludeUnsigned"))
    }
}
