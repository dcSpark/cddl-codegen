pub struct WitPreludeUnsigned(pub RefCell<cddl_lib::PreludeUnsigned>);

impl wit_types::GuestPreludeUnsigned for WitPreludeUnsigned {
    fn new_uint(uint: u64) -> wit_types::PreludeUnsigned {
        let inner = cddl_lib::PreludeUnsigned::new_uint(uint);
        wit_types::PreludeUnsigned::new(WitPreludeUnsigned(RefCell::new(inner)))
    }

    fn as_uint(&self) -> Option<u64> {
        let me = self.0.borrow();
        match &*me {
            cddl_lib::PreludeUnsigned::U64(uint) => Some(*uint),
            _ => None,
        }
    }

    fn new_prelude_biguint(
        prelude_biguint: wit_types::PreludeBiguintBorrow<'_>,
    ) -> wit_types::PreludeUnsigned {
        let prelude_biguint = prelude_biguint
            .get::<WitPreludeBiguint>()
            .0
            .borrow()
            .clone();
        let inner = cddl_lib::PreludeUnsigned::new_prelude_biguint(prelude_biguint);
        wit_types::PreludeUnsigned::new(WitPreludeUnsigned(RefCell::new(inner)))
    }

    fn as_prelude_biguint(&self) -> Option<wit_types::PreludeBiguint> {
        let me = self.0.borrow();
        match &*me {
            cddl_lib::PreludeUnsigned::PreludeBiguint(prelude_biguint) => {
                Some(wit_types::PreludeBiguint::new(WitPreludeBiguint(
                    RefCell::new(prelude_biguint.clone()),
                )))
            }
            _ => None,
        }
    }

    fn kind(&self) -> wit_types::PreludeUnsignedKind {
        let me = self.0.borrow();
        match &*me {
            cddl_lib::PreludeUnsigned::U64(_) => wit_types::PreludeUnsignedKind::Uint,
            cddl_lib::PreludeUnsigned::PreludeBiguint(_) => {
                wit_types::PreludeUnsignedKind::PreludeBiguint
            }
        }
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::PreludeUnsigned as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::PreludeUnsigned, String> {
        <cddl_lib::PreludeUnsigned as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::PreludeUnsigned::new(WitPreludeUnsigned(RefCell::new(v))))
            .map_err(err)
    }
}

