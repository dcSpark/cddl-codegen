pub type Bkeys = OrderedHashMap<Vec<u8>, u64>;

#[derive(Clone, Debug)]
pub struct BytesKeyHolder {
    pub named: Bkeys,
    pub inline: OrderedHashMap<Vec<u8>, u64>,
    pub encodings: Option<BytesKeyHolderEncoding>,
}

impl BytesKeyHolder {
    pub fn new(named: Bkeys, inline: OrderedHashMap<Vec<u8>, u64>) -> Self {
        Self {
            named,
            inline,
            encodings: None,
        }
    }
}

pub type BytesList = Vec<Vec<u8>>;
