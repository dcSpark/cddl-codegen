impl cbor_event::se::Serialize for FixedFields {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array(cbor_event::Len::Len(3))?;
        serializer.write_unsigned_integer(self.a)?;
        serializer.write_text("marker")?;
        serializer.write_unsigned_integer(5u64)?;
        Ok(serializer)
    }
}

impl Deserialize for FixedFields {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let len = raw.array()?;
        let mut read_len = CBORReadLen::new(len);
        read_len.read_elems(3)?;
        read_len.finish()?;
        (|| -> Result<_, DeserializeError> {
            let a = Ok(raw.unsigned_integer()? as u64)
                .map_err(|e: DeserializeError| e.annotate("a"))?;
            (|| -> Result<_, DeserializeError> {
                let b_value = raw.text()?;
                if b_value != "marker" {
                    return Err(DeserializeFailure::FixedValueMismatch {
                        found: Key::Str(b_value),
                        expected: Key::Str(String::from("marker")),
                    }
                    .into());
                }
                Ok(())
            })()
            .map_err(|e| e.annotate("b"))?;
            (|| -> Result<_, DeserializeError> {
                let c_value = raw.unsigned_integer()?;
                if c_value != 5 {
                    return Err(DeserializeFailure::FixedValueMismatch {
                        found: Key::Uint(c_value),
                        expected: Key::Uint(5),
                    }
                    .into());
                }
                Ok(())
            })()
            .map_err(|e| e.annotate("c"))?;
            match len {
                cbor_event::Len::Len(_) => (),
                cbor_event::Len::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(FixedFields { a })
        })()
        .map_err(|e| e.annotate("FixedFields"))
    }
