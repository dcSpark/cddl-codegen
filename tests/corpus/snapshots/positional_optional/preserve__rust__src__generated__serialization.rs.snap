impl cbor_event::se::Serialize for PositionalOptional {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(1),
        )?;
        match &self.uint {
            Some(x) => {
                serializer.write_unsigned_integer_sz(
                    *x,
                    fit_sz(
                        *x,
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.uint_encoding)
                            .unwrap_or_default(),
                    ),
                )?;
            }
            None => {
                serializer.write_special(cbor_event::Special::Null)?;
            }
        };
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

