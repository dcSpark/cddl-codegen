// This file was code-generated using an experimental CDDL to rust tool:
// https://github.com/dcSpark/cddl-codegen

use core::cell::RefCell;

wit_bindgen::generate!({
    path: "wit",
    world: "cddl-lib-world",
});

use exports::cddl::cddl_lib::types as wit_types;

struct Component;

impl wit_types::Guest for Component {
    type PositionalOptional = WitPositionalOptional;
}

export!(Component);

/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitPositionalOptional(pub RefCell<cddl_lib::PositionalOptional>);

impl wit_types::GuestPositionalOptional for WitPositionalOptional {
    fn new(uint: Option<u64>) -> Self {
        let inner = cddl_lib::PositionalOptional::new(uint);
        WitPositionalOptional(RefCell::new(inner))
    }

    fn uint(&self) -> Option<u64> {
        let me = self.0.borrow();
        me.uint.as_ref().map(|x| *x)
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::PositionalOptional as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::PositionalOptional, String> {
        <cddl_lib::PositionalOptional as cddl_lib::serialization::Deserialize>::from_cbor_bytes(
            &bytes,
        )
        .map(|v| wit_types::PositionalOptional::new(WitPositionalOptional(RefCell::new(v))))
        .map_err(err)
    }
}
