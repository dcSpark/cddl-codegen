impl Serialize for ClippyNegBounded {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
        force_canonical: bool,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(1, force_canonical),
        )?;
        serializer.write_negative_integer_sz(
            -(self.neg as i128 + 1),
            fit_sz(
                self.neg,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.neg_encoding)
                    .unwrap_or_default(),
                force_canonical,
            ),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer, force_canonical)
    }
}

impl Deserialize for ClippyNegBounded {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.array_sz()?;
            let len_encoding: LenEncoding = len.into();
            let mut read_len = CBORReadLen::new(len);
            read_len.read_elems(1)?;
            read_len.finish()?;
            let (neg, neg_encoding) = raw
                .negative_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .and_then(|(x, enc)| {
                    if x < -100 {
                        Err(DeserializeFailure::RangeCheck {
                            found: x,
                            min: Some(-100),
                            max: None,
                        }
                        .into())
                    } else {
                        Ok(((x + 1).unsigned_abs() as u64, Some(enc)))
                    }
                })
                .map_err(|e: DeserializeError| e.annotate("neg"))?;
            match len {
                cbor_event::LenSz::Len(_, _) => (),
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(ClippyNegBounded {
                neg,
                encodings: Some(ClippyNegBoundedEncoding {
                    len_encoding,
                    neg_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("ClippyNegBounded"))
    }
}

impl Serialize for ClippyWrappedMap {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
        force_canonical: bool,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_map_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.inner_encoding)
                .unwrap_or_default()
                .to_len_sz(self.inner.len() as u64, force_canonical),
        )?;
        let mut key_order = self
            .inner
            .iter()
            .map(|(k, v)| {
                let mut buf = cbor_event::se::Serializer::new_vec();
                let inner_key_encoding = self
                    .encodings
                    .as_ref()
                    .and_then(|encs| encs.inner_key_encodings.get(k))
                    .cloned()
                    .unwrap_or_default();
                buf.write_unsigned_integer_sz(*k, fit_sz(*k, inner_key_encoding, force_canonical))?;
                Ok((buf.finalize(), k, v))
            })
            .collect::<Result<Vec<(Vec<u8>, &_, &_)>, cbor_event::Error>>()?;
        if force_canonical {
            key_order.sort_by(|(lhs_bytes, _, _), (rhs_bytes, _, _)| {
                cbor_canonical_key_cmp(lhs_bytes, rhs_bytes)
            });
        }
        for (key_bytes, key, value) in key_order {
            serializer.write_raw_bytes(&key_bytes)?;
            let inner_value_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.inner_value_encodings.get(key))
                .cloned()
                .unwrap_or_default();
            serializer.write_text_sz(
                value,
                inner_value_encoding.to_str_len_sz(value.len() as u64, force_canonical),
            )?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.inner_encoding)
            .unwrap_or_default()
            .end(serializer, force_canonical)
    }
}

impl Deserialize for ClippyWrappedMap {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let mut inner_table = OrderedHashMap::new();
            let inner_len = raw.map_sz()?;
            let inner_encoding = inner_len.into();
            let mut inner_key_encodings = BTreeMap::new();
            let mut inner_value_encodings = BTreeMap::new();
            while match inner_len {
                cbor_event::LenSz::Len(n, _) => (inner_table.len() as u64) < n,
                cbor_event::LenSz::Indefinite => true,
            } {
                if matches!(inner_len, cbor_event::LenSz::Indefinite)
                    && raw.cbor_type()? == cbor_event::Type::Special
                    && raw.special_break()?
                {
                    break;
                }
                let (inner_key, inner_key_encoding) =
                    raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                let (inner_value, inner_value_encoding) = raw
                    .text_sz()
                    .map(|(s, enc)| (s, StringEncoding::from(enc)))?;
                if inner_table.insert(inner_key, inner_value).is_some() {
                    return Err(DeserializeFailure::DuplicateKey(Key::Uint(inner_key)).into());
                }
                inner_key_encodings.insert(inner_key, inner_key_encoding);
                inner_value_encodings.insert(inner_key, inner_value_encoding);
            }
            let (inner, inner_encoding, inner_key_encodings, inner_value_encodings) = (
                inner_table,
                inner_encoding,
                inner_key_encodings,
                inner_value_encodings,
            );
            Ok(Self {
                inner,
                encodings: Some(ClippyWrappedMapEncoding {
                    inner_encoding,
                    inner_key_encodings,
                    inner_value_encodings,
                }),
            })
        })()
        .map_err(|e| e.annotate("ClippyWrappedMap"))
    }
}

impl Serialize for DeeplyNested {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
        force_canonical: bool,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(1, force_canonical),
        )?;
        serializer.write_map_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.data_encoding)
                .unwrap_or_default()
                .to_len_sz(self.data.len() as u64, force_canonical),
        )?;
        let mut key_order = self
            .data
            .iter()
            .map(|(k, v)| {
                let mut buf = cbor_event::se::Serializer::new_vec();
                let (data_key_tag_encoding, data_key_encoding) = self
                    .encodings
                    .as_ref()
                    .and_then(|encs| encs.data_key_encodings.get(k))
                    .cloned()
                    .unwrap_or_else(|| (None, StringEncoding::default()));
                buf.write_tag_sz(14u64, fit_sz(14u64, data_key_tag_encoding, force_canonical))?;
                buf.write_bytes_sz(
                    k,
                    data_key_encoding.to_str_len_sz(k.len() as u64, force_canonical),
                )?;
                Ok((buf.finalize(), k, v))
            })
            .collect::<Result<Vec<(Vec<u8>, &_, &_)>, cbor_event::Error>>()?;
        if force_canonical {
            key_order.sort_by(|(lhs_bytes, _, _), (rhs_bytes, _, _)| {
                cbor_canonical_key_cmp(lhs_bytes, rhs_bytes)
            });
        }
        for (key_bytes, key, value) in key_order {
            serializer.write_raw_bytes(&key_bytes)?;
            let (data_value_encoding, data_value_key_encodings, data_value_value_encodings) = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.data_value_encodings.get(key))
                .cloned()
                .unwrap_or_else(|| (LenEncoding::default(), BTreeMap::new(), BTreeMap::new()));
            serializer
                .write_map_sz(data_value_encoding.to_len_sz(value.len() as u64, force_canonical))?;
            let mut key_order = value
                .iter()
                .map(|(k, v)| {
                    let mut buf = cbor_event::se::Serializer::new_vec();
                    let data_value_key_encoding =
                        data_value_key_encodings.get(k).cloned().unwrap_or_default();
                    buf.write_unsigned_integer_sz(
                        *k,
                        fit_sz(*k, data_value_key_encoding, force_canonical),
                    )?;
                    Ok((buf.finalize(), k, v))
                })
                .collect::<Result<Vec<(Vec<u8>, &_, &_)>, cbor_event::Error>>()?;
            if force_canonical {
                key_order.sort_by(|(lhs_bytes, _, _), (rhs_bytes, _, _)| {
                    cbor_canonical_key_cmp(lhs_bytes, rhs_bytes)
                });
            }
            for (key_bytes, key, value) in key_order {
                serializer.write_raw_bytes(&key_bytes)?;
                let (
                    data_value_value_encoding,
                    data_value_value_key_encodings,
                    data_value_value_value_encodings,
                ) = data_value_value_encodings
                    .get(key)
                    .cloned()
                    .unwrap_or_else(|| (LenEncoding::default(), BTreeMap::new(), BTreeMap::new()));
                serializer.write_map_sz(
                    data_value_value_encoding.to_len_sz(value.len() as u64, force_canonical),
                )?;
                let mut key_order = value
                    .iter()
                    .map(|(k, v)| {
                        let mut buf = cbor_event::se::Serializer::new_vec();
                        let (data_value_value_key_tag_encoding, data_value_value_key_encoding) =
                            data_value_value_key_encodings
                                .get(k)
                                .cloned()
                                .unwrap_or((None, None));
                        buf.write_tag_sz(
                            9u64,
                            fit_sz(9u64, data_value_value_key_tag_encoding, force_canonical),
                        )?;
                        buf.write_unsigned_integer_sz(
                            *k,
                            fit_sz(*k, data_value_value_key_encoding, force_canonical),
                        )?;
                        Ok((buf.finalize(), k, v))
                    })
                    .collect::<Result<Vec<(Vec<u8>, &_, &_)>, cbor_event::Error>>()?;
                if force_canonical {
                    key_order.sort_by(|(lhs_bytes, _, _), (rhs_bytes, _, _)| {
                        cbor_canonical_key_cmp(lhs_bytes, rhs_bytes)
                    });
                }
                for (key_bytes, key, value) in key_order {
                    serializer.write_raw_bytes(&key_bytes)?;
                    let (data_value_value_value_encoding, data_value_value_value_elem_encodings) =
                        data_value_value_value_encodings
                            .get(key)
                            .cloned()
                            .unwrap_or_else(|| (LenEncoding::default(), Vec::new()));
                    serializer.write_array_sz(
                        data_value_value_value_encoding
                            .to_len_sz(value.len() as u64, force_canonical),
                    )?;
                    for (i, element) in value.iter().enumerate() {
                        let (
                            data_value_value_value_elem_tag_encoding,
                            data_value_value_value_elem_encoding,
                            data_value_value_value_elem_elem_encodings,
                        ) = data_value_value_value_elem_encodings
                            .get(i)
                            .cloned()
                            .unwrap_or_else(|| (None, LenEncoding::default(), Vec::new()));
                        serializer.write_tag_sz(
                            18u64,
                            fit_sz(
                                18u64,
                                data_value_value_value_elem_tag_encoding,
                                force_canonical,
                            ),
                        )?;
                        serializer.write_array_sz(
                            data_value_value_value_elem_encoding
                                .to_len_sz(element.len() as u64, force_canonical),
                        )?;
                        for (i, element) in element.iter().enumerate() {
                            let data_value_value_value_elem_elem_encoding =
                                data_value_value_value_elem_elem_encodings
                                    .get(i)
                                    .cloned()
                                    .unwrap_or_default();
                            serializer.write_text_sz(
                                element,
                                data_value_value_value_elem_elem_encoding
                                    .to_str_len_sz(element.len() as u64, force_canonical),
                            )?;
                        }
                        data_value_value_value_elem_encoding.end(serializer, force_canonical)?;
                    }
                    data_value_value_value_encoding.end(serializer, force_canonical)?;
                }
                data_value_value_encoding.end(serializer, force_canonical)?;
            }
            data_value_encoding.end(serializer, force_canonical)?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.data_encoding)
            .unwrap_or_default()
            .end(serializer, force_canonical)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer, force_canonical)
    }
}

impl Deserialize for DeeplyNested {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.array_sz()?;
            let len_encoding: LenEncoding = len.into();
            let mut read_len = CBORReadLen::new(len);
            read_len.read_elems(1)?;
            read_len.finish()?;
            let (data, data_encoding, data_key_encodings, data_value_encodings) =
                (|| -> Result<_, DeserializeError> {
                    let mut data_table = OrderedHashMap::new();
                    let data_len = raw.map_sz()?;
                    let data_encoding = data_len.into();
                    let mut data_key_encodings = BTreeMap::new();
                    let mut data_value_encodings = BTreeMap::new();
                    while match data_len {
                        cbor_event::LenSz::Len(n, _) => (data_table.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(data_len, cbor_event::LenSz::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        let (data_key, data_key_tag_encoding, data_key_encoding) =
                            match raw.tag_sz()? {
                                (14, tag_enc) => raw.bytes_sz().map(|(bytes, enc)| {
                                    (bytes, Some(tag_enc), StringEncoding::from(enc))
                                })?,
                                (tag, _enc) => {
                                    return Err(DeserializeFailure::TagMismatch {
                                        found: tag,
                                        expected: 14,
                                    }
                                    .into());
                                }
                            };
                        let mut data_value_table = OrderedHashMap::new();
                        let data_value_len = raw.map_sz()?;
                        let data_value_encoding = data_value_len.into();
                        let mut data_value_key_encodings = BTreeMap::new();
                        let mut data_value_value_encodings = BTreeMap::new();
                        while match data_value_len {
                            cbor_event::LenSz::Len(n, _) => (data_value_table.len() as u64) < n,
                            cbor_event::LenSz::Indefinite => true,
                        } {
                            if matches!(data_value_len, cbor_event::LenSz::Indefinite)
                                && raw.cbor_type()? == cbor_event::Type::Special
                                && raw.special_break()?
                            {
                                break;
                            }
                            let (data_value_key, data_value_key_encoding) =
                                raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                            let mut data_value_value_table = OrderedHashMap::new();
                            let data_value_value_len = raw.map_sz()?;
                            let data_value_value_encoding = data_value_value_len.into();
                            let mut data_value_value_key_encodings = BTreeMap::new();
                            let mut data_value_value_value_encodings = BTreeMap::new();
                            while match data_value_value_len {
                                cbor_event::LenSz::Len(n, _) => {
                                    (data_value_value_table.len() as u64) < n
                                }
                                cbor_event::LenSz::Indefinite => true,
                            } {
                                if matches!(data_value_value_len, cbor_event::LenSz::Indefinite)
                                    && raw.cbor_type()? == cbor_event::Type::Special
                                    && raw.special_break()?
                                {
                                    break;
                                }
                                let (
                                    data_value_value_key,
                                    data_value_value_key_tag_encoding,
                                    data_value_value_key_encoding,
                                ) = match raw.tag_sz()? {
                                    (9, tag_enc) => raw
                                        .unsigned_integer_sz()
                                        .map(|(x, enc)| (x, Some(tag_enc), Some(enc)))?,
                                    (tag, _enc) => {
                                        return Err(DeserializeFailure::TagMismatch {
                                            found: tag,
                                            expected: 9,
                                        }
                                        .into());
                                    }
                                };
                                let mut data_value_value_value_arr = Vec::new();
                                let len = raw.array_sz()?;
                                let data_value_value_value_encoding = len.into();
                                let mut data_value_value_value_elem_encodings = Vec::new();
                                while match len {
                                    cbor_event::LenSz::Len(n, _) => {
                                        (data_value_value_value_arr.len() as u64) < n
                                    }
                                    cbor_event::LenSz::Indefinite => true,
                                } {
                                    if matches!(len, cbor_event::LenSz::Indefinite)
                                        && raw.cbor_type()? == cbor_event::Type::Special
                                        && raw.special_break()?
                                    {
                                        break;
                                    }
                                    let (
                                        data_value_value_value_elem,
                                        data_value_value_value_elem_tag_encoding,
                                        data_value_value_value_elem_encoding,
                                        data_value_value_value_elem_elem_encodings,
                                    ) = match raw.tag_sz()? {
                                        (18, tag_enc) => {
                                            let mut data_value_value_value_elem_arr = Vec::new();
                                            let len = raw.array_sz()?;
                                            let data_value_value_value_elem_encoding = len.into();
                                            let mut data_value_value_value_elem_elem_encodings =
                                                Vec::new();
                                            while match len {
                                                cbor_event::LenSz::Len(n, _) => {
                                                    (data_value_value_value_elem_arr.len() as u64)
                                                        < n
                                                }
                                                cbor_event::LenSz::Indefinite => true,
                                            } {
                                                if matches!(len, cbor_event::LenSz::Indefinite)
                                                    && raw.cbor_type()? == cbor_event::Type::Special
                                                    && raw.special_break()?
                                                {
                                                    break;
                                                }
                                                let (
                                                    data_value_value_value_elem_elem,
                                                    data_value_value_value_elem_elem_encoding,
                                                ) = raw.text_sz().map(|(s, enc)| {
                                                    (s, StringEncoding::from(enc))
                                                })?;
                                                data_value_value_value_elem_arr
                                                    .push(data_value_value_value_elem_elem);
                                                data_value_value_value_elem_elem_encodings.push(
                                                    data_value_value_value_elem_elem_encoding,
                                                );
                                            }
                                            (
                                                data_value_value_value_elem_arr,
                                                Some(tag_enc),
                                                data_value_value_value_elem_encoding,
                                                data_value_value_value_elem_elem_encodings,
                                            )
                                        }
                                        (tag, _enc) => {
                                            return Err(DeserializeFailure::TagMismatch {
                                                found: tag,
                                                expected: 18,
                                            }
                                            .into());
                                        }
                                    };
                                    data_value_value_value_arr.push(data_value_value_value_elem);
                                    data_value_value_value_elem_encodings.push((
                                        data_value_value_value_elem_tag_encoding,
                                        data_value_value_value_elem_encoding,
                                        data_value_value_value_elem_elem_encodings,
                                    ));
                                }
                                let (
                                    data_value_value_value,
                                    data_value_value_value_encoding,
                                    data_value_value_value_elem_encodings,
                                ) = (
                                    data_value_value_value_arr,
                                    data_value_value_value_encoding,
                                    data_value_value_value_elem_encodings,
                                );
                                if data_value_value_table
                                    .insert(data_value_value_key, data_value_value_value)
                                    .is_some()
                                {
                                    return Err(DeserializeFailure::DuplicateKey(Key::Uint(
                                        data_value_value_key,
                                    ))
                                    .into());
                                }
                                data_value_value_key_encodings.insert(
                                    data_value_value_key,
                                    (
                                        data_value_value_key_tag_encoding,
                                        data_value_value_key_encoding,
                                    ),
                                );
                                data_value_value_value_encodings.insert(
                                    data_value_value_key,
                                    (
                                        data_value_value_value_encoding,
                                        data_value_value_value_elem_encodings,
                                    ),
                                );
                            }
                            let (
                                data_value_value,
                                data_value_value_encoding,
                                data_value_value_key_encodings,
                                data_value_value_value_encodings,
                            ) = (
                                data_value_value_table,
                                data_value_value_encoding,
                                data_value_value_key_encodings,
                                data_value_value_value_encodings,
                            );
                            if data_value_table
                                .insert(data_value_key, data_value_value)
                                .is_some()
                            {
                                return Err(DeserializeFailure::DuplicateKey(Key::Uint(
                                    data_value_key,
                                ))
                                .into());
                            }
                            data_value_key_encodings
                                .insert(data_value_key, data_value_key_encoding);
                            data_value_value_encodings.insert(
                                data_value_key,
                                (
                                    data_value_value_encoding,
                                    data_value_value_key_encodings,
                                    data_value_value_value_encodings,
                                ),
                            );
                        }
                        let (
                            data_value,
                            data_value_encoding,
                            data_value_key_encodings,
                            data_value_value_encodings,
                        ) = (
                            data_value_table,
                            data_value_encoding,
                            data_value_key_encodings,
                            data_value_value_encodings,
                        );
                        if data_table.insert(data_key.clone(), data_value).is_some() {
                            return Err(DeserializeFailure::DuplicateKey(Key::Str(String::from(
                                "some complicated/unsupported type",
                            )))
                            .into());
                        }
                        data_key_encodings
                            .insert(data_key.clone(), (data_key_tag_encoding, data_key_encoding));
                        data_value_encodings.insert(
                            data_key.clone(),
                            (
                                data_value_encoding,
                                data_value_key_encodings,
                                data_value_value_encodings,
                            ),
                        );
                    }
                    Ok((
                        data_table,
                        data_encoding,
                        data_key_encodings,
                        data_value_encodings,
                    ))
                })()
                .map_err(|e| e.annotate("data"))?;
            match len {
                cbor_event::LenSz::Len(_, _) => (),
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(DeeplyNested {
                data,
                encodings: Some(DeeplyNestedEncoding {
                    len_encoding,
                    data_encoding,
                    data_key_encodings,
                    data_value_encodings,
                }),
            })
        })()
        .map_err(|e| e.annotate("DeeplyNested"))
    }
}

impl Serialize for Foo {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
        force_canonical: bool,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_tag_sz(
            11u64,
            fit_sz(
                11u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.tag_encoding)
                    .unwrap_or_default(),
                force_canonical,
            ),
        )?;
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(3, force_canonical),
        )?;
        serializer.write_unsigned_integer_sz(
            self.index_0,
            fit_sz(
                self.index_0,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.index_0_encoding)
                    .unwrap_or_default(),
                force_canonical,
            ),
        )?;
        serializer.write_text_sz(
            &self.index_1,
            self.encodings
                .as_ref()
                .map(|encs| encs.index_1_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(self.index_1.len() as u64, force_canonical),
        )?;
        serializer.write_bytes_sz(
            &self.index_2,
            self.encodings
                .as_ref()
                .map(|encs| encs.index_2_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(self.index_2.len() as u64, force_canonical),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer, force_canonical)
    }
}

impl Deserialize for Foo {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let (tag, tag_encoding) = raw.tag_sz()?;
            if tag != 11 {
                return Err(DeserializeFailure::TagMismatch {
                    found: tag,
                    expected: 11,
                }
                .into());
            }
            let len = raw.array_sz()?;
            let len_encoding: LenEncoding = len.into();
            let mut read_len = CBORReadLen::new(len);
            read_len.read_elems(3)?;
            read_len.finish()?;
            let (index_0, index_0_encoding) = raw
                .unsigned_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(x, enc)| (x, Some(enc)))
                .map_err(|e: DeserializeError| e.annotate("index_0"))?;
            let (index_1, index_1_encoding) = raw
                .text_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(s, enc)| (s, StringEncoding::from(enc)))
                .map_err(|e: DeserializeError| e.annotate("index_1"))?;
            let (index_2, index_2_encoding) = raw
                .bytes_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(bytes, enc)| (bytes, StringEncoding::from(enc)))
                .map_err(|e: DeserializeError| e.annotate("index_2"))?;
            match len {
                cbor_event::LenSz::Len(_, _) => (),
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(Foo {
                index_0,
                index_1,
                index_2,
                encodings: Some(FooEncoding {
                    len_encoding,
                    tag_encoding: Some(tag_encoding),
                    index_0_encoding,
                    index_1_encoding,
                    index_2_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("Foo"))
    }
}

impl Serialize for FooBytes {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
        force_canonical: bool,
    ) -> cbor_event::Result<&'se mut Serializer> {
        let mut inner_inner_se = Serializer::new_vec();
        self.inner.serialize(&mut inner_inner_se, force_canonical)?;
        let inner_bytes = inner_inner_se.finalize();
        serializer.write_bytes_sz(
            &inner_bytes,
            self.encodings
                .as_ref()
                .map(|encs| encs.inner_bytes_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(inner_bytes.len() as u64, force_canonical),
        )
    }
}

impl Deserialize for FooBytes {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let (inner_bytes, inner_bytes_encoding) = raw.bytes_sz()?;
            let inner_de = &mut Deserializer::from(inner_bytes);
            let (inner, inner_bytes_encoding) = (
                Foo::deserialize(inner_de)?,
                StringEncoding::from(inner_bytes_encoding),
            );
            if !inner_de.as_slice().is_empty() {
                return Err(DeserializeFailure::CBOR(cbor_event::Error::TrailingData).into());
            }
            Ok(Self {
                inner,
                encodings: Some(FooBytesEncoding {
                    inner_bytes_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("FooBytes"))
    }
}

impl Serialize for GroupChoice {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
        force_canonical: bool,
    ) -> cbor_event::Result<&'se mut Serializer> {
        match self {
            GroupChoice::I3 {
                i3_encoding,
                len_encoding,
            } => {
                serializer.write_array_sz(len_encoding.to_len_sz(1, force_canonical))?;
                serializer
                    .write_unsigned_integer_sz(3u64, fit_sz(3u64, *i3_encoding, force_canonical))?;
                len_encoding.end(serializer, force_canonical)?;
                Ok(serializer)
            }
            GroupChoice::I2 {
                i2_tag_encoding,
                i2_encoding,
                len_encoding,
            } => {
                serializer.write_array_sz(len_encoding.to_len_sz(1, force_canonical))?;
                serializer.write_tag_sz(10u64, fit_sz(10u64, *i2_tag_encoding, force_canonical))?;
                serializer
                    .write_unsigned_integer_sz(2u64, fit_sz(2u64, *i2_encoding, force_canonical))?;
                len_encoding.end(serializer, force_canonical)?;
                Ok(serializer)
            }
            GroupChoice::Foo { foo, len_encoding } => {
                serializer.write_array_sz(len_encoding.to_len_sz(1, force_canonical))?;
                foo.serialize(serializer, force_canonical)?;
                len_encoding.end(serializer, force_canonical)?;
                Ok(serializer)
            }
            GroupChoice::GroupChoice3 {
                x,
                len_encoding,
                index_0_encoding,
                x_encoding,
            } => {
                serializer.write_array_sz(len_encoding.to_len_sz(2, force_canonical))?;
                serializer.write_unsigned_integer_sz(
                    0u64,
                    fit_sz(0u64, *index_0_encoding, force_canonical),
                )?;
                serializer
                    .write_unsigned_integer_sz(*x, fit_sz(*x, *x_encoding, force_canonical))?;
                len_encoding.end(serializer, force_canonical)?;
                Ok(serializer)
            }
            GroupChoice::Plain(plain) => plain.serialize(serializer, force_canonical),
        }
    }
}

impl Deserialize for GroupChoice {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.array_sz()?;
            let len_encoding: LenEncoding = len.into();
            let initial_position = raw.position();
            let mut errs = Vec::new();
            let deser_variant = (|raw: &mut Deserializer| -> Result<_, DeserializeError> {
                let mut read_len = CBORReadLen::new(len);
                read_len.read_elems(1)?;
                read_len.finish()?;
                let (i3_value, i3_encoding) = raw.unsigned_integer_sz()?;
                if i3_value != 3 {
                    return Err(DeserializeFailure::FixedValueMismatch {
                        found: Key::Uint(i3_value),
                        expected: Key::Uint(3),
                    }
                    .into());
                }
                let ret = Ok(Some(i3_encoding));
                match len {
                    cbor_event::LenSz::Len(_, _) => (),
                    cbor_event::LenSz::Indefinite => match raw.special()? {
                        cbor_event::Special::Break => (),
                        _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                    },
                }
                ret
            })(raw);
            match deser_variant {
                Ok(i3_encoding) => {
                    return Ok(Self::I3 {
                        i3_encoding,
                        len_encoding,
                    });
                }
                Err(e) => {
                    errs.push(e.annotate("I3"));
                    raw.set_position(initial_position).unwrap();
                }
            };
            let deser_variant = (|raw: &mut Deserializer| -> Result<_, DeserializeError> {
                let mut read_len = CBORReadLen::new(len);
                read_len.read_elems(1)?;
                read_len.finish()?;
                let ret = match raw.tag_sz()? {
                    (10, tag_enc) => {
                        let (i2_value, i2_encoding) = raw.unsigned_integer_sz()?;
                        if i2_value != 2 {
                            return Err(DeserializeFailure::FixedValueMismatch {
                                found: Key::Uint(i2_value),
                                expected: Key::Uint(2),
                            }
                            .into());
                        }
                        Ok((Some(tag_enc), Some(i2_encoding)))
                    }
                    (tag, _enc) => Err(DeserializeFailure::TagMismatch {
                        found: tag,
                        expected: 10,
                    }
                    .into()),
                };
                match len {
                    cbor_event::LenSz::Len(_, _) => (),
                    cbor_event::LenSz::Indefinite => match raw.special()? {
                        cbor_event::Special::Break => (),
                        _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                    },
                }
                ret
            })(raw);
            match deser_variant {
                Ok((i2_tag_encoding, i2_encoding)) => {
                    return Ok(Self::I2 {
                        i2_tag_encoding,
                        i2_encoding,
                        len_encoding,
                    });
                }
                Err(e) => {
                    errs.push(e.annotate("I2"));
                    raw.set_position(initial_position).unwrap();
                }
            };
            let deser_variant = (|raw: &mut Deserializer| -> Result<_, DeserializeError> {
                let mut read_len = CBORReadLen::new(len);
                read_len.read_elems(1)?;
                read_len.finish()?;
                let ret = Foo::deserialize(raw);
                match len {
                    cbor_event::LenSz::Len(_, _) => (),
                    cbor_event::LenSz::Indefinite => match raw.special()? {
                        cbor_event::Special::Break => (),
                        _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                    },
                }
                ret
            })(raw);
            match deser_variant {
                Ok(foo) => return Ok(Self::Foo { foo, len_encoding }),
                Err(e) => {
                    errs.push(e.annotate("Foo"));
                    raw.set_position(initial_position).unwrap();
                }
            };
            let variant_deser = (|raw: &mut Deserializer| -> Result<_, DeserializeError> {
                let mut read_len = CBORReadLen::new(len);
                read_len.read_elems(2)?;
                read_len.finish()?;
                let index_0_encoding = (|| -> Result<_, DeserializeError> {
                    let (index_0_value, index_0_encoding) = raw.unsigned_integer_sz()?;
                    if index_0_value != 0 {
                        return Err(DeserializeFailure::FixedValueMismatch {
                            found: Key::Uint(index_0_value),
                            expected: Key::Uint(0),
                        }
                        .into());
                    }
                    Ok(Some(index_0_encoding))
                })()
                .map_err(|e| e.annotate("index_0"))?;
                let (x, x_encoding) = raw
                    .unsigned_integer_sz()
                    .map_err(Into::<DeserializeError>::into)
                    .map(|(x, enc)| (x, Some(enc)))
                    .map_err(|e: DeserializeError| e.annotate("x"))?;
                match len {
                    cbor_event::LenSz::Len(_, _) => (),
                    cbor_event::LenSz::Indefinite => match raw.special()? {
                        cbor_event::Special::Break => (),
                        _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                    },
                }
                Ok(Self::GroupChoice3 {
                    x,
                    len_encoding,
                    index_0_encoding,
                    x_encoding,
                })
            })(raw);
            match variant_deser {
                Ok(variant) => return Ok(variant),
                Err(e) => {
                    errs.push(e.annotate("GroupChoice3"));
                    raw.set_position(initial_position).unwrap();
                }
            };
            let deser_variant = (|raw: &mut Deserializer| -> Result<_, DeserializeError> {
                let mut read_len = CBORReadLen::new(len);
                read_len.read_elems(2)?;
                read_len.finish()?;
                let ret = Plain::deserialize_as_embedded_group(raw, &mut read_len, len);
                match len {
                    cbor_event::LenSz::Len(_, _) => (),
                    cbor_event::LenSz::Indefinite => match raw.special()? {
                        cbor_event::Special::Break => (),
                        _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                    },
                }
                ret
            })(raw);
            match deser_variant {
                Ok(plain) => return Ok(Self::Plain(plain)),
                Err(e) => {
                    errs.push(e.annotate("Plain"));
                    raw.set_position(initial_position).unwrap();
                }
            };
            Err(DeserializeFailure::NoVariantMatchedWithCauses(errs).into())
        })()
        .map_err(|e| e.annotate("GroupChoice"))
    }
}

impl Serialize for Int {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
        force_canonical: bool,
    ) -> cbor_event::Result<&'se mut Serializer> {
        match self {
            Self::Uint { value, encoding } => serializer
                .write_unsigned_integer_sz(*value, fit_sz(*value, *encoding, force_canonical)),
            Self::Nint { value, encoding } => serializer.write_negative_integer_sz(
                -((*value as i128) + 1),
                fit_sz(*value, *encoding, force_canonical),
            ),
        }
    }
}

impl Deserialize for Int {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            match raw.cbor_type()? {
                cbor_event::Type::UnsignedInteger => raw
                    .unsigned_integer_sz()
                    .map(|(x, enc)| Self::Uint {
                        value: x,
                        encoding: Some(enc),
                    })
                    .map_err(core::convert::Into::into),
                cbor_event::Type::NegativeInteger => raw
                    .negative_integer_sz()
                    .map(|(x, enc)| Self::Nint {
                        value: (-1 - x) as u64,
                        encoding: Some(enc),
                    })
                    .map_err(core::convert::Into::into),
                _ => Err(DeserializeFailure::NoVariantMatched.into()),
            }
        })()
        .map_err(|e| e.annotate("Int"))
    }
}

impl Serialize for MixedLenKeys {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
        force_canonical: bool,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_map_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(2, force_canonical),
        )?;
        let deser_order = self
            .encodings
            .as_ref()
            .filter(|encs| !force_canonical && encs.orig_deser_order.len() == 2)
            .map(|encs| encs.orig_deser_order.clone())
            .unwrap_or_else(|| vec![1, 0]);
        for field_index in deser_order {
            match field_index {
                1 => {
                    serializer.write_text_sz(
                        "a",
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.a_key_encoding.clone())
                            .unwrap_or_default()
                            .to_str_len_sz("a".len() as u64, force_canonical),
                    )?;
                    serializer.write_unsigned_integer_sz(
                        self.a,
                        fit_sz(
                            self.a,
                            self.encodings
                                .as_ref()
                                .map(|encs| encs.a_encoding)
                                .unwrap_or_default(),
                            force_canonical,
                        ),
                    )?;
                }
                0 => {
                    serializer.write_unsigned_integer_sz(
                        256u64,
                        fit_sz(
                            256u64,
                            self.encodings
                                .as_ref()
                                .map(|encs| encs.key_256_key_encoding)
                                .unwrap_or_default(),
                            force_canonical,
                        ),
                    )?;
                    serializer.write_unsigned_integer_sz(
                        self.key_256,
                        fit_sz(
                            self.key_256,
                            self.encodings
                                .as_ref()
                                .map(|encs| encs.key_256_encoding)
                                .unwrap_or_default(),
                            force_canonical,
                        ),
                    )?;
                }
                _ => unreachable!(),
            };
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer, force_canonical)
    }
}

impl Deserialize for MixedLenKeys {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.map_sz()?;
            let len_encoding: LenEncoding = len.into();
            let mut read_len = CBORReadLen::new(len);
            read_len.read_elems(2)?;
            read_len.finish()?;
            let mut orig_deser_order = Vec::new();
            let mut a_encoding = None;
            let mut a_key_encoding = StringEncoding::default();
            let mut a = None;
            let mut key_256_encoding = None;
            let mut key_256_key_encoding = None;
            let mut key_256 = None;
            let mut read = 0;
            while match len {
                cbor_event::LenSz::Len(n, _) => read < n,
                cbor_event::LenSz::Indefinite => true,
            } {
                match raw.cbor_type()? {
                    cbor_event::Type::UnsignedInteger => match raw.unsigned_integer_sz()? {
                        (256, key_enc) => {
                            if key_256.is_some() {
                                return Err(DeserializeFailure::DuplicateKey(Key::Uint(256)).into());
                            }
                            let (tmp_key_256, tmp_key_256_encoding) = raw
                                .unsigned_integer_sz()
                                .map_err(Into::<DeserializeError>::into)
                                .map(|(x, enc)| (x, Some(enc)))
                                .map_err(|e: DeserializeError| e.annotate("key_256"))?;
                            key_256 = Some(tmp_key_256);
                            key_256_encoding = tmp_key_256_encoding;
                            key_256_key_encoding = Some(key_enc);
                            orig_deser_order.push(0);
                        }
                        (unknown_key, _enc) => {
                            return Err(
                                DeserializeFailure::UnknownKey(Key::Uint(unknown_key)).into()
                            );
                        }
                    },
                    cbor_event::Type::Text => {
                        let (text_key, key_enc) = raw.text_sz()?;
                        match text_key.as_str() {
                            "a" => {
                                if a.is_some() {
                                    return Err(DeserializeFailure::DuplicateKey(Key::Str(
                                        "a".into(),
                                    ))
                                    .into());
                                }
                                let (tmp_a, tmp_a_encoding) = raw
                                    .unsigned_integer_sz()
                                    .map_err(Into::<DeserializeError>::into)
                                    .map(|(x, enc)| (x, Some(enc)))
                                    .map_err(|e: DeserializeError| e.annotate("a"))?;
                                a = Some(tmp_a);
                                a_encoding = tmp_a_encoding;
                                a_key_encoding = StringEncoding::from(key_enc);
                                orig_deser_order.push(1);
                            }
                            unknown_key => {
                                return Err(DeserializeFailure::UnknownKey(Key::Str(
                                    unknown_key.to_owned(),
                                ))
                                .into());
                            }
                        }
                    }
                    cbor_event::Type::Special => match len {
                        cbor_event::LenSz::Len(_, _) => {
                            return Err(DeserializeFailure::BreakInDefiniteLen.into());
                        }
                        cbor_event::LenSz::Indefinite => match raw.special()? {
                            cbor_event::Special::Break => break,
                            _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                        },
                    },
                    other_type => {
                        return Err(DeserializeFailure::UnexpectedKeyType(other_type).into());
                    }
                }
                read += 1;
            }
            let key_256 = match key_256 {
                Some(x) => x,
                None => {
                    return Err(DeserializeFailure::MandatoryFieldMissing(Key::Uint(256)).into());
                }
            };
            let a = match a {
                Some(x) => x,
                None => {
                    return Err(
                        DeserializeFailure::MandatoryFieldMissing(Key::Str(String::from("a")))
                            .into(),
                    );
                }
            };
            Ok(Self {
                key_256,
                a,
                encodings: Some(MixedLenKeysEncoding {
                    len_encoding,
                    orig_deser_order,
                    key_256_key_encoding,
                    key_256_encoding,
                    a_key_encoding,
                    a_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("MixedLenKeys"))
    }
}

impl Serialize for Plain {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
        force_canonical: bool,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(2, force_canonical),
        )?;
        self.serialize_as_embedded_group(serializer, force_canonical)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer, force_canonical)
    }
}

impl SerializeEmbeddedGroup for Plain {
    fn serialize_as_embedded_group<'se>(
        &self,
        serializer: &'se mut Serializer,
        force_canonical: bool,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_tag_sz(
            13u64,
            fit_sz(
                13u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.d_tag_encoding)
                    .unwrap_or_default(),
                force_canonical,
            ),
        )?;
        serializer.write_unsigned_integer_sz(
            self.d,
            fit_sz(
                self.d,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.d_encoding)
                    .unwrap_or_default(),
                force_canonical,
            ),
        )?;
        self.e.serialize(serializer, force_canonical)?;
        Ok(serializer)
    }
}

impl Deserialize for Plain {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        let (len, mut read_len) = (|| -> Result<_, DeserializeError> {
            let len = raw.array_sz()?;
            let mut read_len = CBORReadLen::new(len);
            read_len.read_elems(2)?;
            read_len.finish()?;
            Ok((len, read_len))
        })()
        .map_err(|e| e.annotate("Plain"))?;
        let ret = Self::deserialize_as_embedded_group(raw, &mut read_len, len);
        (|| -> Result<_, DeserializeError> {
            match len {
                cbor_event::LenSz::Len(_, _) => (),
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(())
        })()
        .map_err(|e| e.annotate("Plain"))?;
        ret
    }
}

impl DeserializeEmbeddedGroup for Plain {
    fn deserialize_as_embedded_group(
        raw: &mut Deserializer,
        _read_len: &mut CBORReadLen,
        len: cbor_event::LenSz,
    ) -> Result<Self, DeserializeError> {
        let len_encoding = len.into();
        (|| -> Result<_, DeserializeError> {
            let (d, d_tag_encoding, d_encoding) = (|| -> Result<_, DeserializeError> {
                match raw.tag_sz()? {
                    (13, tag_enc) => raw
                        .unsigned_integer_sz()
                        .map_err(Into::<DeserializeError>::into)
                        .map(|(x, enc)| (x, Some(tag_enc), Some(enc))),
                    (tag, _enc) => Err(DeserializeFailure::TagMismatch {
                        found: tag,
                        expected: 13,
                    }
                    .into()),
                }
            })()
            .map_err(|e| e.annotate("d"))?;
            let e = TaggedText::deserialize(raw).map_err(|e: DeserializeError| e.annotate("e"))?;
            Ok(Plain {
                d,
                e,
                encodings: Some(PlainEncoding {
                    len_encoding,
                    d_tag_encoding,
                    d_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("Plain"))
    }
}

impl Serialize for String32 {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
        force_canonical: bool,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_tag_sz(
            7u64,
            fit_sz(
                7u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.inner_tag_encoding)
                    .unwrap_or_default(),
                force_canonical,
            ),
        )?;
        serializer.write_text_sz(
            &self.inner,
            self.encodings
                .as_ref()
                .map(|encs| encs.inner_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(self.inner.len() as u64, force_canonical),
        )
    }
}

impl Deserialize for String32 {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let (inner, inner_tag_encoding, inner_encoding) = match raw.tag_sz()? {
                (7, tag_enc) => raw
                    .text_sz()
                    .map(|(s, enc)| (s, Some(tag_enc), StringEncoding::from(enc)))?,
                (tag, _enc) => {
                    return Err(DeserializeFailure::TagMismatch {
                        found: tag,
                        expected: 7,
                    }
                    .into());
                }
            };
            if inner.len() < 16 || inner.len() > 32 {
                return Err(DeserializeFailure::RangeCheck {
                    found: inner.len() as i128,
                    min: Some(16),
                    max: Some(32),
                }
                .into());
            }
            Ok(Self {
                inner,
                encodings: Some(String32Encoding {
                    inner_tag_encoding,
                    inner_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("String32"))
    }
}

impl Serialize for String64 {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
        force_canonical: bool,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_text_sz(
            &self.inner,
            self.encodings
                .as_ref()
                .map(|encs| encs.inner_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(self.inner.len() as u64, force_canonical),
        )
    }
}

impl Deserialize for String64 {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let (inner, inner_encoding) = raw
                .text_sz()
                .map(|(s, enc)| (s, StringEncoding::from(enc)))?;
            if inner.len() > 64 {
                return Err(DeserializeFailure::RangeCheck {
                    found: inner.len() as i128,
                    min: Some(0),
                    max: Some(64),
                }
                .into());
            }
            Ok(Self {
                inner,
                encodings: Some(String64Encoding { inner_encoding }),
            })
        })()
        .map_err(|e| e.annotate("String64"))
    }
}

impl Serialize for TableArrMembers {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
        force_canonical: bool,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_map_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(3, force_canonical),
        )?;
        let deser_order = self
            .encodings
            .as_ref()
            .filter(|encs| !force_canonical && encs.orig_deser_order.len() == 3)
            .map(|encs| encs.orig_deser_order.clone())
            .unwrap_or_else(|| vec![0, 1, 2]);
        for field_index in deser_order {
            match field_index {
                0 => {
                    serializer.write_text_sz(
                        "arr",
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.arr_key_encoding.clone())
                            .unwrap_or_default()
                            .to_str_len_sz("arr".len() as u64, force_canonical),
                    )?;
                    serializer.write_array_sz(
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.arr_encoding)
                            .unwrap_or_default()
                            .to_len_sz(self.arr.len() as u64, force_canonical),
                    )?;
                    for (i, element) in self.arr.iter().enumerate() {
                        let arr_elem_encoding = self
                            .encodings
                            .as_ref()
                            .and_then(|encs| encs.arr_elem_encodings.get(i))
                            .cloned()
                            .unwrap_or_default();
                        serializer.write_unsigned_integer_sz(
                            *element as u64,
                            fit_sz(*element as u64, arr_elem_encoding, force_canonical),
                        )?;
                    }
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.arr_encoding)
                        .unwrap_or_default()
                        .end(serializer, force_canonical)?;
                }
                1 => {
                    serializer.write_text_sz(
                        "arr2",
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.arr2_key_encoding.clone())
                            .unwrap_or_default()
                            .to_str_len_sz("arr2".len() as u64, force_canonical),
                    )?;
                    serializer.write_array_sz(
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.arr2_encoding)
                            .unwrap_or_default()
                            .to_len_sz(self.arr2.len() as u64, force_canonical),
                    )?;
                    for element in self.arr2.iter() {
                        element.serialize(serializer, force_canonical)?;
                    }
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.arr2_encoding)
                        .unwrap_or_default()
                        .end(serializer, force_canonical)?;
                }
                2 => {
                    serializer.write_text_sz(
                        "table",
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.table_key_encoding.clone())
                            .unwrap_or_default()
                            .to_str_len_sz("table".len() as u64, force_canonical),
                    )?;
                    serializer.write_map_sz(
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.table_encoding)
                            .unwrap_or_default()
                            .to_len_sz(self.table.len() as u64, force_canonical),
                    )?;
                    let mut key_order = self
                        .table
                        .iter()
                        .map(|(k, v)| {
                            let mut buf = cbor_event::se::Serializer::new_vec();
                            let table_key_encoding = self
                                .encodings
                                .as_ref()
                                .and_then(|encs| encs.table_key_encodings.get(k))
                                .cloned()
                                .unwrap_or_default();
                            buf.write_unsigned_integer_sz(
                                *k,
                                fit_sz(*k, table_key_encoding, force_canonical),
                            )?;
                            Ok((buf.finalize(), k, v))
                        })
                        .collect::<Result<Vec<(Vec<u8>, &_, &_)>, cbor_event::Error>>()?;
                    if force_canonical {
                        key_order.sort_by(|(lhs_bytes, _, _), (rhs_bytes, _, _)| {
                            cbor_canonical_key_cmp(lhs_bytes, rhs_bytes)
                        });
                    }
                    for (key_bytes, key, value) in key_order {
                        serializer.write_raw_bytes(&key_bytes)?;
                        let table_value_encoding = self
                            .encodings
                            .as_ref()
                            .and_then(|encs| encs.table_value_encodings.get(key))
                            .cloned()
                            .unwrap_or_default();
                        serializer.write_text_sz(
                            value,
                            table_value_encoding.to_str_len_sz(value.len() as u64, force_canonical),
                        )?;
                    }
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.table_encoding)
                        .unwrap_or_default()
                        .end(serializer, force_canonical)?;
                }
                _ => unreachable!(),
            };
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer, force_canonical)
    }
}

impl Deserialize for TableArrMembers {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.map_sz()?;
            let len_encoding: LenEncoding = len.into();
            let mut read_len = CBORReadLen::new(len);
            read_len.read_elems(3)?;
            read_len.finish()?;
            let mut orig_deser_order = Vec::new();
            let mut arr_encoding = LenEncoding::default();
            let mut arr_elem_encodings = Vec::new();
            let mut arr_key_encoding = StringEncoding::default();
            let mut arr = None;
            let mut arr2_encoding = LenEncoding::default();
            let mut arr2_key_encoding = StringEncoding::default();
            let mut arr2 = None;
            let mut table_encoding = LenEncoding::default();
            let mut table_key_encodings = BTreeMap::new();
            let mut table_value_encodings = BTreeMap::new();
            let mut table_key_encoding = StringEncoding::default();
            let mut table = None;
            let mut read = 0;
            while match len {
                cbor_event::LenSz::Len(n, _) => read < n,
                cbor_event::LenSz::Indefinite => true,
            } {
                match raw.cbor_type()? {
                    cbor_event::Type::UnsignedInteger => {
                        return Err(DeserializeFailure::UnknownKey(Key::Uint(
                            raw.unsigned_integer()?,
                        ))
                        .into());
                    }
                    cbor_event::Type::Text => {
                        let (text_key, key_enc) = raw.text_sz()?;
                        match text_key.as_str() {
                            "arr" => {
                                if arr.is_some() {
                                    return Err(DeserializeFailure::DuplicateKey(Key::Str(
                                        "arr".into(),
                                    ))
                                    .into());
                                }
                                let (tmp_arr, tmp_arr_encoding, tmp_arr_elem_encodings) =
                                    (|| -> Result<_, DeserializeError> {
                                        let mut arr_arr = Vec::new();
                                        let len = raw.array_sz()?;
                                        let arr_encoding = len.into();
                                        let mut arr_elem_encodings = Vec::new();
                                        while match len {
                                            cbor_event::LenSz::Len(n, _) => {
                                                (arr_arr.len() as u64) < n
                                            }
                                            cbor_event::LenSz::Indefinite => true,
                                        } {
                                            if matches!(len, cbor_event::LenSz::Indefinite)
                                                && raw.cbor_type()? == cbor_event::Type::Special
                                                && raw.special_break()?
                                            {
                                                break;
                                            }
                                            let (arr_elem, arr_elem_encoding) = raw
                                                .unsigned_integer_sz()
                                                .map_err(Into::<DeserializeError>::into)
                                                .and_then(|(x, enc)| {
                                                    if x > 4294967295 {
                                                        Err(DeserializeFailure::RangeCheck {
                                                            found: x as i128,
                                                            min: Some(0),
                                                            max: Some(4294967295),
                                                        }
                                                        .into())
                                                    } else {
                                                        Ok((x, enc))
                                                    }
                                                })
                                                .map(|(x, enc)| (x as u32, Some(enc)))?;
                                            arr_arr.push(arr_elem);
                                            arr_elem_encodings.push(arr_elem_encoding);
                                        }
                                        Ok((arr_arr, arr_encoding, arr_elem_encodings))
                                    })()
                                    .map_err(|e| e.annotate("arr"))?;
                                arr = Some(tmp_arr);
                                arr_encoding = tmp_arr_encoding;
                                arr_elem_encodings = tmp_arr_elem_encodings;
                                arr_key_encoding = StringEncoding::from(key_enc);
                                orig_deser_order.push(0);
                            }
                            "arr2" => {
                                if arr2.is_some() {
                                    return Err(DeserializeFailure::DuplicateKey(Key::Str(
                                        "arr2".into(),
                                    ))
                                    .into());
                                }
                                let (tmp_arr2, tmp_arr2_encoding) =
                                    (|| -> Result<_, DeserializeError> {
                                        let mut arr2_arr = Vec::new();
                                        let len = raw.array_sz()?;
                                        let arr2_encoding = len.into();
                                        while match len {
                                            cbor_event::LenSz::Len(n, _) => {
                                                (arr2_arr.len() as u64) < n
                                            }
                                            cbor_event::LenSz::Indefinite => true,
                                        } {
                                            if matches!(len, cbor_event::LenSz::Indefinite)
                                                && raw.cbor_type()? == cbor_event::Type::Special
                                                && raw.special_break()?
                                            {
                                                break;
                                            }
                                            arr2_arr.push(Foo::deserialize(raw)?);
                                        }
                                        Ok((arr2_arr, arr2_encoding))
                                    })()
                                    .map_err(|e| e.annotate("arr2"))?;
                                arr2 = Some(tmp_arr2);
                                arr2_encoding = tmp_arr2_encoding;
                                arr2_key_encoding = StringEncoding::from(key_enc);
                                orig_deser_order.push(1);
                            }
                            "table" => {
                                if table.is_some() {
                                    return Err(DeserializeFailure::DuplicateKey(Key::Str(
                                        "table".into(),
                                    ))
                                    .into());
                                }
                                let (
                                    tmp_table,
                                    tmp_table_encoding,
                                    tmp_table_key_encodings,
                                    tmp_table_value_encodings,
                                ) = (|| -> Result<_, DeserializeError> {
                                    let mut table_table = OrderedHashMap::new();
                                    let table_len = raw.map_sz()?;
                                    let table_encoding = table_len.into();
                                    let mut table_key_encodings = BTreeMap::new();
                                    let mut table_value_encodings = BTreeMap::new();
                                    while match table_len {
                                        cbor_event::LenSz::Len(n, _) => {
                                            (table_table.len() as u64) < n
                                        }
                                        cbor_event::LenSz::Indefinite => true,
                                    } {
                                        if matches!(table_len, cbor_event::LenSz::Indefinite)
                                            && raw.cbor_type()? == cbor_event::Type::Special
                                            && raw.special_break()?
                                        {
                                            break;
                                        }
                                        let (table_key, table_key_encoding) = raw
                                            .unsigned_integer_sz()
                                            .map(|(x, enc)| (x, Some(enc)))?;
                                        let (table_value, table_value_encoding) = raw
                                            .text_sz()
                                            .map(|(s, enc)| (s, StringEncoding::from(enc)))?;
                                        if table_table.insert(table_key, table_value).is_some() {
                                            return Err(DeserializeFailure::DuplicateKey(
                                                Key::Uint(table_key),
                                            )
                                            .into());
                                        }
                                        table_key_encodings.insert(table_key, table_key_encoding);
                                        table_value_encodings
                                            .insert(table_key, table_value_encoding);
                                    }
                                    Ok((
                                        table_table,
                                        table_encoding,
                                        table_key_encodings,
                                        table_value_encodings,
                                    ))
                                })()
                                .map_err(|e| e.annotate("table"))?;
                                table = Some(tmp_table);
                                table_encoding = tmp_table_encoding;
                                table_key_encodings = tmp_table_key_encodings;
                                table_value_encodings = tmp_table_value_encodings;
                                table_key_encoding = StringEncoding::from(key_enc);
                                orig_deser_order.push(2);
                            }
                            unknown_key => {
                                return Err(DeserializeFailure::UnknownKey(Key::Str(
                                    unknown_key.to_owned(),
                                ))
                                .into());
                            }
                        }
                    }
                    cbor_event::Type::Special => match len {
                        cbor_event::LenSz::Len(_, _) => {
                            return Err(DeserializeFailure::BreakInDefiniteLen.into());
                        }
                        cbor_event::LenSz::Indefinite => match raw.special()? {
                            cbor_event::Special::Break => break,
                            _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                        },
                    },
                    other_type => {
                        return Err(DeserializeFailure::UnexpectedKeyType(other_type).into());
                    }
                }
                read += 1;
            }
            let arr = match arr {
                Some(x) => x,
                None => {
                    return Err(
                        DeserializeFailure::MandatoryFieldMissing(Key::Str(String::from("arr")))
                            .into(),
                    );
                }
            };
            let arr2 = match arr2 {
                Some(x) => x,
                None => {
                    return Err(
                        DeserializeFailure::MandatoryFieldMissing(Key::Str(String::from("arr2")))
                            .into(),
                    );
                }
            };
            let table = match table {
                Some(x) => x,
                None => {
                    return Err(
                        DeserializeFailure::MandatoryFieldMissing(Key::Str(String::from("table")))
                            .into(),
                    );
                }
            };
            Ok(Self {
                arr,
                arr2,
                table,
                encodings: Some(TableArrMembersEncoding {
                    len_encoding,
                    orig_deser_order,
                    arr_key_encoding,
                    arr_encoding,
                    arr_elem_encodings,
                    arr2_key_encoding,
                    arr2_encoding,
                    table_key_encoding,
                    table_encoding,
                    table_key_encodings,
                    table_value_encodings,
                }),
            })
        })()
        .map_err(|e| e.annotate("TableArrMembers"))
    }
}

impl Serialize for TaggedAnonymousChoice {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
        force_canonical: bool,
    ) -> cbor_event::Result<&'se mut Serializer> {
        match self {
            TaggedAnonymousChoice::Int { int, tag_encoding } => {
                serializer.write_tag_sz(10u64, fit_sz(10u64, *tag_encoding, force_canonical))?;
                int.serialize(serializer, force_canonical)
            }
            TaggedAnonymousChoice::Text {
                text,
                text_encoding,
                tag_encoding,
            } => {
                serializer.write_tag_sz(10u64, fit_sz(10u64, *tag_encoding, force_canonical))?;
                serializer.write_text_sz(
                    text,
                    text_encoding.to_str_len_sz(text.len() as u64, force_canonical),
                )
            }
        }
    }
}

impl Deserialize for TaggedAnonymousChoice {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let (tag, tag_encoding) = raw.tag_sz()?;
            if tag != 10 {
                return Err(DeserializeFailure::TagMismatch {
                    found: tag,
                    expected: 10,
                }
                .into());
            }
            let tag_encoding = Some(tag_encoding);
            match raw.cbor_type()? {
                cbor_event::Type::UnsignedInteger | cbor_event::Type::NegativeInteger => {
                    let int = Int::deserialize(raw)?;
                    Ok(Self::Int { int, tag_encoding })
                }
                cbor_event::Type::Text => {
                    let (text, text_encoding) = raw
                        .text_sz()
                        .map(|(s, enc)| (s, StringEncoding::from(enc)))?;
                    Ok(Self::Text {
                        text,
                        text_encoding,
                        tag_encoding,
                    })
                }
                _ => Err(DeserializeFailure::NoVariantMatched.into()),
            }
        })()
        .map_err(|e| e.annotate("TaggedAnonymousChoice"))
    }
}

impl Serialize for TaggedText {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
        force_canonical: bool,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_tag_sz(
            9u64,
            fit_sz(
                9u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.inner_tag_encoding)
                    .unwrap_or_default(),
                force_canonical,
            ),
        )?;
        serializer.write_text_sz(
            &self.inner,
            self.encodings
                .as_ref()
                .map(|encs| encs.inner_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(self.inner.len() as u64, force_canonical),
        )
    }
}

impl Deserialize for TaggedText {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let (inner, inner_tag_encoding, inner_encoding) = match raw.tag_sz()? {
                (9, tag_enc) => raw
                    .text_sz()
                    .map(|(s, enc)| (s, Some(tag_enc), StringEncoding::from(enc)))?,
                (tag, _enc) => {
                    return Err(DeserializeFailure::TagMismatch {
                        found: tag,
                        expected: 9,
                    }
                    .into());
                }
            };
            Ok(Self {
                inner,
                encodings: Some(TaggedTextEncoding {
                    inner_tag_encoding,
                    inner_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("TaggedText"))
    }
}

impl Serialize for TypeChoice {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
        force_canonical: bool,
    ) -> cbor_event::Result<&'se mut Serializer> {
        match self {
            TypeChoice::I0 { i0_encoding } => serializer
                .write_unsigned_integer_sz(0u64, fit_sz(0u64, *i0_encoding, force_canonical)),
            TypeChoice::Helloworld {
                helloworld_encoding,
            } => serializer.write_text_sz(
                "hello world",
                helloworld_encoding.to_str_len_sz("hello world".len() as u64, force_canonical),
            ),
            TypeChoice::U64 {
                uint,
                uint_encoding,
            } => serializer
                .write_unsigned_integer_sz(*uint, fit_sz(*uint, *uint_encoding, force_canonical)),
            TypeChoice::Text {
                text,
                text_encoding,
            } => serializer.write_text_sz(
                text,
                text_encoding.to_str_len_sz(text.len() as u64, force_canonical),
            ),
            TypeChoice::ArrU64 {
                arr_u64,
                arr_u64_tag_encoding,
                arr_u64_encoding,
                arr_u64_elem_encodings,
            } => {
                serializer
                    .write_tag_sz(16u64, fit_sz(16u64, *arr_u64_tag_encoding, force_canonical))?;
                serializer.write_array_sz(
                    arr_u64_encoding.to_len_sz(arr_u64.len() as u64, force_canonical),
                )?;
                for (i, element) in arr_u64.iter().enumerate() {
                    let arr_u64_elem_encoding =
                        arr_u64_elem_encodings.get(i).cloned().unwrap_or_default();
                    serializer.write_unsigned_integer_sz(
                        *element,
                        fit_sz(*element, arr_u64_elem_encoding, force_canonical),
                    )?;
                }
                arr_u64_encoding.end(serializer, force_canonical)
            }
        }
    }
}

impl Deserialize for TypeChoice {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let initial_position = raw.position();
            let mut errs = Vec::new();
            let deser_variant = (|raw: &mut Deserializer| -> Result<_, DeserializeError> {
                let (i0_value, i0_encoding) = raw.unsigned_integer_sz()?;
                if i0_value != 0 {
                    return Err(DeserializeFailure::FixedValueMismatch {
                        found: Key::Uint(i0_value),
                        expected: Key::Uint(0),
                    }
                    .into());
                }
                Ok(Some(i0_encoding))
            })(raw);
            match deser_variant {
                Ok(i0_encoding) => return Ok(Self::I0 { i0_encoding }),
                Err(e) => {
                    errs.push(e.annotate("I0"));
                    raw.set_position(initial_position).unwrap();
                }
            };
            let deser_variant = (|raw: &mut Deserializer| -> Result<_, DeserializeError> {
                let (helloworld_value, helloworld_encoding) = raw.text_sz()?;
                if helloworld_value != "hello world" {
                    return Err(DeserializeFailure::FixedValueMismatch {
                        found: Key::Str(helloworld_value),
                        expected: Key::Str(String::from("hello world")),
                    }
                    .into());
                }
                Ok(StringEncoding::from(helloworld_encoding))
            })(raw);
            match deser_variant {
                Ok(helloworld_encoding) => {
                    return Ok(Self::Helloworld {
                        helloworld_encoding,
                    });
                }
                Err(e) => {
                    errs.push(e.annotate("Helloworld"));
                    raw.set_position(initial_position).unwrap();
                }
            };
            let deser_variant: Result<_, DeserializeError> = raw
                .unsigned_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(x, enc)| (x, Some(enc)));
            match deser_variant {
                Ok((uint, uint_encoding)) => {
                    return Ok(Self::U64 {
                        uint,
                        uint_encoding,
                    });
                }
                Err(e) => {
                    errs.push(e.annotate("U64"));
                    raw.set_position(initial_position).unwrap();
                }
            };
            let deser_variant: Result<_, DeserializeError> = raw
                .text_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(s, enc)| (s, StringEncoding::from(enc)));
            match deser_variant {
                Ok((text, text_encoding)) => {
                    return Ok(Self::Text {
                        text,
                        text_encoding,
                    });
                }
                Err(e) => {
                    errs.push(e.annotate("Text"));
                    raw.set_position(initial_position).unwrap();
                }
            };
            let deser_variant = (|raw: &mut Deserializer| -> Result<_, DeserializeError> {
                match raw.tag_sz()? {
                    (16, tag_enc) => {
                        let mut arr_u64_arr = Vec::new();
                        let len = raw.array_sz()?;
                        let arr_u64_encoding = len.into();
                        let mut arr_u64_elem_encodings = Vec::new();
                        while match len {
                            cbor_event::LenSz::Len(n, _) => (arr_u64_arr.len() as u64) < n,
                            cbor_event::LenSz::Indefinite => true,
                        } {
                            if matches!(len, cbor_event::LenSz::Indefinite)
                                && raw.cbor_type()? == cbor_event::Type::Special
                                && raw.special_break()?
                            {
                                break;
                            }
                            let (arr_u64_elem, arr_u64_elem_encoding) =
                                raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                            arr_u64_arr.push(arr_u64_elem);
                            arr_u64_elem_encodings.push(arr_u64_elem_encoding);
                        }
                        Ok((
                            arr_u64_arr,
                            Some(tag_enc),
                            arr_u64_encoding,
                            arr_u64_elem_encodings,
                        ))
                    }
                    (tag, _enc) => Err(DeserializeFailure::TagMismatch {
                        found: tag,
                        expected: 16,
                    }
                    .into()),
                }
            })(raw);
            match deser_variant {
                Ok((arr_u64, arr_u64_tag_encoding, arr_u64_encoding, arr_u64_elem_encodings)) => {
                    return Ok(Self::ArrU64 {
                        arr_u64,
                        arr_u64_tag_encoding,
                        arr_u64_encoding,
                        arr_u64_elem_encodings,
                    });
                }
                Err(e) => {
                    errs.push(e.annotate("ArrU64"));
                    raw.set_position(initial_position).unwrap();
                }
            };
            Err(DeserializeFailure::NoVariantMatchedWithCauses(errs).into())
        })()
        .map_err(|e| e.annotate("TypeChoice"))
    }
}
