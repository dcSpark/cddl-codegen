            let (uint_bytes, uint_bytes_bytes_encoding, uint_bytes_encoding) =
                (|| -> Result<_, DeserializeError> {
                    let (uint_bytes_bytes, uint_bytes_bytes_encoding) = raw.bytes_sz()?;
                    let inner_de = &mut Deserializer::from(uint_bytes_bytes);
