    fn as_ref(&self) -> &cddl_lib::TypeChoice {
        &self.0
    }
}

#[wasm_bindgen]
pub enum TypeChoiceKind {
    I0,
    Helloworld,
    U64,
    Text,
    ArrU64,
}

pub type U32 = u32;
