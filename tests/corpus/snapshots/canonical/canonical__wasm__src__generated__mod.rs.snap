#[derive(Clone, Debug)]
#[wasm_bindgen]
pub struct TypeChoice(cddl_lib::TypeChoice);

#[wasm_bindgen]
impl TypeChoice {
    pub fn to_cbor_bytes(&self) -> Vec<u8> {
        cddl_lib::serialization::Serialize::to_cbor_bytes(&self.0)
    }

    pub fn from_cbor_bytes(cbor_bytes: &[u8]) -> Result<TypeChoice, JsError> {
        cddl_lib::serialization::Deserialize::from_cbor_bytes(cbor_bytes)
            .map(Self)
            .map_err(|e| JsError::new(&format!("from_bytes: {}", e)))
    }

    pub fn new_i0() -> Self {
        Self(cddl_lib::TypeChoice::new_i0())
    }

    pub fn new_helloworld() -> Self {
        Self(cddl_lib::TypeChoice::new_helloworld())
    }

    pub fn new_uint(uint: u64) -> Self {
        Self(cddl_lib::TypeChoice::new_uint(uint))
    }

    pub fn new_text(text: String) -> Self {
        Self(cddl_lib::TypeChoice::new_text(text))
    }

    pub fn new_arr_u64(arr_u64: Vec<u64>) -> Self {
        Self(cddl_lib::TypeChoice::new_arr_u64(arr_u64))
    }

    pub fn kind(&self) -> TypeChoiceKind {
        match &self.0 {
            cddl_lib::TypeChoice::I0 { .. } => TypeChoiceKind::I0,
            cddl_lib::TypeChoice::Helloworld { .. } => TypeChoiceKind::Helloworld,
            cddl_lib::TypeChoice::U64 { .. } => TypeChoiceKind::U64,
            cddl_lib::TypeChoice::Text { .. } => TypeChoiceKind::Text,
            cddl_lib::TypeChoice::ArrU64 { .. } => TypeChoiceKind::ArrU64,
        }
    }

    pub fn as_uint(&self) -> Option<u64> {
        match &self.0 {
            cddl_lib::TypeChoice::U64 { uint, .. } => Some(*uint),
            _ => None,
        }
    }

    pub fn as_text(&self) -> Option<String> {
        match &self.0 {
            cddl_lib::TypeChoice::Text { text, .. } => Some(text.clone()),
            _ => None,
        }
    }

    pub fn as_arr_u64(&self) -> Option<Vec<u64>> {
        match &self.0 {
            cddl_lib::TypeChoice::ArrU64 { arr_u64, .. } => Some(arr_u64.clone()),
            _ => None,
        }
    }
}

impl From<cddl_lib::TypeChoice> for TypeChoice {
    fn from(native: cddl_lib::TypeChoice) -> Self {
        Self(native)
    }
}

impl From<TypeChoice> for cddl_lib::TypeChoice {
    fn from(wasm: TypeChoice) -> Self {
        wasm.0
    }
}

