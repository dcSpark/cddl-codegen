                .as_ref()
                .map(|encs| encs.data_encoding)
                .unwrap_or_default()
                .to_len_sz(self.data.len() as u64, force_canonical),
        )?;
        let mut key_order = self
            .data
            .iter()
            .map(|(k, v)| {
                let mut buf = cbor_event::se::Serializer::new_vec();
