impl Serialize for CborInCbor {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
        force_canonical: bool,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(2, force_canonical),
        )?;
        let mut foo_bytes_inner_se = Serializer::new_vec();
        self.foo_bytes
            .serialize(&mut foo_bytes_inner_se, force_canonical)?;
        let foo_bytes_bytes = foo_bytes_inner_se.finalize();
        serializer.write_bytes_sz(
            &foo_bytes_bytes,
            self.encodings
                .as_ref()
                .map(|encs| encs.foo_bytes_bytes_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(foo_bytes_bytes.len() as u64, force_canonical),
        )?;
        let mut uint_bytes_inner_se = Serializer::new_vec();
        uint_bytes_inner_se.write_unsigned_integer_sz(
            self.uint_bytes,
            fit_sz(
                self.uint_bytes,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.uint_bytes_encoding)
                    .unwrap_or_default(),
                force_canonical,
            ),
        )?;
        let uint_bytes_bytes = uint_bytes_inner_se.finalize();
        serializer.write_bytes_sz(
            &uint_bytes_bytes,
            self.encodings
                .as_ref()
                .map(|encs| encs.uint_bytes_bytes_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(uint_bytes_bytes.len() as u64, force_canonical),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer, force_canonical)
    }
}

impl Deserialize for CborInCbor {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let len = raw.array_sz()?;
        let len_encoding: LenEncoding = len.into();
        let mut read_len = CBORReadLen::new(len);
        read_len.read_elems(2)?;
        read_len.finish()?;
        (|| -> Result<_, DeserializeError> {
            let (foo_bytes, foo_bytes_bytes_encoding) = (|| -> Result<_, DeserializeError> {
                let (foo_bytes_bytes, foo_bytes_bytes_encoding) = raw.bytes_sz()?;
                let inner_de = &mut Deserializer::from(std::io::Cursor::new(foo_bytes_bytes));
                Ok((
                    Foo::deserialize(inner_de)?,
                    StringEncoding::from(foo_bytes_bytes_encoding),
                ))
            })()
            .map_err(|e| e.annotate("foo_bytes"))?;
            let (uint_bytes, uint_bytes_bytes_encoding, uint_bytes_encoding) =
                (|| -> Result<_, DeserializeError> {
                    let (uint_bytes_bytes, uint_bytes_bytes_encoding) = raw.bytes_sz()?;
                    let inner_de = &mut Deserializer::from(std::io::Cursor::new(uint_bytes_bytes));
                    inner_de
                        .unsigned_integer_sz()
                        .map_err(Into::<DeserializeError>::into)
                        .map(|(x, enc)| {
                            (
                                x,
                                StringEncoding::from(uint_bytes_bytes_encoding),
                                Some(enc),
                            )
                        })
                })()
                .map_err(|e| e.annotate("uint_bytes"))?;
            match len {
                cbor_event::LenSz::Len(_, _) => (),
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(CborInCbor {
                foo_bytes,
                uint_bytes,
                encodings: Some(CborInCborEncoding {
                    len_encoding,
                    foo_bytes_bytes_encoding,
                    uint_bytes_bytes_encoding,
                    uint_bytes_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("CborInCbor"))
    }
}

impl Serialize for DeeplyNested {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
        force_canonical: bool,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(1, force_canonical),
        )?;
        serializer.write_map_sz(
