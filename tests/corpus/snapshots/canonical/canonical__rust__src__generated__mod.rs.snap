        foo: Foo,
        len_encoding: LenEncoding,
    },
    GroupChoice3 {
        x: u64,
        len_encoding: LenEncoding,
        index_0_encoding: Option<cbor_event::Sz>,
        x_encoding: Option<cbor_event::Sz>,
    },
    Plain(Plain),
}

impl GroupChoice {
    pub fn new_i3() -> Self {
        Self::I3 {
            i3_encoding: None,
            len_encoding: LenEncoding::default(),
        }
    }

    pub fn new_i2() -> Self {
        Self::I2 {
            i2_tag_encoding: None,
            i2_encoding: None,
            len_encoding: LenEncoding::default(),
        }
    }

    pub fn new_foo(index_0: u64, index_1: String, index_2: Vec<u8>) -> Self {
        Self::Foo {
            foo: Foo::new(index_0, index_1, index_2),
            len_encoding: LenEncoding::default(),
        }
    }

    pub fn new_group_choice3(x: u64) -> Self {
        Self::GroupChoice3 {
            x,
            len_encoding: LenEncoding::default(),
            index_0_encoding: None,
            x_encoding: None,
        }
    }

    pub fn new_plain(d: u64, e: TaggedText) -> Self {
        Self::Plain(Plain::new(d, e))
    }
}

#[derive(Clone, Debug)]
pub enum Int {
    Uint {
        value: u64,
        encoding: Option<cbor_event::Sz>,
    },
    Nint {
        value: u64,
        encoding: Option<cbor_event::Sz>,
    },
}

impl Int {
    pub fn new_uint(value: u64) -> Self {
        Self::Uint {
            value,
            encoding: None,
        }
    }

    /// * `value` - Value as encoded in CBOR - note: a negative `x` here would be `|x + 1|` due to CBOR's `nint` encoding e.g. to represent -5, pass in 4.
    pub fn new_nint(value: u64) -> Self {
        Self::Nint {
            value,
            encoding: None,
        }
    }
}

impl core::fmt::Display for Int {
    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
        match self {
            Self::Uint { value, .. } => write!(f, "{}", value),
            Self::Nint { value, .. } => write!(f, "{}", -((*value as i128) + 1)),
        }
    }
}

impl core::str::FromStr for Int {
    type Err = IntError;

    fn from_str(s: &str) -> Result<Self, Self::Err> {
        let x = i128::from_str(s).map_err(IntError::Parsing)?;
        Self::try_from(x).map_err(IntError::Bounds)
    }
}

impl TryFrom<i128> for Int {
    type Error = core::num::TryFromIntError;

    fn try_from(x: i128) -> Result<Self, Self::Error> {
        if x >= 0 {
            u64::try_from(x).map(|x| Self::Uint {
                value: x,
                encoding: None,
            })
        } else {
            u64::try_from((x + 1).unsigned_abs()).map(|x| Self::Nint {
                value: x,
                encoding: None,
            })
        }
    }
}

#[derive(Clone, Debug)]
pub enum IntError {
    Bounds(core::num::TryFromIntError),
    Parsing(core::num::ParseIntError),
}

