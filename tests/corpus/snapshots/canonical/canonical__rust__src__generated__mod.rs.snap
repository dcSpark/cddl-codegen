#[derive(Clone, Debug)]
pub struct String32 {
    inner: String,
    pub encodings: Option<String32Encoding>,
}

impl String32 {
    pub fn get(&self) -> &String {
        &self.inner
    }

    fn new(inner: String) -> Result<Self, DeserializeError> {
        if inner.len() < 16 || inner.len() > 32 {
            return Err(DeserializeError::new(
                "String32",
                DeserializeFailure::RangeCheck {
                    found: inner.len() as i128,
                    min: Some(16),
                    max: Some(32),
                },
            ));
        }
        Ok(Self {
            inner,
            encodings: None,
        })
    }
}

impl TryFrom<String> for String32 {
    type Error = DeserializeError;

    fn try_from(inner: String) -> Result<Self, Self::Error> {
        String32::new(inner)
    }
}

