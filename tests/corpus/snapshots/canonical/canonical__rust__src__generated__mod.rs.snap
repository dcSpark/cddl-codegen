#[derive(Clone, Debug)]
pub struct ClippyNegBounded {
    pub neg: u64,
    pub encodings: Option<ClippyNegBoundedEncoding>,
}

impl ClippyNegBounded {
    pub fn new(neg: u64) -> Result<Self, DeserializeError> {
        if neg > 99 {
            return Err(DeserializeFailure::RangeCheck {
                found: neg as i128,
                min: None,
                max: Some(99),
            }
            .into());
        }
        Ok(Self {
            neg,
            encodings: None,
        })
    }
}

