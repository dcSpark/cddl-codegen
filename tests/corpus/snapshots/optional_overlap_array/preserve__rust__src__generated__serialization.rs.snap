use super::cbor_encodings::*;
use super::*;
use cbor_event::de::Deserializer;
use cbor_event::se::{Serialize, Serializer};

impl cbor_event::se::Serialize for OptionalOverlapArray {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(
                    1 + match &self.a {
                        Some(_) => 1,
                        None => 0,
                    },
                ),
        )?;
        if let Some(field) = &self.a {
            serializer.write_unsigned_integer_sz(
                *field,
                fit_sz(
                    *field,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.a_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        }
        serializer.write_unsigned_integer_sz(
            self.b,
            fit_sz(
                self.b,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.b_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}
