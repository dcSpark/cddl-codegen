/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitOptionalOverlapArray(pub RefCell<cddl_lib::OptionalOverlapArray>);

impl wit_types::GuestOptionalOverlapArray for WitOptionalOverlapArray {
    fn new(b: u64) -> Self {
        let inner = cddl_lib::OptionalOverlapArray::new(b);
        WitOptionalOverlapArray(RefCell::new(inner))
    }

    fn a(&self) -> Option<u64> {
        let me = self.0.borrow();
        me.a.as_ref().map(|x| *x)
    }

    fn set_a(&self, a: u64) {
        self.0.borrow_mut().a = Some(a);
    }

    fn b(&self) -> u64 {
        let me = self.0.borrow();
        me.b
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::OptionalOverlapArray as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }
}
