            self.encodings
                .as_ref()
                .map(|encs| encs.b_encoding)
                .unwrap_or_default()
                .to_len_sz(self.b.len() as u64),
        )?;
        for element in self.b.iter() {
            serializer.write_special(cbor_event::Special::Bool(*element))?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.b_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
