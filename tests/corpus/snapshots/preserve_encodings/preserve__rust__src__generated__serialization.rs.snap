                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(Enums {
                c_enum,
                type_choice,
                encodings: Some(EnumsEncoding {
                    len_encoding,
                    c_enum_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("Enums"))
    }
}

impl cbor_event::se::Serialize for First {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(2),
        )?;
        self.serialize_as_embedded_group(serializer)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

