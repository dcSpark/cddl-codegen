            match field_index {
                2 => {
                    serializer.write_unsigned_integer_sz(
                        1u64,
                        fit_sz(
                            1u64,
                            self.encodings
                                .as_ref()
                                .map(|encs| encs.key_1_key_encoding)
                                .unwrap_or_default(),
                        ),
                    )?;
                    match &self.key_1 {
                        Some(x) => {
                            serializer.write_unsigned_integer_sz(
                                *x,
                                fit_sz(
                                    *x,
                                    self.encodings
                                        .as_ref()
                                        .map(|encs| encs.key_1_encoding)
                                        .unwrap_or_default(),
                                ),
                            )?;
                        }
                        None => {
                            serializer.write_special(cbor_event::Special::Null)?;
                        }
                    };
                }
                3 => {
                    if let Some(field) = &self.key_5 {
                        serializer.write_unsigned_integer_sz(
                            5u64,
                            fit_sz(
                                5u64,
                                self.encodings
                                    .as_ref()
                                    .map(|encs| encs.key_5_key_encoding)
                                    .unwrap_or_default(),
                            ),
                        )?;
                        serializer.write_text_sz(
                            field,
                            self.encodings
                                .as_ref()
                                .map(|encs| encs.key_5_encoding.clone())
                                .unwrap_or_default()
                                .to_str_len_sz(field.len() as u64),
                        )?;
                    }
                }
                0 => {
                    serializer.write_text_sz(
                        "foo",
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.foo_key_encoding.clone())
                            .unwrap_or_default()
                            .to_str_len_sz("foo".len() as u64),
                    )?;
                    serializer.write_tag_sz(
                        13u64,
                        fit_sz(
                            13u64,
                            self.encodings
                                .as_ref()
                                .map(|encs| encs.foo_tag_encoding)
                                .unwrap_or_default(),
                        ),
                    )?;
                    self.foo.serialize(serializer)?;
                }
                1 => {
                    if let Some(field) = &self.derp {
                        serializer.write_text_sz(
                            "derp",
                            self.encodings
                                .as_ref()
                                .map(|encs| encs.derp_key_encoding.clone())
                                .unwrap_or_default()
                                .to_str_len_sz("derp".len() as u64),
                        )?;
                        serializer.write_unsigned_integer_sz(
                            *field,
                            fit_sz(
                                *field,
                                self.encodings
                                    .as_ref()
                                    .map(|encs| encs.derp_encoding)
                                    .unwrap_or_default(),
                            ),
                        )?;
                    }
                }
                4 => {
                    serializer.write_text_sz(
                        "five",
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.five_key_encoding.clone())
