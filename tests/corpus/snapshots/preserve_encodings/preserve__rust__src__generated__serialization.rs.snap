            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(
                    3 + match &self.index_2 {
                        Some(_) => 1,
                        None => 0,
                    },
                ),
        )?;
        self.serialize_as_embedded_group(serializer)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl SerializeEmbeddedGroup for Ee {
    fn serialize_as_embedded_group<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_unsigned_integer_sz(
            1u64,
            fit_sz(
                1u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.index_0_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_unsigned_integer_sz(
            self.index_1,
            fit_sz(
                self.index_1,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.index_1_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        if let Some(field) = &self.index_2 {
            serializer.write_bytes_sz(
                field,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.index_2_encoding.clone())
                    .unwrap_or_default()
                    .to_str_len_sz(field.len() as u64),
            )?;
        }
        serializer.write_unsigned_integer_sz(
            self.index_3,
            fit_sz(
                self.index_3,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.index_3_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        Ok(serializer)
    }
}

