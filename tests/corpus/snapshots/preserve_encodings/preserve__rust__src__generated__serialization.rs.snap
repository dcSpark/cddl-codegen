impl cbor_event::se::Serialize for FloatHeads {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(6),
        )?;
        write_float_width(
            serializer,
            cbor_event::se::f32_to_f64_exact(self.h),
            self.encodings
                .as_ref()
                .map(|encs| encs.h_encoding)
                .unwrap_or_default(),
            cbor_event::Sz::Two,
            cbor_event::Sz::Two,
        )?;
        write_float_width(
            serializer,
            cbor_event::se::f32_to_f64_exact(self.u),
            self.encodings
                .as_ref()
                .map(|encs| encs.u_encoding)
                .unwrap_or_default(),
            cbor_event::Sz::Two,
            cbor_event::Sz::Four,
        )?;
        write_float_width(
            serializer,
            self.w,
            self.encodings
                .as_ref()
                .map(|encs| encs.w_encoding)
                .unwrap_or_default(),
            cbor_event::Sz::Four,
            cbor_event::Sz::Eight,
        )?;
        write_float_width(
            serializer,
            cbor_event::se::f32_to_f64_exact(self.s),
            self.encodings
                .as_ref()
                .map(|encs| encs.s_encoding)
                .unwrap_or_default(),
            cbor_event::Sz::Four,
            cbor_event::Sz::Four,
        )?;
        write_float_width(
            serializer,
            self.d,
            self.encodings
                .as_ref()
                .map(|encs| encs.d_encoding)
                .unwrap_or_default(),
            cbor_event::Sz::Eight,
            cbor_event::Sz::Eight,
        )?;
        write_float(
            serializer,
            self.f,
            self.encodings
                .as_ref()
                .map(|encs| encs.f_encoding)
                .unwrap_or_default(),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

