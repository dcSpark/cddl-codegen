            let basic = Basic::deserialize_as_embedded_group(raw, &mut read_len, len)
                .map_err(|e: DeserializeError| e.annotate("basic"))?;
            match len {
                cbor_event::LenSz::Len(_, _) => (),
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(BasicArr {
                basic,
                encodings: Some(BasicArrEncoding { len_encoding }),
            })
        })()
        .map_err(|e| e.annotate("BasicArr"))
    }
}

impl cbor_event::se::Serialize for Bounds {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(6),
        )?;
        if self.w >= 0 {
            serializer.write_unsigned_integer_sz(
                self.w as u64,
                fit_sz(
                    self.w as u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.w_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        } else {
            serializer.write_negative_integer_sz(
                self.w as i128,
                fit_sz(
                    (self.w + 1).unsigned_abs(),
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.w_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        }
        serializer.write_unsigned_integer_sz(
            self.x,
            fit_sz(
                self.x,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.x_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_negative_integer_sz(
            -(self.y as i128 + 1),
            fit_sz(
                self.y,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.y_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_text_sz(
            &self.z,
            self.encodings
                .as_ref()
                .map(|encs| encs.z_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(self.z.len() as u64),
        )?;
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.a_encoding)
                .unwrap_or_default()
                .to_len_sz(self.a.len() as u64),
        )?;
        for (i, element) in self.a.iter().enumerate() {
            let a_elem_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.a_elem_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*element, fit_sz(*element, a_elem_encoding))?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.a_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        serializer.write_map_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.b_encoding)
                .unwrap_or_default()
                .to_len_sz(self.b.len() as u64),
        )?;
        for (key, value) in self.b.iter() {
            let b_key_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.b_key_encodings.get(key))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*key, fit_sz(*key, b_key_encoding))?;
            let b_value_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.b_value_encodings.get(key))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*value, fit_sz(*value, b_value_encoding))?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.b_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for Bounds {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.array_sz()?;
            let len_encoding: LenEncoding = len.into();
            let mut read_len = CBORReadLen::new(len);
            read_len.read_elems(6)?;
            read_len.finish()?;
            let (w, w_encoding) = (|| -> Result<_, DeserializeError> {
                Ok(match raw.cbor_type()? {
                    cbor_event::Type::UnsignedInteger => {
                        let (x, enc) = raw
                            .unsigned_integer_sz()
                            .map_err(Into::<DeserializeError>::into)
                            .and_then(|(x, enc)| {
                                if x > 1000 {
                                    Err(DeserializeFailure::RangeCheck {
                                        found: x as i128,
                                        min: None,
                                        max: Some(1000),
                                    }
                                    .into())
                                } else {
                                    Ok((x, enc))
                                }
                            })?;
                        (x as i64, Some(enc))
                    }
                    _ => {
                        let (x, enc) = raw
                            .negative_integer_sz()
                            .map_err(Into::<DeserializeError>::into)
                            .and_then(|(x, enc)| {
                                if x < -1000 {
                                    Err(DeserializeFailure::RangeCheck {
                                        found: x,
                                        min: Some(-1000),
                                        max: None,
                                    }
                                    .into())
                                } else {
                                    Ok((x, enc))
                                }
                            })?;
                        (x as i64, Some(enc))
                    }
                })
            })()
            .map_err(|e| e.annotate("w"))?;
            let (x, x_encoding) = raw
                .unsigned_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .and_then(|(x, enc)| {
                    if x > 7 {
                        Err(DeserializeFailure::RangeCheck {
                            found: x as i128,
                            min: None,
                            max: Some(7),
                        }
                        .into())
                    } else {
                        Ok((x, Some(enc)))
                    }
                })
                .map_err(|e: DeserializeError| e.annotate("x"))?;
            let (y, y_encoding) = raw
                .negative_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .and_then(|(x, enc)| {
                    if x < -5 {
                        Err(DeserializeFailure::RangeCheck {
                            found: x,
                            min: Some(-5),
                            max: None,
                        }
                        .into())
                    } else {
                        Ok(((x + 1).unsigned_abs() as u64, Some(enc)))
                    }
                })
                .map_err(|e: DeserializeError| e.annotate("y"))?;
            let (z, z_encoding) = raw
                .text_sz()
                .map_err(Into::<DeserializeError>::into)
                .and_then(|(s, enc)| {
                    if s.len() < 3 || s.len() > 14 {
                        Err(DeserializeFailure::RangeCheck {
                            found: s.len() as i128,
                            min: Some(3),
                            max: Some(14),
                        }
                        .into())
                    } else {
                        Ok((s, StringEncoding::from(enc)))
                    }
                })
                .map_err(|e: DeserializeError| e.annotate("z"))?;
            let (a, a_encoding, a_elem_encodings) = (|| -> Result<_, DeserializeError> {
                let mut a_arr = Vec::new();
                let len = raw.array_sz()?;
                let a_encoding = len.into();
                let mut a_elem_encodings = Vec::new();
                while match len {
                    cbor_event::LenSz::Len(n, _) => (a_arr.len() as u64) < n,
                    cbor_event::LenSz::Indefinite => true,
                } {
                    if matches!(len, cbor_event::LenSz::Indefinite)
                        && raw.cbor_type()? == cbor_event::Type::Special
                        && raw.special_break()?
                    {
                        break;
                    }
                    let (a_elem, a_elem_encoding) =
                        raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                    a_arr.push(a_elem);
                    a_elem_encodings.push(a_elem_encoding);
                }
                if a_arr.len() < 1 || a_arr.len() > 3 {
                    return Err(DeserializeFailure::RangeCheck {
                        found: a_arr.len() as i128,
                        min: Some(1),
                        max: Some(3),
                    }
                    .into());
                }
                Ok((a_arr, a_encoding, a_elem_encodings))
            })()
            .map_err(|e| e.annotate("a"))?;
            let (b, b_encoding, b_key_encodings, b_value_encodings) =
                (|| -> Result<_, DeserializeError> {
                    let mut b_table = OrderedHashMap::new();
                    let b_len = raw.map_sz()?;
                    let b_encoding = b_len.into();
                    let mut b_key_encodings = BTreeMap::new();
                    let mut b_value_encodings = BTreeMap::new();
                    while match b_len {
                        cbor_event::LenSz::Len(n, _) => (b_table.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(b_len, cbor_event::LenSz::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        let (b_key, b_key_encoding) =
                            raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                        let (b_value, b_value_encoding) =
                            raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                        if b_table.insert(b_key, b_value).is_some() {
                            return Err(DeserializeFailure::DuplicateKey(Key::Uint(b_key)).into());
                        }
                        b_key_encodings.insert(b_key, b_key_encoding);
                        b_value_encodings.insert(b_key, b_value_encoding);
                    }
                    if b_table.len() > 3 {
                        return Err(DeserializeFailure::RangeCheck {
                            found: b_table.len() as i128,
                            min: None,
                            max: Some(3),
                        }
                        .into());
                    }
                    Ok((b_table, b_encoding, b_key_encodings, b_value_encodings))
                })()
                .map_err(|e| e.annotate("b"))?;
            match len {
                cbor_event::LenSz::Len(_, _) => (),
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(Bounds {
                w,
                x,
                y,
                z,
                a,
                b,
                encodings: Some(BoundsEncoding {
                    len_encoding,
                    w_encoding,
                    x_encoding,
                    y_encoding,
                    z_encoding,
                    a_encoding,
                    a_elem_encodings,
                    b_encoding,
                    b_key_encodings,
                    b_value_encodings,
                }),
            })
        })()
        .map_err(|e| e.annotate("Bounds"))
    }
}

impl cbor_event::se::Serialize for BoundsGroupChoice {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        match self {
            BoundsGroupChoice::A(a) => a.serialize(serializer),
            BoundsGroupChoice::B { b, len_encoding } => {
                serializer.write_array_sz(len_encoding.to_len_sz(1))?;
                b.serialize(serializer)?;
                len_encoding.end(serializer)?;
                Ok(serializer)
            }
            BoundsGroupChoice::C(c) => c.serialize(serializer),
        }
    }
}

impl Deserialize for BoundsGroupChoice {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.array_sz()?;
            let len_encoding: LenEncoding = len.into();
            let initial_position = raw.position();
            let mut errs = Vec::new();
            let deser_variant = (|raw: &mut Deserializer| -> Result<_, DeserializeError> {
                let mut read_len = CBORReadLen::new(len);
                read_len.read_elems(2)?;
                read_len.finish()?;
                let ret = A::deserialize_as_embedded_group(raw, &mut read_len, len);
                match len {
                    cbor_event::LenSz::Len(_, _) => (),
                    cbor_event::LenSz::Indefinite => match raw.special()? {
                        cbor_event::Special::Break => (),
                        _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                    },
                }
                ret
            })(raw);
            match deser_variant {
                Ok(a) => return Ok(Self::A(a)),
                Err(e) => {
                    errs.push(e.annotate("A"));
                    raw.set_position(initial_position).unwrap();
                }
            };
            let deser_variant = (|raw: &mut Deserializer| -> Result<_, DeserializeError> {
                let mut read_len = CBORReadLen::new(len);
                read_len.read_elems(1)?;
                read_len.finish()?;
                let ret = Hash::deserialize(raw);
                match len {
                    cbor_event::LenSz::Len(_, _) => (),
                    cbor_event::LenSz::Indefinite => match raw.special()? {
                        cbor_event::Special::Break => (),
                        _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                    },
                }
                ret
            })(raw);
            match deser_variant {
                Ok(b) => return Ok(Self::B { b, len_encoding }),
                Err(e) => {
                    errs.push(e.annotate("B"));
                    raw.set_position(initial_position).unwrap();
                }
            };
            let deser_variant = (|raw: &mut Deserializer| -> Result<_, DeserializeError> {
                let mut read_len = CBORReadLen::new(len);
                read_len.read_elems(3)?;
                read_len.finish()?;
                let ret = C::deserialize_as_embedded_group(raw, &mut read_len, len);
                match len {
                    cbor_event::LenSz::Len(_, _) => (),
                    cbor_event::LenSz::Indefinite => match raw.special()? {
                        cbor_event::Special::Break => (),
                        _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                    },
                }
                ret
            })(raw);
            match deser_variant {
                Ok(c) => return Ok(Self::C(c)),
                Err(e) => {
                    errs.push(e.annotate("C"));
                    raw.set_position(initial_position).unwrap();
                }
            };
            Err(DeserializeFailure::NoVariantMatchedWithCauses(errs).into())
        })()
        .map_err(|e| e.annotate("BoundsGroupChoice"))
    }
}

impl cbor_event::se::Serialize for BoundsTypeChoice {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        match self {
            BoundsTypeChoice::Bytes {
                bytes,
                bytes_encoding,
            } => serializer.write_bytes_sz(bytes, bytes_encoding.to_str_len_sz(bytes.len() as u64)),
            BoundsTypeChoice::Text {
                text,
                text_encoding,
            } => serializer.write_text_sz(text, text_encoding.to_str_len_sz(text.len() as u64)),
        }
    }
}

impl Deserialize for BoundsTypeChoice {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            match raw.cbor_type()? {
                cbor_event::Type::Bytes => {
                    let (bytes, bytes_encoding) = raw
                        .bytes_sz()
                        .map_err(Into::<DeserializeError>::into)
                        .and_then(|(bytes, enc)| {
                            if bytes.len() > 64 {
                                Err(DeserializeFailure::RangeCheck {
                                    found: bytes.len() as i128,
                                    min: None,
                                    max: Some(64),
                                }
                                .into())
                            } else {
                                Ok((bytes, StringEncoding::from(enc)))
                            }
                        })?;
                    Ok(Self::Bytes {
                        bytes,
                        bytes_encoding,
                    })
                }
                cbor_event::Type::Text => {
                    let (text, text_encoding) = raw
                        .text_sz()
                        .map_err(Into::<DeserializeError>::into)
                        .and_then(|(s, enc)| {
                            if s.len() > 64 {
                                Err(DeserializeFailure::RangeCheck {
                                    found: s.len() as i128,
                                    min: None,
                                    max: Some(64),
                                }
                                .into())
                            } else {
                                Ok((s, StringEncoding::from(enc)))
                            }
                        })?;
                    Ok(Self::Text {
                        text,
                        text_encoding,
                    })
                }
                _ => Err(DeserializeFailure::NoVariantMatched.into()),
            }
        })()
        .map_err(|e| e.annotate("BoundsTypeChoice"))
    }
}

impl cbor_event::se::Serialize for BytesUint {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(2),
        )?;
        self.serialize_as_embedded_group(serializer)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl SerializeEmbeddedGroup for BytesUint {
    fn serialize_as_embedded_group<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_bytes_sz(
            &self.index_0,
            self.encodings
                .as_ref()
                .map(|encs| encs.index_0_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(self.index_0.len() as u64),
        )?;
        serializer.write_unsigned_integer_sz(
            self.index_1,
            fit_sz(
                self.index_1,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.index_1_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        Ok(serializer)
    }
}

impl Deserialize for BytesUint {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        let (len, mut read_len) = (|| -> Result<_, DeserializeError> {
            let len = raw.array_sz()?;
            let mut read_len = CBORReadLen::new(len);
            read_len.read_elems(2)?;
            read_len.finish()?;
            Ok((len, read_len))
        })()
        .map_err(|e| e.annotate("BytesUint"))?;
        let ret = Self::deserialize_as_embedded_group(raw, &mut read_len, len);
        (|| -> Result<_, DeserializeError> {
            match len {
                cbor_event::LenSz::Len(_, _) => (),
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(())
        })()
        .map_err(|e| e.annotate("BytesUint"))?;
        ret
    }
}

impl DeserializeEmbeddedGroup for BytesUint {
    fn deserialize_as_embedded_group(
        raw: &mut Deserializer,
        _read_len: &mut CBORReadLen,
        len: cbor_event::LenSz,
    ) -> Result<Self, DeserializeError> {
        let len_encoding = len.into();
        (|| -> Result<_, DeserializeError> {
            let (index_0, index_0_encoding) = raw
                .bytes_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(bytes, enc)| (bytes, StringEncoding::from(enc)))
                .map_err(|e: DeserializeError| e.annotate("index_0"))?;
            let (index_1, index_1_encoding) = raw
                .unsigned_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(x, enc)| (x, Some(enc)))
                .map_err(|e: DeserializeError| e.annotate("index_1"))?;
            Ok(BytesUint {
                index_0,
                index_1,
                encodings: Some(BytesUintEncoding {
                    len_encoding,
                    index_0_encoding,
                    index_1_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("BytesUint"))
    }
}

impl cbor_event::se::Serialize for C {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(3),
