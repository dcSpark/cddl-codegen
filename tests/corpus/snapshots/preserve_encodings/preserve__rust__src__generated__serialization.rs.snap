impl cbor_event::se::Serialize for SignedInts {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(11),
        )?;
        serializer.write_unsigned_integer_sz(
            self.u_8 as u64,
            fit_sz(
                self.u_8 as u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.u_8_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_unsigned_integer_sz(
            self.u_16 as u64,
            fit_sz(
                self.u_16 as u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.u_16_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_unsigned_integer_sz(
            self.u_32 as u64,
            fit_sz(
                self.u_32 as u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.u_32_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_unsigned_integer_sz(
            self.u_64,
            fit_sz(
                self.u_64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.u_64_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        if self.i_8 >= 0 {
            serializer.write_unsigned_integer_sz(
                self.i_8 as u64,
                fit_sz(
                    self.i_8 as u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.i_8_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        } else {
            serializer.write_negative_integer_sz(
                self.i_8 as i128,
                fit_sz(
                    (self.i_8 + 1).unsigned_abs() as u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.i_8_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        }
        if self.i_16 >= 0 {
            serializer.write_unsigned_integer_sz(
                self.i_16 as u64,
                fit_sz(
                    self.i_16 as u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.i_16_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        } else {
            serializer.write_negative_integer_sz(
                self.i_16 as i128,
                fit_sz(
                    (self.i_16 + 1).unsigned_abs() as u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.i_16_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        }
        if self.i_32 >= 0 {
            serializer.write_unsigned_integer_sz(
                self.i_32 as u64,
                fit_sz(
                    self.i_32 as u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.i_32_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        } else {
            serializer.write_negative_integer_sz(
                self.i_32 as i128,
                fit_sz(
                    (self.i_32 + 1).unsigned_abs() as u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.i_32_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        }
        if self.i_64 >= 0 {
            serializer.write_unsigned_integer_sz(
                self.i_64 as u64,
                fit_sz(
                    self.i_64 as u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.i_64_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        } else {
            serializer.write_negative_integer_sz(
                self.i_64 as i128,
                fit_sz(
                    (self.i_64 + 1).unsigned_abs(),
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.i_64_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        }
        serializer.write_negative_integer_sz(
            -(self.n_64 as i128 + 1),
            fit_sz(
                self.n_64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.n_64_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_unsigned_integer_sz(
            18446744073709551615u64,
            fit_sz(
                18446744073709551615u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.u64_max_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_negative_integer_sz(
            -9223372036854775808,
            fit_sz(
                (-9223372036854775808i128 + 1).unsigned_abs() as u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.i64_min_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for SignedInts {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.array_sz()?;
