                serializer.write_unsigned_integer_sz(5u64, fit_sz(5u64, *index_2_encoding))?;
                len_encoding.end(serializer)?;
                Ok(serializer)
            }
            EnumOptEmbedFields::Ec {
                index_1,
                len_encoding,
                index_0_encoding,
                index_1_encoding,
                index_2_encoding,
            } => {
                serializer.write_array_sz(len_encoding.to_len_sz(3))?;
                serializer.write_unsigned_integer_sz(1u64, fit_sz(1u64, *index_0_encoding))?;
                serializer
                    .write_unsigned_integer_sz(*index_1, fit_sz(*index_1, *index_1_encoding))?;
                serializer.write_unsigned_integer_sz(7u64, fit_sz(7u64, *index_2_encoding))?;
                len_encoding.end(serializer)?;
                Ok(serializer)
            }
            EnumOptEmbedFields::Ed(ed) => ed.serialize(serializer),
            EnumOptEmbedFields::Ee(ee) => ee.serialize(serializer),
            EnumOptEmbedFields::Ef {
                non_overlapping_type_choice_some,
                len_encoding,
                index_0_encoding,
                index_2_tag_encoding,
                index_2_encoding,
            } => {
                serializer.write_array_sz(len_encoding.to_len_sz(
                    2 + match non_overlapping_type_choice_some {
                        Some(_) => 1,
                        None => 0,
                    },
                ))?;
                serializer.write_unsigned_integer_sz(1u64, fit_sz(1u64, *index_0_encoding))?;
                if let Some(field) = non_overlapping_type_choice_some {
                    field.serialize(serializer)?;
                }
                serializer.write_tag_sz(11u64, fit_sz(11u64, *index_2_tag_encoding))?;
                serializer.write_unsigned_integer_sz(11u64, fit_sz(11u64, *index_2_encoding))?;
                len_encoding.end(serializer)?;
                Ok(serializer)
            }
            EnumOptEmbedFields::Eg {
                overlapping_inlined,
                len_encoding,
                index_0_encoding,
                index_2_tag_encoding,
                index_2_encoding,
            } => {
                serializer.write_array_sz(len_encoding.to_len_sz(
                    2 + match overlapping_inlined {
                        Some(_) => 1,
                        None => 0,
                    },
                ))?;
                serializer.write_unsigned_integer_sz(1u64, fit_sz(1u64, *index_0_encoding))?;
                if let Some(field) = overlapping_inlined {
                    field.serialize(serializer)?;
                }
                serializer.write_tag_sz(13u64, fit_sz(13u64, *index_2_tag_encoding))?;
                serializer.write_unsigned_integer_sz(13u64, fit_sz(13u64, *index_2_encoding))?;
