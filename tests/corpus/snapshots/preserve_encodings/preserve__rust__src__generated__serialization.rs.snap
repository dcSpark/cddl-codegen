        )?;
        let mut elem_payloads_inner_se = Serializer::new_vec();
        elem_payloads_inner_se.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.elem_payloads_encoding)
                .unwrap_or_default()
                .to_len_sz(self.elem_payloads.len() as u64),
        )?;
        for (i, element) in self.elem_payloads.iter().enumerate() {
            let (elem_payloads_elem_bytes_encoding, elem_payloads_elem_encoding) = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.elem_payloads_elem_encodings.get(i))
                .cloned()
                .unwrap_or_else(|| (StringEncoding::default(), None));
            let mut elem_payloads_elem_inner_se = Serializer::new_vec();
            elem_payloads_elem_inner_se.write_unsigned_integer_sz(
                *element,
                fit_sz(*element, elem_payloads_elem_encoding),
            )?;
            let elem_payloads_elem_bytes = elem_payloads_elem_inner_se.finalize();
            elem_payloads_inner_se.write_bytes_sz(
                &elem_payloads_elem_bytes,
                elem_payloads_elem_bytes_encoding
                    .to_str_len_sz(elem_payloads_elem_bytes.len() as u64),
            )?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.elem_payloads_encoding)
            .unwrap_or_default()
            .end(&mut elem_payloads_inner_se)?;
        let elem_payloads_bytes = elem_payloads_inner_se.finalize();
        serializer.write_bytes_sz(
            &elem_payloads_bytes,
            self.encodings
                .as_ref()
                .map(|encs| encs.elem_payloads_bytes_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(elem_payloads_bytes.len() as u64),
        )?;
        let mut value_payloads_inner_se = Serializer::new_vec();
        value_payloads_inner_se.write_map_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.value_payloads_encoding)
                .unwrap_or_default()
                .to_len_sz(self.value_payloads.len() as u64),
        )?;
        for (key, value) in self.value_payloads.iter() {
            let value_payloads_key_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.value_payloads_key_encodings.get(key))
                .cloned()
                .unwrap_or_default();
            value_payloads_inner_se
                .write_unsigned_integer_sz(*key, fit_sz(*key, value_payloads_key_encoding))?;
            let (value_payloads_value_bytes_encoding, value_payloads_value_encoding) = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.value_payloads_value_encodings.get(key))
                .cloned()
                .unwrap_or_else(|| (StringEncoding::default(), None));
            let mut value_payloads_value_inner_se = Serializer::new_vec();
            value_payloads_value_inner_se
                .write_unsigned_integer_sz(*value, fit_sz(*value, value_payloads_value_encoding))?;
            let value_payloads_value_bytes = value_payloads_value_inner_se.finalize();
            value_payloads_inner_se.write_bytes_sz(
                &value_payloads_value_bytes,
                value_payloads_value_bytes_encoding
                    .to_str_len_sz(value_payloads_value_bytes.len() as u64),
            )?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.value_payloads_encoding)
            .unwrap_or_default()
            .end(&mut value_payloads_inner_se)?;
        let value_payloads_bytes = value_payloads_inner_se.finalize();
        serializer.write_bytes_sz(
            &value_payloads_bytes,
            self.encodings
                .as_ref()
                .map(|encs| encs.value_payloads_bytes_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(value_payloads_bytes.len() as u64),
        )?;
        let mut after_payload_inner_se = Serializer::new_vec();
        after_payload_inner_se.write_unsigned_integer_sz(
            self.after_payload,
            fit_sz(
                self.after_payload,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.after_payload_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        let after_payload_bytes = after_payload_inner_se.finalize();
        serializer.write_bytes_sz(
            &after_payload_bytes,
            self.encodings
                .as_ref()
                .map(|encs| encs.after_payload_bytes_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(after_payload_bytes.len() as u64),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for CborNestedPayloads {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.array_sz()?;
            let len_encoding: LenEncoding = len.into();
            let mut read_len = CBORReadLen::new(len);
            read_len.read_elems(3)?;
            read_len.finish()?;
            let (
                elem_payloads,
                elem_payloads_bytes_encoding,
                elem_payloads_encoding,
                elem_payloads_elem_encodings,
            ) = (|| -> Result<_, DeserializeError> {
                let (elem_payloads_bytes, elem_payloads_bytes_encoding) = raw.bytes_sz()?;
                let inner_de = &mut Deserializer::from(elem_payloads_bytes);
                let mut elem_payloads_arr = Vec::new();
                let len = inner_de.array_sz()?;
                let elem_payloads_encoding = len.into();
                let mut elem_payloads_elem_encodings = Vec::new();
                while match len {
                    cbor_event::LenSz::Len(n, _) => (elem_payloads_arr.len() as u64) < n,
                    cbor_event::LenSz::Indefinite => true,
                } {
                    if matches!(len, cbor_event::LenSz::Indefinite)
                        && inner_de.cbor_type()? == cbor_event::Type::Special
                        && inner_de.special_break()?
                    {
                        break;
                    }
                    let (elem_payloads_elem_bytes, elem_payloads_elem_bytes_encoding) =
                        inner_de.bytes_sz()?;
                    let inner_de = &mut Deserializer::from(elem_payloads_elem_bytes);
                    let (
                        elem_payloads_elem,
                        elem_payloads_elem_bytes_encoding,
                        elem_payloads_elem_encoding,
                    ) = inner_de.unsigned_integer_sz().map(|(x, enc)| {
                        (
                            x,
                            StringEncoding::from(elem_payloads_elem_bytes_encoding),
                            Some(enc),
                        )
                    })?;
                    if !inner_de.as_slice().is_empty() {
                        return Err(
                            DeserializeFailure::CBOR(cbor_event::Error::TrailingData).into()
                        );
                    }
                    elem_payloads_arr.push(elem_payloads_elem);
                    elem_payloads_elem_encodings.push((
                        elem_payloads_elem_bytes_encoding,
                        elem_payloads_elem_encoding,
                    ));
                }
                let elem_payloads_payload = (
                    elem_payloads_arr,
                    StringEncoding::from(elem_payloads_bytes_encoding),
                    elem_payloads_encoding,
                    elem_payloads_elem_encodings,
                );
                if !inner_de.as_slice().is_empty() {
                    return Err(DeserializeFailure::CBOR(cbor_event::Error::TrailingData).into());
                }
                Ok(elem_payloads_payload)
            })()
            .map_err(|e| e.annotate("elem_payloads"))?;
            let (
                value_payloads,
                value_payloads_bytes_encoding,
                value_payloads_encoding,
                value_payloads_key_encodings,
                value_payloads_value_encodings,
            ) = (|| -> Result<_, DeserializeError> {
                let (value_payloads_bytes, value_payloads_bytes_encoding) = raw.bytes_sz()?;
                let inner_de = &mut Deserializer::from(value_payloads_bytes);
                let mut value_payloads_table = OrderedHashMap::new();
                let value_payloads_len = inner_de.map_sz()?;
                let value_payloads_encoding = value_payloads_len.into();
                let mut value_payloads_key_encodings = BTreeMap::new();
                let mut value_payloads_value_encodings = BTreeMap::new();
                while match value_payloads_len {
                    cbor_event::LenSz::Len(n, _) => (value_payloads_table.len() as u64) < n,
                    cbor_event::LenSz::Indefinite => true,
                } {
                    if matches!(value_payloads_len, cbor_event::LenSz::Indefinite)
                        && inner_de.cbor_type()? == cbor_event::Type::Special
                        && inner_de.special_break()?
                    {
                        break;
                    }
                    let (value_payloads_key, value_payloads_key_encoding) = inner_de
                        .unsigned_integer_sz()
                        .map(|(x, enc)| (x, Some(enc)))?;
                    let (value_payloads_value_bytes, value_payloads_value_bytes_encoding) =
                        inner_de.bytes_sz()?;
                    let inner_de = &mut Deserializer::from(value_payloads_value_bytes);
                    let (
                        value_payloads_value,
                        value_payloads_value_bytes_encoding,
                        value_payloads_value_encoding,
                    ) = inner_de.unsigned_integer_sz().map(|(x, enc)| {
                        (
                            x,
                            StringEncoding::from(value_payloads_value_bytes_encoding),
                            Some(enc),
                        )
                    })?;
                    if !inner_de.as_slice().is_empty() {
                        return Err(
                            DeserializeFailure::CBOR(cbor_event::Error::TrailingData).into()
                        );
                    }
                    if value_payloads_table
                        .insert(value_payloads_key, value_payloads_value)
                        .is_some()
                    {
                        return Err(DeserializeFailure::DuplicateKey(Key::Uint(
                            value_payloads_key,
                        ))
                        .into());
                    }
                    value_payloads_key_encodings
                        .insert(value_payloads_key, value_payloads_key_encoding);
                    value_payloads_value_encodings.insert(
                        value_payloads_key,
                        (
                            value_payloads_value_bytes_encoding,
                            value_payloads_value_encoding,
                        ),
                    );
                }
                let value_payloads_payload = (
                    value_payloads_table,
                    StringEncoding::from(value_payloads_bytes_encoding),
                    value_payloads_encoding,
                    value_payloads_key_encodings,
                    value_payloads_value_encodings,
                );
                if !inner_de.as_slice().is_empty() {
                    return Err(DeserializeFailure::CBOR(cbor_event::Error::TrailingData).into());
                }
                Ok(value_payloads_payload)
            })()
            .map_err(|e| e.annotate("value_payloads"))?;
            let (after_payload, after_payload_bytes_encoding, after_payload_encoding) =
                (|| -> Result<_, DeserializeError> {
                    let (after_payload_bytes, after_payload_bytes_encoding) = raw.bytes_sz()?;
                    let inner_de = &mut Deserializer::from(after_payload_bytes);
                    let after_payload_payload =
                        inner_de.unsigned_integer_sz().map(|(x, enc)| {
                            (
                                x,
                                StringEncoding::from(after_payload_bytes_encoding),
                                Some(enc),
                            )
                        })?;
                    if !inner_de.as_slice().is_empty() {
                        return Err(
                            DeserializeFailure::CBOR(cbor_event::Error::TrailingData).into()
                        );
                    }
                    Ok(after_payload_payload)
                })()
                .map_err(|e| e.annotate("after_payload"))?;
            match len {
                cbor_event::LenSz::Len(_, _) => (),
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(CborNestedPayloads {
                elem_payloads,
                value_payloads,
                after_payload,
                encodings: Some(CborNestedPayloadsEncoding {
                    len_encoding,
                    elem_payloads_bytes_encoding,
                    elem_payloads_encoding,
                    elem_payloads_elem_encodings,
                    value_payloads_bytes_encoding,
                    value_payloads_encoding,
                    value_payloads_key_encodings,
                    value_payloads_value_encodings,
                    after_payload_bytes_encoding,
                    after_payload_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("CborNestedPayloads"))
    }
}

impl cbor_event::se::Serialize for CustomFieldHolder {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(1),
        )?;
        self.nested.serialize(serializer)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

