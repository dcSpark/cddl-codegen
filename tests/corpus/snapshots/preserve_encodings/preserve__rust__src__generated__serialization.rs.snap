            let (i_8, i_8_encoding) = (|| -> Result<_, DeserializeError> {
                Ok(match raw.cbor_type()? {
                    cbor_event::Type::UnsignedInteger => {
                        let (x, enc) = raw
                            .unsigned_integer_sz()
                            .map_err(Into::<DeserializeError>::into)
                            .and_then(|(x, enc)| {
                                if x > 127 {
