                    while match valued_len {
                        cbor_event::LenSz::Len(n, _) => (valued_table.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(valued_len, cbor_event::LenSz::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        let (valued_key, valued_key_encoding) =
                            raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                        let (valued_value, valued_value_encoding) = read_hex_table_string(raw)?;
