                serializer.write_map_sz(len_encoding.to_len_sz(1))?;
                serializer.write_text_sz(
                    "absent",
                    absent_key_encoding.to_str_len_sz("absent".len() as u64),
                )?;
                serializer.write_special(cbor_event::Special::Null)?;
                len_encoding.end(serializer)?;
                Ok(serializer)
            }
            FixedSpecialGroupChoice::Label {
                label,
                label_encoding,
                label_key_encoding,
                len_encoding,
            } => {
                serializer.write_map_sz(len_encoding.to_len_sz(1))?;
                serializer.write_text_sz(
                    "label",
                    label_key_encoding.to_str_len_sz("label".len() as u64),
                )?;
                serializer
                    .write_text_sz(label, label_encoding.to_str_len_sz(label.len() as u64))?;
                len_encoding.end(serializer)?;
                Ok(serializer)
            }
        }
    }
