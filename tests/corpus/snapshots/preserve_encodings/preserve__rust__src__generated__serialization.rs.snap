            read_len.finish()?;
            Ok(Self {
                foo,
                derp,
                key_1,
                key_5,
                encodings: Some(BarEncoding {
                    len_encoding,
                    orig_deser_order,
                    foo_key_encoding,
                    foo_tag_encoding,
                    derp_key_encoding,
                    derp_encoding,
                    key_1_key_encoding,
                    key_1_encoding,
                    key_5_key_encoding,
                    key_5_encoding,
                    five_key_encoding,
                    five_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("Bar"))
