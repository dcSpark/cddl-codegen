impl cbor_event::se::Serialize for CustomTablePositions {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(2),
        )?;
        serializer.write_map_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.keyed_encoding)
                .unwrap_or_default()
                .to_len_sz(self.keyed.len() as u64),
        )?;
        for (key, value) in self.keyed.iter() {
            let keyed_key_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.keyed_key_encodings.get(key))
                .cloned()
                .unwrap_or_default();
            write_hex_table_string(serializer, key, keyed_key_encoding)?;
            let keyed_value_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.keyed_value_encodings.get(key))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*value, fit_sz(*value, keyed_value_encoding))?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.keyed_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        serializer.write_map_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.valued_encoding)
                .unwrap_or_default()
                .to_len_sz(self.valued.len() as u64),
        )?;
        for (key, value) in self.valued.iter() {
            let valued_key_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.valued_key_encodings.get(key))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*key, fit_sz(*key, valued_key_encoding))?;
            let valued_value_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.valued_value_encodings.get(key))
                .cloned()
                .unwrap_or_default();
            write_hex_table_string(serializer, value, valued_value_encoding)?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.valued_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for CustomTablePositions {
