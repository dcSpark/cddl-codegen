    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let (inner, inner_tag_encoding, inner_bytes_encoding) = match raw.tag_sz()? {
                (20, tag_enc) => {
                    let (inner_bytes, inner_bytes_encoding) = raw.bytes_sz()?;
                    let inner_de = &mut Deserializer::from(inner_bytes);
                    let inner_payload = (
                        Foo::deserialize(inner_de)?,
                        Some(tag_enc),
                        StringEncoding::from(inner_bytes_encoding),
                    );
                    if !inner_de.as_slice().is_empty() {
                        return Err(
                            DeserializeFailure::CBOR(cbor_event::Error::TrailingData).into()
                        );
                    }
                    inner_payload
                }
                (tag, _enc) => {
                    return Err(DeserializeFailure::TagMismatch {
                        found: tag,
                        expected: 20,
                    }
                    .into());
                }
            };
            Ok(Self {
                inner,
                encodings: Some(TaggedFooBytesEncoding {
                    inner_tag_encoding,
                    inner_bytes_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("TaggedFooBytes"))
    }
}

