                        (1, key_enc) => {
                            if key_1.is_some() {
                                return Err(DeserializeFailure::DuplicateKey(Key::Uint(1)).into());
                            }
                            let (tmp_key_1, tmp_key_1_encoding) =
                                (|| -> Result<_, DeserializeError> {
                                    read_len.read_elems(1)?;
                                    raw.unsigned_integer_sz()
                                        .map_err(Into::<DeserializeError>::into)
                                        .map(|(x, enc)| (x, Some(enc)))
                                })()
                                .map_err(|e| e.annotate("key_1"))?;
                            key_1 = Some(tmp_key_1);
                            key_1_encoding = tmp_key_1_encoding;
                            key_1_key_encoding = Some(key_enc);
                            orig_deser_order.push(0);
                        }
                        (2, key_enc) => {
                            if key_2.is_some() {
                                return Err(DeserializeFailure::DuplicateKey(Key::Uint(2)).into());
                            }
                            let (tmp_key_2, tmp_key_2_encoding) =
                                (|| -> Result<_, DeserializeError> {
                                    read_len.read_elems(1)?;
                                    raw.text_sz()
                                        .map_err(Into::<DeserializeError>::into)
                                        .map(|(s, enc)| (s, StringEncoding::from(enc)))
                                })()
                                .map_err(|e| e.annotate("key_2"))?;
                            key_2 = Some(tmp_key_2);
                            key_2_encoding = tmp_key_2_encoding;
                            key_2_key_encoding = Some(key_enc);
                            orig_deser_order.push(1);
                        }
                        (unknown_key, _enc) => {
                            return Err(
                                DeserializeFailure::UnknownKey(Key::Uint(unknown_key)).into()
                            );
                        }
                    },
                    cbor_event::Type::Text => {
                        return Err(DeserializeFailure::UnknownKey(Key::Str(raw.text()?)).into());
                    }
                    cbor_event::Type::Special => match len {
                        cbor_event::LenSz::Len(_, _) => {
                            return Err(DeserializeFailure::BreakInDefiniteLen.into());
                        }
                        cbor_event::LenSz::Indefinite => match raw.special()? {
                            cbor_event::Special::Break => break,
                            _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                        },
                    },
                    other_type => {
                        return Err(DeserializeFailure::UnexpectedKeyType(other_type).into());
                    }
                }
                read += 1;
            }
            if key_1 == Some(1337) {
                key_1_default_present = true;
            }
            let key_1 = key_1.unwrap_or(1337);
            if key_2 == Some("two".to_owned()) {
                key_2_default_present = true;
            }
            let key_2 = key_2.unwrap_or_else(|| "two".to_owned());
            read_len.finish()?;
            Ok(Self {
                key_1,
                key_2,
                encodings: Some(MapWithDefaultsEncoding {
                    len_encoding,
                    orig_deser_order,
                    key_1_key_encoding,
                    key_1_encoding,
                    key_1_default_present,
                    key_2_key_encoding,
                    key_2_encoding,
                    key_2_default_present,
                }),
            })
        })()
        .map_err(|e| e.annotate("MapWithDefaults"))
    }
}

impl cbor_event::se::Serialize for NemPreserve {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(1),
        )?;
        serializer.write_map_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.m_encoding)
                .unwrap_or_default()
                .to_len_sz(self.m.len() as u64),
        )?;
        for (key, value) in self.m.iter() {
            let m_key_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.m_key_encodings.get(key))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*key, fit_sz(*key, m_key_encoding))?;
            let m_value_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.m_value_encodings.get(key))
                .cloned()
                .unwrap_or_default();
            serializer.write_text_sz(value, m_value_encoding.to_str_len_sz(value.len() as u64))?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.m_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for NemPreserve {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.array_sz()?;
            let len_encoding: LenEncoding = len.into();
            let mut read_len = CBORReadLen::new(len);
            read_len.read_elems(1)?;
            read_len.finish()?;
            let (m, m_encoding, m_key_encodings, m_value_encodings) =
                (|| -> Result<_, DeserializeError> {
                    let mut m_table = OrderedHashMap::new();
                    let m_len = raw.map_sz()?;
                    let m_encoding = m_len.into();
                    let mut m_key_encodings = BTreeMap::new();
                    let mut m_value_encodings = BTreeMap::new();
                    while match m_len {
                        cbor_event::LenSz::Len(n, _) => (m_table.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(m_len, cbor_event::LenSz::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        let (m_key, m_key_encoding) =
                            raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                        let (m_value, m_value_encoding) = raw
                            .text_sz()
                            .map(|(s, enc)| (s, StringEncoding::from(enc)))?;
                        if m_table.insert(m_key, m_value).is_some() {
                            return Err(DeserializeFailure::DuplicateKey(Key::Uint(m_key)).into());
                        }
                        m_key_encodings.insert(m_key, m_key_encoding);
                        m_value_encodings.insert(m_key, m_value_encoding);
                    }
                    let m_table = NonEmptyMap::try_from(m_table)?;
                    Ok((m_table, m_encoding, m_key_encodings, m_value_encodings))
                })()
                .map_err(|e| e.annotate("m"))?;
            match len {
                cbor_event::LenSz::Len(_, _) => (),
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(NemPreserve {
                m,
                encodings: Some(NemPreserveEncoding {
                    len_encoding,
                    m_encoding,
                    m_key_encodings,
                    m_value_encodings,
                }),
            })
        })()
        .map_err(|e| e.annotate("NemPreserve"))
    }
}

impl cbor_event::se::Serialize for NevPreserve {
