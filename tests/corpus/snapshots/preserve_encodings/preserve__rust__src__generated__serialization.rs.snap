                .to_len_sz(1),
        )?;
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.pts_encoding)
                .unwrap_or_default()
                .to_len_sz(self.pts.len() as u64),
        )?;
        for (i, element) in self.pts.iter().enumerate() {
            let pts_elem_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.pts_elem_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*element, fit_sz(*element, pts_elem_encoding))?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.pts_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

