            .encodings
            .as_ref()
            .filter(|encs| {
                encs.orig_deser_order.len()
                    == 3 + match &self.derp {
                        Some(_) => 1,
                        None => 0,
                    } + match &self.key_5 {
                        Some(_) => 1,
                        None => 0,
