                                    max: Some(9223372036854775807),
                                }
                                .into())
                            } else {
                                Ok((x, enc))
                            }
                        })?;
                    (x as i64, Some(enc))
                }
            };
            if inner < -10 || inner > -3 {
                return Err(DeserializeFailure::RangeCheck {
                    found: inner as i128,
                    min: Some(-10),
