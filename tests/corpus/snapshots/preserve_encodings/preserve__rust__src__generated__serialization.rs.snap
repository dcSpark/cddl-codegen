impl cbor_event::se::Serialize for Enums {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(2),
        )?;
        match &self.c_enum {
            CEnum::I3 => serializer.write_unsigned_integer_sz(
                3u64,
                fit_sz(
                    3u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.c_enum_encoding)
                        .unwrap_or_default(),
                ),
            ),
            CEnum::I1 => serializer.write_unsigned_integer_sz(
                1u64,
                fit_sz(
                    1u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.c_enum_encoding)
                        .unwrap_or_default(),
                ),
            ),
            CEnum::I4 => serializer.write_unsigned_integer_sz(
                4u64,
                fit_sz(
                    4u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.c_enum_encoding)
                        .unwrap_or_default(),
                ),
            ),
        }?;
        self.type_choice.serialize(serializer)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for Enums {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.array_sz()?;
            let len_encoding: LenEncoding = len.into();
            let mut read_len = CBORReadLen::new(len);
            read_len.read_elems(2)?;
            read_len.finish()?;
            let (c_enum, c_enum_encoding) = (|| -> Result<_, DeserializeError> {
                let initial_position = raw.position();
                let deser_variant = (|raw: &mut Deserializer| -> Result<_, DeserializeError> {
                    let (i3_value, i3_encoding) = raw.unsigned_integer_sz()?;
                    if i3_value != 3 {
                        return Err(DeserializeFailure::FixedValueMismatch {
                            found: Key::Uint(i3_value),
                            expected: Key::Uint(3),
                        }
                        .into());
                    }
                    Ok(Some(i3_encoding))
                })(raw);
                match deser_variant {
                    Ok(c_enum_encoding) => return Ok((CEnum::I3, c_enum_encoding)),
                    Err(_) => raw.set_position(initial_position).unwrap(),
                };
                let deser_variant = (|raw: &mut Deserializer| -> Result<_, DeserializeError> {
                    let (i1_value, i1_encoding) = raw.unsigned_integer_sz()?;
                    if i1_value != 1 {
                        return Err(DeserializeFailure::FixedValueMismatch {
                            found: Key::Uint(i1_value),
                            expected: Key::Uint(1),
                        }
                        .into());
                    }
                    Ok(Some(i1_encoding))
                })(raw);
                match deser_variant {
                    Ok(c_enum_encoding) => return Ok((CEnum::I1, c_enum_encoding)),
                    Err(_) => raw.set_position(initial_position).unwrap(),
                };
                let deser_variant = (|raw: &mut Deserializer| -> Result<_, DeserializeError> {
                    let (i4_value, i4_encoding) = raw.unsigned_integer_sz()?;
                    if i4_value != 4 {
                        return Err(DeserializeFailure::FixedValueMismatch {
                            found: Key::Uint(i4_value),
                            expected: Key::Uint(4),
                        }
                        .into());
                    }
                    Ok(Some(i4_encoding))
                })(raw);
                match deser_variant {
                    Ok(c_enum_encoding) => return Ok((CEnum::I4, c_enum_encoding)),
                    Err(_) => raw.set_position(initial_position).unwrap(),
                };
                Err(DeserializeError::new(
                    "CEnum",
                    DeserializeFailure::NoVariantMatched,
