impl SerializeEmbeddedGroup for First {
    fn serialize_as_embedded_group<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_unsigned_integer_sz(
            self.x,
            fit_sz(
                self.x,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.x_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_unsigned_integer_sz(
            self.z,
            fit_sz(
                self.z,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.z_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
