}

impl DeserializeEmbeddedGroup for Second {
    fn deserialize_as_embedded_group<R: BufRead + Seek>(
        raw: &mut Deserializer<R>,
        _read_len: &mut CBORReadLen,
        len: cbor_event::LenSz,
    ) -> Result<Self, DeserializeError> {
        let len_encoding = len.into();
        (|| -> Result<_, DeserializeError> {
            let (y, y_encoding) = raw
                .text_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(s, enc)| (s, StringEncoding::from(enc)))
                .map_err(|e: DeserializeError| e.annotate("y"))?;
            let (z, z_encoding) = raw
                .unsigned_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(x, enc)| (x, Some(enc)))
                .map_err(|e: DeserializeError| e.annotate("z"))?;
            Ok(Second {
                y,
                z,
                encodings: Some(SecondEncoding {
                    len_encoding,
                    y_encoding,
                    z_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("Second"))
    }
}

impl cbor_event::se::Serialize for SignedInts {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(11),
        )?;
        serializer.write_unsigned_integer_sz(
            self.u_8 as u64,
            fit_sz(
                self.u_8 as u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.u_8_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_unsigned_integer_sz(
            self.u_16 as u64,
            fit_sz(
                self.u_16 as u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.u_16_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_unsigned_integer_sz(
            self.u_32 as u64,
            fit_sz(
                self.u_32 as u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.u_32_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_unsigned_integer_sz(
            self.u_64,
            fit_sz(
                self.u_64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.u_64_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        if self.i_8 >= 0 {
            serializer.write_unsigned_integer_sz(
                self.i_8 as u64,
                fit_sz(
                    self.i_8 as u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.i_8_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        } else {
            serializer.write_negative_integer_sz(
                self.i_8 as i128,
                fit_sz(
                    (self.i_8 + 1).abs() as u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.i_8_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        }
        if self.i_16 >= 0 {
            serializer.write_unsigned_integer_sz(
                self.i_16 as u64,
                fit_sz(
                    self.i_16 as u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.i_16_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        } else {
            serializer.write_negative_integer_sz(
                self.i_16 as i128,
                fit_sz(
                    (self.i_16 + 1).abs() as u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.i_16_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        }
        if self.i_32 >= 0 {
            serializer.write_unsigned_integer_sz(
                self.i_32 as u64,
                fit_sz(
                    self.i_32 as u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.i_32_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        } else {
            serializer.write_negative_integer_sz(
                self.i_32 as i128,
                fit_sz(
                    (self.i_32 + 1).abs() as u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.i_32_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        }
        if self.i_64 >= 0 {
            serializer.write_unsigned_integer_sz(
                self.i_64 as u64,
                fit_sz(
                    self.i_64 as u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.i_64_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        } else {
            serializer.write_negative_integer_sz(
                self.i_64 as i128,
                fit_sz(
                    (self.i_64 + 1).abs() as u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.i_64_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        }
        serializer.write_negative_integer_sz(
            -(self.n_64 as i128 + 1),
            fit_sz(
                self.n_64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.n_64_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_unsigned_integer_sz(
            18446744073709551615u64,
            fit_sz(
                18446744073709551615u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.u64_max_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_negative_integer_sz(
            -9223372036854775808,
            fit_sz(
                (-9223372036854775808i128 + 1).abs() as u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.i64_min_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for SignedInts {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let len = raw.array_sz()?;
        let len_encoding: LenEncoding = len.into();
        let mut read_len = CBORReadLen::new(len);
        read_len.read_elems(11)?;
        read_len.finish()?;
        (|| -> Result<_, DeserializeError> {
            let (u_8, u_8_encoding) = raw
                .unsigned_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(x, enc)| (x as u8, Some(enc)))
                .map_err(|e: DeserializeError| e.annotate("u_8"))?;
            let (u_16, u_16_encoding) = raw
                .unsigned_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(x, enc)| (x as u16, Some(enc)))
                .map_err(|e: DeserializeError| e.annotate("u_16"))?;
            let (u_32, u_32_encoding) = raw
                .unsigned_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(x, enc)| (x as u32, Some(enc)))
                .map_err(|e: DeserializeError| e.annotate("u_32"))?;
            let (u_64, u_64_encoding) = raw
                .unsigned_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(x, enc)| (x, Some(enc)))
                .map_err(|e: DeserializeError| e.annotate("u_64"))?;
            let (i_8, i_8_encoding) = (|| -> Result<_, DeserializeError> {
                Ok(match raw.cbor_type()? {
                    cbor_event::Type::UnsignedInteger => {
                        let (x, enc) = raw.unsigned_integer_sz()?;
                        (x as i8, Some(enc))
                    }
                    _ => {
                        let (x, enc) = raw.negative_integer_sz()?;
                        (x as i8, Some(enc))
                    }
                })
            })()
            .map_err(|e| e.annotate("i_8"))?;
            let (i_16, i_16_encoding) = (|| -> Result<_, DeserializeError> {
                Ok(match raw.cbor_type()? {
                    cbor_event::Type::UnsignedInteger => {
                        let (x, enc) = raw.unsigned_integer_sz()?;
                        (x as i16, Some(enc))
                    }
                    _ => {
                        let (x, enc) = raw.negative_integer_sz()?;
                        (x as i16, Some(enc))
                    }
                })
            })()
            .map_err(|e| e.annotate("i_16"))?;
            let (i_32, i_32_encoding) = (|| -> Result<_, DeserializeError> {
                Ok(match raw.cbor_type()? {
                    cbor_event::Type::UnsignedInteger => {
                        let (x, enc) = raw.unsigned_integer_sz()?;
                        (x as i32, Some(enc))
                    }
                    _ => {
                        let (x, enc) = raw.negative_integer_sz()?;
                        (x as i32, Some(enc))
                    }
                })
            })()
            .map_err(|e| e.annotate("i_32"))?;
            let (i_64, i_64_encoding) = (|| -> Result<_, DeserializeError> {
                Ok(match raw.cbor_type()? {
                    cbor_event::Type::UnsignedInteger => {
                        let (x, enc) = raw.unsigned_integer_sz()?;
                        (x as i64, Some(enc))
                    }
                    _ => {
                        let (x, enc) = raw.negative_integer_sz()?;
                        (x as i64, Some(enc))
                    }
                })
            })()
            .map_err(|e| e.annotate("i_64"))?;
            let (n_64, n_64_encoding) = raw
                .negative_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(x, enc)| ((x + 1).abs() as u64, Some(enc)))
                .map_err(|e: DeserializeError| e.annotate("n_64"))?;
            let u64_max_encoding = (|| -> Result<_, DeserializeError> {
                let (u64_max_value, u64_max_encoding) = raw.unsigned_integer_sz()?;
                if u64_max_value != 18446744073709551615 {
                    return Err(DeserializeFailure::FixedValueMismatch {
                        found: Key::Uint(u64_max_value),
                        expected: Key::Uint(18446744073709551615),
                    }
                    .into());
                }
                Ok(Some(u64_max_encoding))
            })()
            .map_err(|e| e.annotate("u64_max"))?;
            let i64_min_encoding = (|| -> Result<_, DeserializeError> {
                let (i64_min_value, i64_min_encoding) = raw.negative_integer_sz()?;
                if i64_min_value != -9223372036854775808 {
                    return Err(DeserializeFailure::FixedValueMismatch {
                        found: Key::Uint((i64_min_value + 1).abs() as u64),
                        expected: Key::Uint(9223372036854775807),
                    }
                    .into());
                }
                Ok(Some(i64_min_encoding))
            })()
            .map_err(|e| e.annotate("i64_min"))?;
            match len {
                cbor_event::LenSz::Len(_, _) => (),
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(SignedInts {
                u_8,
                u_16,
                u_32,
                u_64,
                i_8,
                i_16,
                i_32,
                i_64,
                n_64,
                encodings: Some(SignedIntsEncoding {
                    len_encoding,
                    u_8_encoding,
                    u_16_encoding,
                    u_32_encoding,
                    u_64_encoding,
                    i_8_encoding,
                    i_16_encoding,
                    i_32_encoding,
                    i_64_encoding,
                    n_64_encoding,
                    u64_max_encoding,
                    i64_min_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("SignedInts"))
    }
}

impl cbor_event::se::Serialize for String1632 {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_tag_sz(
            7u64,
            fit_sz(
                7u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.inner_tag_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_text_sz(
            &self.inner,
            self.encodings
                .as_ref()
                .map(|encs| encs.inner_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(self.inner.len() as u64),
        )
    }
}

impl Deserialize for String1632 {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let (inner, inner_tag_encoding, inner_encoding) = match raw.tag_sz()? {
            (7, tag_enc) => raw
                .text_sz()
                .map(|(s, enc)| (s, Some(tag_enc), StringEncoding::from(enc)))?,
            (tag, _enc) => {
                return Err(DeserializeFailure::TagMismatch {
                    found: tag,
                    expected: 7,
                }
                .into())
            }
        };
        if inner.len() < 16 || inner.len() > 32 {
            return Err(DeserializeError::new(
                "String1632",
                DeserializeFailure::RangeCheck {
                    found: inner.len() as isize,
                    min: Some(16),
                    max: Some(32),
                },
            ));
        }
        Ok(Self {
            inner,
            encodings: Some(String1632Encoding {
                inner_tag_encoding,
                inner_encoding,
            }),
        })
    }
}

