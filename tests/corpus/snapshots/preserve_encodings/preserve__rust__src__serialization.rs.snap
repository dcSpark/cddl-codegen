impl cbor_event::se::Serialize for Enums {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(2),
        )?;
        match &self.c_enum {
            CEnum::I3 => serializer.write_unsigned_integer_sz(
                3u64,
                fit_sz(
                    3u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.c_enum_encoding)
                        .unwrap_or_default(),
                ),
            ),
            CEnum::I1 => serializer.write_unsigned_integer_sz(
                1u64,
                fit_sz(
                    1u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.c_enum_encoding)
                        .unwrap_or_default(),
                ),
            ),
            CEnum::I4 => serializer.write_unsigned_integer_sz(
                4u64,
                fit_sz(
                    4u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.c_enum_encoding)
                        .unwrap_or_default(),
                ),
            ),
        }?;
        self.type_choice.serialize(serializer)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

