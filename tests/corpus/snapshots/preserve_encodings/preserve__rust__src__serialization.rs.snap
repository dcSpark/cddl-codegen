impl cbor_event::se::Serialize for Bounds {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(6),
        )?;
        if self.w >= 0 {
            serializer.write_unsigned_integer_sz(
                self.w as u64,
                fit_sz(
                    self.w as u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.w_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        } else {
            serializer.write_negative_integer_sz(
                self.w as i128,
                fit_sz(
                    (self.w + 1).abs() as u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.w_encoding)
                        .unwrap_or_default(),
                ),
            )?;
        }
        serializer.write_unsigned_integer_sz(
            self.x,
            fit_sz(
                self.x,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.x_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_negative_integer_sz(
            -(self.y as i128 + 1),
            fit_sz(
                self.y,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.y_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_text_sz(
            &self.z,
            self.encodings
                .as_ref()
                .map(|encs| encs.z_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(self.z.len() as u64),
        )?;
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.a_encoding)
                .unwrap_or_default()
                .to_len_sz(self.a.len() as u64),
        )?;
        for (i, element) in self.a.iter().enumerate() {
            let a_elem_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.a_elem_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*element, fit_sz(*element, a_elem_encoding))?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.a_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        serializer.write_map_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.b_encoding)
                .unwrap_or_default()
                .to_len_sz(self.b.len() as u64),
        )?;
        for (key, value) in self.b.iter() {
            let b_key_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.b_key_encodings.get(key))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*key, fit_sz(*key, b_key_encoding))?;
            let b_value_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.b_value_encodings.get(key))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*value, fit_sz(*value, b_value_encoding))?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.b_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for Bounds {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let len = raw.array_sz()?;
        let len_encoding: LenEncoding = len.into();
        let mut read_len = CBORReadLen::new(len);
        read_len.read_elems(6)?;
        read_len.finish()?;
        (|| -> Result<_, DeserializeError> {
            let (w, w_encoding) = (|| -> Result<_, DeserializeError> {
                Ok(match raw.cbor_type()? {
                    cbor_event::Type::UnsignedInteger => {
                        let (x, enc) = raw
                            .unsigned_integer_sz()
                            .map_err(Into::<DeserializeError>::into)
                            .and_then(|(x, enc)| {
                                if x > 1000 {
                                    Err(DeserializeFailure::RangeCheck {
                                        found: x as isize,
                                        min: None,
                                        max: Some(1000),
                                    }
                                    .into())
                                } else {
                                    Ok((x, enc))
                                }
                            })?;
                        (x as i64, Some(enc))
                    }
                    _ => {
                        let (x, enc) = raw
                            .negative_integer_sz()
                            .map_err(Into::<DeserializeError>::into)
                            .and_then(|(x, enc)| {
                                if x < -1000 {
                                    Err(DeserializeFailure::RangeCheck {
                                        found: x as isize,
                                        min: Some(-1000),
                                        max: None,
                                    }
                                    .into())
                                } else {
                                    Ok((x, enc))
                                }
                            })?;
                        (x as i64, Some(enc))
                    }
                })
            })()
            .map_err(|e| e.annotate("w"))?;
            let (x, x_encoding) = raw
                .unsigned_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .map_err(Into::<DeserializeError>::into)
                .and_then(|(x, enc)| {
                    if x > 7 {
                        Err(DeserializeFailure::RangeCheck {
                            found: x as isize,
                            min: None,
                            max: Some(7),
                        }
                        .into())
                    } else {
                        Ok((x, Some(enc)))
                    }
                })
                .map_err(|e: DeserializeError| e.annotate("x"))?;
            let (y, y_encoding) = raw
                .negative_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .map_err(Into::<DeserializeError>::into)
                .and_then(|(x, enc)| {
                    if x < -5 {
                        Err(DeserializeFailure::RangeCheck {
                            found: x as isize,
                            min: Some(-5),
                            max: None,
                        }
                        .into())
                    } else {
                        Ok(((x + 1).abs() as u64, Some(enc)))
                    }
                })
                .map_err(|e: DeserializeError| e.annotate("y"))?;
            let (z, z_encoding) = raw
                .text_sz()
                .map_err(Into::<DeserializeError>::into)
                .map_err(Into::<DeserializeError>::into)
                .and_then(|(s, enc)| {
                    if s.len() < 3 || s.len() > 14 {
                        Err(DeserializeFailure::RangeCheck {
                            found: s.len() as isize,
                            min: Some(3),
                            max: Some(14),
                        }
                        .into())
                    } else {
                        Ok((s, StringEncoding::from(enc)))
                    }
                })
                .map_err(|e: DeserializeError| e.annotate("z"))?;
            let (a, a_encoding, a_elem_encodings) = (|| -> Result<_, DeserializeError> {
                let mut a_arr = Vec::new();
                let len = raw.array_sz()?;
                let a_encoding = len.into();
                let mut a_elem_encodings = Vec::new();
                while match len {
                    cbor_event::LenSz::Len(n, _) => (a_arr.len() as u64) < n,
                    cbor_event::LenSz::Indefinite => true,
                } {
                    if let cbor_event::LenSz::Indefinite = len {
                        if raw.cbor_type()? == cbor_event::Type::Special {
                            match raw.special()? {
                                cbor_event::Special::Break => break,
                                _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                            }
                        }
                    }
                    let (a_elem, a_elem_encoding) =
                        raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                    a_arr.push(a_elem);
                    a_elem_encodings.push(a_elem_encoding);
                }
                if a_arr.len() < 1 || a_arr.len() > 3 {
                    return Err(DeserializeFailure::RangeCheck {
                        found: a_arr.len() as isize,
                        min: Some(1),
                        max: Some(3),
                    }
                    .into());
                }
                Ok((a_arr, a_encoding, a_elem_encodings))
            })()
            .map_err(|e| e.annotate("a"))?;
            let (b, b_encoding, b_key_encodings, b_value_encodings) =
                (|| -> Result<_, DeserializeError> {
                    let mut b_table = OrderedHashMap::new();
                    let b_len = raw.map_sz()?;
                    let b_encoding = b_len.into();
                    let mut b_key_encodings = BTreeMap::new();
                    let mut b_value_encodings = BTreeMap::new();
                    while match b_len {
                        cbor_event::LenSz::Len(n, _) => (b_table.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if let cbor_event::LenSz::Indefinite = b_len {
                            if raw.cbor_type()? == cbor_event::Type::Special {
                                match raw.special()? {
                                    cbor_event::Special::Break => break,
                                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                                }
                            }
                        }
                        let (b_key, b_key_encoding) =
                            raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                        let (b_value, b_value_encoding) =
                            raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                        if b_table.insert(b_key, b_value).is_some() {
                            return Err(
                                DeserializeFailure::DuplicateKey(Key::Uint(b_key.into())).into()
                            );
                        }
                        b_key_encodings.insert(b_key, b_key_encoding);
                        b_value_encodings.insert(b_key, b_value_encoding);
                    }
                    if b_table.len() > 3 {
                        return Err(DeserializeFailure::RangeCheck {
                            found: b_table.len() as isize,
                            min: None,
                            max: Some(3),
                        }
                        .into());
                    }
                    Ok((b_table, b_encoding, b_key_encodings, b_value_encodings))
                })()
                .map_err(|e| e.annotate("b"))?;
            match len {
                cbor_event::LenSz::Len(_, _) => (),
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(Bounds {
                w,
                x,
                y,
                z,
                a,
                b,
                encodings: Some(BoundsEncoding {
                    len_encoding,
                    w_encoding,
                    x_encoding,
                    y_encoding,
                    z_encoding,
                    a_encoding,
                    a_elem_encodings,
                    b_encoding,
                    b_key_encodings,
                    b_value_encodings,
                }),
            })
        })()
        .map_err(|e| e.annotate("Bounds"))
    }
}

impl cbor_event::se::Serialize for BoundsGroupChoice {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        match self {
            BoundsGroupChoice::A(a) => a.serialize(serializer),
            BoundsGroupChoice::B { b, len_encoding } => {
                serializer.write_array_sz(len_encoding.to_len_sz(1))?;
                b.serialize(serializer)?;
                len_encoding.end(serializer)?;
                Ok(serializer)
            }
            BoundsGroupChoice::C(c) => c.serialize(serializer),
        }
    }
}

impl Deserialize for BoundsGroupChoice {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.array_sz()?;
            let len_encoding: LenEncoding = len.into();
            let initial_position = raw.as_mut_ref().stream_position().unwrap();
            let mut errs = Vec::new();
            let deser_variant = (|raw: &mut Deserializer<_>| -> Result<_, DeserializeError> {
                let mut read_len = CBORReadLen::new(len);
                read_len.read_elems(2)?;
                read_len.finish()?;
                let ret = A::deserialize_as_embedded_group(raw, &mut read_len, len);
                match len {
                    cbor_event::LenSz::Len(_, _) => (),
                    cbor_event::LenSz::Indefinite => match raw.special()? {
                        cbor_event::Special::Break => (),
                        _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                    },
                }
                ret
            })(raw);
            match deser_variant {
                Ok(a) => return Ok(Self::A(a)),
                Err(e) => {
                    errs.push(e.annotate("A"));
                    raw.as_mut_ref()
                        .seek(SeekFrom::Start(initial_position))
                        .unwrap();
                }
            };
            let deser_variant = (|raw: &mut Deserializer<_>| -> Result<_, DeserializeError> {
                let mut read_len = CBORReadLen::new(len);
                read_len.read_elems(1)?;
                read_len.finish()?;
                let ret = Hash::deserialize(raw);
                match len {
                    cbor_event::LenSz::Len(_, _) => (),
                    cbor_event::LenSz::Indefinite => match raw.special()? {
                        cbor_event::Special::Break => (),
                        _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                    },
                }
                ret
            })(raw);
            match deser_variant {
                Ok(b) => return Ok(Self::B { b, len_encoding }),
                Err(e) => {
                    errs.push(e.annotate("B"));
                    raw.as_mut_ref()
                        .seek(SeekFrom::Start(initial_position))
                        .unwrap();
                }
            };
            let deser_variant = (|raw: &mut Deserializer<_>| -> Result<_, DeserializeError> {
                let mut read_len = CBORReadLen::new(len);
                read_len.read_elems(3)?;
                read_len.finish()?;
                let ret = C::deserialize_as_embedded_group(raw, &mut read_len, len);
                match len {
                    cbor_event::LenSz::Len(_, _) => (),
                    cbor_event::LenSz::Indefinite => match raw.special()? {
                        cbor_event::Special::Break => (),
                        _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                    },
                }
                ret
            })(raw);
            match deser_variant {
                Ok(c) => return Ok(Self::C(c)),
                Err(e) => {
                    errs.push(e.annotate("C"));
                    raw.as_mut_ref()
                        .seek(SeekFrom::Start(initial_position))
                        .unwrap();
                }
            };
            Err(DeserializeError::new(
                "BoundsGroupChoice",
                DeserializeFailure::NoVariantMatchedWithCauses(errs),
            ))
        })()
        .map_err(|e| e.annotate("BoundsGroupChoice"))
    }
}

impl cbor_event::se::Serialize for BoundsTypeChoice {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        match self {
            BoundsTypeChoice::Bytes {
                bytes,
                bytes_encoding,
            } => {
                serializer.write_bytes_sz(&bytes, bytes_encoding.to_str_len_sz(bytes.len() as u64))
            }
            BoundsTypeChoice::Text {
                text,
                text_encoding,
            } => serializer.write_text_sz(&text, text_encoding.to_str_len_sz(text.len() as u64)),
        }
    }
}

impl Deserialize for BoundsTypeChoice {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            match raw.cbor_type()? {
                cbor_event::Type::Bytes => {
                    let (bytes, bytes_encoding) = raw
                        .bytes_sz()
                        .map_err(Into::<DeserializeError>::into)
                        .and_then(|(bytes, enc)| {
                            if bytes.len() > 64 {
                                Err(DeserializeFailure::RangeCheck {
                                    found: bytes.len() as isize,
                                    min: None,
                                    max: Some(64),
                                }
                                .into())
                            } else {
                                Ok((bytes, StringEncoding::from(enc)))
                            }
                        })?;
                    Ok(Self::Bytes {
                        bytes,
                        bytes_encoding,
                    })
                }
                cbor_event::Type::Text => {
                    let (text, text_encoding) = raw
                        .text_sz()
                        .map_err(Into::<DeserializeError>::into)
                        .and_then(|(s, enc)| {
                            if s.len() > 64 {
                                Err(DeserializeFailure::RangeCheck {
                                    found: s.len() as isize,
                                    min: None,
                                    max: Some(64),
                                }
                                .into())
                            } else {
                                Ok((s, StringEncoding::from(enc)))
                            }
                        })?;
                    Ok(Self::Text {
                        text,
                        text_encoding,
                    })
                }
                _ => Err(DeserializeError::new(
                    "BoundsTypeChoice",
                    DeserializeFailure::NoVariantMatched,
                )),
            }
        })()
        .map_err(|e| e.annotate("BoundsTypeChoice"))
    }
}

impl cbor_event::se::Serialize for BytesUint {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(2),
        )?;
        self.serialize_as_embedded_group(serializer)
    }
}

impl SerializeEmbeddedGroup for BytesUint {
    fn serialize_as_embedded_group<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_bytes_sz(
            &self.index_0,
            self.encodings
                .as_ref()
                .map(|encs| encs.index_0_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(self.index_0.len() as u64),
        )?;
        serializer.write_unsigned_integer_sz(
            self.index_1,
            fit_sz(
                self.index_1,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.index_1_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for BytesUint {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let len = raw.array_sz()?;
        let mut read_len = CBORReadLen::new(len);
        read_len.read_elems(2)?;
        read_len.finish()?;
        let ret = Self::deserialize_as_embedded_group(raw, &mut read_len, len);
        match len {
            cbor_event::LenSz::Len(_, _) => (),
            cbor_event::LenSz::Indefinite => match raw.special()? {
                cbor_event::Special::Break => (),
                _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
            },
        }
        ret
    }
}

impl DeserializeEmbeddedGroup for BytesUint {
    fn deserialize_as_embedded_group<R: BufRead + Seek>(
        raw: &mut Deserializer<R>,
        _read_len: &mut CBORReadLen,
        len: cbor_event::LenSz,
    ) -> Result<Self, DeserializeError> {
        let len_encoding = len.into();
        (|| -> Result<_, DeserializeError> {
            let (index_0, index_0_encoding) = raw
                .bytes_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(bytes, enc)| (bytes, StringEncoding::from(enc)))
                .map_err(|e: DeserializeError| e.annotate("index_0"))?;
            let (index_1, index_1_encoding) = raw
                .unsigned_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(x, enc)| (x, Some(enc)))
                .map_err(|e: DeserializeError| e.annotate("index_1"))?;
            Ok(BytesUint {
                index_0,
                index_1,
                encodings: Some(BytesUintEncoding {
                    len_encoding,
                    index_0_encoding,
                    index_1_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("BytesUint"))
    }
}

impl cbor_event::se::Serialize for C {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(3),
        )?;
        self.serialize_as_embedded_group(serializer)
    }
}

impl SerializeEmbeddedGroup for C {
    fn serialize_as_embedded_group<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_unsigned_integer_sz(
            1u64,
            fit_sz(
                1u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.index_0_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        self.x.serialize(serializer)?;
        self.y.serialize(serializer)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for C {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let len = raw.array_sz()?;
        let mut read_len = CBORReadLen::new(len);
        read_len.read_elems(3)?;
        read_len.finish()?;
        let ret = Self::deserialize_as_embedded_group(raw, &mut read_len, len);
        match len {
            cbor_event::LenSz::Len(_, _) => (),
            cbor_event::LenSz::Indefinite => match raw.special()? {
                cbor_event::Special::Break => (),
                _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
            },
        }
        ret
    }
}

impl DeserializeEmbeddedGroup for C {
    fn deserialize_as_embedded_group<R: BufRead + Seek>(
        raw: &mut Deserializer<R>,
        _read_len: &mut CBORReadLen,
        len: cbor_event::LenSz,
    ) -> Result<Self, DeserializeError> {
        let len_encoding = len.into();
        (|| -> Result<_, DeserializeError> {
            let index_0_encoding = (|| -> Result<_, DeserializeError> {
                let (index_0_value, index_0_encoding) = raw.unsigned_integer_sz()?;
                if index_0_value != 1 {
                    return Err(DeserializeFailure::FixedValueMismatch {
                        found: Key::Uint(index_0_value),
                        expected: Key::Uint(1),
                    }
                    .into());
                }
                Ok(Some(index_0_encoding))
            })()
            .map_err(|e| e.annotate("index_0"))?;
            let x = Hash::deserialize(raw).map_err(|e: DeserializeError| e.annotate("x"))?;
            let y = Hash::deserialize(raw).map_err(|e: DeserializeError| e.annotate("y"))?;
            Ok(C {
                x,
                y,
                encodings: Some(CEncoding {
                    len_encoding,
                    index_0_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("C"))
    }
}

impl cbor_event::se::Serialize for CborInCbor {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(3),
        )?;
        let mut foo_bytes_inner_se = Serializer::new_vec();
        self.foo_bytes.serialize(&mut foo_bytes_inner_se)?;
        let foo_bytes_bytes = foo_bytes_inner_se.finalize();
        serializer.write_bytes_sz(
            &foo_bytes_bytes,
            self.encodings
                .as_ref()
                .map(|encs| encs.foo_bytes_bytes_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(foo_bytes_bytes.len() as u64),
        )?;
        let mut uint_bytes_inner_se = Serializer::new_vec();
        uint_bytes_inner_se.write_unsigned_integer_sz(
            self.uint_bytes,
            fit_sz(
                self.uint_bytes,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.uint_bytes_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        let uint_bytes_bytes = uint_bytes_inner_se.finalize();
        serializer.write_bytes_sz(
            &uint_bytes_bytes,
            self.encodings
                .as_ref()
                .map(|encs| encs.uint_bytes_bytes_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(uint_bytes_bytes.len() as u64),
        )?;
        serializer.write_tag_sz(
            20u64,
            fit_sz(
                20u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.tagged_foo_bytes_tag_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        let mut tagged_foo_bytes_inner_se = Serializer::new_vec();
        self.tagged_foo_bytes
            .serialize(&mut tagged_foo_bytes_inner_se)?;
        let tagged_foo_bytes_bytes = tagged_foo_bytes_inner_se.finalize();
        serializer.write_bytes_sz(
            &tagged_foo_bytes_bytes,
            self.encodings
                .as_ref()
                .map(|encs| encs.tagged_foo_bytes_bytes_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(tagged_foo_bytes_bytes.len() as u64),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for CborInCbor {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let len = raw.array_sz()?;
        let len_encoding: LenEncoding = len.into();
        let mut read_len = CBORReadLen::new(len);
        read_len.read_elems(3)?;
        read_len.finish()?;
        (|| -> Result<_, DeserializeError> {
            let (foo_bytes, foo_bytes_bytes_encoding) = (|| -> Result<_, DeserializeError> {
                let (foo_bytes_bytes, foo_bytes_bytes_encoding) = raw.bytes_sz()?;
                let inner_de = &mut Deserializer::from(std::io::Cursor::new(foo_bytes_bytes));
                Ok((
                    Foo::deserialize(inner_de)?,
                    StringEncoding::from(foo_bytes_bytes_encoding),
                ))
            })()
            .map_err(|e| e.annotate("foo_bytes"))?;
            let (uint_bytes, uint_bytes_bytes_encoding, uint_bytes_encoding) =
                (|| -> Result<_, DeserializeError> {
                    let (uint_bytes_bytes, uint_bytes_bytes_encoding) = raw.bytes_sz()?;
                    let inner_de = &mut Deserializer::from(std::io::Cursor::new(uint_bytes_bytes));
                    inner_de
                        .unsigned_integer_sz()
                        .map_err(Into::<DeserializeError>::into)
                        .map(|(x, enc)| {
                            (
                                x,
                                StringEncoding::from(uint_bytes_bytes_encoding),
                                Some(enc),
                            )
                        })
                })()
                .map_err(|e| e.annotate("uint_bytes"))?;
            let (tagged_foo_bytes, tagged_foo_bytes_tag_encoding, tagged_foo_bytes_bytes_encoding) =
                (|| -> Result<_, DeserializeError> {
                    match raw.tag_sz()? {
                        (20, tag_enc) => {
                            let (tagged_foo_bytes_bytes, tagged_foo_bytes_bytes_encoding) =
                                raw.bytes_sz()?;
                            let inner_de = &mut Deserializer::from(std::io::Cursor::new(
                                tagged_foo_bytes_bytes,
                            ));
                            Ok((
                                Foo::deserialize(inner_de)?,
                                Some(tag_enc),
                                StringEncoding::from(tagged_foo_bytes_bytes_encoding),
                            ))
                        }
                        (tag, _enc) => Err(DeserializeFailure::TagMismatch {
                            found: tag,
                            expected: 20,
                        }
                        .into()),
                    }
                })()
                .map_err(|e| e.annotate("tagged_foo_bytes"))?;
            match len {
                cbor_event::LenSz::Len(_, _) => (),
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(CborInCbor {
                foo_bytes,
                uint_bytes,
                tagged_foo_bytes,
                encodings: Some(CborInCborEncoding {
                    len_encoding,
                    foo_bytes_bytes_encoding,
                    uint_bytes_bytes_encoding,
                    uint_bytes_encoding,
                    tagged_foo_bytes_tag_encoding,
                    tagged_foo_bytes_bytes_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("CborInCbor"))
    }
}

impl cbor_event::se::Serialize for DeeplyNested {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(1),
        )?;
        serializer.write_map_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.data_encoding)
                .unwrap_or_default()
                .to_len_sz(self.data.len() as u64),
        )?;
        for (key, value) in self.data.iter() {
            let (data_key_tag_encoding, data_key_encoding) = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.data_key_encodings.get(key))
                .cloned()
                .unwrap_or_else(|| (None, StringEncoding::default()));
            serializer.write_tag_sz(14u64, fit_sz(14u64, data_key_tag_encoding))?;
            serializer.write_bytes_sz(&key, data_key_encoding.to_str_len_sz(key.len() as u64))?;
            let (data_value_encoding, data_value_key_encodings, data_value_value_encodings) = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.data_value_encodings.get(key))
                .cloned()
                .unwrap_or_else(|| (LenEncoding::default(), BTreeMap::new(), BTreeMap::new()));
            serializer.write_map_sz(data_value_encoding.to_len_sz(value.len() as u64))?;
            for (key, value) in value.iter() {
                let data_value_key_encoding = data_value_key_encodings
                    .get(key)
                    .cloned()
                    .unwrap_or_default();
                serializer
                    .write_unsigned_integer_sz(*key, fit_sz(*key, data_value_key_encoding))?;
                let (
                    data_value_value_encoding,
                    data_value_value_key_encodings,
                    data_value_value_value_encodings,
                ) = data_value_value_encodings
                    .get(key)
                    .cloned()
                    .unwrap_or_else(|| (LenEncoding::default(), BTreeMap::new(), BTreeMap::new()));
                serializer.write_map_sz(data_value_value_encoding.to_len_sz(value.len() as u64))?;
                for (key, value) in value.iter() {
                    let (data_value_value_key_tag_encoding, data_value_value_key_encoding) =
                        data_value_value_key_encodings
                            .get(key)
                            .cloned()
                            .unwrap_or_else(|| (None, None));
                    serializer
                        .write_tag_sz(9u64, fit_sz(9u64, data_value_value_key_tag_encoding))?;
                    serializer.write_unsigned_integer_sz(
                        *key,
                        fit_sz(*key, data_value_value_key_encoding),
                    )?;
                    let (data_value_value_value_encoding, data_value_value_value_elem_encodings) =
                        data_value_value_value_encodings
                            .get(key)
                            .cloned()
                            .unwrap_or_else(|| (LenEncoding::default(), Vec::new()));
                    serializer.write_array_sz(
                        data_value_value_value_encoding.to_len_sz(value.len() as u64),
                    )?;
                    for (i, element) in value.iter().enumerate() {
                        let (
                            data_value_value_value_elem_tag_encoding,
                            data_value_value_value_elem_encoding,
                            data_value_value_value_elem_elem_encodings,
                        ) = data_value_value_value_elem_encodings
                            .get(i)
                            .cloned()
                            .unwrap_or_else(|| (None, LenEncoding::default(), Vec::new()));
                        serializer.write_tag_sz(
                            18u64,
                            fit_sz(18u64, data_value_value_value_elem_tag_encoding),
                        )?;
                        serializer.write_array_sz(
                            data_value_value_value_elem_encoding.to_len_sz(element.len() as u64),
                        )?;
                        for (i, element) in element.iter().enumerate() {
                            let data_value_value_value_elem_elem_encoding =
                                data_value_value_value_elem_elem_encodings
                                    .get(i)
                                    .cloned()
                                    .unwrap_or_default();
                            serializer.write_text_sz(
                                &element,
                                data_value_value_value_elem_elem_encoding
                                    .to_str_len_sz(element.len() as u64),
                            )?;
                        }
                        data_value_value_value_elem_encoding.end(serializer)?;
                    }
                    data_value_value_value_encoding.end(serializer)?;
                }
                data_value_value_encoding.end(serializer)?;
            }
            data_value_encoding.end(serializer)?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.data_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for DeeplyNested {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let len = raw.array_sz()?;
        let len_encoding: LenEncoding = len.into();
        let mut read_len = CBORReadLen::new(len);
        read_len.read_elems(1)?;
        read_len.finish()?;
        (|| -> Result<_, DeserializeError> {
            let (data, data_encoding, data_key_encodings, data_value_encodings) = (|| -> Result<_, DeserializeError> {
                let mut data_table = OrderedHashMap::new();
                let data_len = raw.map_sz()?;
                let data_encoding = data_len.into();
                let mut data_key_encodings = BTreeMap::new();
                let mut data_value_encodings = BTreeMap::new();
                while match data_len { cbor_event::LenSz::Len(n, _) => (data_table.len() as u64) < n, cbor_event::LenSz::Indefinite => true, } {
                    if let cbor_event::LenSz::Indefinite = data_len {
                        if raw.cbor_type()? == cbor_event::Type::Special {
                            match raw.special()? {
                                cbor_event::Special::Break => break,
                                _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                            }
                        }
                    }
                    let (data_key, data_key_tag_encoding, data_key_encoding) = match raw.tag_sz()? {
                        (14, tag_enc) => raw.bytes_sz().map(|(bytes, enc)| (bytes, Some(tag_enc), StringEncoding::from(enc)))?,
                        (tag, _enc) => return Err(DeserializeFailure::TagMismatch{ found: tag, expected: 14 }.into()),
                    };
                    let mut data_value_table = OrderedHashMap::new();
                    let data_value_len = raw.map_sz()?;
                    let data_value_encoding = data_value_len.into();
                    let mut data_value_key_encodings = BTreeMap::new();
                    let mut data_value_value_encodings = BTreeMap::new();
                    while match data_value_len { cbor_event::LenSz::Len(n, _) => (data_value_table.len() as u64) < n, cbor_event::LenSz::Indefinite => true, } {
                        if let cbor_event::LenSz::Indefinite = data_value_len {
                            if raw.cbor_type()? == cbor_event::Type::Special {
                                match raw.special()? {
                                    cbor_event::Special::Break => break,
                                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                                }
                            }
                        }
                        let (data_value_key, data_value_key_encoding) = raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                        let mut data_value_value_table = OrderedHashMap::new();
                        let data_value_value_len = raw.map_sz()?;
                        let data_value_value_encoding = data_value_value_len.into();
                        let mut data_value_value_key_encodings = BTreeMap::new();
                        let mut data_value_value_value_encodings = BTreeMap::new();
                        while match data_value_value_len { cbor_event::LenSz::Len(n, _) => (data_value_value_table.len() as u64) < n, cbor_event::LenSz::Indefinite => true, } {
                            if let cbor_event::LenSz::Indefinite = data_value_value_len {
                                if raw.cbor_type()? == cbor_event::Type::Special {
                                    match raw.special()? {
                                        cbor_event::Special::Break => break,
                                        _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                                    }
                                }
                            }
                            let (data_value_value_key, data_value_value_key_tag_encoding, data_value_value_key_encoding) = match raw.tag_sz()? {
                                (9, tag_enc) => raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(tag_enc), Some(enc)))?,
                                (tag, _enc) => return Err(DeserializeFailure::TagMismatch{ found: tag, expected: 9 }.into()),
                            };
                            let mut data_value_value_value_arr = Vec::new();
                            let len = raw.array_sz()?;
                            let data_value_value_value_encoding = len.into();
                            let mut data_value_value_value_elem_encodings = Vec::new();
                            while match len { cbor_event::LenSz::Len(n, _) => (data_value_value_value_arr.len() as u64) < n, cbor_event::LenSz::Indefinite => true, } {
                                if let cbor_event::LenSz::Indefinite = len {
                                    if raw.cbor_type()? == cbor_event::Type::Special {
                                        match raw.special()? {
                                            cbor_event::Special::Break => break,
                                            _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                                        }
                                    }
                                }
                                let (data_value_value_value_elem, data_value_value_value_elem_tag_encoding, data_value_value_value_elem_encoding, data_value_value_value_elem_elem_encodings) = match raw.tag_sz()? {
                                    (18, tag_enc) => {
                                        let mut data_value_value_value_elem_arr = Vec::new();
                                        let len = raw.array_sz()?;
                                        let data_value_value_value_elem_encoding = len.into();
                                        let mut data_value_value_value_elem_elem_encodings = Vec::new();
                                        while match len { cbor_event::LenSz::Len(n, _) => (data_value_value_value_elem_arr.len() as u64) < n, cbor_event::LenSz::Indefinite => true, } {
                                            if let cbor_event::LenSz::Indefinite = len {
                                                if raw.cbor_type()? == cbor_event::Type::Special {
                                                    match raw.special()? {
                                                        cbor_event::Special::Break => break,
                                                        _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                                                    }
                                                }
                                            }
                                            let (data_value_value_value_elem_elem, data_value_value_value_elem_elem_encoding) = raw.text_sz().map(|(s, enc)| (s, StringEncoding::from(enc)))?;
                                            data_value_value_value_elem_arr.push(data_value_value_value_elem_elem);
                                            data_value_value_value_elem_elem_encodings.push(data_value_value_value_elem_elem_encoding);
                                        }
                                        (data_value_value_value_elem_arr, Some(tag_enc), data_value_value_value_elem_encoding, data_value_value_value_elem_elem_encodings)
                                    },
                                    (tag, _enc) => return Err(DeserializeFailure::TagMismatch{ found: tag, expected: 18 }.into()),
                                };
                                data_value_value_value_arr.push(data_value_value_value_elem);
                                data_value_value_value_elem_encodings.push((data_value_value_value_elem_tag_encoding, data_value_value_value_elem_encoding, data_value_value_value_elem_elem_encodings));
                            }
                            let (data_value_value_value, data_value_value_value_encoding, data_value_value_value_elem_encodings) = (data_value_value_value_arr, data_value_value_value_encoding, data_value_value_value_elem_encodings);
                            if data_value_value_table.insert(data_value_value_key, data_value_value_value).is_some() {
                                return Err(DeserializeFailure::DuplicateKey(Key::Uint(data_value_value_key.into())).into());
                            }
                            data_value_value_key_encodings.insert(data_value_value_key, (data_value_value_key_tag_encoding, data_value_value_key_encoding));
                            data_value_value_value_encodings.insert(data_value_value_key, (data_value_value_value_encoding, data_value_value_value_elem_encodings));
                        }
                        let (data_value_value, data_value_value_encoding, data_value_value_key_encodings, data_value_value_value_encodings) = (data_value_value_table, data_value_value_encoding, data_value_value_key_encodings, data_value_value_value_encodings);
                        if data_value_table.insert(data_value_key, data_value_value).is_some() {
                            return Err(DeserializeFailure::DuplicateKey(Key::Uint(data_value_key.into())).into());
                        }
                        data_value_key_encodings.insert(data_value_key, data_value_key_encoding);
                        data_value_value_encodings.insert(data_value_key, (data_value_value_encoding, data_value_value_key_encodings, data_value_value_value_encodings));
                    }
                    let (data_value, data_value_encoding, data_value_key_encodings, data_value_value_encodings) = (data_value_table, data_value_encoding, data_value_key_encodings, data_value_value_encodings);
                    if data_table.insert(data_key.clone(), data_value).is_some() {
                        return Err(DeserializeFailure::DuplicateKey(Key::Str(String::from("some complicated/unsupported type"))).into());
                    }
                    data_key_encodings.insert(data_key.clone(), (data_key_tag_encoding, data_key_encoding));
                    data_value_encodings.insert(data_key.clone(), (data_value_encoding, data_value_key_encodings, data_value_value_encodings));
                }
                Ok((data_table, data_encoding, data_key_encodings, data_value_encodings))
            })().map_err(|e| e.annotate("data"))?;
            match len {
                cbor_event::LenSz::Len(_, _) => (),
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(DeeplyNested {
                data,
                encodings: Some(DeeplyNestedEncoding {
                    len_encoding,
                    data_encoding,
                    data_key_encodings,
                    data_value_encodings,
                }),
            })
        })().map_err(|e| e.annotate("DeeplyNested"))
    }
}

impl cbor_event::se::Serialize for Ed {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(
                    2 + match &self.index_2 {
                        Some(x) => 1,
                        None => 0,
                    },
                ),
        )?;
        self.serialize_as_embedded_group(serializer)
    }
}

impl SerializeEmbeddedGroup for Ed {
    fn serialize_as_embedded_group<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_unsigned_integer_sz(
            1u64,
            fit_sz(
                1u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.index_0_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_unsigned_integer_sz(
            self.index_1,
            fit_sz(
                self.index_1,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.index_1_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        if let Some(field) = &self.index_2 {
            serializer.write_text_sz(
