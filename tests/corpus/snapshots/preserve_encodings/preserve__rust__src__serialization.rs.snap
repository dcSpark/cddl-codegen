impl Deserialize for Bar {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let len = raw.map_sz()?;
        let len_encoding: LenEncoding = len.into();
        let mut read_len = CBORReadLen::new(len);
        read_len.read_elems(3)?;
        (|| -> Result<_, DeserializeError> {
            let mut orig_deser_order = Vec::new();
            let mut key_1_encoding = None;
            let mut key_1_key_encoding = None;
            let mut key_1 = None;
            let mut key_5_encoding = StringEncoding::default();
            let mut key_5_key_encoding = None;
            let mut key_5 = None;
            let mut foo_tag_encoding = None;
            let mut foo_key_encoding = StringEncoding::default();
            let mut foo = None;
            let mut derp_encoding = None;
            let mut derp_key_encoding = StringEncoding::default();
            let mut derp = None;
            let mut five_encoding = None;
            let mut five_key_encoding = StringEncoding::default();
            let mut five_present = false;
            let mut read = 0;
            while match len {
                cbor_event::LenSz::Len(n, _) => read < n,
                cbor_event::LenSz::Indefinite => true,
            } {
                match raw.cbor_type()? {
                    cbor_event::Type::UnsignedInteger => match raw.unsigned_integer_sz()? {
                        (1, key_enc) => {
                            if key_1.is_some() {
                                return Err(DeserializeFailure::DuplicateKey(Key::Uint(1)).into());
                            }
                            let (tmp_key_1, tmp_key_1_encoding) =
                                (|| -> Result<_, DeserializeError> {
                                    Ok(match raw.cbor_type()? != cbor_event::Type::Special {
                                        true => Result::<_, DeserializeError>::Ok(
                                            raw.unsigned_integer_sz()
                                                .map(|(x, enc)| (x, Some(enc)))?,
                                        )
                                        .map(|(x, key_1_encoding)| (Some(x), key_1_encoding))?,
                                        false => {
                                            if raw.special()? != cbor_event::Special::Null {
                                                return Err(DeserializeFailure::ExpectedNull.into());
                                            }
                                            (None, None)
                                        }
                                    })
                                })()
                                .map_err(|e| e.annotate("key_1"))?;
                            key_1 = Some(tmp_key_1);
                            key_1_encoding = tmp_key_1_encoding;
                            key_1_key_encoding = Some(key_enc);
                            orig_deser_order.push(2);
                        }
                        (5, key_enc) => {
                            if key_5.is_some() {
                                return Err(DeserializeFailure::DuplicateKey(Key::Uint(5)).into());
                            }
                            let (tmp_key_5, tmp_key_5_encoding) =
                                (|| -> Result<_, DeserializeError> {
                                    read_len.read_elems(1)?;
                                    raw.text_sz()
                                        .map_err(Into::<DeserializeError>::into)
                                        .map(|(s, enc)| (s, StringEncoding::from(enc)))
                                })()
                                .map_err(|e| e.annotate("key_5"))?;
                            key_5 = Some(tmp_key_5);
                            key_5_encoding = tmp_key_5_encoding;
                            key_5_key_encoding = Some(key_enc);
                            orig_deser_order.push(3);
                        }
                        (unknown_key, _enc) => {
                            return Err(
                                DeserializeFailure::UnknownKey(Key::Uint(unknown_key)).into()
                            )
                        }
                    },
                    cbor_event::Type::Text => {
                        let (text_key, key_enc) = raw.text_sz()?;
                        match text_key.as_str() {
                            "foo" => {
                                if foo.is_some() {
                                    return Err(DeserializeFailure::DuplicateKey(Key::Str(
                                        "foo".into(),
                                    ))
                                    .into());
                                }
                                let (tmp_foo, tmp_foo_tag_encoding) =
                                    (|| -> Result<_, DeserializeError> {
                                        match raw.tag_sz()? {
                                            (13, tag_enc) => {
                                                Ok((Foo::deserialize(raw)?, Some(tag_enc)))
                                            }
                                            (tag, _enc) => Err(DeserializeFailure::TagMismatch {
                                                found: tag,
                                                expected: 13,
                                            }
                                            .into()),
                                        }
                                    })()
                                    .map_err(|e| e.annotate("foo"))?;
                                foo = Some(tmp_foo);
                                foo_tag_encoding = tmp_foo_tag_encoding;
                                foo_key_encoding = StringEncoding::from(key_enc);
                                orig_deser_order.push(0);
                            }
                            "derp" => {
                                if derp.is_some() {
                                    return Err(DeserializeFailure::DuplicateKey(Key::Str(
                                        "derp".into(),
                                    ))
                                    .into());
                                }
                                let (tmp_derp, tmp_derp_encoding) =
                                    (|| -> Result<_, DeserializeError> {
                                        read_len.read_elems(1)?;
                                        raw.unsigned_integer_sz()
                                            .map_err(Into::<DeserializeError>::into)
                                            .map(|(x, enc)| (x, Some(enc)))
                                    })()
                                    .map_err(|e| e.annotate("derp"))?;
                                derp = Some(tmp_derp);
                                derp_encoding = tmp_derp_encoding;
                                derp_key_encoding = StringEncoding::from(key_enc);
                                orig_deser_order.push(1);
                            }
                            "five" => {
                                if five_present {
                                    return Err(DeserializeFailure::DuplicateKey(Key::Str(
                                        "five".into(),
                                    ))
                                    .into());
                                }
                                let tmp_five_encoding = (|| -> Result<_, DeserializeError> {
                                    let (five_value, five_encoding) = raw.unsigned_integer_sz()?;
                                    if five_value != 5 {
                                        return Err(DeserializeFailure::FixedValueMismatch {
                                            found: Key::Uint(five_value),
                                            expected: Key::Uint(5),
                                        }
                                        .into());
                                    }
                                    Ok(Some(five_encoding))
                                })()
                                .map_err(|e| e.annotate("five"))?;
                                five_present = true;
                                five_encoding = tmp_five_encoding;
                                five_key_encoding = StringEncoding::from(key_enc);
                                orig_deser_order.push(4);
                            }
                            unknown_key => {
                                return Err(DeserializeFailure::UnknownKey(Key::Str(
                                    unknown_key.to_owned(),
                                ))
                                .into())
                            }
                        }
                    }
                    cbor_event::Type::Special => match len {
                        cbor_event::LenSz::Len(_, _) => {
                            return Err(DeserializeFailure::BreakInDefiniteLen.into())
                        }
                        cbor_event::LenSz::Indefinite => match raw.special()? {
                            cbor_event::Special::Break => break,
                            _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                        },
                    },
                    other_type => {
                        return Err(DeserializeFailure::UnexpectedKeyType(other_type).into())
                    }
                }
                read += 1;
            }
            let foo = match foo {
                Some(x) => x,
                None => {
                    return Err(
                        DeserializeFailure::MandatoryFieldMissing(Key::Str(String::from("foo")))
                            .into(),
                    )
                }
            };
            let key_1 = match key_1 {
                Some(x) => x,
                None => return Err(DeserializeFailure::MandatoryFieldMissing(Key::Uint(1)).into()),
            };
            if !five_present {
                return Err(
                    DeserializeFailure::MandatoryFieldMissing(Key::Str(String::from("five")))
                        .into(),
                );
            }
            read_len.finish()?;
            Ok(Self {
                foo,
                derp,
                key_1,
                key_5,
                encodings: Some(BarEncoding {
                    len_encoding,
                    orig_deser_order,
                    foo_key_encoding,
                    foo_tag_encoding,
                    derp_key_encoding,
                    derp_encoding,
                    key_1_key_encoding,
                    key_1_encoding,
                    key_5_key_encoding,
                    key_5_encoding,
                    five_key_encoding,
                    five_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("Bar"))
    }
}

impl cbor_event::se::Serialize for Basic {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(2),
        )?;
        self.serialize_as_embedded_group(serializer)
    }
}

impl SerializeEmbeddedGroup for Basic {
    fn serialize_as_embedded_group<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_unsigned_integer_sz(
            self.index_0,
            fit_sz(
                self.index_0,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.index_0_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_text_sz(
            &self.index_1,
            self.encodings
                .as_ref()
                .map(|encs| encs.index_1_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(self.index_1.len() as u64),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for Basic {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let len = raw.array_sz()?;
        let mut read_len = CBORReadLen::new(len);
        read_len.read_elems(2)?;
        read_len.finish()?;
        let ret = Self::deserialize_as_embedded_group(raw, &mut read_len, len);
        match len {
            cbor_event::LenSz::Len(_, _) => (),
            cbor_event::LenSz::Indefinite => match raw.special()? {
                cbor_event::Special::Break => (),
                _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
            },
        }
        ret
    }
}

impl DeserializeEmbeddedGroup for Basic {
    fn deserialize_as_embedded_group<R: BufRead + Seek>(
        raw: &mut Deserializer<R>,
        _read_len: &mut CBORReadLen,
        len: cbor_event::LenSz,
    ) -> Result<Self, DeserializeError> {
        let len_encoding = len.into();
        (|| -> Result<_, DeserializeError> {
            let (index_0, index_0_encoding) = raw
                .unsigned_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(x, enc)| (x, Some(enc)))
                .map_err(|e: DeserializeError| e.annotate("index_0"))?;
            let (index_1, index_1_encoding) = raw
                .text_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(s, enc)| (s, StringEncoding::from(enc)))
                .map_err(|e: DeserializeError| e.annotate("index_1"))?;
            Ok(Basic {
                index_0,
                index_1,
                encodings: Some(BasicEncoding {
                    len_encoding,
                    index_0_encoding,
                    index_1_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("Basic"))
    }
}

