            let (z, z_encoding) = raw
                .unsigned_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(x, enc)| (x, Some(enc)))
                .map_err(|e: DeserializeError| e.annotate("z"))?;
            Ok(First {
                x,
                z,
                encodings: Some(FirstEncoding {
                    len_encoding,
                    x_encoding,
                    z_encoding,
                }),
