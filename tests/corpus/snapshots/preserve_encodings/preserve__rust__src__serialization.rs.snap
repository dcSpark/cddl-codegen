impl cbor_event::se::Serialize for GroupChoice {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        match self {
            GroupChoice::I3 {
                i3_encoding,
                len_encoding,
            } => {
                serializer.write_array_sz(len_encoding.to_len_sz(1))?;
                serializer.write_unsigned_integer_sz(3u64, fit_sz(3u64, *i3_encoding))?;
                len_encoding.end(serializer)?;
                Ok(serializer)
            }
            GroupChoice::I2 {
                i2_tag_encoding,
                i2_encoding,
                len_encoding,
            } => {
                serializer.write_array_sz(len_encoding.to_len_sz(1))?;
                serializer.write_tag_sz(10u64, fit_sz(10u64, *i2_tag_encoding))?;
                serializer.write_unsigned_integer_sz(2u64, fit_sz(2u64, *i2_encoding))?;
                len_encoding.end(serializer)?;
                Ok(serializer)
            }
            GroupChoice::Foo { foo, len_encoding } => {
                serializer.write_array_sz(len_encoding.to_len_sz(1))?;
                foo.serialize(serializer)?;
                len_encoding.end(serializer)?;
                Ok(serializer)
            }
            GroupChoice::GroupChoice3 {
                x,
                len_encoding,
                index_0_encoding,
                x_encoding,
            } => {
                serializer.write_array_sz(len_encoding.to_len_sz(2))?;
                serializer.write_unsigned_integer_sz(0u64, fit_sz(0u64, *index_0_encoding))?;
                serializer.write_unsigned_integer_sz(*x, fit_sz(*x, *x_encoding))?;
                len_encoding.end(serializer)?;
                Ok(serializer)
            }
            GroupChoice::Plain(plain) => plain.serialize(serializer),
        }
    }
}

