impl cbor_event::se::Serialize for Plain {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(2),
        )?;
        self.serialize_as_embedded_group(serializer)
    }
}

impl SerializeEmbeddedGroup for Plain {
    fn serialize_as_embedded_group<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_tag_sz(
            13u64,
            fit_sz(
                13u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.d_tag_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_unsigned_integer_sz(
            self.d,
            fit_sz(
                self.d,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.d_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_tag_sz(
            9u64,
            fit_sz(
                9u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.e_tag_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_text_sz(
            &self.e,
            self.encodings
                .as_ref()
                .map(|encs| encs.e_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(self.e.len() as u64),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for Plain {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let len = raw.array_sz()?;
        let mut read_len = CBORReadLen::new(len);
        read_len.read_elems(2)?;
        read_len.finish()?;
        let ret = Self::deserialize_as_embedded_group(raw, &mut read_len, len);
        match len {
            cbor_event::LenSz::Len(_, _) => (),
            cbor_event::LenSz::Indefinite => match raw.special()? {
                cbor_event::Special::Break => (),
                _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
            },
        }
        ret
    }
}

impl DeserializeEmbeddedGroup for Plain {
    fn deserialize_as_embedded_group<R: BufRead + Seek>(
        raw: &mut Deserializer<R>,
        _read_len: &mut CBORReadLen,
        len: cbor_event::LenSz,
    ) -> Result<Self, DeserializeError> {
        let len_encoding = len.into();
        (|| -> Result<_, DeserializeError> {
            let (d, d_tag_encoding, d_encoding) = (|| -> Result<_, DeserializeError> {
                match raw.tag_sz()? {
                    (13, tag_enc) => raw
                        .unsigned_integer_sz()
                        .map_err(Into::<DeserializeError>::into)
                        .map(|(x, enc)| (x, Some(tag_enc), Some(enc))),
                    (tag, _enc) => Err(DeserializeFailure::TagMismatch {
                        found: tag,
                        expected: 13,
                    }
                    .into()),
                }
            })()
            .map_err(|e| e.annotate("d"))?;
            let (e, e_tag_encoding, e_encoding) = (|| -> Result<_, DeserializeError> {
                match raw.tag_sz()? {
                    (9, tag_enc) => raw
                        .text_sz()
                        .map_err(Into::<DeserializeError>::into)
                        .map(|(s, enc)| (s, Some(tag_enc), StringEncoding::from(enc))),
                    (tag, _enc) => Err(DeserializeFailure::TagMismatch {
                        found: tag,
                        expected: 9,
                    }
                    .into()),
                }
            })()
            .map_err(|e| e.annotate("e"))?;
            Ok(Plain {
                d,
                e,
                encodings: Some(PlainEncoding {
                    len_encoding,
                    d_tag_encoding,
                    d_encoding,
                    e_tag_encoding,
                    e_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("Plain"))
    }
}

impl cbor_event::se::Serialize for PlainArrays {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(4),
        )?;
        self.embedded.serialize_as_embedded_group(serializer)?;
        self.single.serialize(serializer)?;
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.multi_encoding)
                .unwrap_or_default()
                .to_len_sz(2 * self.multi.len() as u64),
        )?;
        for element in self.multi.iter() {
            element.serialize_as_embedded_group(serializer)?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.multi_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for PlainArrays {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let len = raw.array_sz()?;
        let len_encoding: LenEncoding = len.into();
        let mut read_len = CBORReadLen::new(len);
        read_len.read_elems(4)?;
        read_len.finish()?;
        (|| -> Result<_, DeserializeError> {
            let embedded = Plain::deserialize_as_embedded_group(raw, &mut read_len, len)
                .map_err(|e: DeserializeError| e.annotate("embedded"))?;
            let single =
                Plain::deserialize(raw).map_err(|e: DeserializeError| e.annotate("single"))?;
            let (multi, multi_encoding) = (|| -> Result<_, DeserializeError> {
                let mut multi_arr = Vec::new();
                let len = raw.array_sz()?;
                let multi_encoding = len.into();
                let mut multi_read_len = CBORReadLen::new(len);
                while match len {
                    cbor_event::LenSz::Len(n, _) => multi_read_len.read() < n,
                    cbor_event::LenSz::Indefinite => true,
                } {
                    if let cbor_event::LenSz::Indefinite = len {
                        if raw.cbor_type()? == cbor_event::Type::Special {
                            match raw.special()? {
                                cbor_event::Special::Break => break,
                                _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                            }
                        }
                    }
                    multi_read_len.read_elems(2)?;
                    multi_arr.push(Plain::deserialize_as_embedded_group(
                        raw,
                        &mut multi_read_len,
                        len,
                    )?);
                }
                Ok((multi_arr, multi_encoding))
            })()
            .map_err(|e| e.annotate("multi"))?;
            match len {
                cbor_event::LenSz::Len(_, _) => (),
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(PlainArrays {
                embedded,
                single,
                multi,
                encodings: Some(PlainArraysEncoding {
                    len_encoding,
                    multi_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("PlainArrays"))
    }
}

impl cbor_event::se::Serialize for Second {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
