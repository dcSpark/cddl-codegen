            encodings: Some(String64Encoding { inner_encoding }),
        })
    }
}

impl cbor_event::se::Serialize for StructWithCustomSerialization {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(5),
        )?;
        custom_serialize_bytes(
            serializer,
            &self.custom_bytes,
            &self
                .encodings
                .as_ref()
                .map(|encs| encs.custom_bytes_encoding.clone())
                .unwrap_or_default(),
        )?;
        custom_serialize_bytes(
            serializer,
            &self.field,
            &self
                .encodings
                .as_ref()
                .map(|encs| encs.field_encoding.clone())
                .unwrap_or_default(),
        )?;
        write_hex_string(
            serializer,
            &self.overridden,
            &self
                .encodings
                .as_ref()
                .map(|encs| encs.overridden_encoding.clone())
                .unwrap_or_default(),
        )?;
        serializer.write_tag_sz(
            9u64,
            fit_sz(
                9u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.tagged1_tag_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        custom_serialize_bytes(
            serializer,
            &self.tagged1,
            &self
                .encodings
                .as_ref()
                .map(|encs| encs.tagged1_encoding.clone())
                .unwrap_or_default(),
        )?;
        write_tagged_uint_str(
            serializer,
            &self.tagged2,
            self.encodings
                .as_ref()
                .map(|encs| encs.tagged2_tag_encoding)
                .unwrap_or_default(),
            self.encodings
                .as_ref()
                .map(|encs| encs.tagged2_encoding)
                .unwrap_or_default(),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for StructWithCustomSerialization {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let len = raw.array_sz()?;
        let len_encoding: LenEncoding = len.into();
        let mut read_len = CBORReadLen::new(len);
        read_len.read_elems(5)?;
        read_len.finish()?;
        (|| -> Result<_, DeserializeError> {
            let (custom_bytes, custom_bytes_encoding) = custom_deserialize_bytes(raw)
                .map_err(|e: DeserializeError| e.annotate("custom_bytes"))?;
            let (field, field_encoding) =
                custom_deserialize_bytes(raw).map_err(|e: DeserializeError| e.annotate("field"))?;
            let (overridden, overridden_encoding) =
                read_hex_string(raw).map_err(|e: DeserializeError| e.annotate("overridden"))?;
            let (tagged1, tagged1_tag_encoding, tagged1_encoding) =
                (|| -> Result<_, DeserializeError> {
                    match raw.tag_sz()? {
                        (9, tag_enc) => {
                            custom_deserialize_bytes(raw).map(|(tagged1, tagged1_encoding)| {
                                (tagged1, Some(tag_enc), tagged1_encoding)
                            })
                        }
                        (tag, _enc) => Err(DeserializeFailure::TagMismatch {
                            found: tag,
                            expected: 9,
                        }
                        .into()),
                    }
                })()
                .map_err(|e| e.annotate("tagged1"))?;
            let (tagged2, tagged2_tag_encoding, tagged2_encoding) =
                read_tagged_uint_str(raw).map_err(|e: DeserializeError| e.annotate("tagged2"))?;
            match len {
                cbor_event::LenSz::Len(_, _) => (),
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(StructWithCustomSerialization {
                custom_bytes,
                field,
                overridden,
                tagged1,
                tagged2,
                encodings: Some(StructWithCustomSerializationEncoding {
                    len_encoding,
                    custom_bytes_encoding,
                    field_encoding,
                    overridden_encoding,
                    tagged1_tag_encoding,
                    tagged1_encoding,
                    tagged2_tag_encoding,
                    tagged2_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("StructWithCustomSerialization"))
    }
}

impl cbor_event::se::Serialize for TableArrMembers {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_map_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(3),
        )?;
        let deser_order = self
            .encodings
            .as_ref()
            .filter(|encs| encs.orig_deser_order.len() == 3)
            .map(|encs| encs.orig_deser_order.clone())
            .unwrap_or_else(|| (0..3).collect());
        for field_index in deser_order {
            match field_index {
                0 => {
                    serializer.write_text_sz(
                        "arr",
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.arr_key_encoding.clone())
                            .unwrap_or_default()
                            .to_str_len_sz("arr".len() as u64),
                    )?;
                    serializer.write_array_sz(
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.arr_encoding)
                            .unwrap_or_default()
                            .to_len_sz(self.arr.len() as u64),
                    )?;
                    for (i, element) in self.arr.iter().enumerate() {
                        let arr_elem_encoding = self
                            .encodings
                            .as_ref()
                            .and_then(|encs| encs.arr_elem_encodings.get(i))
                            .cloned()
                            .unwrap_or_default();
                        serializer.write_unsigned_integer_sz(
                            *element as u64,
                            fit_sz(*element as u64, arr_elem_encoding),
                        )?;
                    }
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.arr_encoding)
                        .unwrap_or_default()
                        .end(serializer)?;
                }
                1 => {
                    serializer.write_text_sz(
                        "arr2",
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.arr2_key_encoding.clone())
                            .unwrap_or_default()
                            .to_str_len_sz("arr2".len() as u64),
                    )?;
                    serializer.write_array_sz(
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.arr2_encoding)
                            .unwrap_or_default()
                            .to_len_sz(self.arr2.len() as u64),
                    )?;
                    for element in self.arr2.iter() {
                        element.serialize(serializer)?;
                    }
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.arr2_encoding)
                        .unwrap_or_default()
                        .end(serializer)?;
                }
                2 => {
                    serializer.write_text_sz(
                        "table",
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.table_key_encoding.clone())
                            .unwrap_or_default()
                            .to_str_len_sz("table".len() as u64),
                    )?;
                    serializer.write_map_sz(
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.table_encoding)
                            .unwrap_or_default()
                            .to_len_sz(self.table.len() as u64),
                    )?;
                    for (key, value) in self.table.iter() {
                        let table_key_encoding = self
                            .encodings
                            .as_ref()
                            .and_then(|encs| encs.table_key_encodings.get(key))
                            .cloned()
                            .unwrap_or_default();
                        serializer
                            .write_unsigned_integer_sz(*key, fit_sz(*key, table_key_encoding))?;
                        let table_value_encoding = self
                            .encodings
                            .as_ref()
                            .and_then(|encs| encs.table_value_encodings.get(key))
                            .cloned()
                            .unwrap_or_default();
                        serializer.write_text_sz(
                            &value,
                            table_value_encoding.to_str_len_sz(value.len() as u64),
                        )?;
                    }
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.table_encoding)
                        .unwrap_or_default()
                        .end(serializer)?;
                }
                _ => unreachable!(),
            };
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for TableArrMembers {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let len = raw.map_sz()?;
        let len_encoding: LenEncoding = len.into();
        let mut read_len = CBORReadLen::new(len);
        read_len.read_elems(3)?;
        read_len.finish()?;
        (|| -> Result<_, DeserializeError> {
            let mut orig_deser_order = Vec::new();
            let mut arr_encoding = LenEncoding::default();
            let mut arr_elem_encodings = Vec::new();
            let mut arr_key_encoding = StringEncoding::default();
            let mut arr = None;
            let mut arr2_encoding = LenEncoding::default();
            let mut arr2_key_encoding = StringEncoding::default();
            let mut arr2 = None;
            let mut table_encoding = LenEncoding::default();
            let mut table_key_encodings = BTreeMap::new();
            let mut table_value_encodings = BTreeMap::new();
            let mut table_key_encoding = StringEncoding::default();
            let mut table = None;
            let mut read = 0;
            while match len {
                cbor_event::LenSz::Len(n, _) => read < n,
                cbor_event::LenSz::Indefinite => true,
            } {
                match raw.cbor_type()? {
                    cbor_event::Type::UnsignedInteger => {
                        return Err(DeserializeFailure::UnknownKey(Key::Uint(
                            raw.unsigned_integer()?,
                        ))
                        .into())
                    }
                    cbor_event::Type::Text => {
                        let (text_key, key_enc) = raw.text_sz()?;
                        match text_key.as_str() {
                            "arr" => {
                                if arr.is_some() {
                                    return Err(DeserializeFailure::DuplicateKey(Key::Str(
                                        "arr".into(),
                                    ))
                                    .into());
                                }
                                let (tmp_arr, tmp_arr_encoding, tmp_arr_elem_encodings) =
                                    (|| -> Result<_, DeserializeError> {
                                        let mut arr_arr = Vec::new();
                                        let len = raw.array_sz()?;
                                        let arr_encoding = len.into();
                                        let mut arr_elem_encodings = Vec::new();
                                        while match len {
                                            cbor_event::LenSz::Len(n, _) => {
                                                (arr_arr.len() as u64) < n
                                            }
                                            cbor_event::LenSz::Indefinite => true,
                                        } {
                                            if let cbor_event::LenSz::Indefinite = len {
                                                if raw.cbor_type()? == cbor_event::Type::Special {
                                                    match raw.special()? {
                                                        cbor_event::Special::Break => break,
                                                        _ => return Err(
                                                            DeserializeFailure::EndingBreakMissing
                                                                .into(),
                                                        ),
                                                    }
                                                }
                                            }
                                            let (arr_elem, arr_elem_encoding) = raw
                                                .unsigned_integer_sz()
                                                .map(|(x, enc)| (x as u32, Some(enc)))?;
                                            arr_arr.push(arr_elem);
                                            arr_elem_encodings.push(arr_elem_encoding);
                                        }
                                        Ok((arr_arr, arr_encoding, arr_elem_encodings))
                                    })()
                                    .map_err(|e| e.annotate("arr"))?;
                                arr = Some(tmp_arr);
                                arr_encoding = tmp_arr_encoding;
                                arr_elem_encodings = tmp_arr_elem_encodings;
                                arr_key_encoding = StringEncoding::from(key_enc);
                                orig_deser_order.push(0);
                            }
                            "arr2" => {
                                if arr2.is_some() {
                                    return Err(DeserializeFailure::DuplicateKey(Key::Str(
                                        "arr2".into(),
                                    ))
                                    .into());
                                }
                                let (tmp_arr2, tmp_arr2_encoding) =
                                    (|| -> Result<_, DeserializeError> {
                                        let mut arr2_arr = Vec::new();
                                        let len = raw.array_sz()?;
                                        let arr2_encoding = len.into();
                                        while match len {
                                            cbor_event::LenSz::Len(n, _) => {
                                                (arr2_arr.len() as u64) < n
                                            }
                                            cbor_event::LenSz::Indefinite => true,
                                        } {
                                            if let cbor_event::LenSz::Indefinite = len {
                                                if raw.cbor_type()? == cbor_event::Type::Special {
                                                    match raw.special()? {
                                                        cbor_event::Special::Break => break,
                                                        _ => return Err(
                                                            DeserializeFailure::EndingBreakMissing
                                                                .into(),
                                                        ),
                                                    }
                                                }
                                            }
                                            arr2_arr.push(Foo::deserialize(raw)?);
                                        }
                                        Ok((arr2_arr, arr2_encoding))
                                    })()
                                    .map_err(|e| e.annotate("arr2"))?;
                                arr2 = Some(tmp_arr2);
                                arr2_encoding = tmp_arr2_encoding;
                                arr2_key_encoding = StringEncoding::from(key_enc);
                                orig_deser_order.push(1);
                            }
                            "table" => {
                                if table.is_some() {
                                    return Err(DeserializeFailure::DuplicateKey(Key::Str(
                                        "table".into(),
                                    ))
                                    .into());
                                }
                                let (
                                    tmp_table,
                                    tmp_table_encoding,
                                    tmp_table_key_encodings,
                                    tmp_table_value_encodings,
                                ) = (|| -> Result<_, DeserializeError> {
                                    let mut table_table = OrderedHashMap::new();
                                    let table_len = raw.map_sz()?;
                                    let table_encoding = table_len.into();
                                    let mut table_key_encodings = BTreeMap::new();
                                    let mut table_value_encodings = BTreeMap::new();
                                    while match table_len {
                                        cbor_event::LenSz::Len(n, _) => {
                                            (table_table.len() as u64) < n
                                        }
                                        cbor_event::LenSz::Indefinite => true,
                                    } {
                                        if let cbor_event::LenSz::Indefinite = table_len {
                                            if raw.cbor_type()? == cbor_event::Type::Special {
                                                match raw.special()? {
                                                    cbor_event::Special::Break => break,
                                                    _ => {
                                                        return Err(
                                                            DeserializeFailure::EndingBreakMissing
                                                                .into(),
                                                        )
                                                    }
                                                }
                                            }
                                        }
                                        let (table_key, table_key_encoding) = raw
                                            .unsigned_integer_sz()
                                            .map(|(x, enc)| (x, Some(enc)))?;
                                        let (table_value, table_value_encoding) = raw
                                            .text_sz()
                                            .map(|(s, enc)| (s, StringEncoding::from(enc)))?;
                                        if table_table.insert(table_key, table_value).is_some() {
                                            return Err(DeserializeFailure::DuplicateKey(
                                                Key::Uint(table_key.into()),
                                            )
                                            .into());
                                        }
                                        table_key_encodings.insert(table_key, table_key_encoding);
                                        table_value_encodings
                                            .insert(table_key, table_value_encoding);
                                    }
                                    Ok((
                                        table_table,
                                        table_encoding,
                                        table_key_encodings,
                                        table_value_encodings,
                                    ))
                                })()
                                .map_err(|e| e.annotate("table"))?;
                                table = Some(tmp_table);
                                table_encoding = tmp_table_encoding;
                                table_key_encodings = tmp_table_key_encodings;
                                table_value_encodings = tmp_table_value_encodings;
                                table_key_encoding = StringEncoding::from(key_enc);
                                orig_deser_order.push(2);
                            }
                            unknown_key => {
                                return Err(DeserializeFailure::UnknownKey(Key::Str(
                                    unknown_key.to_owned(),
                                ))
                                .into())
                            }
                        }
                    }
                    cbor_event::Type::Special => match len {
                        cbor_event::LenSz::Len(_, _) => {
                            return Err(DeserializeFailure::BreakInDefiniteLen.into())
                        }
                        cbor_event::LenSz::Indefinite => match raw.special()? {
                            cbor_event::Special::Break => break,
                            _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                        },
                    },
                    other_type => {
                        return Err(DeserializeFailure::UnexpectedKeyType(other_type).into())
                    }
                }
                read += 1;
            }
            let arr = match arr {
                Some(x) => x,
                None => {
                    return Err(
                        DeserializeFailure::MandatoryFieldMissing(Key::Str(String::from("arr")))
                            .into(),
                    )
                }
            };
            let arr2 = match arr2 {
                Some(x) => x,
                None => {
                    return Err(
                        DeserializeFailure::MandatoryFieldMissing(Key::Str(String::from("arr2")))
                            .into(),
                    )
                }
            };
            let table = match table {
                Some(x) => x,
                None => {
                    return Err(
                        DeserializeFailure::MandatoryFieldMissing(Key::Str(String::from("table")))
                            .into(),
                    )
                }
            };
            ();
            Ok(Self {
                arr,
                arr2,
                table,
                encodings: Some(TableArrMembersEncoding {
                    len_encoding,
                    orig_deser_order,
                    arr_key_encoding,
                    arr_encoding,
                    arr_elem_encodings,
                    arr2_key_encoding,
                    arr2_encoding,
                    table_key_encoding,
                    table_encoding,
                    table_key_encodings,
                    table_value_encodings,
                }),
            })
        })()
        .map_err(|e| e.annotate("TableArrMembers"))
    }
}

impl cbor_event::se::Serialize for Three {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(3),
        )?;
        self.serialize_as_embedded_group(serializer)
    }
}

impl SerializeEmbeddedGroup for Three {
    fn serialize_as_embedded_group<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_unsigned_integer_sz(
            0u64,
            fit_sz(
                0u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.index_0_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_unsigned_integer_sz(
            self.index_1,
            fit_sz(
                self.index_1,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.index_1_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_text_sz(
            &self.index_2,
            self.encodings
                .as_ref()
                .map(|encs| encs.index_2_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(self.index_2.len() as u64),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for Three {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let len = raw.array_sz()?;
        let mut read_len = CBORReadLen::new(len);
        read_len.read_elems(3)?;
        read_len.finish()?;
        let ret = Self::deserialize_as_embedded_group(raw, &mut read_len, len);
        match len {
            cbor_event::LenSz::Len(_, _) => (),
            cbor_event::LenSz::Indefinite => match raw.special()? {
                cbor_event::Special::Break => (),
                _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
            },
        }
        ret
    }
}

impl DeserializeEmbeddedGroup for Three {
    fn deserialize_as_embedded_group<R: BufRead + Seek>(
        raw: &mut Deserializer<R>,
        _read_len: &mut CBORReadLen,
        len: cbor_event::LenSz,
    ) -> Result<Self, DeserializeError> {
        let len_encoding = len.into();
        (|| -> Result<_, DeserializeError> {
            let index_0_encoding = (|| -> Result<_, DeserializeError> {
                let (index_0_value, index_0_encoding) = raw.unsigned_integer_sz()?;
                if index_0_value != 0 {
                    return Err(DeserializeFailure::FixedValueMismatch {
                        found: Key::Uint(index_0_value),
                        expected: Key::Uint(0),
                    }
                    .into());
                }
                Ok(Some(index_0_encoding))
            })()
            .map_err(|e| e.annotate("index_0"))?;
            let (index_1, index_1_encoding) = raw
                .unsigned_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(x, enc)| (x, Some(enc)))
                .map_err(|e: DeserializeError| e.annotate("index_1"))?;
            let (index_2, index_2_encoding) = raw
                .text_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(s, enc)| (s, StringEncoding::from(enc)))
                .map_err(|e: DeserializeError| e.annotate("index_2"))?;
            Ok(Three {
                index_1,
                index_2,
                encodings: Some(ThreeEncoding {
                    len_encoding,
                    index_0_encoding,
                    index_1_encoding,
                    index_2_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("Three"))
    }
}

impl cbor_event::se::Serialize for TypeChoice {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        match self {
            TypeChoice::I0 { i0_encoding } => {
                serializer.write_unsigned_integer_sz(0u64, fit_sz(0u64, *i0_encoding))
            }
            TypeChoice::Helloworld {
                helloworld_encoding,
            } => serializer.write_text_sz(
                "hello world",
                helloworld_encoding.to_str_len_sz("hello world".len() as u64),
            ),
            TypeChoice::U64 {
                uint,
                uint_encoding,
            } => serializer.write_unsigned_integer_sz(*uint, fit_sz(*uint, *uint_encoding)),
            TypeChoice::Text {
                text,
                text_encoding,
            } => serializer.write_text_sz(&text, text_encoding.to_str_len_sz(text.len() as u64)),
            TypeChoice::ArrU64 {
                arr_u64,
                arr_u64_tag_encoding,
                arr_u64_encoding,
                arr_u64_elem_encodings,
            } => {
                serializer.write_tag_sz(16u64, fit_sz(16u64, *arr_u64_tag_encoding))?;
                serializer.write_array_sz(arr_u64_encoding.to_len_sz(arr_u64.len() as u64))?;
                for (i, element) in arr_u64.iter().enumerate() {
                    let arr_u64_elem_encoding =
                        arr_u64_elem_encodings.get(i).cloned().unwrap_or_default();
                    serializer.write_unsigned_integer_sz(
                        *element,
                        fit_sz(*element, arr_u64_elem_encoding),
                    )?;
                }
                arr_u64_encoding.end(serializer)
            }
        }
    }
}

impl Deserialize for TypeChoice {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let initial_position = raw.as_mut_ref().stream_position().unwrap();
            let mut errs = Vec::new();
            let deser_variant = (|raw: &mut Deserializer<_>| -> Result<_, DeserializeError> {
                let (i0_value, i0_encoding) = raw.unsigned_integer_sz()?;
                if i0_value != 0 {
                    return Err(DeserializeFailure::FixedValueMismatch {
                        found: Key::Uint(i0_value),
                        expected: Key::Uint(0),
                    }
                    .into());
                }
                Ok(Some(i0_encoding))
            })(raw);
            match deser_variant {
                Ok(i0_encoding) => return Ok(Self::I0 { i0_encoding }),
                Err(e) => {
                    errs.push(e.annotate("I0"));
                    raw.as_mut_ref()
                        .seek(SeekFrom::Start(initial_position))
                        .unwrap();
                }
            };
            let deser_variant = (|raw: &mut Deserializer<_>| -> Result<_, DeserializeError> {
                let (helloworld_value, helloworld_encoding) = raw.text_sz()?;
                if helloworld_value != "hello world" {
                    return Err(DeserializeFailure::FixedValueMismatch {
                        found: Key::Str(helloworld_value),
                        expected: Key::Str(String::from("hello world")),
                    }
                    .into());
                }
                Ok(StringEncoding::from(helloworld_encoding))
            })(raw);
            match deser_variant {
                Ok(helloworld_encoding) => {
                    return Ok(Self::Helloworld {
                        helloworld_encoding,
                    })
                }
                Err(e) => {
                    errs.push(e.annotate("Helloworld"));
                    raw.as_mut_ref()
                        .seek(SeekFrom::Start(initial_position))
                        .unwrap();
                }
            };
            let deser_variant: Result<_, DeserializeError> = raw
                .unsigned_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(x, enc)| (x, Some(enc)));
            match deser_variant {
                Ok((uint, uint_encoding)) => {
                    return Ok(Self::U64 {
                        uint,
                        uint_encoding,
                    })
                }
                Err(e) => {
                    errs.push(e.annotate("U64"));
                    raw.as_mut_ref()
                        .seek(SeekFrom::Start(initial_position))
                        .unwrap();
                }
            };
            let deser_variant: Result<_, DeserializeError> = raw
                .text_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(s, enc)| (s, StringEncoding::from(enc)));
            match deser_variant {
                Ok((text, text_encoding)) => {
                    return Ok(Self::Text {
                        text,
                        text_encoding,
                    })
                }
                Err(e) => {
                    errs.push(e.annotate("Text"));
                    raw.as_mut_ref()
                        .seek(SeekFrom::Start(initial_position))
                        .unwrap();
                }
            };
            let deser_variant = (|raw: &mut Deserializer<_>| -> Result<_, DeserializeError> {
                match raw.tag_sz()? {
                    (16, tag_enc) => {
                        let mut arr_u64_arr = Vec::new();
                        let len = raw.array_sz()?;
                        let arr_u64_encoding = len.into();
                        let mut arr_u64_elem_encodings = Vec::new();
                        while match len {
                            cbor_event::LenSz::Len(n, _) => (arr_u64_arr.len() as u64) < n,
                            cbor_event::LenSz::Indefinite => true,
                        } {
                            if let cbor_event::LenSz::Indefinite = len {
                                if raw.cbor_type()? == cbor_event::Type::Special {
                                    match raw.special()? {
                                        cbor_event::Special::Break => break,
                                        _ => {
                                            return Err(
                                                DeserializeFailure::EndingBreakMissing.into()
                                            )
                                        }
                                    }
                                }
                            }
                            let (arr_u64_elem, arr_u64_elem_encoding) =
                                raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                            arr_u64_arr.push(arr_u64_elem);
                            arr_u64_elem_encodings.push(arr_u64_elem_encoding);
                        }
                        Ok((
                            arr_u64_arr,
                            Some(tag_enc),
                            arr_u64_encoding,
                            arr_u64_elem_encodings,
                        ))
                    }
                    (tag, _enc) => Err(DeserializeFailure::TagMismatch {
                        found: tag,
                        expected: 16,
                    }
                    .into()),
                }
            })(raw);
            match deser_variant {
                Ok((arr_u64, arr_u64_tag_encoding, arr_u64_encoding, arr_u64_elem_encodings)) => {
                    return Ok(Self::ArrU64 {
                        arr_u64,
                        arr_u64_tag_encoding,
                        arr_u64_encoding,
                        arr_u64_elem_encodings,
                    })
                }
                Err(e) => {
                    errs.push(e.annotate("ArrU64"));
                    raw.as_mut_ref()
                        .seek(SeekFrom::Start(initial_position))
                        .unwrap();
                }
            };
            Err(DeserializeError::new(
                "TypeChoice",
                DeserializeFailure::NoVariantMatchedWithCauses(errs),
            ))
        })()
        .map_err(|e| e.annotate("TypeChoice"))
    }
}

impl cbor_event::se::Serialize for WrapperList {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.inner_encoding)
                .unwrap_or_default()
                .to_len_sz(self.inner.len() as u64),
        )?;
        for (i, element) in self.inner.iter().enumerate() {
            let inner_elem_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.inner_elem_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer
                .write_unsigned_integer_sz(*element, fit_sz(*element, inner_elem_encoding))?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.inner_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for WrapperList {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let mut inner_arr = Vec::new();
        let len = raw.array_sz()?;
        let inner_encoding = len.into();
        let mut inner_elem_encodings = Vec::new();
        while match len {
            cbor_event::LenSz::Len(n, _) => (inner_arr.len() as u64) < n,
            cbor_event::LenSz::Indefinite => true,
        } {
            if let cbor_event::LenSz::Indefinite = len {
                if raw.cbor_type()? == cbor_event::Type::Special {
                    match raw.special()? {
                        cbor_event::Special::Break => break,
                        _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                    }
                }
            }
            let (inner_elem, inner_elem_encoding) =
                raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
            inner_arr.push(inner_elem);
            inner_elem_encodings.push(inner_elem_encoding);
        }
        let (inner, inner_encoding, inner_elem_encodings) =
            (inner_arr, inner_encoding, inner_elem_encodings);
        Ok(Self {
            inner,
            encodings: Some(WrapperListEncoding {
                inner_encoding,
                inner_elem_encodings,
            }),
        })
    }
}

impl cbor_event::se::Serialize for WrapperTable {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_map_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.inner_encoding)
                .unwrap_or_default()
                .to_len_sz(self.inner.len() as u64),
        )?;
        for (key, value) in self.inner.iter() {
            let inner_key_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.inner_key_encodings.get(key))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*key, fit_sz(*key, inner_key_encoding))?;
            let inner_value_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.inner_value_encodings.get(key))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*value, fit_sz(*value, inner_value_encoding))?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.inner_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for WrapperTable {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let mut inner_table = OrderedHashMap::new();
        let inner_len = raw.map_sz()?;
        let inner_encoding = inner_len.into();
        let mut inner_key_encodings = BTreeMap::new();
        let mut inner_value_encodings = BTreeMap::new();
        while match inner_len {
            cbor_event::LenSz::Len(n, _) => (inner_table.len() as u64) < n,
            cbor_event::LenSz::Indefinite => true,
        } {
            if let cbor_event::LenSz::Indefinite = inner_len {
                if raw.cbor_type()? == cbor_event::Type::Special {
                    match raw.special()? {
                        cbor_event::Special::Break => break,
                        _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                    }
                }
            }
            let (inner_key, inner_key_encoding) =
                raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
            let (inner_value, inner_value_encoding) =
                raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
            if inner_table.insert(inner_key, inner_value).is_some() {
                return Err(DeserializeFailure::DuplicateKey(Key::Uint(inner_key.into())).into());
            }
            inner_key_encodings.insert(inner_key, inner_key_encoding);
            inner_value_encodings.insert(inner_key, inner_value_encoding);
        }
        let (inner, inner_encoding, inner_key_encodings, inner_value_encodings) = (
            inner_table,
            inner_encoding,
            inner_key_encodings,
            inner_value_encodings,
        );
        Ok(Self {
            inner,
            encodings: Some(WrapperTableEncoding {
                inner_encoding,
                inner_key_encodings,
                inner_value_encodings,
            }),
        })
    }
}
