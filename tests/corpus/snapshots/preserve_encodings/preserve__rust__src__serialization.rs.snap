                    let inner_de = &mut Deserializer::from(std::io::Cursor::new(group_bytes_bytes));
                    let (group_bytes, group_bytes_bytes_encoding) = (
                        BasicArr::deserialize(inner_de)?,
                        StringEncoding::from(group_bytes_bytes_encoding),
                    );
                    match len {
                        cbor_event::LenSz::Len(_, _) => (),
                        cbor_event::LenSz::Indefinite => match raw.special()? {
                            cbor_event::Special::Break => (),
                            _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                        },
                    }
                    Ok(Self::GroupBytes {
                        group_bytes,
                        group_bytes_bytes_encoding,
                        len_encoding,
                    })
                }
                _ => Err(DeserializeError::new(
                    "NonOverlapBasicNotBasic",
                    DeserializeFailure::NoVariantMatched,
                )),
            }
        })()
        .map_err(|e| e.annotate("NonOverlapBasicNotBasic"))
    }
}

impl cbor_event::se::Serialize for NonOverlappingTypeChoiceAll {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        match self {
            NonOverlappingTypeChoiceAll::U64 {
                uint,
                uint_encoding,
            } => serializer.write_unsigned_integer_sz(*uint, fit_sz(*uint, *uint_encoding)),
            NonOverlappingTypeChoiceAll::N64 { n64, n64_encoding } => serializer
                .write_negative_integer_sz(-(*n64 as i128 + 1), fit_sz(*n64, *n64_encoding)),
            NonOverlappingTypeChoiceAll::Text {
                text,
                text_encoding,
            } => serializer.write_text_sz(&text, text_encoding.to_str_len_sz(text.len() as u64)),
            NonOverlappingTypeChoiceAll::Bytes {
                bytes,
                bytes_encoding,
            } => {
                serializer.write_bytes_sz(&bytes, bytes_encoding.to_str_len_sz(bytes.len() as u64))
            }
            NonOverlappingTypeChoiceAll::Helloworld {
                helloworld_tag_encoding,
                helloworld_encoding,
            } => {
                serializer.write_tag_sz(13u64, fit_sz(13u64, *helloworld_tag_encoding))?;
                serializer.write_text_sz(
                    "hello world",
                    helloworld_encoding.to_str_len_sz("hello world".len() as u64),
                )
            }
            NonOverlappingTypeChoiceAll::ArrU64 {
                arr_u64,
                arr_u64_encoding,
                arr_u64_elem_encodings,
            } => {
                serializer.write_array_sz(arr_u64_encoding.to_len_sz(arr_u64.len() as u64))?;
                for (i, element) in arr_u64.iter().enumerate() {
                    let arr_u64_elem_encoding =
                        arr_u64_elem_encodings.get(i).cloned().unwrap_or_default();
                    serializer.write_unsigned_integer_sz(
                        *element,
                        fit_sz(*element, arr_u64_elem_encoding),
                    )?;
                }
                arr_u64_encoding.end(serializer)
            }
            NonOverlappingTypeChoiceAll::MapTextToU64 {
                map_text_to_u64,
                map_text_to_u64_encoding,
                map_text_to_u64_key_encodings,
                map_text_to_u64_value_encodings,
            } => {
                serializer.write_map_sz(
                    map_text_to_u64_encoding.to_len_sz(map_text_to_u64.len() as u64),
                )?;
                for (key, value) in map_text_to_u64.iter() {
                    let map_text_to_u64_key_encoding = map_text_to_u64_key_encodings
                        .get(key)
                        .cloned()
                        .unwrap_or_default();
                    serializer.write_text_sz(
                        &key,
                        map_text_to_u64_key_encoding.to_str_len_sz(key.len() as u64),
                    )?;
                    let map_text_to_u64_value_encoding = map_text_to_u64_value_encodings
                        .get(key)
                        .cloned()
                        .unwrap_or_default();
                    serializer.write_unsigned_integer_sz(
                        *value,
                        fit_sz(*value, map_text_to_u64_value_encoding),
                    )?;
                }
                map_text_to_u64_encoding.end(serializer)
            }
        }
    }
}

impl Deserialize for NonOverlappingTypeChoiceAll {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            match raw.cbor_type()? {
                cbor_event::Type::UnsignedInteger => {
                    let (uint, uint_encoding) =
                        raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                    Ok(Self::U64 {
                        uint,
                        uint_encoding,
                    })
                }
                cbor_event::Type::NegativeInteger => {
                    let (n64, n64_encoding) = raw
                        .negative_integer_sz()
                        .map(|(x, enc)| ((x + 1).abs() as u64, Some(enc)))?;
                    Ok(Self::N64 { n64, n64_encoding })
                }
                cbor_event::Type::Text => {
                    let (text, text_encoding) = raw
                        .text_sz()
                        .map(|(s, enc)| (s, StringEncoding::from(enc)))?;
                    Ok(Self::Text {
                        text,
                        text_encoding,
                    })
                }
                cbor_event::Type::Bytes => {
                    let (bytes, bytes_encoding) = raw
                        .bytes_sz()
                        .map(|(bytes, enc)| (bytes, StringEncoding::from(enc)))?;
                    Ok(Self::Bytes {
                        bytes,
                        bytes_encoding,
                    })
                }
                cbor_event::Type::Tag => {
                    let (helloworld_tag_encoding, helloworld_encoding) = match raw.tag_sz()? {
                        (13, tag_enc) => {
                            let (helloworld_value, helloworld_encoding) = raw.text_sz()?;
                            if helloworld_value != "hello world" {
                                return Err(DeserializeFailure::FixedValueMismatch {
                                    found: Key::Str(helloworld_value),
                                    expected: Key::Str(String::from("hello world")),
                                }
                                .into());
                            }
                            (Some(tag_enc), StringEncoding::from(helloworld_encoding))
                        }
                        (tag, _enc) => {
                            return Err(DeserializeFailure::TagMismatch {
                                found: tag,
                                expected: 13,
                            }
                            .into())
                        }
                    };
                    Ok(Self::Helloworld {
                        helloworld_tag_encoding,
                        helloworld_encoding,
                    })
                }
                cbor_event::Type::Array => {
                    let mut arr_u64_arr = Vec::new();
                    let len = raw.array_sz()?;
                    let arr_u64_encoding = len.into();
                    let mut arr_u64_elem_encodings = Vec::new();
                    while match len {
                        cbor_event::LenSz::Len(n, _) => (arr_u64_arr.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if let cbor_event::LenSz::Indefinite = len {
                            if raw.cbor_type()? == cbor_event::Type::Special {
                                match raw.special()? {
                                    cbor_event::Special::Break => break,
                                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                                }
                            }
                        }
                        let (arr_u64_elem, arr_u64_elem_encoding) =
                            raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                        arr_u64_arr.push(arr_u64_elem);
                        arr_u64_elem_encodings.push(arr_u64_elem_encoding);
                    }
                    let (arr_u64, arr_u64_encoding, arr_u64_elem_encodings) =
                        (arr_u64_arr, arr_u64_encoding, arr_u64_elem_encodings);
                    Ok(Self::ArrU64 {
                        arr_u64,
                        arr_u64_encoding,
                        arr_u64_elem_encodings,
                    })
                }
                cbor_event::Type::Map => {
                    let mut map_text_to_u64_table = OrderedHashMap::new();
                    let map_text_to_u64_len = raw.map_sz()?;
                    let map_text_to_u64_encoding = map_text_to_u64_len.into();
                    let mut map_text_to_u64_key_encodings = BTreeMap::new();
                    let mut map_text_to_u64_value_encodings = BTreeMap::new();
                    while match map_text_to_u64_len {
                        cbor_event::LenSz::Len(n, _) => (map_text_to_u64_table.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if let cbor_event::LenSz::Indefinite = map_text_to_u64_len {
                            if raw.cbor_type()? == cbor_event::Type::Special {
                                match raw.special()? {
                                    cbor_event::Special::Break => break,
                                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                                }
                            }
                        }
                        let (map_text_to_u64_key, map_text_to_u64_key_encoding) = raw
                            .text_sz()
                            .map(|(s, enc)| (s, StringEncoding::from(enc)))?;
                        let (map_text_to_u64_value, map_text_to_u64_value_encoding) =
                            raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                        if map_text_to_u64_table
                            .insert(map_text_to_u64_key.clone(), map_text_to_u64_value)
                            .is_some()
                        {
                            return Err(DeserializeFailure::DuplicateKey(Key::Str(
                                map_text_to_u64_key,
                            ))
                            .into());
                        }
                        map_text_to_u64_key_encodings
                            .insert(map_text_to_u64_key.clone(), map_text_to_u64_key_encoding);
                        map_text_to_u64_value_encodings
                            .insert(map_text_to_u64_key.clone(), map_text_to_u64_value_encoding);
                    }
                    let (
                        map_text_to_u64,
                        map_text_to_u64_encoding,
                        map_text_to_u64_key_encodings,
                        map_text_to_u64_value_encodings,
                    ) = (
                        map_text_to_u64_table,
                        map_text_to_u64_encoding,
                        map_text_to_u64_key_encodings,
                        map_text_to_u64_value_encodings,
                    );
                    Ok(Self::MapTextToU64 {
                        map_text_to_u64,
                        map_text_to_u64_encoding,
                        map_text_to_u64_key_encodings,
                        map_text_to_u64_value_encodings,
                    })
                }
                _ => Err(DeserializeError::new(
                    "NonOverlappingTypeChoiceAll",
                    DeserializeFailure::NoVariantMatched,
                )),
            }
        })()
        .map_err(|e| e.annotate("NonOverlappingTypeChoiceAll"))
    }
}

