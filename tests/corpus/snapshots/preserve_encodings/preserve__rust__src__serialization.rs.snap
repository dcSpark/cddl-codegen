impl SerializeEmbeddedGroup for Second {
    fn serialize_as_embedded_group<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_text_sz(
            &self.y,
            self.encodings
                .as_ref()
                .map(|encs| encs.y_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(self.y.len() as u64),
        )?;
        serializer.write_unsigned_integer_sz(
            self.z,
            fit_sz(
                self.z,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.z_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for Second {
