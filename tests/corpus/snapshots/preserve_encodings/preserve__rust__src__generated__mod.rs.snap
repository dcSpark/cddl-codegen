#[derive(Clone, Debug)]
pub enum OverlapBasicEmbed {
    Identity {
        identity_encoding: Option<cbor_event::Sz>,
        len_encoding: LenEncoding,
    },
    X {
        hash: Vec<u8>,
        len_encoding: LenEncoding,
        tag_encoding: Option<cbor_event::Sz>,
        hash_encoding: StringEncoding,
    },
}

impl OverlapBasicEmbed {
    pub fn new_identity() -> Self {
        Self::Identity {
            identity_encoding: None,
            len_encoding: LenEncoding::default(),
        }
    }

    pub fn new_x(hash: Vec<u8>) -> Result<Self, DeserializeError> {
        if hash.len() != 32 {
            return Err(DeserializeFailure::RangeCheck {
                found: hash.len() as i128,
                min: Some(32),
                max: Some(32),
            }
            .into());
        }
        Ok(Self::X {
            hash,
            len_encoding: LenEncoding::default(),
            tag_encoding: None,
            hash_encoding: StringEncoding::default(),
        })
    }
}

