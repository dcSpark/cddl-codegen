#[derive(Clone, Debug)]
pub struct SignBounds {
    pub all_neg: i64,
    pub upto_zero: i64,
    pub le_neg: i64,
    pub le_pos: i64,
    pub ge_pos: i64,
    pub ne_pos: i64,
    pub ne_neg: i64,
    pub straddle: i64,
    pub ne_one: i64,
    pub ne_zero: i64,
    pub encodings: Option<SignBoundsEncoding>,
}

impl SignBounds {
    pub fn new(
        all_neg: i64,
        upto_zero: i64,
        le_neg: i64,
        le_pos: i64,
        ge_pos: i64,
        ne_pos: i64,
        ne_neg: i64,
        straddle: i64,
        ne_one: i64,
        ne_zero: i64,
    ) -> Result<Self, DeserializeError> {
        if all_neg < -10 || all_neg > -3 {
            return Err(DeserializeFailure::RangeCheck {
                found: all_neg as i128,
                min: Some(-10),
                max: Some(-3),
            }
            .into());
        }
        if upto_zero < -10 || upto_zero > 0 {
            return Err(DeserializeFailure::RangeCheck {
                found: upto_zero as i128,
                min: Some(-10),
                max: Some(0),
            }
            .into());
        }
        if le_neg > -3 {
            return Err(DeserializeFailure::RangeCheck {
                found: le_neg as i128,
                min: None,
                max: Some(-3),
            }
            .into());
        }
        if le_pos > 10 {
            return Err(DeserializeFailure::RangeCheck {
                found: le_pos as i128,
                min: None,
                max: Some(10),
            }
            .into());
        }
        if ge_pos < 3 {
            return Err(DeserializeFailure::RangeCheck {
                found: ge_pos as i128,
                min: Some(3),
                max: None,
            }
            .into());
        }
        if ne_pos == 5 {
            return Err(DeserializeFailure::RangeCheck {
                found: ne_pos as i128,
                min: Some(6),
                max: Some(4),
            }
            .into());
        }
        if ne_neg == -5 {
            return Err(DeserializeFailure::RangeCheck {
                found: ne_neg as i128,
                min: Some(-4),
                max: Some(-6),
            }
            .into());
        }
        if straddle < -10 || straddle > 3 {
            return Err(DeserializeFailure::RangeCheck {
                found: straddle as i128,
                min: Some(-10),
                max: Some(3),
            }
            .into());
        }
        if ne_one == 1 {
            return Err(DeserializeFailure::RangeCheck {
                found: ne_one as i128,
                min: Some(2),
                max: Some(0),
            }
            .into());
        }
        if ne_zero == 0 {
            return Err(DeserializeFailure::RangeCheck {
                found: ne_zero as i128,
                min: Some(1),
                max: Some(-1),
            }
            .into());
        }
        Ok(Self {
            all_neg,
            upto_zero,
            le_neg,
            le_pos,
            ge_pos,
            ne_pos,
            ne_neg,
            straddle,
            ne_one,
            ne_zero,
            encodings: None,
        })
    }
}

