    fn try_from(inner: u64) -> Result<Self, Self::Error> {
        TopLevelPosRange::new(inner)
    }
}

#[derive(Clone, Debug)]
pub struct TopLevelTaggedRange {
    pub(crate) inner: u64,
    pub encodings: Option<TopLevelTaggedRangeEncoding>,
}

impl TopLevelTaggedRange {
    pub fn get(&self) -> u64 {
        self.inner
    }

    pub fn new(inner: u64) -> Result<Self, DeserializeError> {
        if inner < 3 || inner > 10 {
            return Err(DeserializeError::new(
                "TopLevelTaggedRange",
                DeserializeFailure::RangeCheck {
                    found: inner as i128,
                    min: Some(3),
                    max: Some(10),
                },
            ));
        }
        Ok(Self {
            inner,
            encodings: None,
        })
    }
}

impl TryFrom<u64> for TopLevelTaggedRange {
    type Error = DeserializeError;

    fn try_from(inner: u64) -> Result<Self, Self::Error> {
        TopLevelTaggedRange::new(inner)
    }
}

#[derive(Clone, Debug)]
pub enum TypeChoice {
    I0 {
        i0_encoding: Option<cbor_event::Sz>,
    },
    Helloworld {
        helloworld_encoding: StringEncoding,
    },
    U64 {
        uint: u64,
        uint_encoding: Option<cbor_event::Sz>,
    },
    Text {
        text: String,
        text_encoding: StringEncoding,
    },
    ArrU64 {
        arr_u64: Vec<u64>,
        arr_u64_tag_encoding: Option<cbor_event::Sz>,
        arr_u64_encoding: LenEncoding,
        arr_u64_elem_encodings: Vec<Option<cbor_event::Sz>>,
    },
}

impl TypeChoice {
    pub fn new_i0() -> Self {
        Self::I0 { i0_encoding: None }
    }

    pub fn new_helloworld() -> Self {
        Self::Helloworld {
            helloworld_encoding: StringEncoding::default(),
        }
    }

    pub fn new_uint(uint: u64) -> Self {
        Self::U64 {
            uint,
            uint_encoding: None,
        }
    }

    pub fn new_text(text: String) -> Self {
        Self::Text {
            text,
            text_encoding: StringEncoding::default(),
        }
    }

    pub fn new_arr_u64(arr_u64: Vec<u64>) -> Self {
        Self::ArrU64 {
            arr_u64,
            arr_u64_tag_encoding: None,
            arr_u64_encoding: LenEncoding::default(),
            arr_u64_elem_encodings: Vec::new(),
        }
    }
}

pub type U32 = u32;

#[derive(Clone, Debug)]
pub struct WidthCollapse {
    pub u16w: u16,
    pub i8w: i8,
    pub i64w: i64,
    pub encodings: Option<WidthCollapseEncoding>,
}

impl WidthCollapse {
    pub fn new(u16w: u16, i8w: i8, i64w: i64) -> Self {
        Self {
            u16w,
            i8w,
            i64w,
            encodings: None,
        }
    }
}

#[derive(Clone, Debug)]
pub struct WrapperList {
    pub(crate) inner: Vec<u64>,
    pub encodings: Option<WrapperListEncoding>,
}

impl WrapperList {
    pub fn get(&self) -> &Vec<u64> {
        &self.inner
    }

    pub fn new(inner: Vec<u64>) -> Self {
        Self {
            inner,
            encodings: None,
        }
    }
}

impl From<Vec<u64>> for WrapperList {
    fn from(inner: Vec<u64>) -> Self {
        WrapperList::new(inner)
    }
}

impl From<WrapperList> for Vec<u64> {
    fn from(wrapper: WrapperList) -> Self {
        wrapper.inner
    }
}

#[derive(Clone, Debug)]
pub struct WrapperTable {
    pub(crate) inner: OrderedHashMap<u64, u64>,
    pub encodings: Option<WrapperTableEncoding>,
}

impl WrapperTable {
    pub fn get(&self) -> &OrderedHashMap<u64, u64> {
        &self.inner
    }

    pub fn new(inner: OrderedHashMap<u64, u64>) -> Self {
        Self {
            inner,
            encodings: None,
        }
    }
}

impl From<OrderedHashMap<u64, u64>> for WrapperTable {
    fn from(inner: OrderedHashMap<u64, u64>) -> Self {
        WrapperTable::new(inner)
    }
}

impl From<WrapperTable> for OrderedHashMap<u64, u64> {
    fn from(wrapper: WrapperTable) -> Self {
        wrapper.inner
    }
}

impl From<TopLevelNegRange> for i64 {
    fn from(wrapper: TopLevelNegRange) -> Self {
        wrapper.inner
    }
}

impl From<TopLevelPosRange> for u64 {
    fn from(wrapper: TopLevelPosRange) -> Self {
