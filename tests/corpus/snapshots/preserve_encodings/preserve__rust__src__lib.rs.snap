#[derive(Clone, Debug)]
pub struct String1632 {
    pub inner: String,
    pub encodings: Option<String1632Encoding>,
}

impl String1632 {
    pub fn new(inner: String) -> Result<Self, DeserializeError> {
        if inner.len() < 16 || inner.len() > 32 {
            return Err(DeserializeError::new(
                "String1632",
                DeserializeFailure::RangeCheck {
                    found: inner.len() as isize,
                    min: Some(16),
                    max: Some(32),
                },
            ));
        }
        Ok(Self {
            inner,
            encodings: None,
        })
    }
}

impl TryFrom<String> for String1632 {
    type Error = DeserializeError;

    fn try_from(inner: String) -> Result<Self, Self::Error> {
        String1632::new(inner)
    }
}

#[derive(Clone, Debug)]
pub struct String64 {
    pub inner: String,
    pub encodings: Option<String64Encoding>,
}

impl String64 {
    pub fn new(inner: String) -> Result<Self, DeserializeError> {
        if inner.len() > 64 {
            return Err(DeserializeError::new(
                "String64",
                DeserializeFailure::RangeCheck {
                    found: inner.len() as isize,
                    min: Some(0),
                    max: Some(64),
                },
            ));
        }
        Ok(Self {
            inner,
            encodings: None,
        })
    }
}

impl TryFrom<String> for String64 {
    type Error = DeserializeError;

    fn try_from(inner: String) -> Result<Self, Self::Error> {
        String64::new(inner)
    }
}

