            uint,
            uint_encoding: None,
        }
    }

    pub fn new_n64(n64: u64) -> Self {
        Self::N64 {
            n64,
            n64_encoding: None,
        }
    }

    pub fn new_text(text: String) -> Self {
        Self::Text {
            text,
            text_encoding: StringEncoding::default(),
        }
    }
}

#[derive(Clone, Debug)]
pub enum OverlapBasicEmbed {
    Identity {
        identity_encoding: Option<cbor_event::Sz>,
        len_encoding: LenEncoding,
    },
    X {
        hash: Vec<u8>,
        len_encoding: LenEncoding,
        tag_encoding: Option<cbor_event::Sz>,
        hash_encoding: StringEncoding,
    },
}

impl OverlapBasicEmbed {
    pub fn new_identity() -> Self {
        Self::Identity {
            identity_encoding: None,
            len_encoding: LenEncoding::default(),
        }
    }

    pub fn new_x(hash: Vec<u8>) -> Result<Self, DeserializeError> {
        if hash.len() < 32 || hash.len() > 32 {
            return Err(DeserializeFailure::RangeCheck {
                found: hash.len() as isize,
                min: Some(32),
                max: Some(32),
            }
            .into());
        }
        Ok(Self::X {
            hash,
            len_encoding: LenEncoding::default(),
            tag_encoding: None,
            hash_encoding: StringEncoding::default(),
        })
    }
}

#[derive(Clone, Debug)]
pub enum OverlappingInlined {
    One {
        one_encoding: Option<cbor_event::Sz>,
        len_encoding: LenEncoding,
    },
    Two {
        index_1: u64,
        len_encoding: LenEncoding,
        index_0_encoding: Option<cbor_event::Sz>,
        index_1_encoding: Option<cbor_event::Sz>,
    },
    Three(Three),
}

impl OverlappingInlined {
    pub fn new_one() -> Self {
        Self::One {
            one_encoding: None,
            len_encoding: LenEncoding::default(),
        }
    }

    pub fn new_two(index_1: u64) -> Self {
        Self::Two {
            index_1,
            len_encoding: LenEncoding::default(),
            index_0_encoding: None,
            index_1_encoding: None,
        }
    }

    pub fn new_three(index_1: u64, index_2: String) -> Self {
        Self::Three(Three::new(index_1, index_2))
    }
}

