        Self::U64 {
            uint,
            uint_encoding: None,
        }
    }

    pub fn new_text(text: String) -> Self {
        Self::Text {
            text,
            text_encoding: StringEncoding::default(),
        }
    }

    pub fn new_arr_u64(arr_u64: Vec<u64>) -> Self {
        Self::ArrU64 {
            arr_u64,
