#[derive(Clone, Debug)]
pub struct Bounds {
    pub w: i64,
    pub x: u64,
    pub y: u64,
    pub z: String,
    pub a: Vec<u64>,
    pub b: OrderedHashMap<u64, u64>,
    pub encodings: Option<BoundsEncoding>,
}

impl Bounds {
    pub fn new(
        w: i64,
        x: u64,
        y: u64,
        z: String,
        a: Vec<u64>,
        b: OrderedHashMap<u64, u64>,
    ) -> Result<Self, DeserializeError> {
        if w < -1000 || w > 1000 {
            return Err(DeserializeFailure::RangeCheck {
                found: w as isize,
                min: Some(-1000),
                max: Some(1000),
            }
            .into());
        }
        if x > 7 {
            return Err(DeserializeFailure::RangeCheck {
                found: x as isize,
                min: None,
                max: Some(7),
            }
            .into());
        }
        if y < 4 {
            return Err(DeserializeFailure::RangeCheck {
                found: y as isize,
                min: Some(4),
                max: None,
            }
            .into());
        }
        if z.len() < 3 || z.len() > 14 {
            return Err(DeserializeFailure::RangeCheck {
                found: z.len() as isize,
                min: Some(3),
                max: Some(14),
            }
            .into());
        }
        if a.len() < 1 || a.len() > 3 {
            return Err(DeserializeFailure::RangeCheck {
                found: a.len() as isize,
                min: Some(1),
                max: Some(3),
            }
            .into());
        }
        if b.len() > 3 {
            return Err(DeserializeFailure::RangeCheck {
                found: b.len() as isize,
                min: None,
                max: Some(3),
            }
            .into());
        }
        Ok(Self {
            w,
            x,
            y,
            z,
            a,
            b,
            encodings: None,
        })
    }
}

