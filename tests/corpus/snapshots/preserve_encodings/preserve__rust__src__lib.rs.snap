        arr_u64_encoding: LenEncoding,
        arr_u64_elem_encodings: Vec<Option<cbor_event::Sz>>,
    },
}

impl TypeChoice {
    pub fn new_i0() -> Self {
        Self::I0 { i0_encoding: None }
    }

