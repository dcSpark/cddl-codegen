use cbor_event::de::Deserializer;
use cbor_event::se::{Serialize, Serializer};
use std::io::{BufRead, Seek, SeekFrom, Write};

impl cbor_event::se::Serialize for OptHolder {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(
                    1 + match &self.f {
                        Some(x) => 1,
                        None => 0,
                    },
                ),
        )?;
        serializer.write_unsigned_integer_sz(
            self.x,
            fit_sz(
                self.x,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.x_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        if let Some(field) = &self.f {
            serializer.write_array_sz(
                self.encodings
                    .as_ref()
                    .map(|encs| encs.f_encoding)
                    .unwrap_or_default()
                    .to_len_sz(field.len() as u64),
            )?;
            for (i, element) in field.iter().enumerate() {
                let f_elem_encoding = self
                    .encodings
                    .as_ref()
                    .and_then(|encs| encs.f_elem_encodings.get(i))
                    .cloned()
                    .unwrap_or_default();
                serializer
                    .write_unsigned_integer_sz(*element, fit_sz(*element, f_elem_encoding))?;
            }
            self.encodings
                .as_ref()
                .map(|encs| encs.f_encoding)
                .unwrap_or_default()
                .end(serializer)?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for OptHolder {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let len = raw.array_sz()?;
        let len_encoding: LenEncoding = len.into();
        let mut read_len = CBORReadLen::new(len);
        read_len.read_elems(1)?;
        (|| -> Result<_, DeserializeError> {
            let (x, x_encoding) = raw
                .unsigned_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(x, enc)| (x, Some(enc)))
                .map_err(|e: DeserializeError| e.annotate("x"))?;
            let (f, f_encoding, f_elem_encodings) = if raw
                .cbor_type()
                .map(|ty| ty == cbor_event::Type::Array)
                .unwrap_or(false)
            {
                (|| -> Result<_, DeserializeError> {
                    read_len.read_elems(1)?;
                    let mut f_arr = Vec::new();
                    let len = raw.array_sz()?;
                    let f_encoding = len.into();
                    let mut f_elem_encodings = Vec::new();
                    while match len {
                        cbor_event::LenSz::Len(n, _) => (f_arr.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if let cbor_event::LenSz::Indefinite = len {
                            if raw.cbor_type()? == cbor_event::Type::Special
                                && raw.special_break()?
                            {
                                break;
                            }
                        }
                        let (f_elem, f_elem_encoding) =
                            raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                        f_arr.push(f_elem);
                        f_elem_encodings.push(f_elem_encoding);
                    }
                    Ok((f_arr, f_encoding, f_elem_encodings))
                })()
                .map_err(|e| e.annotate("f"))
                .map(|(f, f_encoding, f_elem_encodings)| (Some(f), f_encoding, f_elem_encodings))
            } else {
                Ok((None, LenEncoding::default(), Vec::new()))
            }?;
            match len {
                cbor_event::LenSz::Len(_, _) => read_len.finish()?,
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => read_len.finish()?,
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(OptHolder {
                x,
                f,
                encodings: Some(OptHolderEncoding {
                    len_encoding,
                    x_encoding,
                    f_encoding,
                    f_elem_encodings,
                }),
            })
        })()
        .map_err(|e| e.annotate("OptHolder"))
    }
