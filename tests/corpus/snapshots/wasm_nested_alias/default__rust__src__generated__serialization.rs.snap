            read_len.read_elems(1)?;
            let x = Ok(raw.unsigned_integer()?).map_err(|e: DeserializeError| e.annotate("x"))?;
            let f = if raw
                .cbor_type()
                .map(|ty| ty == cbor_event::Type::Array)
                .unwrap_or(false)
            {
                (|| -> Result<_, DeserializeError> {
                    read_len.read_elems(1)?;
                    let mut f_arr = Vec::new();
                    let len = raw.array()?;
                    while match len {
                        cbor_event::Len::Len(n) => (f_arr.len() as u64) < n,
                        cbor_event::Len::Indefinite => true,
                    } {
                        if matches!(len, cbor_event::Len::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        f_arr.push(raw.unsigned_integer()?);
                    }
                    Ok(f_arr)
                })()
                .map_err(|e| e.annotate("f"))
                .map(Some)
            } else {
                Ok(None)
            }?;
            match len {
                cbor_event::Len::Len(_) => read_len.finish()?,
                cbor_event::Len::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => read_len.finish()?,
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(OptHolder { x, f })
        })()
        .map_err(|e| e.annotate("OptHolder"))
