impl cbor_event::se::Serialize for OptHolder {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array(cbor_event::Len::Len(
            1 + match &self.f {
                Some(x) => 1,
                None => 0,
            },
        ))?;
        serializer.write_unsigned_integer(self.x)?;
        if let Some(field) = &self.f {
            serializer.write_array(cbor_event::Len::Len(field.len() as u64))?;
            for element in field.iter() {
                serializer.write_unsigned_integer(*element)?;
            }
        }
        Ok(serializer)
    }
}

impl Deserialize for OptHolder {
