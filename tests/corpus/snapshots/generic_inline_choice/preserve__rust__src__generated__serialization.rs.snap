impl cbor_event::se::Serialize for NestedUint {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(3),
        )?;
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.values_encoding)
                .unwrap_or_default()
                .to_len_sz(self.values.len() as u64),
        )?;
        for (i, element) in self.values.iter().enumerate() {
            let values_elem_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.values_elem_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer
                .write_unsigned_integer_sz(*element, fit_sz(*element, values_elem_encoding))?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.values_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        serializer.write_map_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.lookup_encoding)
                .unwrap_or_default()
                .to_len_sz(self.lookup.len() as u64),
        )?;
        for (key, value) in self.lookup.iter() {
            let lookup_key_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.lookup_key_encodings.get(key))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*key, fit_sz(*key, lookup_key_encoding))?;
            let lookup_value_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.lookup_value_encodings.get(key))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*value, fit_sz(*value, lookup_value_encoding))?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.lookup_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        match &self.maybe {
            Some(x) => {
                serializer.write_unsigned_integer_sz(
                    *x,
                    fit_sz(
                        *x,
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.maybe_encoding)
                            .unwrap_or_default(),
                    ),
                )?;
            }
            None => {
                serializer.write_special(cbor_event::Special::Null)?;
            }
        };
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
