                    let mut lookup_table = OrderedHashMap::new();
                    let lookup_len = raw.map_sz()?;
                    let lookup_encoding = lookup_len.into();
                    let mut lookup_key_encodings = BTreeMap::new();
                    let mut lookup_value_encodings = BTreeMap::new();
                    while match lookup_len {
                        cbor_event::LenSz::Len(n, _) => (lookup_table.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(lookup_len, cbor_event::LenSz::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        let (lookup_key, lookup_key_encoding) =
                            raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                        let (lookup_value, lookup_value_encoding) =
                            raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                        if lookup_table.insert(lookup_key, lookup_value).is_some() {
                            return Err(
                                DeserializeFailure::DuplicateKey(Key::Uint(lookup_key)).into()
                            );
