pub struct WitU64OrTextOrBytes(pub RefCell<cddl_lib::U64OrTextOrBytes>);

impl wit_types::GuestU64OrTextOrBytes for WitU64OrTextOrBytes {
    fn new_u64_or_text(u64_or_text: wit_types::U64OrTextBorrow<'_>) -> wit_types::U64OrTextOrBytes {
        let u64_or_text = u64_or_text.get::<WitU64OrText>().0.borrow().clone();
        let inner = cddl_lib::U64OrTextOrBytes::new_u64_or_text(u64_or_text);
        wit_types::U64OrTextOrBytes::new(WitU64OrTextOrBytes(RefCell::new(inner)))
    }

    fn as_u64_or_text(&self) -> Option<wit_types::U64OrText> {
        let me = self.0.borrow();
        match &*me {
            cddl_lib::U64OrTextOrBytes::U64OrText(u64_or_text) => Some(wit_types::U64OrText::new(
                WitU64OrText(RefCell::new(u64_or_text.clone())),
            )),
            _ => None,
        }
    }

    fn new_bytes(bytes: Vec<u8>) -> wit_types::U64OrTextOrBytes {
        let bytes = bytes.into_iter().collect();
        let inner = cddl_lib::U64OrTextOrBytes::new_bytes(bytes);
        wit_types::U64OrTextOrBytes::new(WitU64OrTextOrBytes(RefCell::new(inner)))
    }

    fn as_bytes(&self) -> Option<Vec<u8>> {
        let me = self.0.borrow();
        match &*me {
            cddl_lib::U64OrTextOrBytes::Bytes(bytes) => Some(bytes.iter().map(|x| *x).collect()),
            _ => None,
        }
    }

    fn kind(&self) -> wit_types::U64OrTextOrBytesKind {
        let me = self.0.borrow();
        match &*me {
            cddl_lib::U64OrTextOrBytes::U64OrText(_) => wit_types::U64OrTextOrBytesKind::U64OrText,
            cddl_lib::U64OrTextOrBytes::Bytes(_) => wit_types::U64OrTextOrBytesKind::Bytes,
        }
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::U64OrTextOrBytes as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::U64OrTextOrBytes, String> {
        <cddl_lib::U64OrTextOrBytes as cddl_lib::serialization::Deserialize>::from_cbor_bytes(
            &bytes,
        )
        .map(|v| wit_types::U64OrTextOrBytes::new(WitU64OrTextOrBytes(RefCell::new(v))))
        .map_err(err)
    }
}
