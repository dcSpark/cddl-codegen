        let value = value.get::<WitLeafU64>().0.borrow().clone();
        let inner = cddl_lib::MidU64::new(value);
        WitMidU64(RefCell::new(inner))
    }

    fn value(&self) -> wit_types::LeafU64 {
        let me = self.0.borrow();
        wit_types::LeafU64::new(WitLeafU64(RefCell::new(me.value.clone())))
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::MidU64 as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(&self.0.borrow())
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::MidU64, String> {
        <cddl_lib::MidU64 as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::MidU64::new(WitMidU64(RefCell::new(v))))
            .map_err(err)
    }
}

pub struct WitNestedChoiceUint(pub RefCell<cddl_lib::NestedChoiceUint>);

impl wit_types::GuestNestedChoiceUint for WitNestedChoiceUint {
    fn new(value: wit_types::U64OrTextOrBytesBorrow<'_>) -> Self {
        let value = value.get::<WitU64OrTextOrBytes>().0.borrow().clone();
        let inner = cddl_lib::NestedChoiceUint::new(value);
        WitNestedChoiceUint(RefCell::new(inner))
    }

    fn value(&self) -> wit_types::U64OrTextOrBytes {
        let me = self.0.borrow();
        wit_types::U64OrTextOrBytes::new(WitU64OrTextOrBytes(RefCell::new(me.value.clone())))
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::NestedChoiceUint as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::NestedChoiceUint, String> {
