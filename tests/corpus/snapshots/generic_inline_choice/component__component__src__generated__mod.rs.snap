pub struct WitNestedUint(pub RefCell<cddl_lib::NestedUint>);

impl wit_types::GuestNestedUint for WitNestedUint {
    fn new(values: Vec<u64>, lookup: Vec<(u64, u64)>, maybe: Option<u64>) -> Self {
        let values = values.into_iter().collect::<Vec<_>>();
        let lookup = lookup.into_iter().collect();
        let inner = cddl_lib::NestedUint::new(values, lookup, maybe);
        WitNestedUint(RefCell::new(inner))
    }

    fn values(&self) -> Vec<u64> {
        let me = self.0.borrow();
        me.values.iter().map(|x| *x).collect()
    }

    fn lookup(&self) -> Vec<(u64, u64)> {
        let me = self.0.borrow();
        me.lookup.iter().map(|(x0, x1)| (*x0, *x1)).collect()
    }

    fn maybe(&self) -> Option<u64> {
        let me = self.0.borrow();
        me.maybe.as_ref().map(|x| *x)
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::NestedUint as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::NestedUint, String> {
        <cddl_lib::NestedUint as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::NestedUint::new(WitNestedUint(RefCell::new(v))))
            .map_err(err)
    }
}

pub struct WitU64OrBytes(pub RefCell<cddl_lib::U64OrBytes>);

impl wit_types::GuestU64OrBytes for WitU64OrBytes {
    fn new_p(p: u64) -> wit_types::U64OrBytes {
        let inner = cddl_lib::U64OrBytes::new_p(p);
        wit_types::U64OrBytes::new(WitU64OrBytes(RefCell::new(inner)))
    }

    fn as_p(&self) -> Option<u64> {
        let me = self.0.borrow();
        match &*me {
            cddl_lib::U64OrBytes::P(p) => Some(*p),
            _ => None,
        }
    }

    fn new_bytes(bytes: Vec<u8>) -> wit_types::U64OrBytes {
        let bytes = bytes.into_iter().collect();
        let inner = cddl_lib::U64OrBytes::new_bytes(bytes);
        wit_types::U64OrBytes::new(WitU64OrBytes(RefCell::new(inner)))
    }

    fn as_bytes(&self) -> Option<Vec<u8>> {
        let me = self.0.borrow();
        match &*me {
            cddl_lib::U64OrBytes::Bytes(bytes) => Some(bytes.iter().map(|x| *x).collect()),
            _ => None,
        }
    }

    fn kind(&self) -> wit_types::U64OrBytesKind {
        let me = self.0.borrow();
        match &*me {
            cddl_lib::U64OrBytes::P(_) => wit_types::U64OrBytesKind::P,
            cddl_lib::U64OrBytes::Bytes(_) => wit_types::U64OrBytesKind::Bytes,
        }
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::U64OrBytes as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::U64OrBytes, String> {
        <cddl_lib::U64OrBytes as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::U64OrBytes::new(WitU64OrBytes(RefCell::new(v))))
            .map_err(err)
    }
}

