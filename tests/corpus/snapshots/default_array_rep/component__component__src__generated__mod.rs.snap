// This file was code-generated using an experimental CDDL to rust tool:
// https://github.com/dcSpark/cddl-codegen

use core::cell::RefCell;

wit_bindgen::generate!({
    path: "wit",
    world: "cddl-lib-world",
});

use exports::cddl::cddl_lib::types as wit_types;

struct Component;

impl wit_types::Guest for Component {
    type ArrayDefault = WitArrayDefault;
    type ArrayDefaultText = WitArrayDefaultText;
}

export!(Component);

/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitArrayDefault(pub RefCell<cddl_lib::ArrayDefault>);

impl wit_types::GuestArrayDefault for WitArrayDefault {
    fn new(a: u64) -> Self {
        let inner = cddl_lib::ArrayDefault::new(a);
        WitArrayDefault(RefCell::new(inner))
    }

    fn a(&self) -> u64 {
        let me = self.0.borrow();
        me.a
    }

    fn b(&self) -> Option<u64> {
        let me = self.0.borrow();
        me.b.as_ref().map(|x| *x)
    }

    fn set_b(&self, b: u64) {
        self.0.borrow_mut().b = Some(b);
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::ArrayDefault as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::ArrayDefault, String> {
        <cddl_lib::ArrayDefault as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::ArrayDefault::new(WitArrayDefault(RefCell::new(v))))
            .map_err(err)
    }
}

pub struct WitArrayDefaultText(pub RefCell<cddl_lib::ArrayDefaultText>);

impl wit_types::GuestArrayDefaultText for WitArrayDefaultText {
    fn new(a: u64) -> Self {
        let inner = cddl_lib::ArrayDefaultText::new(a);
        WitArrayDefaultText(RefCell::new(inner))
    }

    fn a(&self) -> u64 {
        let me = self.0.borrow();
        me.a
    }

    fn s(&self) -> Option<String> {
        let me = self.0.borrow();
        me.s.as_ref().map(|x| x.clone())
    }

    fn set_s(&self, s: String) {
        self.0.borrow_mut().s = Some(s);
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::ArrayDefaultText as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::ArrayDefaultText, String> {
        <cddl_lib::ArrayDefaultText as cddl_lib::serialization::Deserialize>::from_cbor_bytes(
            &bytes,
        )
        .map(|v| wit_types::ArrayDefaultText::new(WitArrayDefaultText(RefCell::new(v))))
        .map_err(err)
    }
}
