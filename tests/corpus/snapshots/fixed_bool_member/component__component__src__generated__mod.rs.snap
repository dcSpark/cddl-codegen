/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitArrMember(pub RefCell<cddl_lib::ArrMember>);

impl wit_types::GuestArrMember for WitArrMember {
    fn new(x: u64) -> Self {
        let inner = cddl_lib::ArrMember::new(x);
        WitArrMember(RefCell::new(inner))
    }

    fn x(&self) -> u64 {
        let me = self.0.borrow();
        me.x
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::ArrMember as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::ArrMember, String> {
        <cddl_lib::ArrMember as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::ArrMember::new(WitArrMember(RefCell::new(v))))
            .map_err(err)
    }
}

