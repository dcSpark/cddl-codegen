impl cbor_event::se::Serialize for FixedMiddle {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(2 + self.rest.len() as u64),
        )?;
        serializer.write_unsigned_integer_sz(
            self.index_0,
            fit_sz(
                self.index_0,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.index_0_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        for (i, element) in self.rest.iter().enumerate() {
            let rest_elem_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.rest_elem_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            match element {
                Repeat::I0 => {
                    serializer.write_unsigned_integer_sz(0u64, fit_sz(0u64, rest_elem_encoding))
                }
                Repeat::I1 => {
                    serializer.write_unsigned_integer_sz(1u64, fit_sz(1u64, rest_elem_encoding))
                }
            }?;
        }
        match &self.suffix {
            Suffix::I2 => serializer.write_unsigned_integer_sz(
                2u64,
                fit_sz(
                    2u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.suffix_encoding)
                        .unwrap_or_default(),
                ),
            ),
            Suffix::I3 => serializer.write_unsigned_integer_sz(
                3u64,
                fit_sz(
                    3u64,
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.suffix_encoding)
                        .unwrap_or_default(),
                ),
            ),
        }?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

