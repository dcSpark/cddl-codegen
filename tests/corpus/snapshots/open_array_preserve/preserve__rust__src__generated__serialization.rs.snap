                let deser_variant = (|raw: &mut Deserializer| -> Result<_, DeserializeError> {
                    let (i3_value, i3_encoding) = raw.unsigned_integer_sz()?;
                    if i3_value != 3 {
                        return Err(DeserializeFailure::FixedValueMismatch {
                            found: Key::Uint(i3_value),
                            expected: Key::Uint(3),
                        }
                        .into());
                    }
                    Ok(Some(i3_encoding))
                })(raw);
                match deser_variant {
                    Ok(suffix_encoding) => return Ok((Suffix::I3, suffix_encoding)),
                    Err(_) => raw.set_position(initial_position).unwrap(),
                };
                Err(DeserializeError::new(
                    "Suffix",
                    DeserializeFailure::NoVariantMatched,
                ))
            })()
            .map_err(|e| e.annotate("suffix"))?;
            match len {
                cbor_event::LenSz::Len(_, _) => read_len.finish()?,
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => read_len.finish()?,
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(FixedMiddle {
                index_0,
                rest,
                suffix,
                encodings: Some(FixedMiddleEncoding {
                    rest_elem_encodings,
                    len_encoding,
                    index_0_encoding,
                    suffix_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("FixedMiddle"))
    }
}

impl cbor_event::se::Serialize for Inner {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(1 + self.rest.len() as u64),
        )?;
        serializer.write_unsigned_integer_sz(
            self.index_0,
            fit_sz(
                self.index_0,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.index_0_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        for (i, element) in self.rest.iter().enumerate() {
            let rest_elem_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.rest_elem_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*element, fit_sz(*element, rest_elem_encoding))?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for Inner {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.array_sz()?;
            let len_encoding: LenEncoding = len.into();
            let mut read_len = CBORReadLen::new(len);
            read_len.read_elems(1)?;
            let (index_0, index_0_encoding) = raw
                .unsigned_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(x, enc)| (x, Some(enc)))
                .map_err(|e: DeserializeError| e.annotate("index_0"))?;
            let mut rest = Vec::new();
            let mut rest_elem_encodings = Vec::new();
            while match len {
                cbor_event::LenSz::Len(n, _) => read_len.read() < n,
                cbor_event::LenSz::Indefinite => raw.as_slice().first() != Some(&0xff),
            } {
                read_len.read_elems(1)?;
                let (rest_elem, rest_elem_encoding) =
                    raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                rest.push(rest_elem);
                rest_elem_encodings.push(rest_elem_encoding);
            }
            match len {
                cbor_event::LenSz::Len(_, _) => read_len.finish()?,
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => read_len.finish()?,
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(Inner {
                index_0,
                rest,
                encodings: Some(InnerEncoding {
                    rest_elem_encodings,
                    len_encoding,
                    index_0_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("Inner"))
    }
}

impl cbor_event::se::Serialize for Middle {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(2 + self.rest.len() as u64),
        )?;
        serializer.write_unsigned_integer_sz(
            self.index_0,
            fit_sz(
                self.index_0,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.index_0_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        for (i, element) in self.rest.iter().enumerate() {
            let rest_elem_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.rest_elem_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*element, fit_sz(*element, rest_elem_encoding))?;
        }
        serializer.write_text_sz(
            &self.index_2,
            self.encodings
                .as_ref()
                .map(|encs| encs.index_2_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(self.index_2.len() as u64),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for Middle {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.array_sz()?;
            let len_encoding: LenEncoding = len.into();
            let mut read_len = CBORReadLen::new(len);
            read_len.read_elems(2)?;
            let (index_0, index_0_encoding) = raw
                .unsigned_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(x, enc)| (x, Some(enc)))
                .map_err(|e: DeserializeError| e.annotate("index_0"))?;
            let mut rest = Vec::new();
            let mut rest_elem_encodings = Vec::new();
            while (match len {
                cbor_event::LenSz::Len(n, _) => read_len.read() < n,
                cbor_event::LenSz::Indefinite => raw.as_slice().first() != Some(&0xff),
            }) && raw.cbor_type()? == cbor_event::Type::UnsignedInteger
            {
                read_len.read_elems(1)?;
                let (rest_elem, rest_elem_encoding) =
                    raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                rest.push(rest_elem);
                rest_elem_encodings.push(rest_elem_encoding);
            }
            let (index_2, index_2_encoding) = raw
                .text_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(s, enc)| (s, StringEncoding::from(enc)))
                .map_err(|e: DeserializeError| e.annotate("index_2"))?;
            match len {
                cbor_event::LenSz::Len(_, _) => read_len.finish()?,
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => read_len.finish()?,
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(Middle {
                index_0,
                rest,
                index_2,
                encodings: Some(MiddleEncoding {
                    rest_elem_encodings,
                    len_encoding,
                    index_0_encoding,
                    index_2_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("Middle"))
    }
}

impl cbor_event::se::Serialize for Outer {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(2),
        )?;
        self.inner.serialize(serializer)?;
        serializer.write_unsigned_integer_sz(
            self.index_1,
            fit_sz(
                self.index_1,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.index_1_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for Outer {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.array_sz()?;
            let len_encoding: LenEncoding = len.into();
            let mut read_len = CBORReadLen::new(len);
            read_len.read_elems(2)?;
            read_len.finish()?;
            let inner =
                Inner::deserialize(raw).map_err(|e: DeserializeError| e.annotate("inner"))?;
            let (index_1, index_1_encoding) = raw
                .unsigned_integer_sz()
                .map_err(Into::<DeserializeError>::into)
                .map(|(x, enc)| (x, Some(enc)))
                .map_err(|e: DeserializeError| e.annotate("index_1"))?;
            match len {
                cbor_event::LenSz::Len(_, _) => (),
                cbor_event::LenSz::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(Outer {
                inner,
                index_1,
                encodings: Some(OuterEncoding {
                    len_encoding,
                    index_1_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("Outer"))
    }
}

