use cbor_event::de::Deserializer;
use cbor_event::se::{Serialize, Serializer};

impl cbor_event::se::Serialize for ProtocolMagic {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_unsigned_integer_sz(
            self.inner,
            fit_sz(
                self.inner,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.inner_encoding)
                    .unwrap_or_default(),
            ),
        )
    }
}

impl Deserialize for ProtocolMagic {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let (inner, inner_encoding) =
                raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
            Ok(Self {
                inner,
                encodings: Some(ProtocolMagicEncoding { inner_encoding }),
            })
        })()
        .map_err(|e| e.annotate("ProtocolMagic"))
    }
}
