use super::cbor_encodings::*;
use super::*;
use crate::error::*;
use cbor_event::de::Deserializer;
use cbor_event::se::{Serialize, Serializer};
use std::io::{BufRead, Seek, SeekFrom, Write};

impl cbor_event::se::Serialize for ProtocolMagic {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_unsigned_integer_sz(
            self.inner,
            fit_sz(
                self.inner,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.inner_encoding)
                    .unwrap_or_default(),
            ),
        )
    }
}

impl Deserialize for ProtocolMagic {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let (inner, inner_encoding) = raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
        Ok(Self {
            inner,
            encodings: Some(ProtocolMagicEncoding { inner_encoding }),
        })
    }
}
