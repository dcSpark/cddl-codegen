#[derive(Clone, Debug)]
pub struct TaggedDefault {
    pub inner: u64,
    pub encodings: Option<TaggedDefaultEncoding>,
}

impl TaggedDefault {
    pub fn new(inner: u64) -> Self {
        Self {
            inner,
            encodings: None,
        }
    }
}

impl From<u64> for TaggedDefault {
    fn from(inner: u64) -> Self {
        TaggedDefault::new(inner)
    }
}

impl From<TaggedDefault> for u64 {
    fn from(wrapper: TaggedDefault) -> Self {
        wrapper.inner
    }
}
