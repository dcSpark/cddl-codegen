    }

    fn d(&self) -> u64 {
        let me = self.0.borrow();
        me.d
    }

    fn e(&self) -> u64 {
        let me = self.0.borrow();
        me.e
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::ComparisonControls as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::ComparisonControls, String> {
        <cddl_lib::ComparisonControls as cddl_lib::serialization::Deserialize>::from_cbor_bytes(
            &bytes,
        )
        .map(|v| wit_types::ComparisonControls::new(WitComparisonControls(RefCell::new(v))))
        .map_err(err)
    }
