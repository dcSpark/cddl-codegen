/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitComparisonControls(pub RefCell<cddl_lib::ComparisonControls>);

impl wit_types::GuestComparisonControls for WitComparisonControls {
    fn new(a: u64, b: u64, c: u64, d: u64, e: u64) -> Result<Self, String> {
        let inner = cddl_lib::ComparisonControls::new(a, b, c, d, e).map_err(err)?;
        Ok(WitComparisonControls(RefCell::new(inner)))
    }

    fn a(&self) -> u64 {
        let me = self.0.borrow();
        me.a
    }

    fn b(&self) -> u64 {
        let me = self.0.borrow();
        me.b
    }

    fn c(&self) -> u64 {
        let me = self.0.borrow();
