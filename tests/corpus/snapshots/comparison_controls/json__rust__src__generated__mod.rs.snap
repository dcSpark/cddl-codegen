            .into());
        }
        if c > 9 {
            return Err(DeserializeFailure::RangeCheck {
                found: c as i128,
                min: None,
                max: Some(9),
            }
            .into());
        }
        if d < 1 {
            return Err(DeserializeFailure::RangeCheck {
                found: d as i128,
                min: Some(1),
                max: None,
            }
            .into());
        }
        Ok(Self { a, b, c, d, e })
