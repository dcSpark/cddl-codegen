// This file was code-generated using an experimental CDDL to rust tool:
// https://github.com/dcSpark/cddl-codegen

use core::cell::RefCell;

wit_bindgen::generate!({
    path: "wit",
    world: "cddl-lib-world",
});

use exports::cddl::cddl_lib::types as wit_types;

struct Component;

impl wit_types::Guest for Component {
    type WrappedNonempty = WitWrappedNonempty;
    type WrappedNonemptyMap = WitWrappedNonemptyMap;
}

export!(Component);

/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitWrappedNonempty(pub RefCell<cddl_lib::WrappedNonempty>);

impl wit_types::GuestWrappedNonempty for WitWrappedNonempty {
    fn new(inner: Vec<u64>) -> Result<Self, String> {
        let inner: Vec<_> = inner.into_iter().collect();
        let inner = cddl_lib::WrappedNonempty::new(inner.try_into().map_err(err)?);
        Ok(WitWrappedNonempty(RefCell::new(inner)))
    }

    fn get(&self) -> Vec<u64> {
        let me = self.0.borrow();
        let inner = me.get().clone();
        inner.iter().map(|x| *x).collect()
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::WrappedNonempty as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::WrappedNonempty, String> {
        <cddl_lib::WrappedNonempty as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::WrappedNonempty::new(WitWrappedNonempty(RefCell::new(v))))
            .map_err(err)
    }
}

pub struct WitWrappedNonemptyMap(pub RefCell<cddl_lib::WrappedNonemptyMap>);

impl wit_types::GuestWrappedNonemptyMap for WitWrappedNonemptyMap {
    fn new(inner: Vec<(String, u64)>) -> Result<Self, String> {
        let inner: Vec<_> = inner.into_iter().collect();
        let inner = cddl_lib::WrappedNonemptyMap::new(inner.try_into().map_err(err)?);
        Ok(WitWrappedNonemptyMap(RefCell::new(inner)))
    }

    fn get(&self) -> Vec<(String, u64)> {
        let me = self.0.borrow();
        let inner = me.get().clone();
        inner.iter().map(|(x0, x1)| (x0.clone(), *x1)).collect()
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::WrappedNonemptyMap as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::WrappedNonemptyMap, String> {
        <cddl_lib::WrappedNonemptyMap as cddl_lib::serialization::Deserialize>::from_cbor_bytes(
            &bytes,
        )
        .map(|v| wit_types::WrappedNonemptyMap::new(WitWrappedNonemptyMap(RefCell::new(v))))
        .map_err(err)
    }
