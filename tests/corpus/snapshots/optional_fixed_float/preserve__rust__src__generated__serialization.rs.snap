impl cbor_event::se::Serialize for OptFixedFloatArray {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(2 + if self.f { 1 } else { 0 }),
        )?;
        serializer.write_unsigned_integer_sz(
            self.x,
            fit_sz(
                self.x,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.x_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        if self.f {
            write_float(
                serializer,
                2.5,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.f_encoding)
                    .unwrap_or_default(),
            )?;
        }
        serializer.write_text_sz(
            &self.label,
            self.encodings
                .as_ref()
                .map(|encs| encs.label_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(self.label.len() as u64),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

