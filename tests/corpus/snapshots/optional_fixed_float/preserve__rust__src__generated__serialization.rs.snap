            .map(|encs| encs.orig_deser_order.clone())
            .unwrap_or_else(|| (0..3).collect());
        for field_index in deser_order {
            match field_index {
                0 => {
                    serializer.write_text_sz(
                        "x",
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.x_key_encoding.clone())
                            .unwrap_or_default()
                            .to_str_len_sz("x".len() as u64),
                    )?;
                    serializer.write_unsigned_integer_sz(
                        self.x,
                        fit_sz(
                            self.x,
                            self.encodings
                                .as_ref()
                                .map(|encs| encs.x_encoding)
                                .unwrap_or_default(),
                        ),
                    )?;
                }
                2 => {
                    if self.rate {
                        serializer.write_text_sz(
                            "rate",
                            self.encodings
                                .as_ref()
                                .map(|encs| encs.rate_key_encoding.clone())
                                .unwrap_or_default()
                                .to_str_len_sz("rate".len() as u64),
                        )?;
                        write_float(
                            serializer,
                            2.5,
                            self.encodings
                                .as_ref()
                                .map(|encs| encs.rate_encoding)
                                .unwrap_or_default(),
                        )?;
                    }
                }
                1 => {
                    if self.amount {
                        serializer.write_text_sz(
                            "amount",
                            self.encodings
                                .as_ref()
                                .map(|encs| encs.amount_key_encoding.clone())
                                .unwrap_or_default()
                                .to_str_len_sz("amount".len() as u64),
                        )?;
                        write_float(
                            serializer,
                            1.5,
                            self.encodings
                                .as_ref()
                                .map(|encs| encs.amount_encoding)
                                .unwrap_or_default(),
