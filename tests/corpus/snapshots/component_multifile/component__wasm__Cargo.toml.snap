[dependencies]
cddl-lib = { path = "../rust", features = ["wasm"] }
cbor_event = { git = "https://github.com/dcSpark/cbor_event", rev = "28514916e97240e1d2b01ba8f804d45c221fbdcd" }
wasm-bindgen = "0.2"
