// This file was code-generated using an experimental CDDL to rust tool:
// https://github.com/dcSpark/cddl-codegen

use core::cell::RefCell;

wit_bindgen::generate!({
    path: "wit",
    world: "cddl-lib-world",
});

use exports::cddl::cddl_lib::types as wit_types;

struct Component;

impl wit_types::Guest for Component {
    type QuotedMapKey = WitQuotedMapKey;
}

export!(Component);

/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitQuotedMapKey(pub RefCell<cddl_lib::QuotedMapKey>);

impl wit_types::GuestQuotedMapKey for WitQuotedMapKey {
    fn new(a: u64, b: String) -> Self {
        let inner = cddl_lib::QuotedMapKey::new(a, b);
        WitQuotedMapKey(RefCell::new(inner))
    }

    fn a(&self) -> u64 {
        let me = self.0.borrow();
        me.a
    }

    fn b(&self) -> String {
        let me = self.0.borrow();
        me.b.clone()
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::QuotedMapKey as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::QuotedMapKey, String> {
        <cddl_lib::QuotedMapKey as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::QuotedMapKey::new(WitQuotedMapKey(RefCell::new(v))))
            .map_err(err)
    }
}
