impl cbor_event::se::Serialize for EnumKeyHolder {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(2),
        )?;
        serializer.write_map_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.choice_keyed_encoding)
                .unwrap_or_default()
                .to_len_sz(self.choice_keyed.len() as u64),
        )?;
        for (key, value) in self.choice_keyed.iter() {
            key.serialize(serializer)?;
            let choice_keyed_value_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.choice_keyed_value_encodings.get(key))
                .cloned()
                .unwrap_or_default();
            serializer.write_text_sz(
                value,
                choice_keyed_value_encoding.to_str_len_sz(value.len() as u64),
            )?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.choice_keyed_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        serializer.write_map_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.int_keyed_encoding)
                .unwrap_or_default()
                .to_len_sz(self.int_keyed.len() as u64),
        )?;
        for (key, value) in self.int_keyed.iter() {
            key.serialize(serializer)?;
            let int_keyed_value_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.int_keyed_value_encodings.get(key))
                .cloned()
                .unwrap_or_default();
            serializer.write_text_sz(
                value,
                int_keyed_value_encoding.to_str_len_sz(value.len() as u64),
            )?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.int_keyed_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for EnumKeyHolder {
