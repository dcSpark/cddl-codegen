                (|| -> Result<_, DeserializeError> {
                    let mut choice_keyed_table = OrderedHashMap::new();
                    let choice_keyed_len = raw.map_sz()?;
                    let choice_keyed_encoding = choice_keyed_len.into();
                    let mut choice_keyed_value_encodings = BTreeMap::new();
                    while match choice_keyed_len {
                        cbor_event::LenSz::Len(n, _) => (choice_keyed_table.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(choice_keyed_len, cbor_event::LenSz::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        let choice_keyed_key = Ikey::deserialize(raw)?;
                        let (choice_keyed_value, choice_keyed_value_encoding) = raw
                            .text_sz()
                            .map(|(s, enc)| (s, StringEncoding::from(enc)))?;
                        if choice_keyed_table
                            .insert(choice_keyed_key.clone(), choice_keyed_value)
                            .is_some()
                        {
                            return Err(DeserializeFailure::DuplicateKey(Key::Str(String::from(
                                "some complicated/unsupported type",
                            )))
                            .into());
                        }
                        choice_keyed_value_encodings
                            .insert(choice_keyed_key.clone(), choice_keyed_value_encoding);
                    }
                    Ok((
                        choice_keyed_table,
                        choice_keyed_encoding,
                        choice_keyed_value_encodings,
                    ))
                })()
                .map_err(|e| e.annotate("choice_keyed"))?;
            let (int_keyed, int_keyed_encoding, int_keyed_value_encodings) =
                (|| -> Result<_, DeserializeError> {
                    let mut int_keyed_table = OrderedHashMap::new();
                    let int_keyed_len = raw.map_sz()?;
                    let int_keyed_encoding = int_keyed_len.into();
                    let mut int_keyed_value_encodings = BTreeMap::new();
                    while match int_keyed_len {
                        cbor_event::LenSz::Len(n, _) => (int_keyed_table.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(int_keyed_len, cbor_event::LenSz::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
