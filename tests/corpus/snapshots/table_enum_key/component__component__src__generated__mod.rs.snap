// This file was code-generated using an experimental CDDL to rust tool:
// https://github.com/dcSpark/cddl-codegen

use core::cell::RefCell;

wit_bindgen::generate!({
    path: "wit",
    world: "cddl-lib-world",
});

use exports::cddl::cddl_lib::types as wit_types;

struct Component;

impl wit_types::Guest for Component {
    type EnumKeyHolder = WitEnumKeyHolder;
    type Ikey = WitIkey;
}

export!(Component);

/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

fn int_to_wit_types(v: &cddl_lib::Int) -> wit_types::Int {
    match v {
        cddl_lib::Int::Uint(value) => wit_types::Int::Uint(*value),
        cddl_lib::Int::Nint(value) => wit_types::Int::Nint(*value),
    }
}

fn int_from_wit_types(v: wit_types::Int) -> cddl_lib::Int {
    match v {
        wit_types::Int::Uint(value) => cddl_lib::Int::new_uint(value),
        wit_types::Int::Nint(value) => cddl_lib::Int::new_nint(value),
    }
}

pub struct WitEnumKeyHolder(pub RefCell<cddl_lib::EnumKeyHolder>);

impl wit_types::GuestEnumKeyHolder for WitEnumKeyHolder {
    fn new(
        choice_keyed: Vec<(wit_types::IkeyBorrow<'_>, String)>,
        int_keyed: Vec<(wit_types::Int, String)>,
    ) -> Self {
        let choice_keyed = choice_keyed
            .into_iter()
            .map(|(x0, x1)| (x0.get::<WitIkey>().0.borrow().clone(), x1))
            .collect();
        let int_keyed = int_keyed
            .into_iter()
            .map(|(x0, x1)| (int_from_wit_types(x0), x1))
            .collect();
        let inner = cddl_lib::EnumKeyHolder::new(choice_keyed, int_keyed);
        WitEnumKeyHolder(RefCell::new(inner))
    }

    fn choice_keyed(&self) -> Vec<(wit_types::Ikey, String)> {
        let me = self.0.borrow();
        me.choice_keyed
            .iter()
            .map(|(x0, x1)| {
                (
                    wit_types::Ikey::new(WitIkey(RefCell::new(x0.clone()))),
                    x1.clone(),
                )
            })
            .collect()
    }

    fn int_keyed(&self) -> Vec<(wit_types::Int, String)> {
        let me = self.0.borrow();
        me.int_keyed
            .iter()
            .map(|(x0, x1)| (int_to_wit_types(x0), x1.clone()))
            .collect()
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::EnumKeyHolder as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::EnumKeyHolder, String> {
        <cddl_lib::EnumKeyHolder as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::EnumKeyHolder::new(WitEnumKeyHolder(RefCell::new(v))))
            .map_err(err)
    }
}

pub struct WitIkey(pub RefCell<cddl_lib::Ikey>);

impl wit_types::GuestIkey for WitIkey {
    fn new_uint(uint: u64) -> wit_types::Ikey {
        let inner = cddl_lib::Ikey::new_uint(uint);
        wit_types::Ikey::new(WitIkey(RefCell::new(inner)))
    }

    fn as_uint(&self) -> Option<u64> {
        let me = self.0.borrow();
        match &*me {
            cddl_lib::Ikey::U64(uint) => Some(*uint),
            _ => None,
        }
    }

    fn new_n64(n64: u64) -> wit_types::Ikey {
        let inner = cddl_lib::Ikey::new_n64(n64);
        wit_types::Ikey::new(WitIkey(RefCell::new(inner)))
    }

    fn as_n64(&self) -> Option<u64> {
        let me = self.0.borrow();
        match &*me {
            cddl_lib::Ikey::N64(n64) => Some(*n64),
            _ => None,
        }
    }

    fn kind(&self) -> wit_types::IkeyKind {
        let me = self.0.borrow();
        match &*me {
            cddl_lib::Ikey::U64(_) => wit_types::IkeyKind::Uint,
            cddl_lib::Ikey::N64(_) => wit_types::IkeyKind::N64,
        }
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::Ikey as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(&self.0.borrow())
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::Ikey, String> {
        <cddl_lib::Ikey as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::Ikey::new(WitIkey(RefCell::new(v))))
            .map_err(err)
    }
}
