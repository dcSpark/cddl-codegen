impl cbor_event::se::Serialize for EnumKeyHolder {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array(cbor_event::Len::Len(2))?;
        serializer.write_map(cbor_event::Len::Len(self.choice_keyed.len() as u64))?;
        for (key, value) in self.choice_keyed.iter() {
            key.serialize(serializer)?;
            serializer.write_text(&value)?;
        }
        serializer.write_map(cbor_event::Len::Len(self.int_keyed.len() as u64))?;
        for (key, value) in self.int_keyed.iter() {
            key.serialize(serializer)?;
            serializer.write_text(&value)?;
        }
        Ok(serializer)
    }
}

impl Deserialize for EnumKeyHolder {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let len = raw.array()?;
        let mut read_len = CBORReadLen::from(len);
        read_len.read_elems(2)?;
        read_len.finish()?;
        (|| -> Result<_, DeserializeError> {
            let choice_keyed = (|| -> Result<_, DeserializeError> {
                let mut choice_keyed_table = BTreeMap::new();
                let choice_keyed_len = raw.map()?;
                while match choice_keyed_len {
                    cbor_event::Len::Len(n) => (choice_keyed_table.len() as u64) < n,
                    cbor_event::Len::Indefinite => true,
                } {
                    if let cbor_event::Len::Indefinite = choice_keyed_len {
                        if raw.cbor_type()? == cbor_event::Type::Special && raw.special_break()? {
                            break;
                        }
                    }
                    let choice_keyed_key = Ikey::deserialize(raw)?;
                    let choice_keyed_value = raw.text()? as String;
                    if choice_keyed_table
                        .insert(choice_keyed_key.clone(), choice_keyed_value)
                        .is_some()
                    {
                        return Err(DeserializeFailure::DuplicateKey(Key::Str(String::from(
                            "some complicated/unsupported type",
                        )))
                        .into());
                    }
                }
                Ok(choice_keyed_table)
            })()
            .map_err(|e| e.annotate("choice_keyed"))?;
            let int_keyed = (|| -> Result<_, DeserializeError> {
                let mut int_keyed_table = BTreeMap::new();
                let int_keyed_len = raw.map()?;
                while match int_keyed_len {
                    cbor_event::Len::Len(n) => (int_keyed_table.len() as u64) < n,
                    cbor_event::Len::Indefinite => true,
                } {
                    if let cbor_event::Len::Indefinite = int_keyed_len {
                        if raw.cbor_type()? == cbor_event::Type::Special && raw.special_break()? {
                            break;
                        }
                    }
                    let int_keyed_key = Int::deserialize(raw)?;
                    let int_keyed_value = raw.text()? as String;
                    if int_keyed_table
                        .insert(int_keyed_key.clone(), int_keyed_value)
                        .is_some()
                    {
                        return Err(DeserializeFailure::DuplicateKey(Key::Str(String::from(
                            "some complicated/unsupported type",
                        )))
                        .into());
                    }
                }
                Ok(int_keyed_table)
            })()
            .map_err(|e| e.annotate("int_keyed"))?;
            match len {
                cbor_event::Len::Len(_) => (),
                cbor_event::Len::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(EnumKeyHolder {
                choice_keyed,
                int_keyed,
            })
        })()
        .map_err(|e| e.annotate("EnumKeyHolder"))
    }
}

impl cbor_event::se::Serialize for Ikey {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        match self {
            Ikey::U64(uint) => serializer.write_unsigned_integer(*uint),
            Ikey::N64(n64) => serializer
                .write_negative_integer_sz(-(*n64 as i128 + 1), cbor_event::Sz::canonical(*n64)),
        }
    }
}

impl Deserialize for Ikey {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            match raw.cbor_type()? {
                cbor_event::Type::UnsignedInteger => Ok(Ikey::U64(raw.unsigned_integer()? as u64)),
                cbor_event::Type::NegativeInteger => Ok(Ikey::N64(
                    raw.negative_integer_sz()
                        .map(|(x, _enc)| (x + 1).abs() as u64)?,
                )),
                _ => Err(DeserializeError::new(
                    "Ikey",
                    DeserializeFailure::NoVariantMatched,
                )),
            }
        })()
        .map_err(|e| e.annotate("Ikey"))
    }
}

impl cbor_event::se::Serialize for Int {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        match self {
            Self::Uint(x) => serializer.write_unsigned_integer(*x),
            Self::Nint(x) => serializer
                .write_negative_integer_sz(-((*x as i128) + 1), cbor_event::Sz::canonical(*x)),
        }
    }
}

impl Deserialize for Int {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            match raw.cbor_type()? {
                cbor_event::Type::UnsignedInteger => Ok(Self::Uint(raw.unsigned_integer()?)),
                cbor_event::Type::NegativeInteger => Ok(Self::Nint(
                    (-1 - raw.negative_integer_sz().map(|(x, _enc)| x)?) as u64,
                )),
                _ => Err(DeserializeFailure::NoVariantMatched.into()),
            }
        })()
        .map_err(|e| e.annotate("Int"))
    }
