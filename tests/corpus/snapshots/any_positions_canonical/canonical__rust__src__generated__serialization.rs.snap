impl Serialize for Tagged {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
        force_canonical: bool,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_tag_sz(
            11u64,
            fit_sz(
                11u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.inner_tag_encoding)
                    .unwrap_or_default(),
                force_canonical,
            ),
        )?;
        self.inner.serialize(serializer, force_canonical)
    }
}

impl Deserialize for Tagged {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let (inner, inner_tag_encoding) = match raw.tag_sz()? {
                (11, tag_enc) => (
                    crate::generated::any_cbor::AnyCbor::deserialize(raw)?,
                    Some(tag_enc),
                ),
                (tag, _enc) => {
                    return Err(DeserializeFailure::TagMismatch {
                        found: tag,
                        expected: 11,
                    }
                    .into());
                }
            };
            Ok(Self {
                inner,
                encodings: Some(TaggedEncoding { inner_tag_encoding }),
            })
        })()
        .map_err(|e| e.annotate("Tagged"))
    }
}
