impl cbor_event::se::Serialize for Holder {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array(cbor_event::Len::Len(1))?;
        let mut payload_inner_se = Serializer::new_vec();
        payload_inner_se.write_map(cbor_event::Len::Len(self.payload.len() as u64))?;
        for (key, value) in self.payload.iter() {
            key.serialize(&mut payload_inner_se)?;
            payload_inner_se.write_unsigned_integer(*value)?;
        }
        let payload_bytes = payload_inner_se.finalize();
        serializer.write_bytes(&payload_bytes)?;
        Ok(serializer)
    }
}

