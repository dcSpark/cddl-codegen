                let payload_len = inner_de.map()?;
                while match payload_len {
                    cbor_event::Len::Len(n) => (payload_table.len() as u64) < n,
                    cbor_event::Len::Indefinite => true,
                } {
                    if matches!(payload_len, cbor_event::Len::Indefinite)
                        && inner_de.cbor_type()? == cbor_event::Type::Special
                        && inner_de.special_break()?
