                        let payload_key = PreludeBignint::deserialize(inner_de)?;
                        let (payload_value, payload_value_encoding) = inner_de
                            .unsigned_integer_sz()
                            .map(|(x, enc)| (x, Some(enc)))?;
                        if payload_table
                            .insert(payload_key.clone(), payload_value)
                            .is_some()
                        {
                            return Err(DeserializeFailure::DuplicateKey(Key::Str(String::from(
                                "some complicated/unsupported type",
