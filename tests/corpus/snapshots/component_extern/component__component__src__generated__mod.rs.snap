/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitExt(pub RefCell<cddl_lib::Ext>);

impl wit_types::GuestExt for WitExt {
