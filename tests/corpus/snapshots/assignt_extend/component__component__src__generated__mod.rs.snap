        let inner = cddl_lib::ExtFirst::new_text(text);
        wit_types::ExtFirst::new(WitExtFirst(RefCell::new(inner)))
    }

    fn as_text(&self) -> Option<String> {
        let me = self.0.borrow();
        match &*me {
            cddl_lib::ExtFirst::Text(text) => Some(text.clone()),
            _ => None,
        }
    }

    fn new_uint(uint: u64) -> wit_types::ExtFirst {
        let inner = cddl_lib::ExtFirst::new_uint(uint);
        wit_types::ExtFirst::new(WitExtFirst(RefCell::new(inner)))
    }

    fn as_uint(&self) -> Option<u64> {
        let me = self.0.borrow();
        match &*me {
            cddl_lib::ExtFirst::U64(uint) => Some(*uint),
            _ => None,
        }
    }

    fn kind(&self) -> wit_types::ExtFirstKind {
        let me = self.0.borrow();
        match &*me {
            cddl_lib::ExtFirst::Text(_) => wit_types::ExtFirstKind::Text,
            cddl_lib::ExtFirst::U64(_) => wit_types::ExtFirstKind::Uint,
        }
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::ExtFirst as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::ExtFirst, String> {
        <cddl_lib::ExtFirst as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::ExtFirst::new(WitExtFirst(RefCell::new(v))))
            .map_err(err)
    }
}

pub struct WitExtended(pub RefCell<cddl_lib::Extended>);

impl wit_types::GuestExtended for WitExtended {
