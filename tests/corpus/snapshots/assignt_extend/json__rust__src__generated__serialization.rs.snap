use super::*;
use crate::generated::error::*;
use cbor_event::de::Deserializer;
use cbor_event::se::{Serialize, Serializer};

impl cbor_event::se::Serialize for Extended {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        match self {
            Extended::U64(uint) => serializer.write_unsigned_integer(*uint),
            Extended::Words(words) => serializer.write_text(words),
            Extended::Bytes(bytes) => serializer.write_bytes(bytes),
        }
    }
}

impl Deserialize for Extended {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            match raw.cbor_type()? {
                cbor_event::Type::UnsignedInteger => Ok(Extended::U64(raw.unsigned_integer()?)),
                cbor_event::Type::Text => Ok(Extended::Words(raw.text()?)),
                cbor_event::Type::Bytes => Ok(Extended::Bytes(raw.bytes()?)),
                _ => Err(DeserializeFailure::NoVariantMatched.into()),
            }
        })()
        .map_err(|e| e.annotate("Extended"))
    }
}
