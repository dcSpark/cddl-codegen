    fn b(&self) -> String {
        let me = self.0.borrow();
        me.b.clone()
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::Plain as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(&self.0.borrow())
