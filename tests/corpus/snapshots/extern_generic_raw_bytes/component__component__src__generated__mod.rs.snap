// This file was code-generated using an experimental CDDL to rust tool:
// https://github.com/dcSpark/cddl-codegen

use core::cell::RefCell;

wit_bindgen::generate!({
    path: "wit",
    world: "cddl-lib-world",
});

use exports::cddl::cddl_lib::types as wit_types;

struct Component;

impl wit_types::Guest for Component {
    type ExtSetPlain = WitExtSetPlain;
    type ExtSetPubKey = WitExtSetPubKey;
    type Plain = WitPlain;
    type PubKey = WitPubKey;
    type UsingFlavored = WitUsingFlavored;
}

export!(Component);

/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitExtSetPlain(pub RefCell<cddl_lib::ExtSetPlain>);

impl wit_types::GuestExtSetPlain for WitExtSetPlain {
    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::ExtSetPlain as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::ExtSetPlain, String> {
        <cddl_lib::ExtSetPlain as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::ExtSetPlain::new(WitExtSetPlain(RefCell::new(v))))
            .map_err(err)
    }
}

