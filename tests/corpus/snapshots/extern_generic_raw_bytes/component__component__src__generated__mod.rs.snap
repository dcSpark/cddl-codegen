pub struct WitPlain(pub RefCell<cddl_lib::Plain>);

impl wit_types::GuestPlain for WitPlain {
    fn new(a: u64, b: String) -> Self {
        let inner = cddl_lib::Plain::new(a, b);
        WitPlain(RefCell::new(inner))
    }

    fn a(&self) -> u64 {
        let me = self.0.borrow();
        me.a
