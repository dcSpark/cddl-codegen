pub struct WitUsingFlavored(pub RefCell<cddl_lib::UsingFlavored>);

impl wit_types::GuestUsingFlavored for WitUsingFlavored {
    fn new(
        keys: wit_types::ExtSetPubKeyBorrow<'_>,
        plains: wit_types::ExtSetPlainBorrow<'_>,
    ) -> Self {
        let keys = keys.get::<WitExtSetPubKey>().0.borrow().clone();
        let plains = plains.get::<WitExtSetPlain>().0.borrow().clone();
        let inner = cddl_lib::UsingFlavored::new(keys, plains);
        WitUsingFlavored(RefCell::new(inner))
