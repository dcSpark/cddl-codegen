    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::UsingFlavored as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::UsingFlavored, String> {
        <cddl_lib::UsingFlavored as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::UsingFlavored::new(WitUsingFlavored(RefCell::new(v))))
            .map_err(err)
