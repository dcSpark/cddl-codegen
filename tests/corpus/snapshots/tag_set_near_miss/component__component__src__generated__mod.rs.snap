    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::SetNonEmptyU64, String> {
        <cddl_lib::SetNonEmptyU64 as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
