    fn as_arr_u64(&self) -> Option<wit_types::SetNonEmptyU64> {
        let me = self.0.borrow();
        match &*me {
            cddl_lib::NearMiss::ArrU64(arr_u64) => Some(wit_types::SetNonEmptyU64::new(
                WitSetNonEmptyU64(RefCell::new(arr_u64.clone())),
            )),
            _ => None,
        }
    }

    fn new_arr_u642(arr_u642: Vec<u64>) -> wit_types::NearMiss {
        let arr_u642 = arr_u642.into_iter().collect::<Vec<_>>();
        let inner = cddl_lib::NearMiss::new_arr_u642(arr_u642);
        wit_types::NearMiss::new(WitNearMiss(RefCell::new(inner)))
    }

    fn as_arr_u642(&self) -> Option<Vec<u64>> {
        let me = self.0.borrow();
        match &*me {
            cddl_lib::NearMiss::ArrU642(arr_u642) => Some(arr_u642.iter().map(|x| *x).collect()),
            _ => None,
        }
    }

    fn kind(&self) -> wit_types::NearMissKind {
        let me = self.0.borrow();
        match &*me {
            cddl_lib::NearMiss::ArrU64(_) => wit_types::NearMissKind::ArrU64,
            cddl_lib::NearMiss::ArrU642(_) => wit_types::NearMissKind::ArrU642,
        }
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::NearMiss as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::NearMiss, String> {
        <cddl_lib::NearMiss as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::NearMiss::new(WitNearMiss(RefCell::new(v))))
            .map_err(err)
    }
}

pub struct WitSetNonEmptyU64(pub RefCell<cddl_lib::SetNonEmptyU64>);

impl wit_types::GuestSetNonEmptyU64 for WitSetNonEmptyU64 {
    fn new(inner: Vec<u64>) -> Result<Self, String> {
        let inner = (inner.into_iter().collect::<Vec<_>>())
            .try_into()
