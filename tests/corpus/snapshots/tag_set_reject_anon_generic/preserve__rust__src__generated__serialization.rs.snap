            let g_elem_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.g_elem_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*element, fit_sz(*element, g_elem_encoding))?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.g_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
