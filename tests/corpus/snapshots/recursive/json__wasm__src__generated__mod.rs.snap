        serde_json::from_str(json)
            .map(Self)
            .map_err(|e| JsError::new(&format!("from_json: {}", e)))
    }

    pub fn value(&self) -> u64 {
        self.0.value
    }

    pub fn children(&self) -> TreeList {
        self.0.children.clone().into()
    }

    pub fn new(value: u64, children: &TreeList) -> Self {
        Self(cddl_lib::Tree::new(value, children.clone().into()))
    }
}

impl From<cddl_lib::Tree> for Tree {
    fn from(native: cddl_lib::Tree) -> Self {
        Self(native)
    }
}

impl From<Tree> for cddl_lib::Tree {
    fn from(wasm: Tree) -> Self {
        wasm.0
    }
}

impl AsRef<cddl_lib::Tree> for Tree {
    fn as_ref(&self) -> &cddl_lib::Tree {
        &self.0
    }
}

#[derive(Clone, Debug)]
#[wasm_bindgen]
pub struct TreeList(Vec<cddl_lib::Tree>);

#[wasm_bindgen]
