                let mut children_arr = Vec::new();
                let len = raw.array_sz()?;
                let children_encoding = len.into();
                while match len {
                    cbor_event::LenSz::Len(n, _) => (children_arr.len() as u64) < n,
                    cbor_event::LenSz::Indefinite => true,
                } {
                    if matches!(len, cbor_event::LenSz::Indefinite)
