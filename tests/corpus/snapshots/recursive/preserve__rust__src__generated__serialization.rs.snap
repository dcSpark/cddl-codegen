impl cbor_event::se::Serialize for Tree {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(2),
        )?;
        serializer.write_unsigned_integer_sz(
            self.value,
            fit_sz(
                self.value,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.value_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_array_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.children_encoding)
                .unwrap_or_default()
                .to_len_sz(self.children.len() as u64),
        )?;
        for element in self.children.iter() {
            element.serialize(serializer)?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.children_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

