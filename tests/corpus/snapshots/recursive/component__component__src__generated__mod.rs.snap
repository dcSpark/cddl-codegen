// This file was code-generated using an experimental CDDL to rust tool:
// https://github.com/dcSpark/cddl-codegen

use core::cell::RefCell;

wit_bindgen::generate!({
    path: "wit",
    world: "cddl-lib-world",
});

use exports::cddl::cddl_lib::types as wit_types;

struct Component;

impl wit_types::Guest for Component {
    type Tree = WitTree;
}

export!(Component);

/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitTree(pub RefCell<cddl_lib::Tree>);

impl wit_types::GuestTree for WitTree {
    fn new(value: u64, children: Vec<wit_types::TreeBorrow<'_>>) -> Self {
        let children = children
            .into_iter()
            .map(|x| x.get::<WitTree>().0.borrow().clone())
            .collect();
        let inner = cddl_lib::Tree::new(value, children);
        WitTree(RefCell::new(inner))
    }

    fn value(&self) -> u64 {
        let me = self.0.borrow();
        me.value
    }

    fn children(&self) -> Vec<wit_types::Tree> {
        let me = self.0.borrow();
        me.children
            .iter()
            .map(|x| wit_types::Tree::new(WitTree(RefCell::new(x.clone()))))
            .collect()
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::Tree as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(&self.0.borrow())
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::Tree, String> {
        <cddl_lib::Tree as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::Tree::new(WitTree(RefCell::new(v))))
            .map_err(err)
    }
}
