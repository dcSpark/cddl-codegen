#[derive(Clone, Debug)]
pub struct Inner {
    pub a: u64,
    pub b: u64,
    pub encodings: Option<InnerEncoding>,
}

impl Inner {
    pub fn new(a: u64, b: u64) -> Self {
        Self {
            a,
            b,
            encodings: None,
        }
    }
}

#[derive(Clone, Debug)]
pub struct Outer {
    pub x: u64,
    pub inner: Inner,
    pub y: u64,
    pub encodings: Option<OuterEncoding>,
}

impl Outer {
    pub fn new(x: u64, inner: Inner, y: u64) -> Self {
        Self {
            x,
            inner,
            y,
            encodings: None,
        }
    }
}
