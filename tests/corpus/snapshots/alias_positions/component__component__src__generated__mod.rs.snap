    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::Credential, String> {
        <cddl_lib::Credential as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::Credential::new(WitCredential(RefCell::new(v))))
            .map_err(err)
    }
}

pub struct WitHolder(pub RefCell<cddl_lib::Holder>);

impl wit_types::GuestHolder for WitHolder {
    fn new(
