pub struct WitNested(pub RefCell<cddl_lib::Nested>);

impl wit_types::GuestNested for WitNested {
    fn new(
        arr: Vec<Vec<u8>>,
        opt: Option<Vec<u8>>,
        deep: Vec<(u64, Vec<(Vec<u8>, String)>)>,
    ) -> Self {
        let arr = arr
            .into_iter()
            .map(|x| x.into_iter().collect())
            .collect::<Vec<_>>();
        let opt = opt.map(|v| v.into_iter().collect());
        let deep = deep
            .into_iter()
            .map(|(x0, x1)| {
                (
                    x0,
                    x1.into_iter()
                        .map(|(x0, x1)| (x0.into_iter().collect(), x1))
                        .collect(),
                )
            })
            .collect();
        let inner = cddl_lib::Nested::new(arr, opt, deep);
        WitNested(RefCell::new(inner))
    }

    fn arr(&self) -> Vec<Vec<u8>> {
        let me = self.0.borrow();
        me.arr
            .iter()
            .map(|x| x.iter().map(|x| *x).collect())
            .collect()
    }

    fn opt(&self) -> Option<Vec<u8>> {
        let me = self.0.borrow();
        me.opt.as_ref().map(|x| x.iter().map(|x| *x).collect())
    }

    fn deep(&self) -> Vec<(u64, Vec<(Vec<u8>, String)>)> {
        let me = self.0.borrow();
        me.deep
            .iter()
            .map(|(x0, x1)| {
                (
                    *x0,
                    x1.iter()
                        .map(|(x0, x1)| (x0.iter().map(|x| *x).collect(), x1.clone()))
                        .collect(),
                )
            })
            .collect()
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::Nested as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(&self.0.borrow())
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::Nested, String> {
        <cddl_lib::Nested as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
