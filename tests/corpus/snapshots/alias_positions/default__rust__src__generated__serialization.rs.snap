        serializer.write_unsigned_integer(1u64)?;
        serializer.write_unsigned_integer(self.key_1)?;
        for (key, value) in self.rest.iter() {
            serializer.write_unsigned_integer(*key)?;
            serializer.write_map(cbor_event::Len::Len(value.len() as u64))?;
            for (key, value) in value.iter() {
                serializer.write_bytes(key)?;
                serializer.write_text(value)?;
            }
        }
        Ok(serializer)
    }
}

