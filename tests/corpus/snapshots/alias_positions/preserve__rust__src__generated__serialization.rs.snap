                    .unsigned_integer_sz()
                    .map(|(x, enc)| Self::Uint {
                        value: x,
                        encoding: Some(enc),
                    })
                    .map_err(core::convert::Into::into),
                cbor_event::Type::NegativeInteger => raw
                    .negative_integer_sz()
                    .map(|(x, enc)| Self::Nint {
                        value: (-1 - x) as u64,
                        encoding: Some(enc),
                    })
                    .map_err(core::convert::Into::into),
                _ => Err(DeserializeFailure::NoVariantMatched.into()),
            }
        })()
        .map_err(|e| e.annotate("Int"))
    }
}

impl cbor_event::se::Serialize for Keyed {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_map_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.len_encoding)
                .unwrap_or_default()
                .to_len_sz(1),
        )?;
        let deser_order = self
            .encodings
            .as_ref()
            .filter(|encs| encs.orig_deser_order.len() == 1)
            .map(|encs| encs.orig_deser_order.clone())
            .unwrap_or_else(|| (0..1).collect());
        for field_index in deser_order {
            match field_index {
                0 => {
                    serializer.write_unsigned_integer_sz(
                        1u64,
                        fit_sz(
                            1u64,
                            self.encodings
                                .as_ref()
                                .map(|encs| encs.key_1_key_encoding)
                                .unwrap_or_default(),
                        ),
                    )?;
                    serializer.write_map_sz(
                        self.encodings
                            .as_ref()
                            .map(|encs| encs.key_1_encoding)
                            .unwrap_or_default()
                            .to_len_sz(self.key_1.len() as u64),
                    )?;
                    for (key, value) in self.key_1.iter() {
                        let key_1_key_encoding = self
                            .encodings
                            .as_ref()
                            .and_then(|encs| encs.key_1_key_encodings.get(key))
                            .cloned()
                            .unwrap_or_default();
                        serializer
                            .write_unsigned_integer_sz(*key, fit_sz(*key, key_1_key_encoding))?;
                        let key_1_value_encoding = self
                            .encodings
                            .as_ref()
                            .and_then(|encs| encs.key_1_value_encodings.get(key))
                            .cloned()
                            .unwrap_or_default();
                        serializer.write_text_sz(
                            value,
                            key_1_value_encoding.to_str_len_sz(value.len() as u64),
                        )?;
                    }
                    self.encodings
                        .as_ref()
                        .map(|encs| encs.key_1_encoding)
                        .unwrap_or_default()
                        .end(serializer)?;
                }
                _ => unreachable!(),
            };
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
