            fit_sz(
                self.idx,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.idx_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_bytes_sz(
            &self.hash,
            self.encodings
                .as_ref()
                .map(|encs| encs.hash_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(self.hash.len() as u64),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
