                                while match key_1_len {
                                    cbor_event::LenSz::Len(n, _) => (key_1_table.len() as u64) < n,
                                    cbor_event::LenSz::Indefinite => true,
                                } {
                                    if matches!(key_1_len, cbor_event::LenSz::Indefinite)
                                        && raw.cbor_type()? == cbor_event::Type::Special
                                        && raw.special_break()?
                                    {
                                        break;
                                    }
                                    let (key_1_key, key_1_key_encoding) =
                                        raw.unsigned_integer_sz().map(|(x, enc)| (x, Some(enc)))?;
                                    let (key_1_value, key_1_value_encoding) = raw
                                        .text_sz()
                                        .map(|(s, enc)| (s, StringEncoding::from(enc)))?;
                                    if key_1_table.insert(key_1_key, key_1_value).is_some() {
                                        return Err(DeserializeFailure::DuplicateKey(Key::Str(
