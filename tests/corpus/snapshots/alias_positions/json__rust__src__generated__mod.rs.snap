fn open_holder_rest_flatten_serialize<S: serde::Serializer>(
    rest: &BTreeMap<Epoch, BTreeMap<PolicyId, Label>>,
    serializer: S,
) -> Result<S::Ok, S::Error> {
    crate::generated::open_struct_rest_json::serialize_flattened_rest(
        &["key_1"],
        |k: &u64| Ok::<String, core::convert::Infallible>(k.to_string()),
        rest.iter(),
        serializer,
    )
}

fn open_holder_rest_flatten_deserialize<'de, D: serde::Deserializer<'de>>(
    deserializer: D,
) -> Result<BTreeMap<Epoch, BTreeMap<PolicyId, Label>>, D::Error> {
    let pairs: Vec<(String, BTreeMap<PolicyId, Label>)> =
        crate::generated::open_struct_rest_json::read_flattened_rest_pairs(deserializer)?;
    pairs
        .into_iter()
        .map(|(ks, v)| {
            let k = ks.parse::<u64>().map_err(|_| {
                serde::de::Error::custom(format!(
                    "open struct-map rest key {ks:?} is not a valid uint"
                ))
            })?;
            OpenHolder::validate_rest_key(&k).map_err(serde::de::Error::custom)?;
            Ok((k, v))
        })
        .collect()
}

