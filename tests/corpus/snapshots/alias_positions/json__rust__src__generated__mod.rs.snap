#[derive(Clone, Debug, serde::Deserialize, serde::Serialize, schemars::JsonSchema)]
pub struct OpenHolder {
    pub key_1: u64,
    /// Captured open-map entries whose keys are not declared fields (CDDL `* k => v` rest row). Serialized after the declared fields; defaults empty. `@duplicates preserve` makes this a `PairMap` (duplicate keys kept, in wire order); otherwise the loose table container.
    #[serde(flatten)]
    #[serde(
        serialize_with = "open_holder_rest_flatten_serialize",
        deserialize_with = "open_holder_rest_flatten_deserialize"
    )]
    rest: BTreeMap<Epoch, BTreeMap<PolicyId, Label>>,
}

impl OpenHolder {
    pub fn new(key_1: u64) -> Self {
        Self {
            key_1,
            rest: BTreeMap::new(),
        }
    }

    fn validate_rest_key(key: &Epoch) -> Result<(), crate::generated::error::DeserializeError> {
        if *key == 1 {
            return Err(crate::generated::error::DeserializeFailure::DuplicateKey(
                crate::generated::error::Key::Uint(1),
            )
            .into());
        }
        Ok(())
    }

    pub fn rest(&self) -> &BTreeMap<Epoch, BTreeMap<PolicyId, Label>> {
        &self.rest
    }

    pub fn insert_rest(
        &mut self,
        entry_key: Epoch,
        value: BTreeMap<PolicyId, Label>,
    ) -> Result<(), crate::generated::error::DeserializeError> {
        Self::validate_rest_key(&entry_key)?;
        let mut candidate = self.rest.clone();
        candidate.insert(entry_key, value);
        self.rest = candidate;
        Ok(())
    }
}

