            .map(Self)
            .map_err(|e| JsError::new(&format!("from_bytes: {}", e)))
    }

    pub fn new_ea() -> Self {
        Self(cddl_lib::EnumOptEmbedFields::new_ea())
    }

    pub fn new_eb(index_1: Option<String>) -> Self {
        Self(cddl_lib::EnumOptEmbedFields::new_eb(index_1))
    }

    pub fn new_ec(index_1: u64) -> Self {
        Self(cddl_lib::EnumOptEmbedFields::new_ec(index_1))
    }

    pub fn new_ed(index_1: u64) -> Self {
        Self(cddl_lib::EnumOptEmbedFields::new_ed(index_1))
    }

    pub fn new_ee(index_1: u64, index_3: u64) -> Self {
        Self(cddl_lib::EnumOptEmbedFields::new_ee(index_1, index_3))
    }

    pub fn new_ef(non_overlapping_type_choice_some: Option<NonOverlappingTypeChoiceSome>) -> Self {
        Self(cddl_lib::EnumOptEmbedFields::new_ef(
            non_overlapping_type_choice_some.map(Into::into),
        ))
    }

    pub fn new_eg(overlapping_inlined: Option<OverlappingInlined>) -> Self {
        Self(cddl_lib::EnumOptEmbedFields::new_eg(
            overlapping_inlined.map(Into::into),
        ))
    }

    pub fn kind(&self) -> EnumOptEmbedFieldsKind {
        match &self.0 {
            cddl_lib::EnumOptEmbedFields::Ea => EnumOptEmbedFieldsKind::Ea,
            cddl_lib::EnumOptEmbedFields::Eb(_) => EnumOptEmbedFieldsKind::Eb,
            cddl_lib::EnumOptEmbedFields::Ec(_) => EnumOptEmbedFieldsKind::Ec,
            cddl_lib::EnumOptEmbedFields::Ed(_) => EnumOptEmbedFieldsKind::Ed,
            cddl_lib::EnumOptEmbedFields::Ee(_) => EnumOptEmbedFieldsKind::Ee,
            cddl_lib::EnumOptEmbedFields::Ef(_) => EnumOptEmbedFieldsKind::Ef,
            cddl_lib::EnumOptEmbedFields::Eg(_) => EnumOptEmbedFieldsKind::Eg,
        }
    }

    /// Returns None if not Eb variant OR it is but it's set to None
    /// This is to get around wasm_bindgen not supporting Option<Option<T>>
    pub fn as_eb(&self) -> Option<String> {
        match &self.0 {
            cddl_lib::EnumOptEmbedFields::Eb(index_1) => index_1.clone(),
            _ => None,
        }
    }

    pub fn as_ec(&self) -> Option<u64> {
        match &self.0 {
            cddl_lib::EnumOptEmbedFields::Ec(index_1) => Some(*index_1),
            _ => None,
        }
    }

    pub fn as_ed(&self) -> Option<Ed> {
        match &self.0 {
            cddl_lib::EnumOptEmbedFields::Ed(ed) => Some(ed.clone().into()),
            _ => None,
        }
    }

    pub fn as_ee(&self) -> Option<Ee> {
        match &self.0 {
            cddl_lib::EnumOptEmbedFields::Ee(ee) => Some(ee.clone().into()),
            _ => None,
        }
    }

    /// Returns None if not Ef variant OR it is but it's set to None
    /// This is to get around wasm_bindgen not supporting Option<Option<T>>
    pub fn as_ef(&self) -> Option<NonOverlappingTypeChoiceSome> {
        match &self.0 {
            cddl_lib::EnumOptEmbedFields::Ef(non_overlapping_type_choice_some) => {
                non_overlapping_type_choice_some
                    .clone()
                    .map(std::convert::Into::into)
            }
            _ => None,
        }
    }

    /// Returns None if not Eg variant OR it is but it's set to None
    /// This is to get around wasm_bindgen not supporting Option<Option<T>>
    pub fn as_eg(&self) -> Option<OverlappingInlined> {
        match &self.0 {
            cddl_lib::EnumOptEmbedFields::Eg(overlapping_inlined) => {
                overlapping_inlined.clone().map(std::convert::Into::into)
            }
            _ => None,
        }
    }
}

