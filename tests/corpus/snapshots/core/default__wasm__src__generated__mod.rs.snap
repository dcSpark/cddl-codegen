/// `[* uint] @duplicates reject`: an insertion-ordered, duplicate-free set (order preserved for byte-exact round-trip). `add` is checked — an already-present element is refused; construct via `try_from` (the uniqueness door).
#[derive(Clone, Debug)]
#[wasm_bindgen]
pub struct U64OrderedSet(pub(crate) OrderedSet<u64>);

#[wasm_bindgen]
impl U64OrderedSet {
    pub fn new() -> Self {
        Self(OrderedSet::new())
    }

    pub fn len(&self) -> usize {
        self.0.len()
    }

    pub fn get(&self, index: usize) -> u64 {
        self.0[index]
    }

    pub fn add(&mut self, elem: u64) -> Result<(), JsError> {
        self.0.push(elem).map_err(|e| JsError::new(&e.to_string()))
    }

    pub fn try_from(elements: Vec<u64>) -> Result<U64OrderedSet, JsError> {
        OrderedSet::try_from(elements)
            .map(Self)
            .map_err(|e| JsError::new(&e.to_string()))
    }
}

impl From<OrderedSet<u64>> for U64OrderedSet {
    fn from(native: OrderedSet<u64>) -> Self {
        Self(native)
    }
}

impl From<U64OrderedSet> for OrderedSet<u64> {
    fn from(wasm: U64OrderedSet) -> Self {
        wasm.0
    }
}

impl AsRef<OrderedSet<u64>> for U64OrderedSet {
    fn as_ref(&self) -> &OrderedSet<u64> {
        &self.0
    }
}

