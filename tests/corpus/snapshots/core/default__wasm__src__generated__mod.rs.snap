/// struct documentation here
#[derive(Clone, Debug)]
#[wasm_bindgen]
pub struct Docs(pub(crate) cddl_lib::Docs);

#[wasm_bindgen]
impl Docs {
    pub fn to_cbor_bytes(&self) -> Vec<u8> {
        cddl_lib::serialization::ToCBORBytes::to_cbor_bytes(&self.0)
    }

    pub fn from_cbor_bytes(cbor_bytes: &[u8]) -> Result<Docs, JsError> {
        cddl_lib::serialization::Deserialize::from_cbor_bytes(cbor_bytes)
            .map(Self)
            .map_err(|e| JsError::new(&format!("from_bytes: {}", e)))
    }

    pub fn foo(&self) -> String {
        self.0.foo.clone()
    }

    pub fn bar(&self) -> u64 {
        self.0.bar
    }

    /// * `foo` - this is a field-level comment
    /// * `bar` - bar is a u64
    pub fn new(foo: String, bar: u64) -> Self {
        Self(cddl_lib::Docs::new(foo, bar))
    }
}

