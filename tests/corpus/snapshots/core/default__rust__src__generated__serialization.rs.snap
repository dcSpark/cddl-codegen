        raw: &mut Deserializer<R>,
        _read_len: &mut CBORReadLen,
        len: cbor_event::Len,
    ) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let d = (|| -> Result<_, DeserializeError> {
                match raw.tag()? {
                    23 => Ok(raw.unsigned_integer()? as u64),
                    tag => Err(DeserializeFailure::TagMismatch {
                        found: tag,
                        expected: 23,
                    }
                    .into()),
                }
            })()
            .map_err(|e| e.annotate("d"))?;
            let e = TaggedText::deserialize(raw).map_err(|e: DeserializeError| e.annotate("e"))?;
            Ok(Plain { d, e })
        })()
        .map_err(|e| e.annotate("Plain"))
    }
}

impl cbor_event::se::Serialize for PlainArrays {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array(cbor_event::Len::Len(4))?;
        self.embedded.serialize_as_embedded_group(serializer)?;
        self.single.serialize(serializer)?;
        serializer.write_array(cbor_event::Len::Len(2 * self.multi.len() as u64))?;
        for element in self.multi.iter() {
            element.serialize_as_embedded_group(serializer)?;
        }
        Ok(serializer)
    }
}

impl Deserialize for PlainArrays {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.array()?;
            let mut read_len = CBORReadLen::from(len);
            read_len.read_elems(4)?;
            read_len.finish()?;
            let embedded = Plain::deserialize_as_embedded_group(raw, &mut read_len, len)
                .map_err(|e: DeserializeError| e.annotate("embedded"))?;
            let single =
                Plain::deserialize(raw).map_err(|e: DeserializeError| e.annotate("single"))?;
            let multi = (|| -> Result<_, DeserializeError> {
                let mut multi_arr = Vec::new();
                let len = raw.array()?;
                let mut multi_read_len = CBORReadLen::from(len);
                while match len {
                    cbor_event::Len::Len(n) => multi_read_len.read() < n,
                    cbor_event::Len::Indefinite => true,
                } {
                    if let cbor_event::Len::Indefinite = len {
                        if raw.cbor_type()? == cbor_event::Type::Special && raw.special_break()? {
                            break;
                        }
                    }
                    multi_read_len.read_elems(2)?;
                    multi_arr.push(Plain::deserialize_as_embedded_group(
                        raw,
                        &mut multi_read_len,
                        len,
                    )?);
                }
                Ok(multi_arr)
            })()
            .map_err(|e| e.annotate("multi"))?;
            match len {
                cbor_event::Len::Len(_) => (),
                cbor_event::Len::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(PlainArrays {
                embedded,
                single,
                multi,
            })
        })()
        .map_err(|e| e.annotate("PlainArrays"))
    }
}

impl cbor_event::se::Serialize for Second {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array(cbor_event::Len::Len(2))?;
        self.serialize_as_embedded_group(serializer)
    }
}

impl SerializeEmbeddedGroup for Second {
    fn serialize_as_embedded_group<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_text(&self.y)?;
        serializer.write_unsigned_integer(self.z)?;
        Ok(serializer)
    }
}

impl Deserialize for Second {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let (len, mut read_len) = (|| -> Result<_, DeserializeError> {
            let len = raw.array()?;
            let mut read_len = CBORReadLen::from(len);
            read_len.read_elems(2)?;
            read_len.finish()?;
            Ok((len, read_len))
        })()
        .map_err(|e| e.annotate("Second"))?;
        let ret = Self::deserialize_as_embedded_group(raw, &mut read_len, len);
        (|| -> Result<_, DeserializeError> {
            match len {
                cbor_event::Len::Len(_) => (),
                cbor_event::Len::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(())
        })()
        .map_err(|e| e.annotate("Second"))?;
        ret
    }
}

impl DeserializeEmbeddedGroup for Second {
    fn deserialize_as_embedded_group<R: BufRead + Seek>(
        raw: &mut Deserializer<R>,
        _read_len: &mut CBORReadLen,
        len: cbor_event::Len,
    ) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let y = Ok(raw.text()? as String).map_err(|e: DeserializeError| e.annotate("y"))?;
            let z = Ok(raw.unsigned_integer()? as u64)
                .map_err(|e: DeserializeError| e.annotate("z"))?;
            Ok(Second { y, z })
        })()
        .map_err(|e| e.annotate("Second"))
    }
}

impl cbor_event::se::Serialize for SignBounds {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array(cbor_event::Len::Len(10))?;
        if self.all_neg >= 0 {
            serializer.write_unsigned_integer(self.all_neg as u64)?;
        } else {
            serializer.write_negative_integer_sz(
                self.all_neg as i128,
                cbor_event::Sz::canonical((self.all_neg + 1).abs() as u64),
            )?;
        }
        if self.upto_zero >= 0 {
            serializer.write_unsigned_integer(self.upto_zero as u64)?;
        } else {
            serializer.write_negative_integer_sz(
                self.upto_zero as i128,
                cbor_event::Sz::canonical((self.upto_zero + 1).abs() as u64),
            )?;
        }
        if self.le_neg >= 0 {
            serializer.write_unsigned_integer(self.le_neg as u64)?;
        } else {
            serializer.write_negative_integer_sz(
                self.le_neg as i128,
                cbor_event::Sz::canonical((self.le_neg + 1).abs() as u64),
            )?;
        }
        if self.le_pos >= 0 {
            serializer.write_unsigned_integer(self.le_pos as u64)?;
        } else {
            serializer.write_negative_integer_sz(
                self.le_pos as i128,
                cbor_event::Sz::canonical((self.le_pos + 1).abs() as u64),
            )?;
        }
        if self.ge_pos >= 0 {
            serializer.write_unsigned_integer(self.ge_pos as u64)?;
        } else {
            serializer.write_negative_integer_sz(
                self.ge_pos as i128,
                cbor_event::Sz::canonical((self.ge_pos + 1).abs() as u64),
            )?;
        }
        if self.ne_pos >= 0 {
            serializer.write_unsigned_integer(self.ne_pos as u64)?;
        } else {
            serializer.write_negative_integer_sz(
                self.ne_pos as i128,
                cbor_event::Sz::canonical((self.ne_pos + 1).abs() as u64),
            )?;
        }
        if self.ne_neg >= 0 {
            serializer.write_unsigned_integer(self.ne_neg as u64)?;
        } else {
            serializer.write_negative_integer_sz(
                self.ne_neg as i128,
                cbor_event::Sz::canonical((self.ne_neg + 1).abs() as u64),
            )?;
        }
        if self.straddle >= 0 {
            serializer.write_unsigned_integer(self.straddle as u64)?;
        } else {
            serializer.write_negative_integer_sz(
                self.straddle as i128,
                cbor_event::Sz::canonical((self.straddle + 1).abs() as u64),
            )?;
        }
        if self.ne_one >= 0 {
            serializer.write_unsigned_integer(self.ne_one as u64)?;
        } else {
            serializer.write_negative_integer_sz(
                self.ne_one as i128,
                cbor_event::Sz::canonical((self.ne_one + 1).abs() as u64),
            )?;
        }
        if self.ne_zero >= 0 {
            serializer.write_unsigned_integer(self.ne_zero as u64)?;
        } else {
            serializer.write_negative_integer_sz(
                self.ne_zero as i128,
                cbor_event::Sz::canonical((self.ne_zero + 1).abs() as u64),
            )?;
        }
        Ok(serializer)
    }
}

