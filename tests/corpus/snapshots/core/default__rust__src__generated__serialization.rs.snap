                }
            };
            Err(DeserializeFailure::NoVariantMatchedWithCauses(errs).into())
        })()
        .map_err(|e| e.annotate("TypeChoice"))
    }
}

impl cbor_event::se::Serialize for UsingExternGeneric {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array(cbor_event::Len::Len(1))?;
        self.foo.serialize(serializer)?;
        Ok(serializer)
    }
}

impl Deserialize for UsingExternGeneric {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.array()?;
            let mut read_len = CBORReadLen::from(len);
            read_len.read_elems(1)?;
            read_len.finish()?;
            let foo = ExternGenericExternalFoo::deserialize(raw)
                .map_err(|e: DeserializeError| e.annotate("foo"))?;
            match len {
                cbor_event::Len::Len(_) => (),
                cbor_event::Len::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(UsingExternGeneric { foo })
        })()
        .map_err(|e| e.annotate("UsingExternGeneric"))
    }
}

impl cbor_event::se::Serialize for WrapperInt {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_unsigned_integer(self.0)
    }
}

impl Deserialize for WrapperInt {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> { Ok(Self(raw.unsigned_integer()? as u64)) })()
            .map_err(|e| e.annotate("WrapperInt"))
    }
}

impl cbor_event::se::Serialize for WrapperList {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array(cbor_event::Len::Len(self.0.len() as u64))?;
        for element in self.0.iter() {
            serializer.write_unsigned_integer(*element)?;
        }
        Ok(serializer)
    }
}

impl Deserialize for WrapperList {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let mut inner_arr = Vec::new();
            let len = raw.array()?;
            while match len {
                cbor_event::Len::Len(n) => (inner_arr.len() as u64) < n,
                cbor_event::Len::Indefinite => true,
            } {
                if let cbor_event::Len::Indefinite = len {
                    if raw.cbor_type()? == cbor_event::Type::Special && raw.special_break()? {
                        break;
                    }
                }
                inner_arr.push(raw.unsigned_integer()? as u64);
            }
            Ok(Self(inner_arr))
        })()
        .map_err(|e| e.annotate("WrapperList"))
    }
}

impl cbor_event::se::Serialize for WrapperTable {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_map(cbor_event::Len::Len(self.0.len() as u64))?;
        for (key, value) in self.0.iter() {
            serializer.write_unsigned_integer(*key)?;
            serializer.write_unsigned_integer(*value)?;
        }
        Ok(serializer)
    }
}

impl Deserialize for WrapperTable {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let mut inner_table = BTreeMap::new();
            let inner_len = raw.map()?;
            while match inner_len {
                cbor_event::Len::Len(n) => (inner_table.len() as u64) < n,
                cbor_event::Len::Indefinite => true,
            } {
                if let cbor_event::Len::Indefinite = inner_len {
                    if raw.cbor_type()? == cbor_event::Type::Special && raw.special_break()? {
                        break;
                    }
                }
                let inner_key = raw.unsigned_integer()? as u64;
                let inner_value = raw.unsigned_integer()? as u64;
                if inner_table.insert(inner_key, inner_value).is_some() {
                    return Err(
                        DeserializeFailure::DuplicateKey(Key::Uint(inner_key.into())).into(),
                    );
                }
            }
            Ok(Self(inner_table))
        })()
        .map_err(|e| e.annotate("WrapperTable"))
    }
}
