impl cbor_event::se::Serialize for SignedInts {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array(cbor_event::Len::Len(11))?;
        serializer.write_unsigned_integer(self.u_8 as u64)?;
        serializer.write_unsigned_integer(self.u_16 as u64)?;
        serializer.write_unsigned_integer(self.u_32 as u64)?;
        serializer.write_unsigned_integer(self.u_64)?;
        if self.i_8 >= 0 {
            serializer.write_unsigned_integer(self.i_8 as u64)?;
        } else {
            serializer.write_negative_integer(self.i_8 as i64)?;
        }
        if self.i_16 >= 0 {
            serializer.write_unsigned_integer(self.i_16 as u64)?;
        } else {
            serializer.write_negative_integer(self.i_16 as i64)?;
        }
        if self.i_32 >= 0 {
            serializer.write_unsigned_integer(self.i_32 as u64)?;
        } else {
            serializer.write_negative_integer(self.i_32 as i64)?;
        }
        if self.i_64 >= 0 {
            serializer.write_unsigned_integer(self.i_64 as u64)?;
        } else {
            serializer.write_negative_integer(self.i_64 as i64)?;
        }
        serializer.write_negative_integer_sz(
            -(self.n_64 as i128 + 1),
            cbor_event::Sz::canonical(self.n_64),
        )?;
        serializer.write_unsigned_integer(18446744073709551615u64)?;
        serializer.write_negative_integer_sz(-9223372036854775808i128, cbor_event::Sz::Eight)?;
        Ok(serializer)
    }
}

