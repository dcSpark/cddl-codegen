impl cbor_event::se::Serialize for OptFixedArr {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array(cbor_event::Len::Len(2 + if self.bfix { 1 } else { 0 }))?;
        serializer.write_unsigned_integer(self.a)?;
        if self.bfix {
            serializer.write_special(cbor_event::Special::Bool(true))?;
        }
        serializer.write_text(&self.b)?;
