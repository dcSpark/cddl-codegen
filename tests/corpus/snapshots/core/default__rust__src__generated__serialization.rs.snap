impl cbor_event::se::Serialize for Bounds {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array(cbor_event::Len::Len(6))?;
        if self.w >= 0 {
            serializer.write_unsigned_integer(self.w as u64)?;
        } else {
            serializer.write_negative_integer(self.w as i64)?;
        }
        serializer.write_unsigned_integer(self.x)?;
        serializer
            .write_negative_integer_sz(-(self.y as i128 + 1), cbor_event::Sz::canonical(self.y))?;
        serializer.write_text(&self.z)?;
        serializer.write_array(cbor_event::Len::Len(self.a.len() as u64))?;
        for element in self.a.iter() {
            serializer.write_unsigned_integer(*element)?;
        }
        serializer.write_map(cbor_event::Len::Len(self.b.len() as u64))?;
        for (key, value) in self.b.iter() {
            serializer.write_unsigned_integer(*key)?;
            serializer.write_unsigned_integer(*value)?;
        }
        Ok(serializer)
    }
}

