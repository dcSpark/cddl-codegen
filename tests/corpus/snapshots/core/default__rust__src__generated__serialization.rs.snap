impl cbor_event::se::Serialize for NonOverlappingTypeChoiceAll {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        match self {
            NonOverlappingTypeChoiceAll::U64(uint) => serializer.write_unsigned_integer(*uint),
            NonOverlappingTypeChoiceAll::N64(n64) => serializer
                .write_negative_integer_sz(-(*n64 as i128 + 1), cbor_event::Sz::canonical(*n64)),
            NonOverlappingTypeChoiceAll::Text(text) => serializer.write_text(text),
            NonOverlappingTypeChoiceAll::Bytes(bytes) => serializer.write_bytes(bytes),
            NonOverlappingTypeChoiceAll::Helloworld => {
                serializer.write_tag(30u64)?;
                serializer.write_text("hello world")
            }
            NonOverlappingTypeChoiceAll::ArrU64(arr_u64) => {
                serializer.write_array(cbor_event::Len::Len(arr_u64.len() as u64))?;
                for element in arr_u64.iter() {
                    serializer.write_unsigned_integer(*element)?;
                }
                Ok(serializer)
            }
            NonOverlappingTypeChoiceAll::MapTextToU64(map_text_to_u64) => {
                serializer.write_map(cbor_event::Len::Len(map_text_to_u64.len() as u64))?;
                for (key, value) in map_text_to_u64.iter() {
                    serializer.write_text(key)?;
                    serializer.write_unsigned_integer(*value)?;
                }
                Ok(serializer)
            }
        }
    }
}

impl Deserialize for NonOverlappingTypeChoiceAll {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            match raw.cbor_type()? {
                cbor_event::Type::UnsignedInteger => {
                    Ok(NonOverlappingTypeChoiceAll::U64(raw.unsigned_integer()?))
                }
                cbor_event::Type::NegativeInteger => Ok(NonOverlappingTypeChoiceAll::N64(
                    raw.negative_integer_sz()
                        .map(|(x, _enc)| (x + 1).unsigned_abs() as u64)?,
                )),
                cbor_event::Type::Text => Ok(NonOverlappingTypeChoiceAll::Text(raw.text()?)),
                cbor_event::Type::Bytes => Ok(NonOverlappingTypeChoiceAll::Bytes(raw.bytes()?)),
                cbor_event::Type::Tag => {
                    match raw.tag()? {
                        30 => {
                            let helloworld_value = raw.text()?;
                            if helloworld_value != "hello world" {
                                return Err(DeserializeFailure::FixedValueMismatch {
                                    found: Key::Str(helloworld_value),
                                    expected: Key::Str(String::from("hello world")),
                                }
                                .into());
                            }
                        }
                        tag => {
                            return Err(DeserializeFailure::TagMismatch {
                                found: tag,
                                expected: 30,
                            }
                            .into());
                        }
                    }
                    Ok(NonOverlappingTypeChoiceAll::Helloworld)
                }
                cbor_event::Type::Array => {
                    let mut arr_u64_arr = Vec::new();
                    let len = raw.array()?;
                    while match len {
                        cbor_event::Len::Len(n) => (arr_u64_arr.len() as u64) < n,
                        cbor_event::Len::Indefinite => true,
                    } {
                        if matches!(len, cbor_event::Len::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        arr_u64_arr.push(raw.unsigned_integer()?);
                    }
                    let arr_u64 = arr_u64_arr;
                    Ok(Self::ArrU64(arr_u64))
                }
                cbor_event::Type::Map => {
                    let mut map_text_to_u64_table = BTreeMap::new();
                    let map_text_to_u64_len = raw.map()?;
                    while match map_text_to_u64_len {
                        cbor_event::Len::Len(n) => (map_text_to_u64_table.len() as u64) < n,
                        cbor_event::Len::Indefinite => true,
                    } {
                        if matches!(map_text_to_u64_len, cbor_event::Len::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        let map_text_to_u64_key = raw.text()?;
                        let map_text_to_u64_value = raw.unsigned_integer()?;
                        if map_text_to_u64_table
                            .insert(map_text_to_u64_key.clone(), map_text_to_u64_value)
                            .is_some()
                        {
                            return Err(DeserializeFailure::DuplicateKey(Key::Str(
                                map_text_to_u64_key,
                            ))
                            .into());
                        }
                    }
                    let map_text_to_u64 = map_text_to_u64_table;
                    Ok(Self::MapTextToU64(map_text_to_u64))
                }
                _ => Err(DeserializeFailure::NoVariantMatched.into()),
            }
        })()
        .map_err(|e| e.annotate("NonOverlappingTypeChoiceAll"))
    }
}

