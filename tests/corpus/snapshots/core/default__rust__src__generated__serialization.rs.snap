        match &self.b {
            Some(x) => {
                serializer.write_special(cbor_event::Special::Bool(*x))?;
            }
            None => {
                serializer.write_special(cbor_event::Special::Null)?;
            }
        };
        match &self.f {
            Some(x) => {
                serializer.write_special(cbor_event::Special::Float(*x))?;
            }
            None => {
                serializer.write_special(cbor_event::Special::Null)?;
            }
        };
        Ok(serializer)
