            let f = (|| -> Result<_, DeserializeError> {
                let f_is_some = match raw.cbor_type()? {
                    cbor_event::Type::Special => {
                        let initial_position = raw.position();
                        let special = raw.special()?;
                        raw.set_position(initial_position).unwrap();
                        match special {
                            cbor_event::Special::Null => false,
                            _ => true,
                        }
                    }
                    _ => true,
                };
                Ok(match f_is_some {
                    true => Some(read_float_width(
                        raw,
                        cbor_event::Sz::Two,
                        cbor_event::Sz::Eight,
                    )?),
                    false => {
                        if raw.special()? != cbor_event::Special::Null {
                            return Err(DeserializeFailure::ExpectedNull.into());
                        }
                        None
                    }
                })
