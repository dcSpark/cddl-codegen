impl cbor_event::se::Serialize for StructWithCustomSerialization {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array(cbor_event::Len::Len(5))?;
        custom_serialize_bytes(serializer, &self.custom_bytes)?;
        custom_serialize_bytes(serializer, &self.field)?;
        write_hex_string(serializer, &self.overridden)?;
        serializer.write_tag(9u64)?;
        custom_serialize_bytes(serializer, &self.tagged1)?;
        write_tagged_uint_str(serializer, &self.tagged2)?;
        Ok(serializer)
    }
}

impl Deserialize for StructWithCustomSerialization {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.array()?;
            let mut read_len = CBORReadLen::from(len);
            read_len.read_elems(5)?;
            read_len.finish()?;
            let custom_bytes = custom_deserialize_bytes(raw)
                .map_err(|e: DeserializeError| e.annotate("custom_bytes"))?;
            let field =
                custom_deserialize_bytes(raw).map_err(|e: DeserializeError| e.annotate("field"))?;
            let overridden =
                read_hex_string(raw).map_err(|e: DeserializeError| e.annotate("overridden"))?;
            let tagged1 = (|| -> Result<_, DeserializeError> {
                match raw.tag()? {
                    9 => custom_deserialize_bytes(raw),
                    tag => Err(DeserializeFailure::TagMismatch {
                        found: tag,
                        expected: 9,
                    }
                    .into()),
                }
            })()
            .map_err(|e| e.annotate("tagged1"))?;
            let tagged2 =
                read_tagged_uint_str(raw).map_err(|e: DeserializeError| e.annotate("tagged2"))?;
            match len {
                cbor_event::Len::Len(_) => (),
                cbor_event::Len::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(StructWithCustomSerialization {
                custom_bytes,
                field,
                overridden,
                tagged1,
