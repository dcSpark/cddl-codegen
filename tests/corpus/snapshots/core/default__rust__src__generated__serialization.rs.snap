impl cbor_event::se::Serialize for Externs {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_map(cbor_event::Len::Len(
            1 + match &self.opt {
                Some(_) => 1,
                None => 0,
            },
        ))?;
        if let Some(field) = &self.opt {
            serializer.write_text("opt")?;
            field.serialize(serializer)?;
        }
        serializer.write_text("req")?;
        self.req.serialize(serializer)?;
        Ok(serializer)
    }
}

