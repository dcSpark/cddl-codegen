impl cbor_event::se::Serialize for FloatBounds {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array(cbor_event::Len::Len(6))?;
        serializer.write_special(cbor_event::Special::Float(self.incl))?;
        serializer.write_special(cbor_event::Special::Float(self.excl))?;
        serializer.write_special(cbor_event::Special::Float(self.lt))?;
        serializer.write_special(cbor_event::Special::Float(self.ge))?;
        serializer.write_special(cbor_event::Special::Float(self.eq))?;
        write_float_width(
            serializer,
            widen_f32(self.f32le),
            cbor_event::Sz::Four,
            cbor_event::Sz::Four,
        )?;
        Ok(serializer)
    }
}

