                        found: Key::Str(helloworld_value),
                        expected: Key::Str(String::from("hello world")),
                    }
                    .into());
                }
                Ok(())
            })(raw);
            match deser_variant {
                Ok(()) => return Ok(TypeChoice::Helloworld),
                Err(e) => {
                    errs.push(e.annotate("Helloworld"));
                    raw.set_position(initial_position).unwrap();
                }
            };
            let deser_variant = (|raw: &mut Deserializer| -> Result<_, DeserializeError> {
                Ok(raw.unsigned_integer()?)
            })(raw);
            match deser_variant {
                Ok(uint) => return Ok(Self::U64(uint)),
                Err(e) => {
                    errs.push(e.annotate("U64"));
                    raw.set_position(initial_position).unwrap();
                }
            };
            let deser_variant =
                (|raw: &mut Deserializer| -> Result<_, DeserializeError> { Ok(raw.text()?) })(raw);
            match deser_variant {
                Ok(text) => return Ok(Self::Text(text)),
                Err(e) => {
                    errs.push(e.annotate("Text"));
                    raw.set_position(initial_position).unwrap();
                }
            };
            let deser_variant =
                (|raw: &mut Deserializer| -> Result<_, DeserializeError> { Ok(raw.bytes()?) })(raw);
            match deser_variant {
                Ok(bytes) => return Ok(Self::Bytes(bytes)),
                Err(e) => {
                    errs.push(e.annotate("Bytes"));
                    raw.set_position(initial_position).unwrap();
                }
            };
            let deser_variant = (|raw: &mut Deserializer| -> Result<_, DeserializeError> {
                match raw.tag()? {
                    64 => {
                        let mut arr_u64_arr = Vec::new();
                        let len = raw.array()?;
                        while match len {
