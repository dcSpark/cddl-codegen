impl cbor_event::se::Serialize for Enums {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array(cbor_event::Len::Len(2))?;
        match &self.c_enum {
            CEnum::I3 => serializer.write_unsigned_integer(3u64),
            CEnum::I1 => serializer.write_unsigned_integer(1u64),
            CEnum::I4 => serializer.write_unsigned_integer(4u64),
        }?;
        self.type_choice.serialize(serializer)?;
        Ok(serializer)
    }
}

