impl cbor_event::se::Serialize for TypeChoice {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        match self {
            TypeChoice::I0 => serializer.write_unsigned_integer(0u64),
            TypeChoice::Helloworld => serializer.write_text("hello world"),
            TypeChoice::U64(uint) => serializer.write_unsigned_integer(*uint),
            TypeChoice::Text(text) => serializer.write_text(text),
            TypeChoice::Bytes(bytes) => serializer.write_bytes(bytes),
            TypeChoice::ArrU64(arr_u64) => {
                serializer.write_tag(64u64)?;
                serializer.write_array(cbor_event::Len::Len(arr_u64.len() as u64))?;
                for element in arr_u64.iter() {
                    serializer.write_unsigned_integer(*element)?;
                }
                Ok(serializer)
            }
        }
    }
}

