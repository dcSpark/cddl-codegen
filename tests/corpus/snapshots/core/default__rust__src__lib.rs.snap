#[derive(Clone, Debug, Copy)]
pub struct WrapperInt(u64);

impl WrapperInt {
    pub fn custom_getter(&self) -> u64 {
        self.0
    }

    pub fn new(inner: u64) -> Self {
        Self(inner)
    }
}

impl From<u64> for WrapperInt {
    fn from(inner: u64) -> Self {
        WrapperInt::new(inner)
    }
}

#[derive(Clone, Debug)]
pub struct WrapperList(Vec<u64>);

impl WrapperList {
    pub fn new(inner: Vec<u64>) -> Self {
        Self(inner)
    }
}

impl From<Vec<u64>> for WrapperList {
    fn from(inner: Vec<u64>) -> Self {
        WrapperList::new(inner)
    }
}

impl From<WrapperList> for Vec<u64> {
    fn from(wrapper: WrapperList) -> Self {
        wrapper.0
    }
}

#[derive(Clone, Debug)]
pub struct WrapperTable(BTreeMap<u64, u64>);

impl WrapperTable {
    pub fn new(inner: BTreeMap<u64, u64>) -> Self {
        Self(inner)
    }
}

impl From<BTreeMap<u64, u64>> for WrapperTable {
    fn from(inner: BTreeMap<u64, u64>) -> Self {
        WrapperTable::new(inner.clone().into())
    }
}

impl From<WrapperTable> for BTreeMap<u64, u64> {
    fn from(wrapper: WrapperTable) -> Self {
        wrapper.0
    }
}

impl From<NintGeNewtype> for u64 {
    fn from(wrapper: NintGeNewtype) -> Self {
        wrapper.0
    }
}

impl From<NintLeNewtype> for u64 {
    fn from(wrapper: NintLeNewtype) -> Self {
