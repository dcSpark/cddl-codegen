#[derive(Clone, Debug)]
pub struct FloatBounds {
    pub incl: f64,
    pub excl: f64,
    pub lt: f64,
    pub ge: f64,
    pub eq: f64,
    pub f32le: f32,
}

impl FloatBounds {
    pub fn new(
        incl: f64,
        excl: f64,
        lt: f64,
        ge: f64,
        eq: f64,
        f32le: f32,
    ) -> Result<Self, DeserializeError> {
        if !(incl >= 0.5f64 && incl <= 10.5f64) {
            return Err(DeserializeFailure::RangeCheckFloat {
                found: incl as f64,
                min: Some(0.5f64),
                max: Some(10.5f64),
                min_inclusive: true,
                max_inclusive: true,
            }
            .into());
        }
        if !(excl >= 0.5f64 && excl < 10.5f64) {
            return Err(DeserializeFailure::RangeCheckFloat {
                found: excl as f64,
                min: Some(0.5f64),
                max: Some(10.5f64),
                min_inclusive: true,
                max_inclusive: false,
            }
            .into());
        }
        if !(lt < 10.5f64) {
            return Err(DeserializeFailure::RangeCheckFloat {
                found: lt as f64,
                min: None,
                max: Some(10.5f64),
                min_inclusive: false,
                max_inclusive: false,
            }
            .into());
        }
        if !(ge >= 0.5f64) {
            return Err(DeserializeFailure::RangeCheckFloat {
                found: ge as f64,
                min: Some(0.5f64),
                max: None,
                min_inclusive: true,
                max_inclusive: false,
            }
            .into());
        }
        if !(eq >= 3.3f64 && eq <= 3.3f64) {
            return Err(DeserializeFailure::RangeCheckFloat {
                found: eq as f64,
                min: Some(3.3f64),
                max: Some(3.3f64),
                min_inclusive: true,
                max_inclusive: true,
            }
            .into());
        }
        if !((f32le as f64) <= 10.5f64) {
            return Err(DeserializeFailure::RangeCheckFloat {
                found: f32le as f64,
                min: None,
                max: Some(10.5f64),
                min_inclusive: false,
                max_inclusive: true,
            }
            .into());
        }
        Ok(Self {
            incl,
            excl,
            lt,
            ge,
            eq,
            f32le,
        })
    }
}

