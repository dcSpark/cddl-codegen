#[derive(Clone, Debug)]
pub enum OverlapBasicEmbed {
    Identity,
    X(Vec<u8>),
}

impl OverlapBasicEmbed {
    pub fn new_identity() -> Self {
        Self::Identity
    }

    pub fn new_x(hash: Vec<u8>) -> Result<Self, DeserializeError> {
        if hash.len() != 32 {
            return Err(DeserializeFailure::RangeCheck {
                found: hash.len() as i128,
                min: Some(32),
                max: Some(32),
            }
            .into());
        }
        Ok(Self::X(hash))
    }
}

