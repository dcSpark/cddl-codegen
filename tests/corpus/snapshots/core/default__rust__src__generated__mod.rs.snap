pub struct NintGeNewtype(pub(crate) u64);

impl NintGeNewtype {
    pub fn get(&self) -> u64 {
        self.0
    }

    pub fn new(inner: u64) -> Result<Self, DeserializeError> {
        if inner > 4 {
            return Err(DeserializeError::new(
                "NintGeNewtype",
                DeserializeFailure::RangeCheck {
                    found: inner as i128,
                    min: None,
                    max: Some(4),
                },
            ));
        }
        Ok(Self(inner))
    }
}

impl TryFrom<u64> for NintGeNewtype {
    type Error = DeserializeError;

    fn try_from(inner: u64) -> Result<Self, Self::Error> {
        NintGeNewtype::new(inner)
    }
}

