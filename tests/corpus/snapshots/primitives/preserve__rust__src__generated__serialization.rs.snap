                .as_ref()
                .map(|encs| encs.d_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(self.d.len() as u64),
        )?;
        serializer.write_bytes_sz(
            &self.e,
            self.encodings
                .as_ref()
                .map(|encs| encs.e_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(self.e.len() as u64),
        )?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

impl Deserialize for Primitives {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let len = raw.array_sz()?;
        let len_encoding: LenEncoding = len.into();
