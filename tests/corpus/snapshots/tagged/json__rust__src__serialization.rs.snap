impl cbor_event::se::Serialize for Holder {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array(cbor_event::Len::Len(1))?;
        self.payload.serialize(serializer)?;
        Ok(serializer)
    }
}

impl Deserialize for Holder {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let len = raw.array()?;
        let mut read_len = CBORReadLen::new(len);
        read_len.read_elems(1)?;
        read_len.finish()?;
        (|| -> Result<_, DeserializeError> {
            let payload = TaggedNewtype::deserialize(raw)
                .map_err(|e: DeserializeError| e.annotate("payload"))?;
            match len {
                cbor_event::Len::Len(_) => (),
                cbor_event::Len::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(Holder { payload })
        })()
        .map_err(|e| e.annotate("Holder"))
    }
}

impl cbor_event::se::Serialize for TaggedNewtype {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_tag(42u64)?;
        serializer.write_text(&self.0)
    }
}

impl Deserialize for TaggedNewtype {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        Ok(Self(match raw.tag()? {
            42 => raw.text()? as String,
            tag => {
                return Err(DeserializeFailure::TagMismatch {
                    found: tag,
                    expected: 42,
                }
                .into())
            }
        }))
    }
