#[derive(Clone, Debug)]
pub struct Holder {
    pub payload: TaggedNewtype,
    pub encodings: Option<HolderEncoding>,
}

impl Holder {
    pub fn new(payload: TaggedNewtype) -> Self {
        Self {
            payload,
            encodings: None,
        }
    }
}

impl From<TaggedNewtype> for String {
    fn from(wrapper: TaggedNewtype) -> Self {
        wrapper.inner
    }
}

pub type Tagged = String;

#[derive(Clone, Debug)]
pub struct TaggedNewtype {
    pub inner: String,
    pub encodings: Option<TaggedNewtypeEncoding>,
}

impl TaggedNewtype {
    pub fn new(inner: String) -> Self {
        Self {
            inner,
            encodings: None,
        }
    }
}

impl From<String> for TaggedNewtype {
    fn from(inner: String) -> Self {
        TaggedNewtype::new(inner)
    }
}
