        self.encodings
            .as_ref()
            .map(|encs| encs.p_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        serializer.write_map_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.np_encoding)
                .unwrap_or_default()
                .to_len_sz(self.np.len() as u64),
        )?;
        for (i, (key, value)) in self.np.iter().enumerate() {
            let np_key_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.np_key_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*key, fit_sz(*key, np_key_encoding))?;
            let np_value_encoding = self
                .encodings
