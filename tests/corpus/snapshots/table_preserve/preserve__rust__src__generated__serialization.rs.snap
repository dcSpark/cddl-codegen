            self.encodings
                .as_ref()
                .map(|encs| encs.g_encoding)
                .unwrap_or_default()
                .to_len_sz(self.g.len() as u64),
        )?;
        for (i, (key, value)) in self.g.iter().enumerate() {
            let g_key_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.g_key_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer.write_text_sz(key, g_key_encoding.to_str_len_sz(key.len() as u64))?;
            let g_value_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.g_value_encodings.get(i))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*value, fit_sz(*value, g_value_encoding))?;
        }
