impl cbor_event::se::Serialize for Int {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        match self {
            Self::Uint { value, encoding } => {
                serializer.write_unsigned_integer_sz(*value, fit_sz(*value, *encoding))
            }
            Self::Nint { value, encoding } => serializer
                .write_negative_integer_sz(-((*value as i128) + 1), fit_sz(*value, *encoding)),
        }
    }
}

impl Deserialize for Int {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            match raw.cbor_type()? {
                cbor_event::Type::UnsignedInteger => raw
                    .unsigned_integer_sz()
                    .map(|(x, enc)| Self::Uint {
                        value: x,
                        encoding: Some(enc),
                    })
                    .map_err(std::convert::Into::into),
                cbor_event::Type::NegativeInteger => raw
                    .negative_integer_sz()
                    .map(|(x, enc)| Self::Nint {
                        value: (-1 - x) as u64,
                        encoding: Some(enc),
                    })
                    .map_err(std::convert::Into::into),
                _ => Err(DeserializeFailure::NoVariantMatched.into()),
            }
        })()
        .map_err(|e| e.annotate("Int"))
    }
}

impl cbor_event::se::Serialize for Md {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        match self {
            Md::Mdmap {
                mdmap,
                mdmap_encoding,
                mdmap_key_encodings,
            } => {
                serializer.write_map_sz(mdmap_encoding.to_len_sz(mdmap.len() as u64))?;
                for (i, (key, value)) in mdmap.iter().enumerate() {
                    let mdmap_key_encoding =
                        mdmap_key_encodings.get(i).cloned().unwrap_or_default();
                    serializer
                        .write_text_sz(key, mdmap_key_encoding.to_str_len_sz(key.len() as u64))?;
                    value.serialize(serializer)?;
                }
                mdmap_encoding.end(serializer)
            }
            Md::ArrMd {
                arr_md,
                arr_md_encoding,
            } => {
                serializer.write_array_sz(arr_md_encoding.to_len_sz(arr_md.len() as u64))?;
                for element in arr_md.iter() {
                    element.serialize(serializer)?;
                }
                arr_md_encoding.end(serializer)
            }
            Md::Int(int) => int.serialize(serializer),
            Md::Bytes {
                bytes,
                bytes_encoding,
            } => serializer.write_bytes_sz(bytes, bytes_encoding.to_str_len_sz(bytes.len() as u64)),
            Md::Text {
                text,
                text_encoding,
            } => serializer.write_text_sz(text, text_encoding.to_str_len_sz(text.len() as u64)),
        }
    }
}

impl Deserialize for Md {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            match raw.cbor_type()? {
                cbor_event::Type::Map => {
                    let mut mdmap_table = Vec::new();
                    let mdmap_len = raw.map_sz()?;
                    let mdmap_encoding = mdmap_len.into();
                    let mut mdmap_key_encodings = Vec::new();
                    while match mdmap_len {
                        cbor_event::LenSz::Len(n, _) => (mdmap_table.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(mdmap_len, cbor_event::LenSz::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        let (mdmap_key, mdmap_key_encoding) = raw
                            .text_sz()
                            .map(|(s, enc)| (s, StringEncoding::from(enc)))?;
                        let mdmap_value = Md::deserialize(raw)?;
                        mdmap_table.push((mdmap_key, mdmap_value));
                        mdmap_key_encodings.push(mdmap_key_encoding);
                    }
                    let mdmap_table = PairMap::from(mdmap_table);
                    let (mdmap, mdmap_encoding, mdmap_key_encodings) =
                        (mdmap_table, mdmap_encoding, mdmap_key_encodings);
                    Ok(Self::Mdmap {
                        mdmap,
                        mdmap_encoding,
                        mdmap_key_encodings,
                    })
                }
                cbor_event::Type::Array => {
                    let mut arr_md_arr = Vec::new();
                    let len = raw.array_sz()?;
                    let arr_md_encoding = len.into();
                    while match len {
                        cbor_event::LenSz::Len(n, _) => (arr_md_arr.len() as u64) < n,
                        cbor_event::LenSz::Indefinite => true,
                    } {
                        if matches!(len, cbor_event::LenSz::Indefinite)
                            && raw.cbor_type()? == cbor_event::Type::Special
                            && raw.special_break()?
                        {
                            break;
                        }
                        arr_md_arr.push(Md::deserialize(raw)?);
                    }
                    let (arr_md, arr_md_encoding) = (arr_md_arr, arr_md_encoding);
                    Ok(Self::ArrMd {
                        arr_md,
                        arr_md_encoding,
                    })
                }
                cbor_event::Type::UnsignedInteger | cbor_event::Type::NegativeInteger => {
                    Ok(Md::Int(Int::deserialize(raw)?))
                }
                cbor_event::Type::Bytes => {
                    let (bytes, bytes_encoding) = raw
                        .bytes_sz()
                        .map(|(bytes, enc)| (bytes, StringEncoding::from(enc)))?;
                    Ok(Self::Bytes {
                        bytes,
                        bytes_encoding,
                    })
                }
                cbor_event::Type::Text => {
                    let (text, text_encoding) = raw
                        .text_sz()
                        .map(|(s, enc)| (s, StringEncoding::from(enc)))?;
                    Ok(Self::Text {
                        text,
                        text_encoding,
                    })
                }
                _ => Err(DeserializeFailure::NoVariantMatched.into()),
            }
        })()
        .map_err(|e| e.annotate("Md"))
    }
}
