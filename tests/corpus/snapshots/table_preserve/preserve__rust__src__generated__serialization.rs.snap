            .as_ref()
            .map(|encs| encs.g_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        self.m.serialize(serializer)?;
        if let Some(field) = &self.o {
            serializer.write_map_sz(
                self.encodings
                    .as_ref()
                    .map(|encs| encs.o_encoding)
                    .unwrap_or_default()
                    .to_len_sz(field.len() as u64),
            )?;
            for (i, (key, value)) in field.iter().enumerate() {
                let o_key_encoding = self
                    .encodings
                    .as_ref()
                    .and_then(|encs| encs.o_key_encodings.get(i))
                    .cloned()
                    .unwrap_or_default();
                serializer.write_unsigned_integer_sz(*key, fit_sz(*key, o_key_encoding))?;
                let o_value_encoding = self
                    .encodings
                    .as_ref()
                    .and_then(|encs| encs.o_value_encodings.get(i))
                    .cloned()
                    .unwrap_or_default();
                serializer
                    .write_text_sz(value, o_value_encoding.to_str_len_sz(value.len() as u64))?;
