use crate::generated::pair_map::{NonEmptyPairMap, PairMap};

#[derive(Clone, Debug)]
pub struct Holder {
    pub p: Pmap,
    pub np: Nepmap,
    pub g: PmapTxt,
    pub m: Md,
    pub o: Option<Pmap>,
}

impl Holder {
    pub fn new(p: Pmap, np: Nepmap, g: PmapTxt, m: Md) -> Self {
        Self {
            p,
            np,
            g,
            m,
            o: None,
        }
    }
}

#[derive(Clone, Debug)]
pub enum Int {
    Uint(u64),
    Nint(u64),
}

impl Int {
    pub fn new_uint(value: u64) -> Self {
        Self::Uint(value)
    }

    /// * `value` - Value as encoded in CBOR - note: a negative `x` here would be `|x + 1|` due to CBOR's `nint` encoding e.g. to represent -5, pass in 4.
    pub fn new_nint(value: u64) -> Self {
        Self::Nint(value)
    }
}

impl core::fmt::Display for Int {
    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
        match self {
            Self::Uint(x) => write!(f, "{}", x),
            Self::Nint(x) => write!(f, "{}", -((*x as i128) + 1)),
        }
    }
}

impl core::str::FromStr for Int {
    type Err = IntError;

    fn from_str(s: &str) -> Result<Self, Self::Err> {
        let x = i128::from_str(s).map_err(IntError::Parsing)?;
        Self::try_from(x).map_err(IntError::Bounds)
    }
}

impl TryFrom<i128> for Int {
    type Error = core::num::TryFromIntError;

    fn try_from(x: i128) -> Result<Self, Self::Error> {
        if x >= 0 {
            u64::try_from(x).map(Self::Uint)
        } else {
            u64::try_from((x + 1).unsigned_abs()).map(Self::Nint)
        }
    }
}

#[derive(Clone, Debug)]
pub enum IntError {
    Bounds(core::num::TryFromIntError),
    Parsing(core::num::ParseIntError),
}

#[derive(Clone, Debug)]
pub enum Md {
    Mdmap(Mdmap),
    ArrMd(Vec<Md>),
    Int(Int),
    Bytes(Vec<u8>),
    Text(String),
}

impl Md {
    pub fn new_mdmap(mdmap: Mdmap) -> Self {
        Self::Mdmap(mdmap)
    }

    pub fn new_arr_md(arr_md: Vec<Md>) -> Self {
        Self::ArrMd(arr_md)
    }

    pub fn new_int(int: Int) -> Self {
        Self::Int(int)
    }

    pub fn new_bytes(bytes: Vec<u8>) -> Self {
        Self::Bytes(bytes)
    }

    pub fn new_text(text: String) -> Self {
        Self::Text(text)
    }
}

pub type Mdmap = PairMap<String, Md>;

/// `{+ u64 => String}`: at least one entry, enforced at the `NonEmptyMap` `TryFrom` door (the CBOR decoder routes through the same door, so wire-side and API-side rejection are identical).
pub type Nepmap = NonEmptyPairMap<u64, String>;

pub type Pmap = PairMap<u64, String>;

pub type PmapTxt = PairMap<String, u64>;
