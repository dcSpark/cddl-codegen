impl cbor_event::se::Serialize for Int {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        match self {
            Self::Uint(x) => serializer.write_unsigned_integer(*x),
            Self::Nint(x) => serializer
                .write_negative_integer_sz(-((*x as i128) + 1), cbor_event::Sz::canonical(*x)),
        }
    }
}

impl Deserialize for Int {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            match raw.cbor_type()? {
                cbor_event::Type::UnsignedInteger => Ok(Self::Uint(raw.unsigned_integer()?)),
                cbor_event::Type::NegativeInteger => Ok(Self::Nint(
                    (-1 - raw.negative_integer_sz().map(|(x, _enc)| x)?) as u64,
                )),
                _ => Err(DeserializeFailure::NoVariantMatched.into()),
            }
        })()
        .map_err(|e| e.annotate("Int"))
    }
}

impl cbor_event::se::Serialize for Md {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        match self {
            Md::Mdmap(mdmap) => {
                serializer.write_map(cbor_event::Len::Len(mdmap.len() as u64))?;
                for (key, value) in mdmap.iter() {
                    serializer.write_text(key)?;
                    value.serialize(serializer)?;
                }
                Ok(serializer)
            }
            Md::ArrMd(arr_md) => {
                serializer.write_array(cbor_event::Len::Len(arr_md.len() as u64))?;
                for element in arr_md.iter() {
                    element.serialize(serializer)?;
                }
                Ok(serializer)
            }
            Md::Int(int) => int.serialize(serializer),
            Md::Bytes(bytes) => serializer.write_bytes(bytes),
            Md::Text(text) => serializer.write_text(text),
        }
    }
}

