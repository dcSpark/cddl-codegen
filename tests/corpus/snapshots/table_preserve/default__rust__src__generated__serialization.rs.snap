impl cbor_event::se::Serialize for Holder {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array(cbor_event::Len::Len(
            4 + match &self.o {
                Some(_) => 1,
                None => 0,
            },
        ))?;
        serializer.write_map(cbor_event::Len::Len(self.p.len() as u64))?;
        for (key, value) in self.p.iter() {
            serializer.write_unsigned_integer(*key)?;
            serializer.write_text(value)?;
        }
        serializer.write_map(cbor_event::Len::Len(self.np.len() as u64))?;
        for (key, value) in self.np.iter() {
            serializer.write_unsigned_integer(*key)?;
            serializer.write_text(value)?;
        }
        serializer.write_map(cbor_event::Len::Len(self.g.len() as u64))?;
        for (key, value) in self.g.iter() {
            serializer.write_text(key)?;
            serializer.write_unsigned_integer(*value)?;
        }
        self.m.serialize(serializer)?;
        if let Some(field) = &self.o {
            serializer.write_map(cbor_event::Len::Len(field.len() as u64))?;
            for (key, value) in field.iter() {
                serializer.write_unsigned_integer(*key)?;
                serializer.write_text(value)?;
            }
        }
        Ok(serializer)
    }
}

