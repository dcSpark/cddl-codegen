#[derive(Clone, Debug)]
pub enum Int {
    Uint {
        value: u64,
        encoding: Option<cbor_event::Sz>,
    },
    Nint {
        value: u64,
        encoding: Option<cbor_event::Sz>,
    },
}

impl Int {
    pub fn new_uint(value: u64) -> Self {
        Self::Uint {
            value,
            encoding: None,
        }
    }

    /// * `value` - Value as encoded in CBOR - note: a negative `x` here would be `|x + 1|` due to CBOR's `nint` encoding e.g. to represent -5, pass in 4.
    pub fn new_nint(value: u64) -> Self {
        Self::Nint {
            value,
            encoding: None,
        }
    }
}

impl core::fmt::Display for Int {
    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
        match self {
            Self::Uint { value, .. } => write!(f, "{}", value),
            Self::Nint { value, .. } => write!(f, "{}", -((*value as i128) + 1)),
        }
    }
}

impl core::str::FromStr for Int {
    type Err = IntError;

    fn from_str(s: &str) -> Result<Self, Self::Err> {
        let x = i128::from_str(s).map_err(IntError::Parsing)?;
        Self::try_from(x).map_err(IntError::Bounds)
    }
}

impl TryFrom<i128> for Int {
    type Error = core::num::TryFromIntError;

    fn try_from(x: i128) -> Result<Self, Self::Error> {
        if x >= 0 {
            u64::try_from(x).map(|x| Self::Uint {
                value: x,
                encoding: None,
            })
        } else {
            u64::try_from((x + 1).unsigned_abs()).map(|x| Self::Nint {
                value: x,
                encoding: None,
            })
        }
    }
}

impl From<CborInt> for Int {
    fn from(wrapper: CborInt) -> Self {
        wrapper.inner
    }
}

#[derive(Clone, Debug)]
pub enum IntError {
    Bounds(core::num::TryFromIntError),
    Parsing(core::num::ParseIntError),
}
