use cbor_encodings::{CborIntEncoding, CborIntTableEncoding};

pub type BareInt = Int;

#[derive(Clone, Debug)]
pub struct CborInt {
    pub(crate) inner: Int,
    pub encodings: Option<CborIntEncoding>,
}

impl CborInt {
    pub fn get(&self) -> &Int {
        &self.inner
    }

    pub fn new(inner: Int) -> Self {
        Self {
            inner,
            encodings: None,
        }
    }
}

impl From<Int> for CborInt {
    fn from(inner: Int) -> Self {
        CborInt::new(inner)
    }
}

#[derive(Clone, Debug)]
pub struct CborIntTable {
    pub(crate) inner: OrderedHashMap<String, Int>,
    pub encodings: Option<CborIntTableEncoding>,
