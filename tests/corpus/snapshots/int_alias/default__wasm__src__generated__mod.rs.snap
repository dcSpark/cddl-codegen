            .map(Self)
            .map_err(|e| JsError::new(&format!("from_bytes: {}", e)))
    }

    pub fn new(inner: &Int) -> Self {
        Self(cddl_lib::CborInt::new(inner.clone().into()))
    }

    pub fn get(&self) -> Int {
        self.0.get().clone().into()
    }
}

impl From<cddl_lib::CborInt> for CborInt {
