            &inner_bytes,
            self.encodings
                .as_ref()
                .map(|encs| encs.inner_bytes_encoding.clone())
                .unwrap_or_default()
                .to_str_len_sz(inner_bytes.len() as u64),
        )
    }
}

impl Deserialize for CborInt {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let (inner_bytes, inner_bytes_encoding) = raw.bytes_sz()?;
            let inner_de = &mut Deserializer::from(inner_bytes);
            let (inner, inner_bytes_encoding) = (
                Int::deserialize(inner_de)?,
                StringEncoding::from(inner_bytes_encoding),
