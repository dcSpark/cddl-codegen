#[derive(Clone, Debug)]
pub enum Int {
    Uint(u64),
    Nint(u64),
}

impl serde::Serialize for Int {
    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>
    where
        S: serde::Serializer,
    {
        serializer.serialize_str(&self.to_string())
