// This file was code-generated using an experimental CDDL to rust tool:
// https://github.com/dcSpark/cddl-codegen

use core::cell::RefCell;

wit_bindgen::generate!({
    path: "wit",
    world: "cddl-lib-world",
});

use exports::cddl::cddl_lib::types as wit_types;

struct Component;

impl wit_types::Guest for Component {
    type SingleFieldMap = WitSingleFieldMap;
    type SingleFieldMapOpt = WitSingleFieldMapOpt;
}

export!(Component);

/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitSingleFieldMap(pub RefCell<cddl_lib::SingleFieldMap>);

impl wit_types::GuestSingleFieldMap for WitSingleFieldMap {
    fn new(t: u64) -> Self {
        let inner = cddl_lib::SingleFieldMap::new(t);
        WitSingleFieldMap(RefCell::new(inner))
    }

    fn t(&self) -> u64 {
        let me = self.0.borrow();
        me.t
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::SingleFieldMap as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::SingleFieldMap, String> {
        <cddl_lib::SingleFieldMap as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::SingleFieldMap::new(WitSingleFieldMap(RefCell::new(v))))
            .map_err(err)
    }
}

pub struct WitSingleFieldMapOpt(pub RefCell<cddl_lib::SingleFieldMapOpt>);

impl wit_types::GuestSingleFieldMapOpt for WitSingleFieldMapOpt {
    fn new() -> Self {
        let inner = cddl_lib::SingleFieldMapOpt::new();
        WitSingleFieldMapOpt(RefCell::new(inner))
    }

    fn t(&self) -> Option<u64> {
        let me = self.0.borrow();
        me.t.as_ref().map(|x| *x)
    }

    fn set_t(&self, t: u64) {
        self.0.borrow_mut().t = Some(t);
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::SingleFieldMapOpt as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::SingleFieldMapOpt, String> {
        <cddl_lib::SingleFieldMapOpt as cddl_lib::serialization::Deserialize>::from_cbor_bytes(
            &bytes,
        )
        .map(|v| wit_types::SingleFieldMapOpt::new(WitSingleFieldMapOpt(RefCell::new(v))))
        .map_err(err)
    }
}
