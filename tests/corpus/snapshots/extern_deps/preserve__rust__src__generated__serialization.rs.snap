            element.serialize(serializer)?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.bars_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        serializer.write_map_sz(
            self.encodings
                .as_ref()
                .map(|encs| encs.table_encoding)
                .unwrap_or_default()
                .to_len_sz(self.table.len() as u64),
        )?;
        for (key, value) in self.table.iter() {
            let table_key_encoding = self
                .encodings
                .as_ref()
                .and_then(|encs| encs.table_key_encodings.get(key))
                .cloned()
                .unwrap_or_default();
            serializer.write_unsigned_integer_sz(*key, fit_sz(*key, table_key_encoding))?;
            value.serialize(serializer)?;
        }
        self.encodings
            .as_ref()
            .map(|encs| encs.table_encoding)
            .unwrap_or_default()
            .end(serializer)?;
        self.baz.serialize(serializer)?;
        self.qux.serialize(serializer)?;
        self.encodings
            .as_ref()
            .map(|encs| encs.len_encoding)
            .unwrap_or_default()
            .end(serializer)
    }
}

