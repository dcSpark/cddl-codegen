#[derive(Clone, Debug)]
pub enum TypeChoice {
    U64 {
        uint: u64,
        uint_encoding: Option<cbor_event::Sz>,
    },
    Text {
        text: String,
        text_encoding: StringEncoding,
    },
    Bytes {
        bytes: Vec<u8>,
        bytes_encoding: StringEncoding,
    },
}

impl TypeChoice {
    pub fn new_uint(uint: u64) -> Self {
        Self::U64 {
            uint,
            uint_encoding: None,
        }
    }

    pub fn new_text(text: String) -> Self {
        Self::Text {
            text,
            text_encoding: StringEncoding::default(),
        }
    }

    pub fn new_bytes(bytes: Vec<u8>) -> Self {
        Self::Bytes {
            bytes,
            bytes_encoding: StringEncoding::default(),
        }
    }
}
