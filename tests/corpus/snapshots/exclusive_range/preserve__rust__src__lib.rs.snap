use crate::error::*;
use crate::ordered_hash_map::OrderedHashMap;
use crate::serialization::{LenEncoding, StringEncoding};
use cbor_encodings::ExclusiveRangeEncoding;
use std::collections::BTreeMap;
use std::convert::TryFrom;

#[derive(Clone, Debug)]
pub struct ExclusiveRange {
    pub v: u64,
    pub encodings: Option<ExclusiveRangeEncoding>,
}

impl ExclusiveRange {
    pub fn new(v: u64) -> Result<Self, DeserializeError> {
        if v > 9 {
            return Err(DeserializeFailure::RangeCheck {
                found: v as isize,
                min: None,
                max: Some(9),
            }
            .into());
        }
        Ok(Self { v, encodings: None })
    }
}
