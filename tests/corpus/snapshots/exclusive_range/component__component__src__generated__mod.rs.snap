// This file was code-generated using an experimental CDDL to rust tool:
// https://github.com/dcSpark/cddl-codegen

use core::cell::RefCell;

wit_bindgen::generate!({
    path: "wit",
    world: "cddl-lib-world",
});

use exports::cddl::cddl_lib::types as wit_types;

struct Component;

impl wit_types::Guest for Component {
    type ExclusiveRange = WitExclusiveRange;
}

export!(Component);

/// Every fallible door on this face reports through the rust crate's own error `Display`,
/// so a WIT `result<_, string>` carries the same text a native caller would see.
fn err<E: core::fmt::Display>(e: E) -> String {
    e.to_string()
}

pub struct WitExclusiveRange(pub RefCell<cddl_lib::ExclusiveRange>);

impl wit_types::GuestExclusiveRange for WitExclusiveRange {
    fn new(v: u64) -> Result<Self, String> {
        let inner = cddl_lib::ExclusiveRange::new(v).map_err(err)?;
        Ok(WitExclusiveRange(RefCell::new(inner)))
    }

    fn v(&self) -> u64 {
        let me = self.0.borrow();
        me.v
    }

    fn to_cbor_bytes(&self) -> Vec<u8> {
        <cddl_lib::ExclusiveRange as cddl_lib::serialization::ToCBORBytes>::to_cbor_bytes(
            &self.0.borrow(),
        )
    }

    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::ExclusiveRange, String> {
        <cddl_lib::ExclusiveRange as cddl_lib::serialization::Deserialize>::from_cbor_bytes(&bytes)
            .map(|v| wit_types::ExclusiveRange::new(WitExclusiveRange(RefCell::new(v))))
            .map_err(err)
    }
}
