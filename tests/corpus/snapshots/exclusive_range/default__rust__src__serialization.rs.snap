use super::*;
use crate::error::*;
use cbor_event::de::Deserializer;
use cbor_event::se::{Serialize, Serializer};
use std::io::{BufRead, Seek, SeekFrom, Write};

impl cbor_event::se::Serialize for ExclusiveRange {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_array(cbor_event::Len::Len(1))?;
        serializer.write_unsigned_integer(self.v)?;
        Ok(serializer)
    }
}

impl Deserialize for ExclusiveRange {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        let len = raw.array()?;
        let mut read_len = CBORReadLen::new(len);
        read_len.read_elems(1)?;
        read_len.finish()?;
        (|| -> Result<_, DeserializeError> {
            let v = Ok(raw
                .unsigned_integer()
                .map_err(Into::<DeserializeError>::into)
                .and_then(|x| {
                    if x > 11 {
                        Err(DeserializeFailure::RangeCheck {
                            found: x as isize,
                            min: None,
                            max: Some(11),
                        }
                        .into())
                    } else {
                        Ok(x)
                    }
                })? as u64)
            .map_err(|e: DeserializeError| e.annotate("v"))?;
            match len {
                cbor_event::Len::Len(_) => (),
                cbor_event::Len::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(ExclusiveRange { v })
        })()
        .map_err(|e| e.annotate("ExclusiveRange"))
    }
}
