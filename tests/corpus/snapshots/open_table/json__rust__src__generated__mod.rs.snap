#[derive(Clone, Debug)]
pub struct OpenTable {
    /// The open table's TYPED entries (CDDL `* k1 => v1`, the first row): every map entry whose key is of this row's declared CBOR major type. Its map surface is FLATTENED onto the wasm class (`insert`/`get`/`len`/`keys`), so there is no whole-map getter. Defaults empty. `@duplicates preserve` makes this a `PairMap` (duplicate keys kept, in wire order); otherwise the loose table container, which rejects a duplicate key.
    pub entries: BTreeMap<Vec<u8>, u64>,
    /// The open table's CAPTURED entries (CDDL `* k2 => v2`, the trailing catch-all row): every map entry the typed row did not claim. Defaults empty. `@duplicates preserve` makes this a `PairMap` (duplicate keys kept, in wire order); otherwise the loose table container.
    pub rest: BTreeMap<Md, Md>,
}

impl OpenTable {
    pub fn new() -> Self {
        Self {
            entries: BTreeMap::new(),
            rest: BTreeMap::new(),
        }
    }
}

impl Default for OpenTable {
    fn default() -> Self {
        Self::new()
    }
}

