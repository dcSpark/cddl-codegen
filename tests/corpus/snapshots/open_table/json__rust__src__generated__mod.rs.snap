impl OpenTableNonEmpty {
    /// * `first_key` - the key of the first typed entry (CDDL `+ k1 => v1`: an open table spelled with `+` holds at least one typed entry)
    /// * `first_value` - its value
    pub fn new(first_key: Vec<u8>, first_value: u64) -> Self {
        Self {
            entries: {
                let mut seed = BTreeMap::new();
                seed.insert(first_key, first_value);
                seed
            },
            rest: BTreeMap::new(),
        }
    }
