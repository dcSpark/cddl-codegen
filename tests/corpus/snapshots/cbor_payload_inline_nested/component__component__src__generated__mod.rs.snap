    fn from_cbor_bytes(bytes: Vec<u8>) -> Result<wit_types::CborInlineNested, String> {
        <cddl_lib::CborInlineNested as cddl_lib::serialization::Deserialize>::from_cbor_bytes(
            &bytes,
