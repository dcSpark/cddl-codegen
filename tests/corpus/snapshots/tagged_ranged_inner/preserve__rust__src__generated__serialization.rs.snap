impl cbor_event::se::Serialize for TaggedRanged {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_tag_sz(
            42u64,
            fit_sz(
                42u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.inner_tag_encoding)
                    .unwrap_or_default(),
            ),
        )?;
        serializer.write_unsigned_integer_sz(
            self.inner as u64,
            fit_sz(
                self.inner as u64,
                self.encodings
                    .as_ref()
                    .map(|encs| encs.inner_encoding)
                    .unwrap_or_default(),
            ),
        )
    }
}

impl Deserialize for TaggedRanged {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let (inner, inner_tag_encoding, inner_encoding) = match raw.tag_sz()? {
                (42, tag_enc) => raw
                    .unsigned_integer_sz()
                    .map_err(Into::<DeserializeError>::into)
                    .and_then(|(x, enc)| {
                        if x > 255 {
                            Err(DeserializeFailure::RangeCheck {
                                found: x as i128,
                                min: Some(0),
                                max: Some(255),
                            }
                            .into())
                        } else {
                            Ok((x, enc))
                        }
                    })
                    .map(|(x, enc)| (x as u8, Some(tag_enc), Some(enc)))?,
                (tag, _enc) => {
                    return Err(DeserializeFailure::TagMismatch {
                        found: tag,
                        expected: 42,
                    }
                    .into());
                }
            };
            Ok(Self {
                inner,
                encodings: Some(TaggedRangedEncoding {
                    inner_tag_encoding,
                    inner_encoding,
                }),
            })
        })()
        .map_err(|e| e.annotate("TaggedRanged"))
    }
}
