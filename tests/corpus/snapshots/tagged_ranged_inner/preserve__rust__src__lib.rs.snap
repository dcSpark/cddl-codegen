#[derive(Clone, Debug)]
pub struct TaggedRanged {
    pub inner: u8,
    pub encodings: Option<TaggedRangedEncoding>,
}

impl TaggedRanged {
    pub fn new(inner: u8) -> Self {
        Self {
            inner,
            encodings: None,
        }
    }
}

impl From<u8> for TaggedRanged {
    fn from(inner: u8) -> Self {
        TaggedRanged::new(inner)
    }
}

impl From<TaggedRanged> for u8 {
    fn from(wrapper: TaggedRanged) -> Self {
        wrapper.inner
    }
}
