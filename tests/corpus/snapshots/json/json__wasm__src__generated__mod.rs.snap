pub type MapTextToU64 = Table;

pub type MapU64ToText = PreservePmap;

/// `{+ k => v}` (`MapU64ToText`): at least one entry, enforced by the `NonEmptyPairMap` representation (an entry-ordered, DUPLICATE-permitting vec of pairs — `insert` APPENDS and never replaces a key, `get` returns the first match).
/// Enter via `try_from` or `new(first_key, first_value)`.
/// `insert` can never violate the bound; removal is checked in the core type.
#[derive(Clone, Debug)]
#[wasm_bindgen]
pub struct NePreservePmap(pub(crate) NonEmptyPairMap<u64, String>);

#[wasm_bindgen]
impl NePreservePmap {
    pub fn new(first_key: u64, first_value: String) -> Self {
        Self(NonEmptyPairMap::new(first_key, first_value))
    }

    pub fn len(&self) -> usize {
        self.0.len()
    }

    pub fn insert(&mut self, key: u64, value: String) -> Option<String> {
        self.0.insert(key, value)
    }

    pub fn get(&self, key: u64) -> Option<String> {
        self.0.get(&key).cloned()
    }

    pub fn keys(&self) -> Vec<u64> {
        self.0.keys().copied().collect::<Vec<_>>()
    }

    pub fn try_from(map: &MapU64ToText) -> Result<NePreservePmap, JsError> {
        let inner: PairMap<u64, String> = map.clone().into();
        NonEmptyPairMap::try_from(inner)
            .map(Self)
            .map_err(|e| JsError::new(&e.to_string()))
    }
}

impl From<NonEmptyPairMap<u64, String>> for NePreservePmap {
    fn from(native: NonEmptyPairMap<u64, String>) -> Self {
        Self(native)
    }
}

impl From<NePreservePmap> for NonEmptyPairMap<u64, String> {
    fn from(wasm: NePreservePmap) -> Self {
        wasm.0
    }
}

impl AsRef<NonEmptyPairMap<u64, String>> for NePreservePmap {
    fn as_ref(&self) -> &NonEmptyPairMap<u64, String> {
        &self.0
    }
}

