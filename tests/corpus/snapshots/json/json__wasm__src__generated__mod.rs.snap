/// `[* uint] @duplicates reject`: an insertion-ordered, duplicate-free set (order preserved for byte-exact round-trip). `add` is checked — an already-present element is refused; construct via `try_from` (the uniqueness door). `insert` is the std-set door (returns `false`, set unchanged, for an already-present element); `contains` tests membership.
#[derive(Clone, Debug)]
#[wasm_bindgen]
pub struct RejectUints(pub(crate) OrderedSet<u64>);

#[wasm_bindgen]
impl RejectUints {
    pub fn new() -> Self {
        Self(OrderedSet::new())
    }

    pub fn len(&self) -> usize {
        self.0.len()
    }

    pub fn get(&self, index: usize) -> u64 {
        self.0[index]
    }

    pub fn add(&mut self, elem: u64) -> Result<(), JsError> {
        self.0.push(elem).map_err(|e| JsError::new(&e.to_string()))
    }

    pub fn insert(&mut self, elem: u64) -> bool {
        self.0.insert(elem)
    }

    pub fn contains(&self, elem: u64) -> bool {
        self.0.contains(&elem)
    }

    pub fn try_from(elements: Vec<u64>) -> Result<RejectUints, JsError> {
        OrderedSet::try_from(elements)
            .map(Self)
            .map_err(|e| JsError::new(&e.to_string()))
    }
}

impl From<OrderedSet<u64>> for RejectUints {
    fn from(native: OrderedSet<u64>) -> Self {
        Self(native)
    }
}

impl From<RejectUints> for OrderedSet<u64> {
    fn from(wasm: RejectUints) -> Self {
        wasm.0
    }
}

impl AsRef<OrderedSet<u64>> for RejectUints {
    fn as_ref(&self) -> &OrderedSet<u64> {
        &self.0
    }
}

