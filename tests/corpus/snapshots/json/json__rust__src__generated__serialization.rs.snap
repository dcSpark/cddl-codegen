                        return Err(DeserializeFailure::UnexpectedKeyType(other_type).into());
                    }
                }
                read += 1;
            }
            let xs = match xs {
                Some(x) => x,
                None => {
                    return Err(
                        DeserializeFailure::MandatoryFieldMissing(Key::Str(String::from("xs")))
                            .into(),
                    );
                }
            };
            Ok(Self { xs })
        })()
        .map_err(|e| e.annotate("RejectSetJson"))
    }
}

impl cbor_event::se::Serialize for StrWrapper {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_text(&self.0)
    }
}

impl Deserialize for StrWrapper {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> { Ok(Self(raw.text()?)) })()
            .map_err(|e| e.annotate("StrWrapper"))
    }
}

impl cbor_event::se::Serialize for StructWrapper {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        self.0.serialize(serializer)
    }
}

impl Deserialize for StructWrapper {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> { Ok(Self(U64Wrapper::deserialize(raw)?)) })()
            .map_err(|e| e.annotate("StructWrapper"))
    }
}

impl cbor_event::se::Serialize for TableHolder {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_array(cbor_event::Len::Len(1))?;
        serializer.write_map(cbor_event::Len::Len(self.t.len() as u64))?;
        for (key, value) in self.t.iter() {
            serializer.write_text(key)?;
            serializer.write_unsigned_integer(*value)?;
        }
        Ok(serializer)
    }
}

impl Deserialize for TableHolder {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let len = raw.array()?;
            let mut read_len = CBORReadLen::from(len);
            read_len.read_elems(1)?;
            read_len.finish()?;
            let t = (|| -> Result<_, DeserializeError> {
                let mut t_table = BTreeMap::new();
                let t_len = raw.map()?;
                while match t_len {
                    cbor_event::Len::Len(n) => (t_table.len() as u64) < n,
                    cbor_event::Len::Indefinite => true,
                } {
                    if matches!(t_len, cbor_event::Len::Indefinite)
                        && raw.cbor_type()? == cbor_event::Type::Special
                        && raw.special_break()?
                    {
                        break;
                    }
                    let t_key = raw.text()?;
                    let t_value = raw.unsigned_integer()?;
                    if t_table.insert(t_key.clone(), t_value).is_some() {
                        return Err(DeserializeFailure::DuplicateKey(Key::Str(t_key)).into());
                    }
                }
                Ok(t_table)
            })()
            .map_err(|e| e.annotate("t"))?;
            match len {
                cbor_event::Len::Len(_) => (),
                cbor_event::Len::Indefinite => match raw.special()? {
                    cbor_event::Special::Break => (),
                    _ => return Err(DeserializeFailure::EndingBreakMissing.into()),
                },
            }
            Ok(TableHolder { t })
        })()
        .map_err(|e| e.annotate("TableHolder"))
    }
}

impl cbor_event::se::Serialize for U64Wrapper {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_unsigned_integer(self.0)
    }
}

impl Deserialize for U64Wrapper {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> { Ok(Self(raw.unsigned_integer()?)) })()
            .map_err(|e| e.annotate("U64Wrapper"))
    }
}

impl cbor_event::se::Serialize for U8Wrapper {
    fn serialize<'se>(
        &self,
        serializer: &'se mut Serializer,
    ) -> cbor_event::Result<&'se mut Serializer> {
        serializer.write_unsigned_integer(self.0 as u64)
    }
}

impl Deserialize for U8Wrapper {
    fn deserialize(raw: &mut Deserializer) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let inner = raw
                .unsigned_integer()
                .map_err(Into::<DeserializeError>::into)
                .and_then(|x| {
                    if x > 255 {
                        Err(DeserializeFailure::RangeCheck {
                            found: x as i128,
                            min: Some(0),
                            max: Some(255),
                        }
                        .into())
                    } else {
                        Ok(x)
                    }
                })? as u8;
            if inner > 255 {
                return Err(DeserializeFailure::RangeCheck {
                    found: inner as i128,
                    min: Some(0),
                    max: Some(255),
                }
                .into());
            }
            Ok(Self(inner))
        })()
        .map_err(|e| e.annotate("U8Wrapper"))
    }
}
