---
source: src/tests/snapshot_tests.rs
expression: content
---
[package]
name = "cddl-lib-wasm"
version = "0.1.0"
edition = "2024"

[package.metadata.cddl-codegen]
generated-with = "0.1.0"

[lib]
crate-type = ["cdylib", "rlib"]

[dependencies]
cddl-lib = { path = "../rust", features = ["wasm"] }
cbor_event = "3.2.0"
wasm-bindgen = "0.2"
linked-hash-map = "0.5.3"
serde = "1.0"
serde_json = { version = "1.0.57", features = ["float_roundtrip"] }
serde-wasm-bindgen = "0.6.5"
