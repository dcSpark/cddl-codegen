; Nominal one-value types: every rule owns direct codecs (including preserve sidecars) rather than
; relying on the inline-only C-style fixed enum path.  The fixed/null presence lowering is pinned
; separately by tests/robustness/choice_fixed_null_collapse.cddl.
true_value = true
false_value = false
nil_value = nil
null_value = null
undefined_value = undefined
answer = 42
version = 5
marker = "v1"
bytes_hex = h'CAFE'
bytes_raw = 'hi'
bytes_empty = h''
bytes_choice = h'AA' / h'BB' / null
mixed_text_bytes_choice = "a" / h'61'
bytes_members = [required: h'CAFE', ? optional: 'hi']
bytes_map_members = {required: h'CAFE', ? optional: 'hi'}
bytes_default = [ ? payload: bytes .default h'CAFE', end: uint ]
tagged_bytes = #6.7(h'CAFE')
cbor_bytes = bytes .cbor h'CAFE'
