; Homogeneous-array occurrence windows. The named bounded rules below are also the preferred wasm
; classes for matching inline fields, while `nested_upper` proves a bounded array can be an element.
one_or_more = [+ uint]
bounded = [2*5 uint]
upper = [*5 uint]
lower = [2* uint]
maybe = [? uint]
exact = [2*2 uint]
nested_upper = [* [*2 uint]]
nested_bounded = [2*3 [*2 uint]]
; Embed sites are where occurrence counts are actually enforceable (the top-level rules are
; transparent Vec aliases with no standalone wire API). Occurrence bounds are LENGTH constraints
; on the array — they must never be misread as element VALUE bounds (`[+ uint]` once rejected the
; element value 0, and `[2*5 uint]` rejected element values outside 2..=5, while any length
; passed). The emit-tests deser-reject cases push each field's length out of bounds. The inline
; fields exercise named-class dedup for each window family.
occurrence_holder = [
  o: one_or_more,
  b: bounded,
  upper: upper,
  lower: lower,
  maybe: maybe,
  exact: exact,
  nested: nested_upper,
  nested_bounded: nested_bounded,
  inline_bounded: [1*3 text],
  inline_upper: [0*5 uint],
  inline_lower: [2* uint],
  inline_maybe: [0*1 uint],
  inline_exact: [2*2 uint],
]

middle_occurrence = [
  ; Canonical safe middle occurrence: the bytes segment ends at its mandatory Text-class suffix.
  ; The major-disjoint boundary is what lets the decoder honor RFC 8610 greedy matching without a
  ; rewind or a value-level discriminator.
  prefix: uint,
  * bytes,
  suffix: tstr,
]

exact_middle_occurrence = [
  ; An exact window stops by count, so same-major uint values need no discriminator or rewind.
  prefix: uint,
  2*2 uint,
  suffix: uint,
]
