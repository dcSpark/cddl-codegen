; The `.default` value kinds beyond the uint/text pair `default_value.cddl` already carries.
;
; `true`/`false` are CDDL prelude CONSTANTS spelled as typenames rather than as their own literal
; syntax, so a bool default is lowered from the typename — the same classification the fixed map-key
; path makes. Both spellings appear because they are separate lowering arms, and both reps appear
; because the serializer's skip-compare and the deserializer's collapse are emitted per
; representation.
bool_default = { a: uint, ? f: bool .default true, ? g: bool .default false }

bool_default_array = [ a: uint, ? f: bool .default false ]

; A float default lands on the float carrier the head names (`float64` -> `f64`), and the
; skip-compare that decides whether to write the member is the same NaN-safe comparison the rest of
; the float path uses.
float_default = { a: uint, ? f: float64 .default 1.5 }
