nums = [* uint]
; float and bool elements are CBOR major type 7 (Special), which the array element-loop break-check
; must NOT treat as a terminator — otherwise every non-empty value is rejected / fails to compile.
floats = [* float64]
bools = [* bool]
; ...and referencing such a named special-element collection as a record field must not panic
; generation (the Array-element Special-class assert in intermediate.rs was stale for the definite
; case; it fired at generation time regardless of profile). `bool_holder` is the systematic catch:
; its emit-tests round-trip runs under every profile. A `float_holder` can't join it here because
; floats don't support --preserve-encodings (a pre-existing generation limitation the corpus
; exercises for every entry — same reason float prelude types are excluded from prelude.cddl).
bool_holder = [b: bools]
