nums = [* uint]
; float and bool elements are CBOR major type 7 (Special), which the array element-loop break-check
; must NOT treat as a terminator — otherwise every non-empty value is rejected / fails to compile.
floats = [* float64]
bools = [* bool]
; ...and referencing such a named special-element collection as a record field must not panic
; generation (the Array-element Special-class assert in intermediate.rs was stale for the definite
; case; it fired at generation time regardless of profile). `bool_holder` is the systematic catch on
; two axes: it generates+compiles under all three profiles (locking that generation-time panic), and
; its default-profile emit-tests round-trip exercises `make_deser_loop_break_check` — which is
; type-agnostic, so it equally locks the `[* float64]` break-check regression (a `bool` element is the
; same CBOR major type 7 as a float). A `float_holder` can't join it because floats don't support
; --preserve-encodings (a pre-existing generation limitation the corpus exercises for every entry —
; same reason float prelude types are excluded from prelude.cddl).
bool_holder = [b: bools]
