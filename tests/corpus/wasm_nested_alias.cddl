nums = [* uint]
tags = { * uint => text }
nested_arr = [* nums]
tagged_list = [* tags]
value_map = { * uint => nums }
opt_holder = [ x: uint, ? f: nums ]
passthru = nums
passthru_map = { * uint => passthru }
; passthrough alias to a named MAP: transparent `pub type` in rust, but the wasm alias must point at
; the map's wrapper struct (`pub type PassthruTags = Tags`), not `for_wasm_member`'s inline-only
; `MapU64ToText` (which only exists for anonymous inline maps -> E0425). Contrast `passthru` above (a
; directly-exposable array) which stays transparent (`Vec<u64>`).
passthru_tags = tags
passthru_tags_map = { * uint => passthru_tags }
