; `--emit-tests` mints table keys consecutively from a base. A key DOMAIN can carry its own value
; window, and a hardcoded base of `0` is then a key the (correct) generated bounds check rejects
; with `RangeCheck` — the emitted round-trip vector goes red blaming a decoder that is behaving
; exactly as the CDDL says. Each table below sits in a RECORD FIELD rather than being a bare
; top-level rule: a top-level table is a transparent alias with no standalone round-trip test of
; its own, so it would never reach the minter's map arm.
;
; An unbounded `*` table mints at length 1 (not 0), so a single `*`-spelled table genuinely
; reaches the key path — these are not vacuous.

; `.ne N` parses to Range(N+1, N-1): an INVERTED range encoding an EXCLUSION, not a window.
holder_ne_zero = [m: {* int .ne 0 => uint}] ; the naive base IS the excluded value
holder_ne_one = [m: {* int .ne 1 => uint}]  ; the excluded value sits one past the naive base

; A two-sided window that does not contain 0 — the non-inverted arm of the same predicate.
holder_window = [m: {* 5..9 => tstr}]

; A one-sided window (no upper endpoint).
holder_ge = [m: {* uint .ge 5 => tstr}]

; A `nint` key: its RUST value is the u64 magnitude `m = |v + 1|`, not the CDDL value, and the
; magnitude is DECREASING in the value — so the window's endpoints swap on the way in. `.ge -5`
; becomes a magnitude window `m <= 4` (base 0 is already inside it, so the key spelling stays the
; pre-base `__i as u64`), while `.le -5` becomes `m >= 4` (base 0 is magnitude 0 = value -1, which
; violates it, so a non-zero magnitude must be chosen). Choosing or verifying a base in VALUE space
; here emits `-5 as u64` = 18446744073709551611.
holder_nint_ge = [m: {* nint .ge -5 => uint}]
holder_nint_le = [m: {* nint .le -5 => uint}]

; These exact-one restricted dynamic open-struct rows exercise constructor-map minting and its
; shared collision search. (Loose `*` rows mint through `insert_rest`, so they cannot observe a
; `key_base`.) N64 magnitude 0 is value -1, so it differs from fixed uint 0 and retains base 0;
; ordinary uint 0 collides and moves to base 1. A fixed nint -1 control is unavailable: record
; fixed nint keys are deliberately unsupported before generation, so the unit `FixedValue` equality
; control directly owns it.
holder_dynamic_nint_uint_zero = { 0: uint, 1*1 nint => uint }
holder_dynamic_uint_uint_zero = { 0: uint, 1*1 uint => uint }

; A NON-integer key whose window is a LENGTH (`.size 3`), which the `__i.to_string()` key spelling
; has no way to steer. The minter must SKIP it loudly (the map mints empty and says why), never
; mint a violating key and let the emitted vector go red against a correct decoder.
holder_str_size = [m: {* tstr .size 3 => uint}]

; A protected open struct whose FORBIDDEN key 0 sits at the rest domain's baseline coordinate. The
; round-trip's extra rest entry enters through the checked `insert_rest` door, which rejects
; declared and forbidden keys; the entry key must also skip the baseline's own rest key (2).
holder_forbidden_rest_zero = { 1: uint, 0*0 0: text, * uint => text }

; Each checked rest insertion must move past a colliding forbidden or declared key.
holder_forbidden_union_rest = { 1: uint, 0*0 0: text, 0*0 "a": text, * (uint / tstr) => text }
holder_forbidden_text_rest = { 1: uint, 0*0 "a": text, * tstr => text }
holder_declared_text_rest = { a: uint, * tstr => uint }
holder_declared_int_rest = { 0: uint, * int => text }
holder_declared_sized_text_rest = { "aa": uint, * tstr .size 2 => text }
rest_key_newtype = uint ; @newtype
holder_declared_newtype_rest = { 0: uint, * rest_key_newtype => text }

; A union with only composite key variants keeps its valid bytes mint for checked insertion.
holder_composite_choice_rest = { a: uint, * (bytes / [* uint]) => text }

; A bounded `@newtype` rest key searches inside the wrapper's own window, at both window sides and
; for a `.size`-bounded text key. The first candidate of each collides with the declared key.
rest_key_le = uint .le 5 ; @newtype
holder_declared_bounded_newtype_le_rest = { 0: uint, * rest_key_le => text }
rest_key_ge = uint .ge 5 ; @newtype
holder_declared_bounded_newtype_ge_rest = { 5: uint, * rest_key_ge => text }
rest_key_sized_text = tstr .size 1 ; @newtype
holder_declared_bounded_newtype_text_rest = { "a": uint, * rest_key_sized_text => text }
; A window whose only value is declared leaves no entry key: the checked insertion is skipped loudly.
rest_key_zero = uint .le 0 ; @newtype
holder_declared_exhausted_newtype_rest = { 0: uint, * rest_key_zero => text }
; A bounded bytes key has no uint/text image, so it keeps its generic in-window mint.
rest_key_bounded_bytes = bytes .size (1..3) ; @newtype
holder_declared_bounded_bytes_newtype_rest = { 0: uint, * rest_key_bounded_bytes => text }
