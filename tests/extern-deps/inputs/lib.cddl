everything = [
    ; from a single-level nested mod
    foo,
    extern_crate_foo,
    ; extern-dep type as a LIST element: proves the wasm wrapper's inner-storage path resolves to
    ; the dep's own rust crate (no `--extern-wasm-crate` mapping here — the single-crate convention's
    ; rust type is itself `#[wasm_bindgen]`, so it doubles as the boundary type)
    extern_foos: [* extern_crate_foo],
    ; test using in arrays too
    bars: [* bar],
    ; and maps
    table: { * uint => bar_typedef }
    ; and from a multi-level nested mod
    baz: baz,
    ; and root dir mod
    qux: qux,
]

; `int` is common scaffolding: under `--common-import-override` the generator re-exports the common
; crate's `Int`/`IntError` instead of minting a crate-local enum. Reference it in BOTH shapes so both
; re-export sites are exercised: an alias-only use (no struct field) and a direct struct-field use.
delta_coin = int

int_holder = [
    delta: int,
]