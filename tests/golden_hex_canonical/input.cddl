; Canonical-form golden known-answer vectors. The byte strings in tests.rs are hand-derived from
; RFC 8949 §4.2.1/§4.2.2 (preferred/minimal-length arguments, definite-length re-framing),
; independent of the generator AND of the tests/deser_test cbor_event helpers — in particular of
; cbor_event's Sz::canonical(), which is the header-minimality core the generated canonical path
; itself trusts. A bug there corrupts the canonical suite's expected bytes and the generated output
; identically; these raw spec-anchored vectors are the independent check.
;
; Same type shapes as tests/golden_hex_preserve (the two suites assert the two halves of the same
; contract: preserve keeps an irregular encoding, canonical minimizes it).

pair = [a: uint, b: uint]

strs = [s: tstr, v: bstr]

kv = { a: uint, b: uint }

uint_seq   = [* uint]
seq_holder = [xs: uint_seq]

tagged_one = #6.11([x: uint])

; negative integers (major type 1): argument minimization mirrored from `pair`.
npair = [n: nint, m: nint]

; table (`{ * uint => text }`): the RUNTIME canonical key sort (emitted per-table under
; --canonical-form) — distinct from the codegen-time STRUCT key sort pinned by
; tests/canonical's mixed_len_keys_ordering_rule. Wrapped in a record.
uint_table   = { * uint => text }
table_holder = [t: uint_table]

; cross-major keys: `int` spans uint (major 0) and nint (major 1), the ONLY cell where the
; documented RFC 7049 §3.9 length-first key order and RFC 8949 §4.2.1 pure-bytewise order
; DISAGREE (single-major minimal heads grow with length, so the rules coincide there):
; -1 = 0x20 (1 byte) sorts before 256 = 0x19 0x01 0x00 (3 bytes) under length-first, but
; after it under bytewise (0x19 < 0x20). The uint_table vectors above can't discriminate.
int_table  = { * int => text }
int_holder = [it: int_table]

; tag-258 set idiom (`#6.258([* a]) / [* a]`): --canonical-form normalizes the tag's SIZE (a
; non-minimal header minimizes) but NEVER its PRESENCE — a tagged value stays tagged, an untagged
; value stays untagged. Carries the EXPLICIT `; @duplicates preserve` opt-out (tag 258 now DEFAULTS
; to `@duplicates reject`), which pins the transparent alias (Vec<String>) here. Wrap in a record.
opt_set        = #6.258([* tstr]) / [* tstr] ; @duplicates preserve
opt_set_holder = [s: opt_set]

; `@duplicates preserve` table (PairMap): under --canonical-form a preserve-mode table STABLE-sorts
; its entries by encoded key bytes, keeping DUPLICATE keys adjacent in first-appearance order —
; distinct from `uint_table` above, whose keyed table can hold no duplicates. Duplicate-carrying data
; has no RFC 8949 canonical form, so this is the documented deterministic best-effort (never a
; refusal); the vectors in tests.rs pin all three properties: sort-by-key-bytes, dup-adjacency in
; first-appearance order, and per-entry header minimization.
dup_pmap        = { * uint => text } ; @duplicates preserve
dup_pmap_holder = [p: dup_pmap]
