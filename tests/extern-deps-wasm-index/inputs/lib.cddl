; Consumer spec for the `--extern-wrapper-index` deferral feature. Every collection shape below is
; over the dependency's extern type `idx_foo`, so the wrappers the consumer would mint collide by
; name with the ones the dependency's own wasm crate already emits — a wasm duplicate-symbol link
; error when both are linked into one cdylib. Pointing `--extern-wrapper-index
; index_dep_crate=<dep collections.rs>` at the dep's index makes the consumer DEFER the wrappers the
; dep owns. The dep index lists: IdxFooList, MapU64ToIdxFoo (NOT MapIdxFooToIdxFoo).
;
; A consumer-owned struct, used as a map VALUE to make one map MIXED (extern key + consumer value).
; `c: (int .ne 1)` is a control-constrained signed int: it takes the two-major-type signed path and
; emits an i64-window width guard (`min: i64::MIN, max: i64::MAX`) into `RangeCheck`'s fields. Those
; fields are i128, so the literals compile on wasm32-unknown-unknown — this member deliberately pins
; that widened class on wasm32 (they were `isize`, 32-bit on wasm, and any such crate failed to link).
local_thing = [a: uint, b: tstr, c: (int .ne 1)]

; (e) NAMED `[+ idx_bar]` rule, deliberately UNREFERENCED by any other rule and alphabetically
;     FIRST in the struct walk (BTreeMap order: AbcBars < Everything < ZetaHolder). Its restricted
;     class (AbcBars — rule-declared, never deferred) is minted locally, but its `try_from` source
;     is the LOOSE structural IdxBarList, which IS in the dep index -> the source mint defers and
;     the conversion resolves against the dep's class. The rule is unreferenced and the only loose
;     `[* idx_bar]` use lives in another module (zeta.cddl), so the root-scope `use` for the
;     try_from source can come ONLY from the emission-scope import routing — this cell is RED if
;     the source is re-minted locally (duplicate class at link, the order-dependent hazard: this
;     rule's emitters run before any other idx_bar use) OR if the deferred source's import isn't
;     routed (unresolved IdxBarList in the try_from signature).
abc_bars = [+ idx_bar]

everything = [
    ; (a) list over an extern element whose wrapper IS in the index -> DEFERRED (imported from
    ;     index_dep_crate_wasm::collections, no local IdxFooList class)
    foos: [* idx_foo],
    ; (a) map whose wrapper IS in the index -> DEFERRED (MapU64ToIdxFoo)
    foo_table: { * uint => idx_foo },
    ; (b) all-extern map whose wrapper is NOT in the index -> minted LOCALLY + a stderr warning; its
    ;     keys-list wrapper IdxFooList IS in the index -> DEFERRED, so keys() builds via `.into()` (R3d)
    foo_to_foo: { * idx_foo => idx_foo },
    ; (c) MIXED map (extern key + consumer value) -> minted LOCALLY, silent; keys-list IdxFooList IS
    ;     in the index -> DEFERRED, so keys() builds via `.into()` (R3d)
    foo_keyed: { * idx_foo => local_thing },
    ; (d) NonEmpty list over an extern element whose restricted wrapper IS in the index ->
    ;     DEFERRED (imported NonEmptyIdxFooList, no local class). Closes the NonEmpty deferral
    ;     boundary: the synthesized `NonEmpty*List` emitter must consult the dep index too, or two
    ;     consumers of the same dep both mint `#[wasm_bindgen] NonEmptyIdxFooList` and collide.
    bars: [+ idx_foo],
    ; (f) INLINE `[+ idx_baz]` whose restricted wrapper is NOT in the index (local mint + warning
    ;     hint) but whose LOOSE try_from source IdxBazList IS -> the synthesized NonEmptyIdxBazList
    ;     is minted locally with `try_from(&IdxBazList)` against the dep's deferred class. No loose
    ;     `[* idx_baz]` use exists anywhere, so the root `use` for IdxBazList can come ONLY from the
    ;     emission-scope import routing (the inline twin of the `abc_bars` cell above).
    only_nb_baz: [+ idx_baz],
]
