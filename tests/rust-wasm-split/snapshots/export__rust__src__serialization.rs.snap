    }
}

impl cbor_event::se::Serialize for TypeChoice {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        match self {
            TypeChoice::I0 => serializer.write_unsigned_integer(0u64),
            TypeChoice::Helloworld => serializer.write_text("hello world"),
            TypeChoice::Text(text) => serializer.write_text(&text),
            TypeChoice::Bytes(bytes) => serializer.write_bytes(&bytes),
            TypeChoice::U64(uint) => {
                serializer.write_tag(64u64)?;
                serializer.write_unsigned_integer(*uint)
            }
        }
    }
}

impl Deserialize for TypeChoice {
    fn deserialize<R: BufRead + Seek>(raw: &mut Deserializer<R>) -> Result<Self, DeserializeError> {
        (|| -> Result<_, DeserializeError> {
            let initial_position = raw.as_mut_ref().stream_position().unwrap();
            let mut errs = Vec::new();
            let deser_variant = (|raw: &mut Deserializer<_>| -> Result<_, DeserializeError> {
                let i0_value = raw.unsigned_integer()?;
                if i0_value != 0 {
                    return Err(DeserializeFailure::FixedValueMismatch {
                        found: Key::Uint(i0_value),
                        expected: Key::Uint(0),
                    }
                    .into());
                }
                Ok(())
            })(raw);
            match deser_variant {
                Ok(()) => return Ok(TypeChoice::I0),
                Err(e) => {
                    errs.push(e.annotate("I0"));
                    raw.as_mut_ref()
                        .seek(SeekFrom::Start(initial_position))
                        .unwrap();
                }
            };
            let deser_variant = (|raw: &mut Deserializer<_>| -> Result<_, DeserializeError> {
                let helloworld_value = raw.text()?;
                if helloworld_value != "hello world" {
                    return Err(DeserializeFailure::FixedValueMismatch {
                        found: Key::Str(helloworld_value),
                        expected: Key::Str(String::from("hello world")),
                    }
                    .into());
                }
                Ok(())
            })(raw);
            match deser_variant {
                Ok(()) => return Ok(TypeChoice::Helloworld),
                Err(e) => {
                    errs.push(e.annotate("Helloworld"));
                    raw.as_mut_ref()
                        .seek(SeekFrom::Start(initial_position))
                        .unwrap();
                }
            };
            let deser_variant = (|raw: &mut Deserializer<_>| -> Result<_, DeserializeError> {
                Ok(raw.text()? as String)
            })(raw);
            match deser_variant {
                Ok(text) => return Ok(Self::Text(text)),
                Err(e) => {
                    errs.push(e.annotate("Text"));
                    raw.as_mut_ref()
                        .seek(SeekFrom::Start(initial_position))
                        .unwrap();
                }
            };
            let deser_variant = (|raw: &mut Deserializer<_>| -> Result<_, DeserializeError> {
                Ok(raw.bytes()? as Vec<u8>)
            })(raw);
            match deser_variant {
                Ok(bytes) => return Ok(Self::Bytes(bytes)),
                Err(e) => {
                    errs.push(e.annotate("Bytes"));
                    raw.as_mut_ref()
                        .seek(SeekFrom::Start(initial_position))
                        .unwrap();
                }
            };
            let deser_variant = (|raw: &mut Deserializer<_>| -> Result<_, DeserializeError> {
                match raw.tag()? {
                    64 => Ok(raw.unsigned_integer()? as u64),
                    tag => Err(DeserializeFailure::TagMismatch {
                        found: tag,
                        expected: 64,
                    }
                    .into()),
                }
            })(raw);
            match deser_variant {
                Ok(uint) => return Ok(Self::U64(uint)),
                Err(e) => {
                    errs.push(e.annotate("U64"));
                    raw.as_mut_ref()
                        .seek(SeekFrom::Start(initial_position))
                        .unwrap();
                }
            };
            Err(DeserializeError::new(
                "TypeChoice",
                DeserializeFailure::NoVariantMatchedWithCauses(errs),
            ))
        })()
        .map_err(|e| e.annotate("TypeChoice"))
    }
}
