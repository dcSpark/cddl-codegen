impl cbor_event::se::Serialize for TaggedTypeChoice {
    fn serialize<'se, W: Write>(
        &self,
        serializer: &'se mut Serializer<W>,
    ) -> cbor_event::Result<&'se mut Serializer<W>> {
        serializer.write_tag(23u64)?;
        match self {
            TaggedTypeChoice::Stringliteral => serializer.write_text("string literal"),
            TaggedTypeChoice::Foo(foo) => foo.serialize(serializer),
            TaggedTypeChoice::U64(uint) => serializer.write_unsigned_integer(*uint),
