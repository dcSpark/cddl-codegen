# global .gitignore
*.swp

# IDE
.idea/
.vscode/
docs/node_modules

# node_modules anywhere (docs/, cddl-matrix/ dev-only typecheck deps, …) — never committed;
# reproduced from the committed lockfile via `bun install`
node_modules/

# Rust
target/
book/

# Mac files
**/.DS_STore

# Test files (generated output dirs, any export suffix e.g. export, export_wasm, export_json_preserve)
tests/*/export*/
# The hand-written umbrella cdylib (workspace_regen gate) resolves a fresh lock against the
# regenerated export dirs on every run; the lock is a transient artifact, not a source of truth.
tests/workspace-regen/umbrella/Cargo.lock
# The dep-universe warm-up crate is only ever `cargo fetch`ed (check.ts offline preflight);
# its lock is re-resolved per warm-up, not a source of truth.
tests/warmup/Cargo.lock
# The matrix's component-execution probe host is COPIED into scratch and built there (verify.ts
# never builds it in the checkout), so a lock here can only come from a hand `cargo` run — a local
# artifact, not a source of truth.
cddl-matrix/component-probe-host/Cargo.lock
# getting_started_example generates the documented first-run output here (see getting_started.mdx)
example/export*/

# insta pending snapshots (transient; bless with `INSTA_UPDATE=always cargo test`, never commit)
*.snap.new
*.pending-snap

# The one shared `npm install` the TypeScript-side test legs resolve their deps from
# (`shared_ts_toolchain`): keyed by a hash of the effective manifest, reinstalled on a pin bump,
# disposable like any other build artifact.
/.ts-toolchain/

# Scratch area for draft/investigation artifacts (not committed)
/draft/
/.gate-cache/

# cddl-matrix: matrix.json is the committed golden (guarded by `bun run build_matrix.ts --check`);
# verify_report.json is a transient per-run report, not a source of truth.
cddl-matrix/verify_report.json

# cargo-mutants survey output (regenerated, not committed)
mutants.out/
mutants.out.old/
