# global .gitignore
*.swp

# IDE
.idea/
.vscode/
docs/node_modules

# Rust
target/
book/

# Mac files
**/.DS_STore

# Test files (generated output dirs, any export suffix e.g. export, export_wasm, export_json_preserve)
tests/*/export*/

# insta pending snapshots (transient; bless with `INSTA_UPDATE=always cargo test`, never commit)
*.snap.new
*.pending-snap

# Scratch area for draft/investigation artifacts (not committed)
/draft/

# cddl-matrix: matrix.json is the committed golden (guarded by build_matrix.py --check);
# verify_report.json is a transient per-run report, not a source of truth.
cddl-matrix/verify_report.json
